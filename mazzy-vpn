menu_check_all() {
    cmd_validate all || true
    printf '\n'
    cmd_probe all --timeout "$DEFAULT_PROBE_TIMEOUT" || true
}

menu_test_all() {
    local protocol answer
    protocol="$(choose_protocol)" || return 1
    load_profiles "$protocol"
    ((${#PROFILES[@]} > 0)) || {
        warn "Для $(protocol_title "$protocol") профилей нет"
        return 1
    }
    printf 'Будут последовательно проверены %d профилей %s.\n' \
        "${#PROFILES[@]}" "$(protocol_title "$protocol")"
    printf 'Каждый тест временно меняет VPN-маршрут и затем выполняет rollback.\n'
    read -r -p "$(msg continue_prompt)" answer
    [[ "$answer" == "y" || "$answer" == "Y" ||
       "$answer" == "j" || "$answer" == "J" ]] || {
        say "$(msg cancelled)"
        return 0
    }
    cmd_test_all "$protocol" --timeout "$DEFAULT_TEST_TIMEOUT"
}

menu_autostart() {
    local answer
    case "$UI_LANG" in
        ru) printf '  1. Включить автоподключение\n  2. Выключить автоподключение\n' ;;
        en) printf '  1. Enable autostart\n  2. Disable autostart\n' ;;
        de) printf '  1. Autostart aktivieren\n  2. Autostart deaktivieren\n' ;;
        zh) printf '  1. 启用自动启动\n  2. 禁用自动启动\n' ;;
        ja) printf '  1. 自動起動を有効化\n  2. 自動起動を無効化\n' ;;
        ko) printf '  1. 자동 시작 활성화\n  2. 자동 시작 비활성화\n' ;;
    esac
    read -r -p "$(msg choice)" answer
    case "$answer" in
        1) cmd_autostart on ;;
        2) cmd_autostart off ;;
        *) warn "$(msg invalid_choice)"; return 1 ;;
    esac
}

menu_config_folders() {
    local choice path
    case "$UI_LANG" in
        ru) printf '  1. Просканировать папку без изменений\n  2. Импортировать распознанные конфиги\n  3. Создать новую структуру папок\n  0. Назад\n' ;;
        en) printf '  1. Scan a folder without changes\n  2. Import recognized configs\n  3. Create a new folder structure\n  0. Back\n' ;;
        de) printf '  1. Ordner ohne Änderungen scannen\n  2. Erkannte Konfigurationen importieren\n  3. Neue Ordnerstruktur erstellen\n  0. Zurück\n' ;;
        zh) printf '  1. 扫描文件夹但不修改\n  2. 导入识别到的配置\n  3. 创建新的文件夹结构\n  0. 返回\n' ;;
        ja) printf '  1. 変更せずフォルダーをスキャン\n  2. 認識した設定をインポート\n  3. 新しいフォルダー構造を作成\n  0. 戻る\n' ;;
        ko) printf '  1. 변경 없이 폴더 스캔\n  2. 인식된 설정 가져오기\n  3. 새 폴더 구조 생성\n  0. 뒤로\n' ;;
    esac
    read -r -p "$(msg choice)" choice || return 0
    case "$choice" in
        1)
            read -r -e -p "$(msg config_folder)" path
            [[ -n "$path" ]] || { warn "$(msg no_folder)"; return 1; }
            cmd_import_dir "$path" --dry-run
            ;;
        2)
            read -r -e -p "$(msg config_folder)" path
            [[ -n "$path" ]] || { warn "$(msg no_folder)"; return 1; }
            cmd_import_dir "$path"
            ;;
        3)
            read -r -e -p "$(msg new_folder)" path
            cmd_init_config_dir "${path:-$PWD/mazzy-vpn-configs}"
            ;;
        0) return 0 ;;
        *) warn "$(msg invalid_choice)"; return 1 ;;
    esac
}

interactive_menu() {
    local choice
    require_profile_access
    while true; do
        dashboard_render
        print_main_menu
        read -r -p "$(msg choose_action)" choice || return 0
        case "$choice" in
            1) cmd_quick_connect || true ;;
            2) cmd_connect || true ;;
            3) cmd_disconnect || true ;;
            4) cmd_dashboard || true ;;
            5) cmd_test || true ;;
            6) menu_check_all ;;
            7) menu_test_all || true ;;
            8) cmd_emergency || true ;;
            9) cmd_diagnose || true ;;
            10) cmd_doctor || true ;;
            11) cmd_list all ;;
            12) menu_autostart || true ;;
            13) cmd_logs ;;
            14) cmd_self_test || true ;;
            15) menu_config_folders || true ;;
            16) menu_language || true ;;
            0) return 0 ;;
            *) warn "$(msg unknown_item)" ;;
        esac
    done
}

main() {
    local command="${1:-}"
    [[ $# -eq 0 ]] || shift
    case "$command" in
        "") interactive_menu ;;
        help|-h|--help) usage ;;
        version|-V|--version)
            say "$PRODUCT_NAME $VERSION ($CLI_COMMAND; alias: $COMPAT_COMMAND)"
            ;;
        list|ls) cmd_list "$@" ;;
        connect|up|start|switch) cmd_connect "$@" ;;
        quick|fast) cmd_quick_connect "$@" ;;
        disconnect|down|stop) cmd_disconnect "$@" ;;
        reconnect|restart) cmd_reconnect "$@" ;;
        dashboard|dash) cmd_dashboard "$@" ;;
        status|show) cmd_status "$@" ;;
        diagnose|diag) cmd_diagnose "$@" ;;
        validate|lint) cmd_validate "$@" ;;
        probe|ping) cmd_probe "$@" ;;
        test|check) cmd_test "$@" ;;
        test-all|check-all) cmd_test_all "$@" ;;
        emergency|recover) cmd_emergency "$@" ;;
        self-test|selftest) cmd_self_test "$@" ;;
        doctor) cmd_doctor "$@" ;;
        autostart|auto) cmd_autostart "$@" ;;
        import|add) cmd_import "$@" ;;
        import-dir|add-dir|scan-dir) cmd_import_dir "$@" ;;
        init-config-dir|init-dir) cmd_init_config_dir "$@" ;;
        remove|delete|rm) cmd_remove "$@" ;;
        logs|log) cmd_logs "$@" ;;
        language|lang|locale) cmd_language "$@" ;;
        _service-run) service_run ;;
        _health-check) health_check ;;
        _test-timeout) test_timeout_handler "${1:-}" ;;
        _recover-stale-test) recover_stale_test_state ;;
        _dedupe-quick-policy)
            require_root _dedupe-quick-policy
            cleanup_duplicate_quick_policy
            ;;
        _openvpn-dns-up) openvpn_dns_up "${1:-}" ;;
        _openvpn-dns-down) openvpn_dns_down "${1:-}" ;;
        *) error "Неизвестная команда: $command"; usage >&2; return 2 ;;
    esac
}

main "$@"
