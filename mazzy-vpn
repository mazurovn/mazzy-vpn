transition_clear_recovery_marker() {
    [[ -e "$TRANSITION_RECOVERY_MARKER" ]] || return 0
    rm -f -- "$TRANSITION_RECOVERY_MARKER" || return 1
    sync -f "$STATE_DIR"
}

transition_mark_recovery_required() {
    local reason="$1" tmp="" content old_umask rc=0
    mkdir -p -- "$STATE_DIR" || return 1
    chmod 700 -- "$STATE_DIR" || return 1
    content="$(
        jq -cn \
            --arg reason "$reason" \
            --arg created_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
            '{
                state: "recovery-required",
                reason: $reason,
                created_at: $created_at,
                guard_table: "mazzy_vpn_transition"
            }'
    )" || return 1
    old_umask="$(umask)" || return 1
    umask 077
    tmp="$(mktemp "$STATE_DIR/.transition-recovery.XXXXXX")" || rc=1
    ((rc != 0)) || printf '%s\n' "$content" >"$tmp" || rc=1
    ((rc != 0)) || chmod 600 -- "$tmp" || rc=1
    ((rc != 0)) || mv -f -- "$tmp" "$TRANSITION_RECOVERY_MARKER" || rc=1
    ((rc != 0)) || sync -f "$TRANSITION_RECOVERY_MARKER" || rc=1
    ((rc != 0)) || sync -f "$STATE_DIR" || rc=1
    if ((rc != 0)) && [[ -n "$tmp" && -e "$tmp" ]]; then
        rm -f -- "$tmp" || true
    fi
    umask "$old_umask" || return 1
    return "$rc"
}

transition_guard_hold() {
    local reason="$1"
    if [[ ! -e "$TRANSITION_RECOVERY_MARKER" ]]; then
        transition_mark_recovery_required "$reason" ||
            error "Не удалось сохранить marker аварийного transition recovery"
    fi
    error "Прямой egress остаётся заблокированным до подтверждённого восстановления"
    return 1
}

transition_guard_release() {
    rm -f -- "$TRANSITION_FALLBACK_RULES" || return 1
    sync -f "$STATE_DIR" || return 1
    transition_clear_recovery_marker || return 1
    transition_guard_remove
}

transition_resolve_host() {
    local host="$1"
    timeout --foreground --kill-after=1s 6s python3 - "$host" <<'PY'
import ipaddress
import socket
import sys

host = sys.argv[1]
addresses = set()
for family, _, _, _, sockaddr in socket.getaddrinfo(host, None, type=socket.SOCK_STREAM):
    if family not in (socket.AF_INET, socket.AF_INET6):
        continue
    address = ipaddress.ip_address(sockaddr[0].split("%", 1)[0])
    addresses.add((address.version, str(address)))
for version, address in sorted(addresses):
    print(version, address)
PY
}

transition_endpoint_rules() {
    local protocol="$1" file="$2" endpoint host port transport family address
    local -a ports=()
    [[ -n "$protocol" && -r "$file" ]] || return 0
    validate_endpoint "$protocol" "$file" || return 1
    endpoint="$(profile_endpoint "$protocol" "$file")"
    host="$(endpoint_host "$endpoint")"
    port="$(endpoint_port "$endpoint")"
    transport="$(profile_transport "$protocol" "$file")"
    if [[ "$protocol" == l2tp ]]; then
        transport=udp
        ports=(500 4500 1701)
    else
        ports=("$port")
    fi
    while read -r family address; do
        [[ "$family" == 4 || "$family" == 6 ]] || return 1
        for port in "${ports[@]}"; do
            if [[ "$family" == 4 ]]; then
                printf '        ip daddr %s %s dport %s accept\n' \
                    "$address" "$transport" "$port"
            else
                printf '        ip6 daddr %s %s dport %s accept\n' \
                    "$address" "$transport" "$port"
            fi
        done
    done < <(transition_resolve_host "$host")
}

transition_dns_rules() {
    local nameserver family address
    while read -r _ nameserver _; do
        [[ -n "$nameserver" ]] || continue
        while read -r family address; do
            if [[ "$family" == 4 ]]; then
                printf '        ip daddr %s udp dport 53 accept\n' "$address"
                printf '        ip daddr %s tcp dport 53 accept\n' "$address"
            elif [[ "$family" == 6 ]]; then
                printf '        ip6 daddr %s udp dport 53 accept\n' "$address"
                printf '        ip6 daddr %s tcp dport 53 accept\n' "$address"
            fi
        done < <(transition_resolve_host "$nameserver" 2>/dev/null || true)
    done < <(awk '$1 == "nameserver" { print $1, $2, "" }' /etc/resolv.conf 2>/dev/null)
}

transition_live_adguard_endpoints() {
    local pid line transport endpoint host port family address found=0
    pid="$(adguard_fallback_process_pid)" || return 1
    while IFS= read -r line; do
        [[ "$line" == *"pid=$pid,"* ]] || continue
        transport="$(awk '{ print tolower($1) }' <<<"$line")"
        endpoint="$(awk '{ print $6 }' <<<"$line")"
        [[ "$transport" == tcp || "$transport" == udp ]] || continue
        host="$(endpoint_host "$endpoint")"
        port="$(endpoint_port "$endpoint")"
        [[ "$port" =~ ^[0-9]+$ ]] || continue
        while read -r family address; do
            [[ "$family" == 4 || "$family" == 6 ]] || continue
            found=1
            printf '%s %s %s %s\n' "$family" "$address" "$transport" "$port"
        done < <(transition_resolve_host "$host")
    done < <(ss -H -n -t -u -p 2>/dev/null)
    ((found == 1))
}

transition_route_interface() {
    local address="$1" interface
    interface="$(
        ip -o route get "$address" 2>/dev/null |
            awk '{ for (i=1; i<=NF; i++) if ($i == "dev") { print $(i+1); exit } }'
    )"
    [[ "$interface" =~ ^[A-Za-z0-9_.:-]{1,64}$ ]] || return 1
    printf '%s\n' "$interface"
}

transition_live_fallback_endpoint_rules() {
    local fallback="$1" tool endpoint host port family address transport
    local found=0
    [[ -n "$fallback" ]] || return 0
    case "$fallback" in
        legacy)
            if command -v awg >/dev/null 2>&1; then
                tool=awg
            elif command -v wg >/dev/null 2>&1; then
                tool=wg
            else
                return 1
            fi
            while read -r _ endpoint; do
                [[ -n "$endpoint" && "$endpoint" != '(none)' ]] || continue
                host="$(endpoint_host "$endpoint")"
                port="$(endpoint_port "$endpoint")"
                [[ "$port" =~ ^[0-9]+$ ]] || continue
                while read -r family address; do
                    found=1
                    if [[ "$family" == 4 ]]; then
                        printf '        ip daddr %s udp dport %s accept\n' "$address" "$port"
                    elif [[ "$family" == 6 ]]; then
                        printf '        ip6 daddr %s udp dport %s accept\n' "$address" "$port"
                    fi
                done < <(transition_resolve_host "$host")
            done < <("$tool" show "$LEGACY_FALLBACK_INTERFACE" endpoints 2>/dev/null)
            ;;
        adguard)
            while read -r family address transport port; do
                found=1
                if [[ "$family" == 4 ]]; then
                    printf '        ip daddr %s %s dport %s accept\n' \
                        "$address" "$transport" "$port"
                elif [[ "$family" == 6 ]]; then
                    printf '        ip6 daddr %s %s dport %s accept\n' \
                        "$address" "$transport" "$port"
                fi
            done < <(transition_live_adguard_endpoints)
            ;;
        *) return 1 ;;
    esac
    ((found == 1))
}

transition_cached_fallback_endpoint_rules() {
    [[ -r "$TRANSITION_FALLBACK_RULES" ]] || return 1
    awk '
        NF == 7 && $1 == "ip" && $2 == "daddr" &&
            $3 ~ /^([0-9]{1,3}\.){3}[0-9]{1,3}$/ &&
            ($4 == "tcp" || $4 == "udp") && $5 == "dport" &&
            $6 ~ /^[0-9]{1,5}$/ && $7 == "accept" { print; next }
        NF == 7 && $1 == "ip6" && $2 == "daddr" &&
            $3 ~ /^[0-9A-Fa-f:]+$/ &&
            ($4 == "tcp" || $4 == "udp") && $5 == "dport" &&
            $6 ~ /^[0-9]{1,5}$/ && $7 == "accept" { print; next }
        { invalid = 1 }
        END { exit invalid }
    ' "$TRANSITION_FALLBACK_RULES"
}

transition_guard_install() {
    local protocol="${1:-}" file="${2:-}" fallback="${3:-}"
    local previous_protocol="${4:-}" previous_file="${5:-}"
    local target_interface="" previous_interface="" fallback_interface=""
    local rules="" definition=""
    local fallback_rules="" tmp_rules=""
    command -v nft >/dev/null 2>&1 || {
        error "Безопасное переключение недоступно: установите nftables"
        return 1
    }
    command -v python3 >/dev/null 2>&1 || {
        error "Безопасное переключение недоступно: установите python3"
        return 1
    }
    target_interface="$(interface_for_protocol "$protocol" 2>/dev/null || true)"
    previous_interface="$(interface_for_protocol "$previous_protocol" 2>/dev/null || true)"
    fallback_interface="$(transition_external_interface "$fallback" 2>/dev/null || true)"
    if [[ -n "$fallback" ]]; then
        fallback_rules="$(transition_live_fallback_endpoint_rules "$fallback")" ||
            fallback_rules="$(transition_cached_fallback_endpoint_rules)" || {
                error "Не удалось получить точный allowlist fallback endpoint"
                return 1
            }
        mkdir -p -- "$STATE_DIR" || return 1
        chmod 700 -- "$STATE_DIR" || return 1
        tmp_rules="$(mktemp "$STATE_DIR/.transition-rules.XXXXXX")" || return 1
        printf '%s\n' "$fallback_rules" >"$tmp_rules" || {
            rm -f -- "$tmp_rules"
            return 1
        }
        chmod 600 -- "$tmp_rules" || {
            rm -f -- "$tmp_rules"
            return 1
        }
        mv -f -- "$tmp_rules" "$TRANSITION_FALLBACK_RULES" || return 1
        sync -f "$TRANSITION_FALLBACK_RULES" || return 1
        sync -f "$STATE_DIR" || return 1
    fi
    rules="$({
        transition_endpoint_rules "$protocol" "$file"
        transition_endpoint_rules "$previous_protocol" "$previous_file"
        transition_dns_rules
        [[ -z "$fallback_rules" ]] || printf '%s\n' "$fallback_rules"
    } | LC_ALL=C sort -u)" || {
        error "Не удалось получить точный allowlist transport endpoint"
        return 1
    }
    definition="$({
        printf 'table inet %s {\n' "$TRANSITION_GUARD_TABLE"
        printf '    chain output {\n'
        printf '        type filter hook output priority -150; policy accept;\n'
        printf '        oifname "lo" accept\n'
        [[ -z "$target_interface" ]] || printf '        oifname "%s" accept\n' "$target_interface"
        [[ -z "$previous_interface" ]] || printf '        oifname "%s" accept\n' "$previous_interface"
        [[ -z "$fallback_interface" ]] || printf '        oifname "%s" accept\n' "$fallback_interface"
        [[ "$protocol" != l2tp && "$previous_protocol" != l2tp ]] ||
            printf '        oifname "ppp*" accept\n'
        printf '%s\n' "$rules"
        printf '        reject with icmpx type admin-prohibited\n'
        printf '    }\n'
        printf '    chain forward {\n'
        printf '        type filter hook forward priority -150; policy accept;\n'
        [[ -z "$target_interface" ]] || printf '        oifname "%s" accept\n' "$target_interface"
        [[ -z "$previous_interface" ]] || printf '        oifname "%s" accept\n' "$previous_interface"
        [[ -z "$fallback_interface" ]] || printf '        oifname "%s" accept\n' "$fallback_interface"
        [[ "$protocol" != l2tp && "$previous_protocol" != l2tp ]] ||
            printf '        oifname "ppp*" accept\n'
        printf '        reject with icmpx type admin-prohibited\n'
        printf '    }\n'
        printf '}\n'
    })"
    if transition_guard_installed; then
        {
            printf 'delete table inet %s\n' "$TRANSITION_GUARD_TABLE"
            printf '%s' "$definition"
        } | nft -f - >/dev/null || return 1
    else
        printf '%s' "$definition" | nft -f - >/dev/null || return 1
    fi
    transition_clear_recovery_marker
}

transition_readiness_probe_family() {
    local interface="$1" max_time="$2" family="$3" url="$4"
    local connect_timeout=3 trace probe_ip
    [[ -n "$interface" ]] || return 1
    [[ "$max_time" =~ ^[1-9][0-9]*$ ]] || return 1
    ((max_time <= 120)) || return 1
    ((max_time < connect_timeout)) && connect_timeout="$max_time"
    trace="$(
        env -u ALL_PROXY -u all_proxy -u HTTP_PROXY -u http_proxy \
            -u HTTPS_PROXY -u https_proxy -u NO_PROXY -u no_proxy \
            curl -q "-$family" -fsS --proto '=https' --max-redirs 0 \
                --noproxy '*' --proxy '' \
                --connect-timeout "$connect_timeout" --max-time "$max_time" \
                --interface "$interface" \
                --user-agent 'mazzy-vpn-transition/1' \
                "$url" 2>/dev/null |
            head -c "$((TRANSITION_READY_PROBE_MAX_BYTES + 1))"
    )" || return 1
    ((${#trace} > 0 && ${#trace} <= TRANSITION_READY_PROBE_MAX_BYTES)) ||
        return 1
    probe_ip="$(
        LC_ALL=C awk '
            BEGIN { records = 0; ip_count = 0; scheme_count = 0; invalid = 0 }
            {
                records++
                if (records > 32 || length($0) > 512 ||
                    $0 !~ /^[a-z][a-z0-9_]{0,31}=[ -~]{0,480}$/) {
                    invalid = 1
                    next
                }
                separator = index($0, "=")
                key = substr($0, 1, separator - 1)
                value = substr($0, separator + 1)
                if (key == "ip") {
                    ip_count++
                    ip = value
                } else if (key == "visit_scheme") {
                    scheme_count++
                    scheme = value
                }
            }
            END {
                if (invalid || records < 2 || ip_count != 1 ||
                    scheme_count != 1 || scheme != "https") exit 1
                print ip
            }
        ' <<<"$trace"
    )" || return 1
    python3 - "$probe_ip" "$family" <<'PY' >/dev/null
import ipaddress
import sys

address = ipaddress.ip_address(sys.argv[1])
expected = int(sys.argv[2])
raise SystemExit(0 if address.version == expected else 1)
PY
}

transition_readiness_probe() {
    local interface="$1" max_time="${2:-3}" attempted=0
    if ip -o -4 address show dev "$interface" scope global 2>/dev/null |
       grep -q .; then
        attempted=1
        transition_readiness_probe_family \
            "$interface" "$max_time" 4 "$TRANSITION_READY_PROBE_URL" && return 0
    fi
    if ip -o -6 address show dev "$interface" scope global 2>/dev/null |
       grep -q .; then
        attempted=1
        transition_readiness_probe_family \
            "$interface" "$max_time" 6 "$TRANSITION_READY_PROBE_URL_V6" && return 0
    fi
    ((attempted == 1)) || {
        transition_readiness_probe_family \
            "$interface" "$max_time" 4 "$TRANSITION_READY_PROBE_URL" && return 0
        transition_readiness_probe_family \
            "$interface" "$max_time" 6 "$TRANSITION_READY_PROBE_URL_V6" && return 0
    }
    return 1
}

wait_for_connection_ready() {
    local protocol="$1" timeout="${2:-$TRANSITION_READY_TIMEOUT}"
    local deadline remaining interface probe_timeout
    [[ "$timeout" =~ ^[0-9]+$ ]] && ((timeout >= 3 && timeout <= 120)) ||
        timeout=20
    deadline=$((SECONDS + timeout))
    while ((SECONDS < deadline)); do
        if service_active && connection_local_ok "$protocol"; then
            interface="$(interface_for_protocol "$protocol")"
            remaining=$((deadline - SECONDS))
            probe_timeout=3
            ((remaining < probe_timeout)) && probe_timeout="$remaining"
            if [[ -n "$interface" ]] && ((probe_timeout > 0)) &&
               transition_readiness_probe "$interface" "$probe_timeout"; then
                return 0
            fi
        fi
        systemctl_quiet is-failed "$SERVICE_NAME" && return 1
        sleep 1
    done
    return 1
}

validate_permissions() {
    local file="$1" mode owner directory directory_mode directory_owner
    mode="$(stat -c '%a' "$file" 2>/dev/null || printf '777')"
    [[ "$mode" == "600" || "$mode" == "400" ]] || return 1
    ((EUID == 0)) || return 0
    owner="$(stat -c '%u' "$file" 2>/dev/null || true)"
    [[ "$owner" == "0" ]] || return 1
    directory="$(dirname -- "$file")"
    while :; do
        [[ -d "$directory" && ! -L "$directory" ]] || return 1
        directory_owner="$(stat -c '%u' "$directory" 2>/dev/null || true)"
        directory_mode="$(stat -c '%a' "$directory" 2>/dev/null || true)"
        [[ "$directory_owner" == "0" && "$directory_mode" =~ ^[0-7]{3,4}$ ]] ||
            return 1
        (((8#$directory_mode & 8#022) == 0)) || return 1
        [[ "$directory" == "/" ]] && break
        directory="$(dirname -- "$directory")"
    done
}

has_directive() {
    local file="$1" directive="$2"
    grep -Eiq "^[[:space:]]*${directive}([[:space:]=]|$)" "$file"
}

validate_profile() {
    local protocol="$1" file="$2" quiet="${3:-0}"
    local deadline_end_ms="${4:-}" bad=0 unsafe parser_rc=0
    [[ -f "$file" ]] || {
        ((quiet)) || check_fail "Профиль отсутствует: $file"
        return 1
    }

    if ! validate_permissions "$file"; then
        ((quiet)) || check_warn "Небезопасные права $(stat -c '%a' "$file" 2>/dev/null): $file"
    elif ((quiet == 0)); then
        check_ok "Права профиля закрыты: $(basename -- "$file")"
    fi

    case "$protocol" in
        amneziawg|wireguard)
            for unsafe in PreUp PostUp PreDown PostDown; do
                if has_directive "$file" "$unsafe"; then
                    ((quiet)) || check_fail "$file содержит выполняемую команду $unsafe"
                    bad=1
                fi
            done
            for unsafe in '\[Interface\]' PrivateKey '\[Peer\]' PublicKey AllowedIPs Endpoint; do
                if ! grep -Eq "^[[:space:]]*${unsafe}([[:space:]=]|$)" "$file"; then
                    ((quiet)) || check_fail "$file: отсутствует $unsafe"
                    bad=1
                fi
            done
            if [[ "$protocol" == "amneziawg" ]]; then
                for unsafe in Jc Jmin Jmax S1 S2 H1 H2 H3 H4; do
                    if ! has_directive "$file" "$unsafe"; then
                        ((quiet)) || check_fail "$file: отсутствует параметр AmneziaWG $unsafe"
                        bad=1
                    fi
                done
            fi
            ;;
        openvpn)
            for unsafe in up down route-up route-pre-down ipchange plugin \
                tls-verify auth-user-pass-verify client-connect client-disconnect \
                learn-address config tls-crypt-v2-verify client-crresponse iproute \
                script-security management management-client-auth cd chroot daemon \
                log log-append status writepid syslog; do
                if has_directive "$file" "$unsafe"; then
                    ((quiet)) || check_fail "$file содержит запрещённую выполняемую директиву $unsafe"
                    bad=1
                fi
            done
            for unsafe in client remote dev; do
                if ! has_directive "$file" "$unsafe"; then
                    ((quiet)) || check_fail "$file: отсутствует директива $unsafe"
                    bad=1
                fi
            done
            ;;
        l2tp)
            if ! grep -Eq '^[[:space:]]*type[[:space:]]*=[[:space:]]*vpn[[:space:]]*$' "$file" ||
               ! grep -Eiq '^[[:space:]]*service-type[[:space:]]*=.*l2tp' "$file"; then
                ((quiet)) || check_fail "$file не является профилем NetworkManager L2TP"
                bad=1
            fi
            for unsafe in id gateway; do
                if ! has_directive "$file" "$unsafe"; then
                    ((quiet)) || check_fail "$file: отсутствует параметр L2TP $unsafe"
                    bad=1
                fi
            done
            if grep -q 'CHANGE_ME' "$file"; then
                ((quiet)) || check_fail "$file содержит незаполненные значения CHANGE_ME"
                bad=1
            fi
            ;;
        *)
            ((quiet)) || check_fail "Неизвестный протокол: $protocol"
            return 1
            ;;
    esac
    if ! validate_endpoint "$protocol" "$file"; then
        ((quiet)) || check_fail "$file: endpoint отсутствует или имеет неверный host/port"
        bad=1
    fi
    if [[ "$protocol" == "openvpn" && "$bad" -eq 0 ]]; then
        openvpn_parser_ok "$file" "$deadline_end_ms" || parser_rc=$?
        if ((parser_rc == 124)); then
            return 124
        elif ((parser_rc != 0)); then
            ((quiet)) || check_fail "$file: OpenVPN отклонил конфигурацию при безопасном разборе"
            bad=1
        fi
    fi
    ((bad == 0))
}

requested_protocols() {
    local requested="${1:-all}" protocol
    if [[ "$requested" == "all" ]]; then
        printf '%s\n' amneziawg wireguard openvpn l2tp
        return 0
    fi
    protocol="$(canonical_protocol "$requested")" || return 1
    printf '%s\n' "$protocol"
}

cmd_validate() {
    local requested="${1:-all}" protocol file total=0 passed=0 failed=0
    local -a protocols=()
    require_profile_access validate "$@"
    mapfile -t protocols < <(requested_protocols "$requested") ||
        die "Неизвестный протокол: $requested"
    say "Проверка VPN-профилей (формат, безопасность, права, endpoint)"
    for protocol in "${protocols[@]}"; do
        load_profiles "$protocol"
        if ((${#PROFILES[@]} == 0)); then
            warn "$(protocol_title "$protocol"): профилей нет"
            continue
        fi
        for file in "${PROFILES[@]}"; do
            total=$((total + 1))
            if validate_profile "$protocol" "$file" 1 &&
               validate_permissions "$file"; then
                passed=$((passed + 1))
                printf '[ OK ] %-11s %s\n' "$(protocol_title "$protocol")" \
                    "$(profile_name "$file")"
            else
                failed=$((failed + 1))
                printf '[FAIL] %-11s %s\n' "$(protocol_title "$protocol")" \
                    "$(profile_name "$file")"
                validate_profile "$protocol" "$file" 0 || true
                validate_permissions "$file" ||
                    check_fail "Небезопасные права: $(stat -c '%a' "$file" 2>/dev/null) $file"
            fi
        done
    done
    printf '\nИтог: profiles=%d passed=%d failed=%d\n' "$total" "$passed" "$failed"
    ((total > 0 && failed == 0))
}

profile_transport() {
    local protocol="$1" file="$2"
    case "$protocol" in
        openvpn)
            awk '
                $1 == "proto" { proto=tolower($2) }
                $1 == "remote" && NF >= 4 { remote_proto=tolower($4) }
                END {
                    value=(remote_proto != "" ? remote_proto : proto)
                    if (value ~ /^tcp/) print "tcp"; else print "udp"
                }
            ' "$file"
            ;;
        *) printf 'udp\n' ;;
    esac
}

probe_clock_ms() {
    local uptime seconds fraction
    if IFS=' ' read -r uptime _ </proc/uptime 2>/dev/null &&
       [[ "$uptime" =~ ^([0-9]+)\.([0-9]+)$ ]]; then
        seconds="${BASH_REMATCH[1]}"
        fraction="${BASH_REMATCH[2]}000"
        fraction="${fraction:0:3}"
        printf '%s\n' "$((10#$seconds * 1000 + 10#$fraction))"
        return
    fi
    date +%s%3N
}

probe_ping_latency_ms() {
    LC_ALL=C awk '
        match($0, /time[=<][0-9.]+[[:space:]]*ms/) {
            value = substr($0, RSTART, RLENGTH)
            if (value ~ /^time</) {
                print 0
                exit
            }
            sub(/^time=/, "", value)
            sub(/[[:space:]]*ms$/, "", value)
            printf "%.0f\n", value
            exit
        }
    '
}

ping_host() {
    local host="$1" timeout="$2" output=""
    PROBE_PING_LATENCY_MS=""
    command -v ping >/dev/null 2>&1 || return 2
    if [[ "$host" == *:* ]]; then
        output="$(
            LC_ALL=C timeout --foreground --kill-after=1s "$((timeout + 1))s" \
                ping -6 -n -c 1 -W "$timeout" -- "$host" 2>/dev/null
        )" || return 1
    else
        output="$(
            LC_ALL=C timeout --foreground --kill-after=1s "$((timeout + 1))s" \
                ping -4 -n -c 1 -W "$timeout" -- "$host" 2>/dev/null
        )" || return 1
    fi
    PROBE_PING_LATENCY_MS="$(probe_ping_latency_ms <<<"$output")"
}

probe_tcp_port() {
    local host="$1" port="$2" timeout="$3" started finished
    PROBE_TCP_LATENCY_MS=""
    command -v nc >/dev/null 2>&1 || return 2
    started="$(probe_clock_ms)" || return 1
    timeout --foreground --kill-after=1s "$((timeout + 1))s" \
        nc -z -w "$timeout" "$host" "$port" >/dev/null 2>&1 ||
        return 1
    finished="$(probe_clock_ms)" || return 1
    PROBE_TCP_LATENCY_MS="$((finished - started))"
    ((PROBE_TCP_LATENCY_MS >= 0)) || PROBE_TCP_LATENCY_MS=0
}

probe_result_record() {
    local protocol="$1" file="$2" transport="$3" selected="$4" active="$5"
    local reachability="$6" latency_ms="$7" latency_source="$8" message_key="$9"
    local opaque_id display_name
    opaque_id="$(profile_opaque_id "$protocol" "$file")"
    display_name="$(profile_probe_label "$file")"
    if [[ ! "$latency_ms" =~ ^[0-9]+$ ]]; then
        latency_ms=null
        latency_source=none
    fi
    jq -cn \
        --arg profile_id "$opaque_id" \
        --arg display_name "$display_name" \
        --arg protocol "$protocol" \
        --arg transport "$transport" \
        --arg reachability "$reachability" \
        --argjson latency_ms "$latency_ms" \
        --arg latency_source "$latency_source" \
        --arg message_key "$message_key" \
        --argjson selected "$selected" \
        --argjson active "$active" \
        '{
            profile_id: $profile_id,
            display_name: $display_name,
            protocol: $protocol,
            selected: $selected,
            active: $active,
            transport: $transport,
            reachability: $reachability,
            latency_ms: $latency_ms,
            latency_source: $latency_source,
            message_key: $message_key
        }'
}

probe_profile_record() {
    local protocol="$1" file="$2" timeout="$3" selected="$4" active="$5"
    local endpoint host port transport ping_rc=0 tcp_rc=0 latency=""
    endpoint="$(profile_endpoint "$protocol" "$file")"
    host="$(endpoint_host "$endpoint")"
    port="$(endpoint_port "$endpoint")"
    transport="$(profile_transport "$protocol" "$file")"

    if ! validate_endpoint "$protocol" "$file"; then
        probe_result_record "$protocol" "$file" "$transport" "$selected" "$active" \
            invalid "" none probe.invalid.endpoint
        return
    fi
    if ! timeout --foreground --kill-after=1s "$((timeout + 1))s" \
        getent ahosts "$host" >/dev/null 2>&1; then
        probe_result_record "$protocol" "$file" "$transport" "$selected" "$active" \
            unreachable "" none probe.unreachable.dns
        return
    fi

    ping_host "$host" "$timeout" || ping_rc=$?
    if [[ "$transport" == tcp ]]; then
        probe_tcp_port "$host" "$port" "$timeout" || tcp_rc=$?
        case "$tcp_rc" in
            0)
                if [[ "$ping_rc" -eq 0 &&
                      "$PROBE_PING_LATENCY_MS" =~ ^[0-9]+$ ]]; then
                    latency="$PROBE_PING_LATENCY_MS"
                    probe_result_record "$protocol" "$file" "$transport" \
                        "$selected" "$active" reachable "$latency" icmp \
                        probe.reachable.tcp-icmp
                else
                    latency="$PROBE_TCP_LATENCY_MS"
                    probe_result_record "$protocol" "$file" "$transport" \
                        "$selected" "$active" reachable "$latency" tcp \
                        probe.reachable.tcp
                fi
                ;;
            1)
                probe_result_record "$protocol" "$file" "$transport" \
                    "$selected" "$active" unreachable "" none \
                    probe.unreachable.tcp
                ;;
            2)
                if [[ "$ping_rc" -eq 0 ]]; then
                    probe_result_record "$protocol" "$file" "$transport" \
                        "$selected" "$active" reachable \
                        "$PROBE_PING_LATENCY_MS" icmp \
                        probe.reachable.icmp-only
                else
                    probe_result_record "$protocol" "$file" "$transport" \
                        "$selected" "$active" unknown "" none \
                        probe.unknown.tcp-unchecked
                fi
                ;;
        esac
        return
    fi

    case "$ping_rc" in
        0)
            probe_result_record "$protocol" "$file" "$transport" \
                "$selected" "$active" reachable "$PROBE_PING_LATENCY_MS" icmp \
                probe.reachable.icmp
            ;;
        1)
            probe_result_record "$protocol" "$file" "$transport" \
                "$selected" "$active" unknown "" none \
                probe.unknown.icmp-no-response
            ;;
        2)
            probe_result_record "$protocol" "$file" "$transport" \
                "$selected" "$active" unknown "" none \
                probe.unknown.ping-unavailable
            ;;
    esac
}

probe_locations_json() (
    local requested="$1" timeout="$2" concurrency="$3"
    local requested_profile_id="${4:-}" protocol file opaque_id
    local selected_protocol="" selected_file="" selected=false active=false
    local index=0 started finished tmp result_file pid wait_rc=0
    local -a protocols=() pids=()

    mapfile -t protocols < <(requested_protocols "$requested") || return 2
    tmp="$(mktemp -d "${TMPDIR:-/tmp}/mazzy-vpn-probe.XXXXXX")" || return 1
    umask 077
    trap '
        for pid in "${pids[@]:-}"; do
            kill "$pid" 2>/dev/null || true
        done
        wait 2>/dev/null || true
        rm -rf -- "$tmp"
    ' EXIT
    trap 'exit 130' HUP INT TERM

    if selected_from_state; then
        selected_protocol="$SELECTED_PROTOCOL"
        selected_file="$SELECTED_PROFILE"
        if service_active && connection_local_ok "$selected_protocol"; then
            active=true
        fi
    fi
    started="$(probe_clock_ms)" || started=0

    for protocol in "${protocols[@]}"; do
        load_profiles "$protocol"
        for file in "${PROFILES[@]}"; do
            opaque_id="$(profile_opaque_id "$protocol" "$file")"
            if [[ -n "$requested_profile_id" &&
                  "$opaque_id" != "$requested_profile_id" ]]; then
                continue
            fi
            selected=false
            if [[ "$protocol" == "$selected_protocol" &&
                  "$file" == "$selected_file" ]]; then
                selected=true
            fi
            index=$((index + 1))
            printf -v result_file '%s/%06d.json' "$tmp" "$index"
            probe_profile_record "$protocol" "$file" "$timeout" \
                "$selected" "$([[ "$selected" == true && "$active" == true ]] &&
                    printf true || printf false)" >"$result_file" &
            pids+=("$!")
            if ((${#pids[@]} >= concurrency)); then
                wait "${pids[0]}" || wait_rc=1
                pids=("${pids[@]:1}")
            fi
        done
    done
    for pid in "${pids[@]}"; do
        wait "$pid" || wait_rc=1
    done
    pids=()
    ((wait_rc == 0)) || return 1

    finished="$(probe_clock_ms)" || finished="$started"
    ((finished >= started)) || finished="$started"
    if ((index == 0)); then
        jq -cn \
            --arg checked_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
            --arg scope "$requested" \
            --argjson timeout_seconds "$timeout" \
            --argjson concurrency "$concurrency" \
            --argjson duration_ms "$((finished - started))" \
            '{
                schema_version: 1,
                checked_at: $checked_at,
                scope: $scope,
                timeout_seconds: $timeout_seconds,
                concurrency: $concurrency,
                duration_ms: $duration_ms,
                summary: {
                    total: 0, reachable: 0, unknown: 0,
                    unreachable: 0, invalid: 0, active: 0
                },
                results: []
            }'
        return
    fi

    jq -cs \
        --arg checked_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        --arg scope "$requested" \
        --argjson timeout_seconds "$timeout" \
        --argjson concurrency "$concurrency" \
        --argjson duration_ms "$((finished - started))" \
        '{
            schema_version: 1,
            checked_at: $checked_at,
            scope: $scope,
            timeout_seconds: $timeout_seconds,
            concurrency: $concurrency,
            duration_ms: $duration_ms,
            summary: {
                total: length,
                reachable: map(select(.reachability == "reachable")) | length,
                unknown: map(select(.reachability == "unknown")) | length,
                unreachable: map(select(.reachability == "unreachable")) | length,
                invalid: map(select(.reachability == "invalid")) | length,
                active: map(select(.active == true)) | length
            },
            results: .
        }' "$tmp"/*.json
)

probe_result_ok() {
    jq -e '
        .summary.total > 0
        and .summary.unreachable == 0
        and .summary.invalid == 0
    ' <<<"$1" >/dev/null 2>&1
}

render_probe_result() {
    local result="$1" status protocol name active latency source message
    say "Проверка endpoint: DNS + latency; TCP-порты проверяются дополнительно"
    while IFS=$'\t' read -r status protocol name active latency source message; do
        local label="" latency_label="" active_label=""
        case "$status" in
            reachable) label='[ OK ]' ;;
            unknown) label='[WARN]' ;;
            unreachable|invalid) label='[FAIL]' ;;
        esac
        [[ "$latency" == null || -z "$latency" ]] ||
            latency_label=" · ${latency} ms (${source^^})"
        [[ "$active" != true ]] || active_label=' · ACTIVE'
        printf '%s %-11s %-36s %s%s%s\n' \
            "$label" "$(protocol_title "$protocol")" "$name" \
            "$message" "$latency_label" "$active_label"
    done < <(
        jq -r '
            .results[] |
            [
                .reachability, .protocol, .display_name, .active,
                (.latency_ms // "null"), .latency_source,
                (
                    if .message_key == "probe.reachable.icmp" then "endpoint доступен"
                    elif .message_key == "probe.reachable.tcp-icmp" then "TCP endpoint доступен"
                    elif .message_key == "probe.reachable.tcp" then "TCP endpoint доступен; ICMP без ответа"
                    elif .message_key == "probe.reachable.icmp-only" then "host доступен; TCP probe не установлен"
                    elif .message_key == "probe.unknown.icmp-no-response" then "DNS OK; ICMP без ответа, UDP не подтверждён"
                    elif .message_key == "probe.unknown.ping-unavailable" then "DNS OK; ping не установлен"
                    elif .message_key == "probe.unknown.tcp-unchecked" then "DNS OK; ICMP/TCP не подтверждены"
                    elif .message_key == "probe.unreachable.dns" then "DNS не разрешается"
                    elif .message_key == "probe.unreachable.tcp" then "TCP-порт недоступен"
                    else "неверный endpoint"
                    end
                )
            ] | @tsv
        ' <<<"$result"
    )
    printf '\nИтог: endpoints=%s reachable=%s unknown=%s unreachable=%s invalid=%s active=%s duration_ms=%s\n' \
        "$(jq -r '.summary.total' <<<"$result")" \
        "$(jq -r '.summary.reachable' <<<"$result")" \
        "$(jq -r '.summary.unknown' <<<"$result")" \
        "$(jq -r '.summary.unreachable' <<<"$result")" \
        "$(jq -r '.summary.invalid' <<<"$result")" \
        "$(jq -r '.summary.active' <<<"$result")" \
        "$(jq -r '.duration_ms' <<<"$result")"
    say "Доступность endpoint не подтверждает VPN-авторизацию и маршрутизацию; для этого используйте live test."
}

cmd_probe() {
    local requested="all" timeout="$DEFAULT_PROBE_TIMEOUT" concurrency=4
    local json_output=false payload response result
    local -a original_args=("$@")
    while (($#)); do
        case "$1" in
            --timeout)
                shift
                [[ $# -gt 0 ]] || die "--timeout требует число секунд"
                timeout="$1"
                ;;
            --jobs)
                shift
                [[ $# -gt 0 ]] || die "--jobs требует число параллельных проверок"
                concurrency="$1"
                ;;
            --json)
                json_output=true
                ;;
            --help|-h)
                say "Использование: $CLI_COMMAND probe [ПРОТОКОЛ|all] [--timeout 3] [--jobs 4] [--json]"
                return 0
                ;;
            -*)
                die "Неизвестный параметр probe: $1"
                ;;
            *)
                [[ "$requested" == "all" ]] || die "Лишний аргумент probe: $1"
                requested="$1"
                ;;
        esac
        shift
    done
    if ! [[ "$timeout" =~ ^[0-9]+$ ]] ||
       ! ((timeout >= 1 && timeout <= 30)); then
        die "Таймаут probe должен быть от 1 до 30 секунд"
    fi
    if ! [[ "$concurrency" =~ ^[0-9]+$ ]] ||
       ! ((concurrency >= 1 && concurrency <= 8)); then
        die "Число параллельных probe должно быть от 1 до 8"
    fi
    requested_protocols "$requested" >/dev/null ||
        die "Неизвестный протокол: $requested"

    if api_client_ready; then
        payload="$(
            jq -cn \
                --arg protocol "$requested" \
                --argjson timeout_seconds "$timeout" \
                --argjson concurrency "$concurrency" \
                '{
                    timeout_seconds: $timeout_seconds,
                    concurrency: $concurrency
                } + if $protocol == "all" then {} else {protocol: $protocol} end'
        )"
        response="$(api_client_query_payload tests.probe "$payload" 900000)" || {
            error "Local API endpoint probe is unavailable"
            return 70
        }
        if [[ "$(jq -r '.status' <<<"$response")" != ok ]]; then
            error "Local API: $(jq -r '.error.code + ": " + .error.message_key' <<<"$response")"
            return 1
        fi
        result="$(jq -c '.result' <<<"$response")"
    else
        require_profile_access probe "${original_args[@]}"
        result="$(probe_locations_json "$requested" "$timeout" "$concurrency")" ||
            die "Не удалось завершить проверку endpoint"
    fi

    if [[ "$json_output" == true ]]; then
        jq . <<<"$result"
    else
        render_probe_result "$result"
    fi
    probe_result_ok "$result"
}

fix_profile_permissions() {
    local file="$1"
    if ((EUID == 0)); then
        chown root:root -- "$(effective_config_dir)" "$(dirname -- "$file")" "$file" ||
            return 1
        chmod go-w -- "$(effective_config_dir)" "$(dirname -- "$file")" ||
            return 1
    fi
    chmod 600 "$file" || return 1
    validate_permissions "$file" || {
        warn "Нельзя безопасно исправить всю цепочку каталогов профиля: $file"
        return 1
    }
    check_ok "Исправлены владелец/права: $file"
}

cmd_list() {
    local requested="${1:-all}" protocol
    if api_client_ready; then
        api_client_fetch_profiles || return
        if [[ "$requested" == "all" ]]; then
            for protocol in amneziawg wireguard openvpn l2tp; do
                api_client_print_profile_list "$protocol"
            done
            return 0
        fi
        protocol="$(canonical_protocol "$requested")" ||
            die "Неизвестный протокол: $requested"
        api_client_print_profile_list "$protocol"
        return 0
    fi
    require_profile_access list "$@"
    if [[ "$requested" == "all" ]]; then
        for protocol in amneziawg wireguard openvpn l2tp; do
            print_profile_list "$protocol"
        done
        return 0
    fi
    protocol="$(canonical_protocol "$requested")" || die "Неизвестный протокол: $requested"
    print_profile_list "$protocol"
}

profiles_json_live() {
    local protocol file first=true selected_protocol="" selected_file="" opaque_id
    local display_name location country_code
    selected_from_state || true
    selected_protocol="${SELECTED_PROTOCOL:-}"
    selected_file="${SELECTED_PROFILE:-}"

    printf '{"schema_version":1,"generated_at":%s,"profiles":[' "$(date +%s)"
    for protocol in amneziawg wireguard openvpn l2tp; do
        load_profiles "$protocol"
        for file in "${PROFILES[@]}"; do
            [[ "$first" == true ]] || printf ','
            first=false
            opaque_id="$(profile_opaque_id "$protocol" "$file")"
            display_name="$(profile_name "$file")"
            location="$(profile_location "$file")"
            country_code="$(profile_config_country_code "$file" 2>/dev/null || true)"
            printf '{'
            printf '"profile_id":"%s","protocol":"%s","protocol_name":"%s",' \
                "$(json_escape "$opaque_id")" \
                "$(json_escape "$protocol")" \
                "$(json_escape "$(protocol_title "$protocol")")"
            printf '"file_name":"%s","name":"%s","location":"%s",' \
                "$(json_escape "$(basename -- "$file")")" \
                "$(json_escape "$display_name")" \
                "$(json_escape "$location")"
            if [[ -n "$country_code" ]]; then
                printf '"country_code":"%s",' "$(json_escape "$country_code")"
            else
                printf '"country_code":null,'
            fi
            if [[ "$protocol" == "$selected_protocol" &&
                  "$file" == "$selected_file" ]]; then
                printf '"selected":true'
            else
                printf '"selected":false'
            fi
            printf '}'
        done
    done
    printf ']}\n'
}

profile_opaque_id() {
    local protocol="$1" file="$2" digest
    digest="$(
        printf '%s\000%s' "$protocol" "$(basename -- "$file")" |
            sha256sum |
            awk '{ print substr($1, 1, 32) }'
    )"
    printf 'profile-%s\n' "$digest"
}

prepare_dashboard_dir() {
    mkdir -p -- "$DASHBOARD_DIR" || return 1
    if ((EUID == 0)); then
        if getent group "$RUNTIME_READER_GROUP" >/dev/null 2>&1; then
            chown -- "root:$RUNTIME_READER_GROUP" "$DASHBOARD_DIR" || return 1
            chmod 750 -- "$DASHBOARD_DIR" || return 1
        else
            chown -- root:root "$DASHBOARD_DIR" || return 1
            chmod 700 -- "$DASHBOARD_DIR" || return 1
        fi
    else
        chmod 750 -- "$DASHBOARD_DIR" || return 1
    fi
}

protect_dashboard_cache() {
    local target="$1"
    if ((EUID == 0)); then
        if getent group "$RUNTIME_READER_GROUP" >/dev/null 2>&1; then
            chown -- "root:$RUNTIME_READER_GROUP" "$target" || return 1
            chmod 640 -- "$target" || return 1
        else
            chown -- root:root "$target" || return 1
            chmod 600 -- "$target" || return 1
        fi
    else
        chmod 640 -- "$target" || return 1
    fi
}

write_profiles_cache() (
    local tmp="" tmp_token="${VPNCTL_CACHE_TMP_TOKEN:-$$}"
    trap '[[ -z "${tmp:-}" ]] || rm -f -- "$tmp"' EXIT
    trap 'exit 1' HUP INT TERM
    ((EUID == 0)) || [[ "${VPNCTL_ALLOW_UNPRIVILEGED:-0}" == "1" ]] ||
        return 1
    prepare_dashboard_dir || return 1
    [[ "$tmp_token" =~ ^[A-Za-z0-9-]{1,64}$ ]] || tmp_token="$$"
    tmp="$DASHBOARD_DIR/.profiles.$tmp_token"
    umask 077
    profiles_json_live >"$tmp" || return 1
    protect_dashboard_cache "$tmp" || return 1
    mv -f -- "$tmp" "$PROFILES_FILE" || return 1
    tmp=""
)

cmd_profiles_json() {
    if [[ -r "$PROFILES_FILE" ]]; then
        cat -- "$PROFILES_FILE"
        return 0
    fi
    if ((EUID == 0)) || [[ "${VPNCTL_ALLOW_UNPRIVILEGED:-0}" == "1" ]]; then
        write_profiles_cache || return 1
        cat -- "$PROFILES_FILE"
        return 0
    fi
    printf '{"schema_version":1,"generated_at":0,"available":false,'
    printf '"error":"profile cache is not ready","profiles":[]}\n'
    return 1
}

cmd_profiles_api_json() {
    api_client_ready || {
        error "$(msg api_socket_unavailable 'profiles --api-json')"
        return 70
    }
    api_client_query profiles.list || {
        error "$(msg api_profiles_unavailable)"
        return 70
    }
}

choose_protocol() {
    local answer protocol count runtime
    stdin_interactive || {
        error "Укажите протокол: amneziawg, wireguard, openvpn или l2tp"
        return 1
    }
    printf '\n%s\n' "$(msg choose_protocol)" >&2
    local index=1
    for protocol in amneziawg wireguard openvpn l2tp; do
        load_profiles "$protocol"
        count="${#PROFILES[@]}"
        if protocol_runtime_available "$protocol"; then
            runtime="$(msg ready)"
        else
            runtime="$(msg runtime_missing)"
        fi
        printf '  %d. %-12s %s: %-3d %s\n' "$index" \
            "$(protocol_title "$protocol")" "$(msg profile_count)" "$count" "$runtime" >&2
        index=$((index + 1))
    done
    read -r -p "$(msg protocol_number)" answer
    case "$answer" in
        1) printf 'amneziawg\n' ;;
        2) printf 'wireguard\n' ;;
        3) printf 'openvpn\n' ;;
        4) printf 'l2tp\n' ;;
        *) error "$(msg invalid_protocol)"; return 1 ;;
    esac
}

transition_external_interface() {
    local candidate="" family address transport port endpoint_interface="" found=0
    case "$1" in
        legacy) printf '%s\n' "$LEGACY_FALLBACK_INTERFACE" ;;
        adguard)
            candidate="$(transition_route_interface 1.1.1.1)" || return 1
            while read -r family address transport port; do
                endpoint_interface="$(transition_route_interface "$address")" || return 1
                [[ "$candidate" != "$endpoint_interface" ]] || return 1
                found=1
            done < <(transition_live_adguard_endpoints)
            ((found == 1)) || return 1
            printf '%s\n' "$candidate"
            ;;
    esac
}

transition_wait_external_ready() {
    local fallback="$1" preferred_interface="${2:-}" interface deadline
    deadline=$((SECONDS + TRANSITION_READY_TIMEOUT))
    while ((SECONDS < deadline)); do
        interface="$preferred_interface"
        [[ -n "$interface" ]] || interface="$(transition_external_interface "$fallback")"
        if [[ -n "$interface" ]] && ip link show "$interface" >/dev/null 2>&1 &&
           transition_readiness_probe "$interface" 3; then
            return 0
        fi
        sleep 1
    done
    return 1
}

transition_restore_previous() {
    local previous_active="$1" previous_protocol="$2" previous_profile="$3"
    local previous_state_backup="$4" fallback="$5" fallback_interface="$6"
    stop_service_bounded 15 || true
    cleanup_stale_quick_policy
    if [[ -n "$previous_state_backup" && -r "$previous_state_backup" ]]; then
        install -m 600 -- "$previous_state_backup" "$STATE_FILE" || {
            transition_guard_hold state-restore-failed
            return 1
        }
        if ! sync -f "$STATE_FILE" || ! sync -f "$STATE_DIR"; then
            transition_guard_hold state-restore-sync-failed
            return 1
        fi
    else
        rm -f -- "$STATE_FILE" || {
            transition_guard_hold state-restore-failed
            return 1
        }
        sync -f "$STATE_DIR" || {
            transition_guard_hold state-restore-sync-failed
            return 1
        }
    fi
    health_reset

    if [[ -n "$fallback" ]]; then
        if [[ -r "$STATE_FILE" ]]; then
            set_desired_state down || {
                transition_guard_hold state-restore-failed
                return 1
            }
        fi
        if start_external_fallback "$fallback" &&
           transition_wait_external_ready "$fallback" "$fallback_interface"; then
            transition_guard_release || return 1
            info "Предыдущий внешний VPN восстановлен и проверен"
            return 0
        fi
        transition_guard_hold external-fallback-restore-failed
        return 1
    fi
    if ((previous_active)); then
        reset_service_start_limit
        if systemctl start "$SERVICE_NAME" &&
           wait_for_connection_ready "$previous_protocol"; then
            transition_guard_release || return 1
            info "Предыдущее managed VPN-соединение восстановлено и проверено"
            return 0
        fi
        transition_guard_hold managed-vpn-restore-failed
        return 1
    fi
    transition_guard_release
}

cmd_connect() (
    local -a original=("$@")
    local requested_protocol="${1:-}" requested_profile="${2:-}" protocol fallback=""
    local transition_guard_active=0 previous_active=0 previous_protocol=""
    local previous_profile="" previous_state_backup="" fallback_interface=""
    # shellcheck disable=SC2317,SC2329  # invoked by the EXIT trap below
    cleanup_connect_transition_guard() {
        if ((transition_guard_active)); then
            transition_guard_hold interrupted-connect >/dev/null 2>&1 || true
        fi
        [[ -z "$previous_state_backup" ]] || rm -f -- "$previous_state_backup"
    }
    trap cleanup_connect_transition_guard EXIT
    if api_client_ready; then
        api_client_cmd_connect "${original[@]}"
        return
    fi
    require_profile_access connect "${original[@]}"
    if selected_from_state; then
        previous_protocol="$SELECTED_PROTOCOL"
        previous_profile="$SELECTED_PROFILE"
    fi
    if [[ -z "$requested_protocol" ]]; then
        protocol="$(choose_protocol)" || return 1
    else
        protocol="$(canonical_protocol "$requested_protocol")" ||
            die "Неизвестный протокол: $requested_protocol"
    fi
    resolve_profile "$protocol" "$requested_profile" || return 1
    validate_profile "$protocol" "$SELECTED_PROFILE" 1 ||
        die "Профиль не прошёл проверку безопасности: $SELECTED_PROFILE. Запустите $CLI_COMMAND doctor"
    validate_permissions "$SELECTED_PROFILE" ||
        die "Небезопасный владелец/права профиля или каталога. Запустите $CLI_COMMAND doctor --fix"
    require_root connect "$protocol" "$(basename -- "$SELECTED_PROFILE")"
    systemd_available || die "systemd недоступен; выполните установку на системе с systemd"
    acquire_action_lock

    info "Выбран $(protocol_title "$protocol"): $(profile_name "$SELECTED_PROFILE")"
    cancel_test_guard
    discard_test_backup
    mkdir -p -- "$RUN_DIR" || die "Не удалось открыть runtime directory"
    chmod 700 -- "$RUN_DIR" || die "Не удалось защитить runtime directory"
    if [[ -r "$STATE_FILE" ]]; then
        previous_state_backup="$(mktemp "$RUN_DIR/.transition-state.XXXXXX")" ||
            die "Не удалось сохранить предыдущее состояние"
        install -m 600 -- "$STATE_FILE" "$previous_state_backup" ||
            die "Не удалось сохранить предыдущее состояние"
    fi
    service_active && previous_active=1
    fallback="$(detect_external_fallback || true)"
    fallback_interface="$(transition_external_interface "$fallback")"
    transition_guard_install "$protocol" "$SELECTED_PROFILE" "$fallback" \
        "$previous_protocol" "$previous_profile" ||
        die "Переключение отменено: не удалось закрыть прямой выход в интернет"
    transition_guard_active=1
    systemctl_quiet stop "$SERVICE_NAME" || true
    if [[ -n "$fallback" ]]; then
        info "Временно останавливаем внешний VPN: $(external_fallback_title "$fallback")"
        if ! stop_external_fallbacks; then
            error "Не удалось безопасно остановить внешний VPN"
            if transition_restore_previous "$previous_active" "$previous_protocol" \
                "$previous_profile" "$previous_state_backup" "$fallback" \
                "$fallback_interface"; then
                transition_guard_active=0
            fi
            return 1
        fi
    fi
    cleanup_stale_quick_policy
    write_state "$protocol" "$SELECTED_PROFILE" up ||
        die "Не удалось сохранить выбранный профиль"
    health_reset
    systemctl_quiet start "$HEALTH_TIMER" || warn "Не удалось запустить $HEALTH_TIMER"
    reset_service_start_limit

    if ! systemctl start "$SERVICE_NAME"; then
        error "Сервис VPN не запустился. Последние сообщения:"
        journalctl -u "$SERVICE_NAME" -n 30 --no-pager 2>/dev/null || true
        if transition_restore_previous "$previous_active" "$previous_protocol" \
            "$previous_profile" "$previous_state_backup" "$fallback" \
            "$fallback_interface"; then
            transition_guard_active=0
        fi
        return 1
    fi
    if ! wait_for_connection_ready "$protocol"; then
        error "VPN не подтвердил защищённый выход за ${TRANSITION_READY_TIMEOUT}s"
        systemctl_quiet stop "$SERVICE_NAME" || true
        if transition_restore_previous "$previous_active" "$previous_protocol" \
            "$previous_profile" "$previous_state_backup" "$fallback" \
            "$fallback_interface"; then
            transition_guard_active=0
        fi
        return 1
    fi
    transition_guard_release || die "Не удалось снять transition guard"
    transition_guard_active=0
    say "Подключение запущено. Защищённый выход подтверждён. Проверка: $CLI_COMMAND diagnose"
)

cmd_disconnect() (
    if api_client_ready; then
        api_client_cmd_disconnect "$@"
        return
    fi
    require_root disconnect
    systemd_available || die "systemd недоступен"
    acquire_action_lock
    cancel_test_guard
    discard_test_backup
    if [[ -r "$STATE_FILE" ]]; then
        set_desired_state down || die "Не удалось сохранить состояние отключения"
    fi
    health_reset
    if systemctl_quiet stop "$SERVICE_NAME"; then
        transition_guard_release || warn "Не удалось полностью снять transition guard"
        say "VPN отключён."
    else
        transition_guard_release || warn "Не удалось полностью снять transition guard"
        warn "Сервис уже остановлен или не установлен."
    fi
)

cmd_reconnect() (
    local fallback="" transition_guard_active=0 previous_active=0
    local previous_protocol="" previous_profile="" previous_state_backup=""
    local fallback_interface=""
    # shellcheck disable=SC2317,SC2329  # invoked by the EXIT trap below
    cleanup_reconnect_transition_guard() {
        if ((transition_guard_active)); then
            transition_guard_hold interrupted-reconnect >/dev/null 2>&1 || true
        fi
        [[ -z "$previous_state_backup" ]] || rm -f -- "$previous_state_backup"
    }
    trap cleanup_reconnect_transition_guard EXIT
    if api_client_ready; then
        api_client_cmd_reconnect "$@"
        return
    fi
    require_root reconnect
    acquire_action_lock
    cancel_test_guard
    discard_test_backup
    selected_from_state || die "Сначала выберите профиль: $CLI_COMMAND connect"
    previous_protocol="$SELECTED_PROTOCOL"
    previous_profile="$SELECTED_PROFILE"
    validate_profile "$SELECTED_PROTOCOL" "$SELECTED_PROFILE" 1 ||
        die "Выбранный профиль не прошёл проверку"
    mkdir -p -- "$RUN_DIR" || die "Не удалось открыть runtime directory"
    chmod 700 -- "$RUN_DIR" || die "Не удалось защитить runtime directory"
    if [[ -r "$STATE_FILE" ]]; then
        previous_state_backup="$(mktemp "$RUN_DIR/.transition-state.XXXXXX")" ||
            die "Не удалось сохранить предыдущее состояние"
        install -m 600 -- "$STATE_FILE" "$previous_state_backup" ||
            die "Не удалось сохранить предыдущее состояние"
    fi
    service_active && previous_active=1
    fallback="$(detect_external_fallback || true)"
    fallback_interface="$(transition_external_interface "$fallback")"
    transition_guard_install "$SELECTED_PROTOCOL" "$SELECTED_PROFILE" "$fallback" \
        "$previous_protocol" "$previous_profile" ||
        die "Переподключение отменено: не удалось закрыть прямой выход в интернет"
    transition_guard_active=1
    if [[ -n "$fallback" ]]; then
        info "Временно останавливаем внешний VPN: $(external_fallback_title "$fallback")"
        if ! stop_external_fallbacks; then
            if transition_restore_previous "$previous_active" "$previous_protocol" \
                "$previous_profile" "$previous_state_backup" "$fallback" \
                "$fallback_interface"; then
                transition_guard_active=0
            fi
            die "Не удалось безопасно остановить внешний VPN"
        fi
    fi
    stop_service_bounded 15 || true
    cleanup_stale_quick_policy
    write_state "$SELECTED_PROTOCOL" "$SELECTED_PROFILE" up ||
        die "Не удалось обновить состояние"
    health_reset
    reset_service_start_limit
    if ! systemctl start "$SERVICE_NAME"; then
        if transition_restore_previous "$previous_active" "$previous_protocol" \
            "$previous_profile" "$previous_state_backup" "$fallback" \
            "$fallback_interface"; then
            transition_guard_active=0
        fi
        die "Не удалось перезапустить $SERVICE_NAME"
    fi
    if ! wait_for_connection_ready "$SELECTED_PROTOCOL"; then
        systemctl_quiet stop "$SERVICE_NAME" || true
        if transition_restore_previous "$previous_active" "$previous_protocol" \
            "$previous_profile" "$previous_state_backup" "$fallback" \
            "$fallback_interface"; then
            transition_guard_active=0
        fi
        die "VPN не подтвердил защищённый выход за ${TRANSITION_READY_TIMEOUT}s"
    fi
    transition_guard_release || die "Не удалось снять transition guard"
    transition_guard_active=0
    say "Переподключение запущено. Защищённый выход подтверждён."
)

cmd_quick_connect() {
    local interface
    if api_client_ready; then
        api_client_cmd_quick "$@"
        return
    fi
    require_profile_access quick
    if ! selected_from_state; then
        info "$(msg no_default)"
        cmd_connect
        return
    fi
    interface="$(interface_for_protocol "$SELECTED_PROTOCOL")"
    if service_active && connection_local_ok "$SELECTED_PROTOCOL" &&
       public_ip "$interface" 3 >/dev/null; then
        say "$(msg already_connected): $(protocol_title "$SELECTED_PROTOCOL") / $(profile_name "$SELECTED_PROFILE")"
        return 0
    fi
    cmd_reconnect
}

service_active() {
    systemctl_quiet is-active "$SERVICE_NAME"
}

interface_for_protocol() {
    case "$1" in
        amneziawg) printf 'vpnaw0\n' ;;
        wireguard) printf 'vpnwg0\n' ;;
        openvpn) printf 'vpnovpn0\n' ;;
        l2tp)
            ip -o link show 2>/dev/null |
                awk -F': ' '$2 ~ /^ppp[0-9]+(@.*)?$/ { sub(/@.*/, "", $2); print $2; exit }'
            ;;
    esac
}

latest_handshake() {
    local protocol="$1" interface="$2" tool
    [[ "$protocol" == "amneziawg" ]] && tool=awg || tool=wg
    "$tool" show "$interface" latest-handshakes 2>/dev/null |
        awk 'BEGIN { max=0 } $2 > max { max=$2 } END { print max }'
}

connection_local_ok() {
    local protocol="$1" interface connection_id
    interface="$(interface_for_protocol "$protocol")"
    case "$protocol" in
        amneziawg|wireguard|openvpn)
            [[ -n "$interface" ]] && ip link show "$interface" >/dev/null 2>&1
            ;;
        l2tp)
            connection_id="$(l2tp_connection_id "$SELECTED_PROFILE")"
            nmcli -t -f NAME connection show --active 2>/dev/null |
                grep -Fqx -- "$connection_id"
            ;;
    esac
}

public_ip() {
    local interface="${1:-}" max_time="${2:-7}" connect_timeout=3 result
    [[ "$max_time" =~ ^[0-9]+$ ]] || max_time=7
    ((max_time < 1)) && return 1
    ((max_time < connect_timeout)) && connect_timeout="$max_time"
    local -a args=(-4 -fsS --connect-timeout "$connect_timeout" --max-time "$max_time")
    [[ -n "$interface" ]] && args+=(--interface "$interface")
    result="$(curl "${args[@]}" "$PROBE_URL" 2>/dev/null)" || return 1
    ((${#result} <= 64)) && [[ "$result" =~ ^[0-9A-Fa-f:.]+$ ]] || return 1
    printf '%s\n' "$result"
}

public_ipv6() {
    local interface="${1:-}" max_time="${2:-7}" connect_timeout=3 result
    [[ "$max_time" =~ ^[0-9]+$ ]] || max_time=7
    ((max_time < 1)) && return 1
    ((max_time < connect_timeout)) && connect_timeout="$max_time"
    local -a args=(-6 -fsS --connect-timeout "$connect_timeout" --max-time "$max_time")
    [[ -n "$interface" ]] && args+=(--interface "$interface")
    result="$(curl "${args[@]}" "$PROBE_V6_URL" 2>/dev/null)" || return 1
    ((${#result} <= 64)) && [[ "$result" == *:* ]] &&
        [[ "$result" =~ ^[0-9A-Fa-f:.]+$ ]] || return 1
    printf '%s\n' "$result"
}

profile_expected_country_code() {
    profile_config_country_code "$1"
}

verify_geo_record() {
    local provider="$1" url="$2" interface="$3" max_time="$4" raw
    local -a args=(-4 -fsS --connect-timeout 3 --max-time "$max_time")
    [[ -n "$interface" ]] && args+=(--interface "$interface")
    raw="$(curl "${args[@]}" "$url" 2>/dev/null)" || return 1
    jq -ce --arg provider "$provider" '
        def clean($limit):
            tostring
            | gsub("[\u0000-\u001f\u007f]"; " ")
            | .[0:$limit];
        (
            if $provider == "ipapi" then
                {
                    provider: $provider,
                    ip: (.ip // ""),
                    country_code: (.country_code // ""),
                    country: (.country_name // ""),
                    region: (.region // ""),
                    city: (.city // "")
                }
            else
                if (.success // true) == false then error("provider failure") else . end
                | {
                    provider: $provider,
                    ip: (.ip // ""),
                    country_code: (.country_code // ""),
                    country: (.country // ""),
                    region: (.region // ""),
                    city: (.city // "")
                }
            end
        )
        | .ip |= clean(64)
        | .country_code |= (clean(2) | ascii_upcase)
        | .country |= clean(96)
        | .region |= clean(96)
        | .city |= clean(96)
        | select(.ip | test("^[0-9A-Fa-f:.]{3,64}$"))
        | select(.country_code | test("^[A-Z]{2}$"))
    ' <<<"$raw"
}

verify_dns_state() {
    local interface="$1" dns="" domains=""
    command -v resolvectl >/dev/null 2>&1 || {
        printf 'unavailable\n'
        return
    }
    dns="$(resolvectl dns "$interface" 2>/dev/null || true)"
    [[ -n "$dns" ]] || {
        printf 'unknown\n'
        return
    }
    domains="$(resolvectl domain "$interface" 2>/dev/null || true)"
    if grep -Eq '(^|[[:space:]])~\.($|[[:space:]])' <<<"$domains"; then
        printf 'vpn-full-tunnel\n'
    else
        printf 'vpn-interface\n'
    fi
}

verify_speed_sample() {
    local interface="$1" max_time="$2" raw bytes_per_second first_byte
    local mbps connect_ms
    local LC_ALL=C
    export LC_ALL
    [[ -n "$interface" ]] || return 1
    raw="$(
        curl -4 -fsS --interface "$interface" \
            --connect-timeout 5 --max-time "$max_time" \
            --output /dev/null \
            --write-out $'%{speed_download}\t%{time_starttransfer}' \
            "$VERIFY_SPEED_URL" 2>/dev/null
    )" || return 1
    IFS=$'\t' read -r bytes_per_second first_byte <<<"$raw"
    [[ "$bytes_per_second" =~ ^[0-9]+([.][0-9]+)?$ ]] || return 1
    [[ "$first_byte" =~ ^[0-9]+([.][0-9]+)?$ ]] || return 1
    mbps="$(awk -v speed="$bytes_per_second" 'BEGIN { printf "%.2f", speed * 8 / 1000000 }')"
    connect_ms="$(awk -v seconds="$first_byte" 'BEGIN { printf "%d", seconds * 1000 + 0.5 }')"
    jq -cn --argjson mbps "$mbps" --argjson connect_ms "$connect_ms" \
        '{measured: true, mbps: $mbps, connect_ms: $connect_ms}'
}

verify_connection_json() {
    local max_time="$1" include_speed="$2" protocol="" interface=""
    local profile="" expected="" bound_v4="" default_v4="" bound_v6="" default_v6=""
    local geo_primary="" geo_secondary="" primary_country="" secondary_country=""
    local providers='[]' observed="" agreement=null geo_ip_mismatch=false
    local country_match=unknown dns_state=unknown speed_result
    local active=false route_same=false ipv6_leak=false verdict=verified
    local message_key=verify.verified findings_json
    local -a findings=()

    if ! selected_from_state; then
        findings+=(verify.profile.not-selected)
        verdict=failed
        message_key=verify.failed.no-profile
    else
        protocol="$SELECTED_PROTOCOL"
        profile="$(profile_name "$SELECTED_PROFILE")"
        expected="$(profile_expected_country_code "$SELECTED_PROFILE" 2>/dev/null || true)"
        interface="$(interface_for_protocol "$protocol")"
        if service_active && connection_local_ok "$protocol"; then
            active=true
        else
            findings+=(verify.tunnel.inactive)
            verdict=failed
            message_key=verify.failed.inactive
        fi
    fi

    if [[ "$active" == true && -n "$interface" ]]; then
        bound_v4="$(public_ip "$interface" "$max_time" 2>/dev/null || true)"
        default_v4="$(public_ip "" "$max_time" 2>/dev/null || true)"
        if [[ -z "$bound_v4" ]]; then
            findings+=(verify.ipv4.bound-unavailable)
            verdict=failed
            message_key=verify.failed.no-egress
        elif [[ -n "$default_v4" && "$bound_v4" == "$default_v4" ]]; then
            route_same=true
        else
            findings+=(verify.ipv4.route-mismatch)
            [[ "$verdict" == failed ]] || verdict=warning
            [[ "$message_key" == verify.verified ]] &&
                message_key=verify.warning.route-mismatch
        fi

        bound_v6="$(public_ipv6 "$interface" "$max_time" 2>/dev/null || true)"
        default_v6="$(public_ipv6 "" "$max_time" 2>/dev/null || true)"
        if [[ -n "$default_v6" &&
              ( -z "$bound_v6" || "$bound_v6" != "$default_v6" ) ]]; then
            ipv6_leak=true
            findings+=(verify.ipv6.potential-leak)
            [[ "$verdict" == failed ]] || verdict=warning
            [[ "$message_key" == verify.verified ]] &&
                message_key=verify.warning.ipv6-leak
        fi

        geo_primary="$(
            verify_geo_record ipapi "$VERIFY_GEO_PRIMARY_URL" \
                "$interface" "$max_time" 2>/dev/null || true
        )"
        geo_secondary="$(
            verify_geo_record ipwho "$VERIFY_GEO_SECONDARY_URL" \
                "$interface" "$max_time" 2>/dev/null || true
        )"
        if [[ -n "$geo_primary" &&
              "$(jq -r '.ip' <<<"$geo_primary")" != "$bound_v4" ]]; then
            geo_primary=""
            geo_ip_mismatch=true
        fi
        if [[ -n "$geo_secondary" &&
              "$(jq -r '.ip' <<<"$geo_secondary")" != "$bound_v4" ]]; then
            geo_secondary=""
            geo_ip_mismatch=true
        fi
        if [[ "$geo_ip_mismatch" == true ]]; then
            findings+=(verify.geo.ip-mismatch)
            [[ "$verdict" == failed ]] || verdict=warning
            [[ "$message_key" == verify.verified ]] &&
                message_key=verify.warning.geo-ip-mismatch
        fi
        if [[ -n "$geo_primary" && -n "$geo_secondary" ]]; then
            providers="$(jq -cn --argjson a "$geo_primary" --argjson b "$geo_secondary" '[$a, $b]')"
            primary_country="$(jq -r '.country_code' <<<"$geo_primary")"
            secondary_country="$(jq -r '.country_code' <<<"$geo_secondary")"
            if [[ "$primary_country" == "$secondary_country" ]]; then
                agreement=true
            else
                agreement=false
                findings+=(verify.geo.providers-disagree)
                [[ "$verdict" == failed ]] || verdict=warning
                [[ "$message_key" == verify.verified ]] &&
                    message_key=verify.warning.geo-disagreement
            fi
        elif [[ -n "$geo_primary" ]]; then
            providers="$(jq -cn --argjson a "$geo_primary" '[$a]')"
            findings+=(verify.geo.single-provider)
            [[ "$verdict" == failed ]] || verdict=warning
            [[ "$message_key" == verify.verified ]] &&
                message_key=verify.warning.geo-single-provider
        elif [[ -n "$geo_secondary" ]]; then
            providers="$(jq -cn --argjson a "$geo_secondary" '[$a]')"
            findings+=(verify.geo.single-provider)
            [[ "$verdict" == failed ]] || verdict=warning
            [[ "$message_key" == verify.verified ]] &&
                message_key=verify.warning.geo-single-provider
        else
            findings+=(verify.geo.unavailable)
            [[ "$verdict" == failed ]] || verdict=warning
            [[ "$message_key" == verify.verified ]] &&
                message_key=verify.warning.geo-unavailable
        fi
        observed="$(jq -r '.[0].country_code // ""' <<<"$providers")"
        if [[ -n "$expected" && -n "$observed" ]]; then
            if [[ "$expected" == "$observed" ]]; then
                country_match=match
            else
                country_match=mismatch
                findings+=(verify.geo.profile-mismatch)
                [[ "$verdict" == failed ]] || verdict=warning
                [[ "$message_key" == verify.verified ]] &&
                    message_key=verify.warning.location-mismatch
            fi
        elif [[ -z "$expected" && -n "$observed" ]]; then
            findings+=(verify.geo.expected-country-unavailable)
            [[ "$verdict" == failed ]] || verdict=warning
            [[ "$message_key" == verify.verified ]] &&
                message_key=verify.warning.expected-country-unavailable
        fi

        dns_state="$(verify_dns_state "$interface")"
        if [[ "$dns_state" != vpn-full-tunnel ]]; then
            findings+=(verify.dns.not-confirmed-full-tunnel)
            [[ "$verdict" == failed ]] || verdict=warning
            [[ "$message_key" == verify.verified ]] &&
                message_key=verify.warning.dns-not-confirmed
        fi
    fi

    speed_result='{"requested":false,"measured":false,"mbps":null,"connect_ms":null}'
    if [[ "$include_speed" == true ]]; then
        if [[ "$active" == true && -n "$interface" ]]; then
            speed_result="$(
                verify_speed_sample "$interface" "$((max_time > 20 ? max_time : 20))" \
                    2>/dev/null || true
            )"
        else
            speed_result=""
        fi
        if [[ -n "$speed_result" ]]; then
            speed_result="$(jq -c '. + {requested: true}' <<<"$speed_result")"
        else
            speed_result='{"requested":true,"measured":false,"mbps":null,"connect_ms":null}'
            findings+=(verify.speed.unavailable)
            [[ "$verdict" == failed ]] || verdict=warning
            [[ "$message_key" == verify.verified ]] &&
                message_key=verify.warning.speed-unavailable
        fi
    fi

    findings_json="$(jq -cn --args '$ARGS.positional' -- "${findings[@]}")"
    jq -cn \
        --arg checked_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        --arg verdict "$verdict" \
        --arg message_key "$message_key" \
        --arg protocol "$protocol" \
        --arg profile "$profile" \
        --arg interface "$interface" \
        --arg bound_v4 "$bound_v4" \
        --arg default_v4 "$default_v4" \
        --arg bound_v6 "$bound_v6" \
        --arg default_v6 "$default_v6" \
        --arg expected "$expected" \
        --arg observed "$observed" \
        --arg country_match "$country_match" \
        --arg dns_state "$dns_state" \
        --argjson active "$active" \
        --argjson route_same "$route_same" \
        --argjson ipv6_leak "$ipv6_leak" \
        --argjson agreement "$agreement" \
        --argjson providers "$providers" \
        --argjson speed "$speed_result" \
        --argjson findings "$findings_json" \
        '{
            schema_version: 1,
            checked_at: $checked_at,
            verdict: $verdict,
            message_key: $message_key,
            tunnel: {
                active: $active,
                protocol: (if $protocol == "" then null else $protocol end),
                profile: (if $profile == "" then null else $profile end),
                interface: (if $interface == "" then null else $interface end)
            },
            ipv4: {
                interface_ip: (if $bound_v4 == "" then null else $bound_v4 end),
                default_ip: (if $default_v4 == "" then null else $default_v4 end),
                same_egress: $route_same
            },
            ipv6: {
                interface_ip: (if $bound_v6 == "" then null else $bound_v6 end),
                default_ip: (if $default_v6 == "" then null else $default_v6 end),
                potential_leak: $ipv6_leak
            },
            geo: {
                expected_country_code: (if $expected == "" then null else $expected end),
                observed_country_code: (if $observed == "" then null else $observed end),
                country_match: $country_match,
                providers_agree: $agreement,
                providers: $providers
            },
            dns: {state: $dns_state},
            speed: $speed,
            findings: $findings
        }'
}

render_verify_result() {
    local result="$1" verdict observed country city
    verdict="$(jq -r '.verdict' <<<"$result")"
    observed="$(jq -r '.geo.observed_country_code // "—"' <<<"$result")"
    country="$(jq -r '.geo.providers[0].country // "—"' <<<"$result")"
    city="$(jq -r '.geo.providers[0].city // "—"' <<<"$result")"
    if [[ "$verdict" == verified ]]; then
        printf 'Network egress verified\n'
    else
        printf 'Network egress verification: %s\n' "$verdict"
    fi
    printf 'Tunnel:          %s\n' "$(jq -r '.tunnel.active' <<<"$result")"
    printf 'IPv4 egress:     %s\n' "$(jq -r '.ipv4.same_egress' <<<"$result")"
    printf 'Observed place:  %s — %s, %s\n' "$observed" "$country" "$city"
    printf 'Profile match:   %s\n' "$(jq -r '.geo.country_match' <<<"$result")"
    printf 'IPv6 leak risk:  %s\n' "$(jq -r '.ipv6.potential_leak' <<<"$result")"
    printf 'DNS route:       %s\n' "$(jq -r '.dns.state' <<<"$result")"
    if [[ "$(jq -r '.speed.requested' <<<"$result")" == true ]]; then
        printf 'Speed sample:    %s Mbps (first byte %s ms)\n' \
            "$(jq -r '.speed.mbps // "unavailable"' <<<"$result")" \
            "$(jq -r '.speed.connect_ms // "unavailable"' <<<"$result")"
    fi
    say "This verifies network egress, DNS routing and IPv6 signals. Sites may also use account, cookies, browser language, WebRTC or device location."
}

cmd_verify() {
    local max_time=10 include_speed=false json_output=false payload response result
    local -a original_args=("$@")
    while (($#)); do
        case "$1" in
            --timeout)
                shift
                [[ $# -gt 0 ]] || die "--timeout требует число секунд"
                max_time="$1"
                ;;
            --speed) include_speed=true ;;
            --json) json_output=true ;;
            --help|-h)
                say "Использование: $CLI_COMMAND verify [--timeout 10] [--speed] [--json]"
                return 0
                ;;
            *) die "Неизвестный параметр verify: $1" ;;
        esac
        shift
    done
    if [[ ! "$max_time" =~ ^[0-9]+$ ]] ||
       ((max_time < 3 || max_time > 30)); then
        die "Таймаут verify должен быть от 3 до 30 секунд"
    fi

    if api_client_ready; then
        payload="$(
            jq -cn \
                --argjson timeout_seconds "$max_time" \
                --argjson include_speed "$include_speed" \
                '{
                    timeout_seconds: $timeout_seconds,
                    include_speed: $include_speed
                }'
        )"
        response="$(api_client_query_payload tests.verify-egress "$payload" 180000)" || {
            error "Local API VPN verification is unavailable"
            return 70
        }
        if [[ "$(jq -r '.status' <<<"$response")" != ok ]]; then
            error "Local API: $(jq -r '.error.code + ": " + .error.message_key' <<<"$response")"
            return 1
        fi
        result="$(jq -c '.result' <<<"$response")"
    else
        require_profile_access verify "${original_args[@]}"
        result="$(verify_connection_json "$max_time" "$include_speed")" ||
            die "Не удалось проверить VPN egress"
    fi

    if [[ "$json_output" == true ]]; then
        jq . <<<"$result"
    else
        render_verify_result "$result"
    fi
    [[ "$(jq -r '.verdict' <<<"$result")" != failed ]]
}

service_probe_result_json() {
    local service_id="$1" reachability="$2" eligibility="$3" reason_code="$4"
    local http_status="${5:-}"
    if [[ "$http_status" =~ ^[1-5][0-9]{2}$ ]]; then
        jq -cn \
            --arg service_id "$service_id" \
            --arg reachability "$reachability" \
            --arg eligibility "$eligibility" \
            --arg reason_code "$reason_code" \
            --argjson http_status "$http_status" \
            '{
                service_id: $service_id,
                probe_version: 1,
                reachability: $reachability,
                egress_eligibility: $eligibility,
                reason_code: $reason_code,
                http_status: $http_status
            }'
    else
        jq -cn \
            --arg service_id "$service_id" \
            --arg reachability "$reachability" \
            --arg eligibility "$eligibility" \
            --arg reason_code "$reason_code" \
            '{
                service_id: $service_id,
                probe_version: 1,
                reachability: $reachability,
                egress_eligibility: $eligibility,
                reason_code: $reason_code,
                http_status: null
            }'
    fi
}

service_probe_one_json() {
    local service_id="$1" interface="$2" timeout_seconds="$3" url=""
    local raw="" raw_bytes=0 parsed="" status="" location="" allow="" rc=0
    local LC_ALL=C
    case "$service_id" in
        notebooklm) url="$SERVICE_PROBE_NOTEBOOKLM_URL" ;;
        openai) url="$SERVICE_PROBE_OPENAI_URL" ;;
        *) return 2 ;;
    esac
    [[ -n "$interface" ]] || {
        service_probe_result_json "$service_id" unreachable indeterminate \
            service.network-unreachable
        return
    }

    raw="$(
        env \
            -u ALL_PROXY -u all_proxy \
            -u HTTP_PROXY -u http_proxy \
            -u HTTPS_PROXY -u https_proxy \
            -u NO_PROXY -u no_proxy \
            curl -q --silent --show-error --head \
                --interface "$interface" \
                --connect-timeout "$timeout_seconds" \
                --max-time "$timeout_seconds" \
                --max-redirs 0 \
                --proto '=https' \
                --noproxy '*' --proxy '' \
                --user-agent 'Mazzy-VPN-Service-Egress/1' \
                --header 'Accept: */*' \
                --output /dev/null --dump-header - \
                --url "$url" 2>/dev/null |
            head -c "$((SERVICE_PROBE_MAX_HEADER_BYTES + 1))"
    )" || rc=$?
    raw_bytes="$(printf '%s' "$raw" | wc -c)" || raw_bytes=0
    if ((raw_bytes > SERVICE_PROBE_MAX_HEADER_BYTES)); then
        service_probe_result_json "$service_id" reachable indeterminate \
            service.response-too-large
        return
    fi
    if ((rc != 0)); then
        service_probe_result_json "$service_id" unreachable indeterminate \
            service.network-unreachable
        return
    fi
    if LC_ALL=C grep -q $'[^\r -~]' <<<"$raw"; then
        service_probe_result_json "$service_id" reachable indeterminate \
            service.response-invalid
        return
    fi
    parsed="$(
        awk '
            {
                line=$0
                sub(/\r$/, "", line)
                if (length(line) > 1024) invalid=1
                if (line ~ /^HTTP\/[0-9.]+ [1-5][0-9][0-9]([ ]|$)/) {
                    status=line
                    sub(/^HTTP\/[0-9.]+[ ]+/, "", status)
                    sub(/[ ].*$/, "", status)
                    location=""
                    location_count=0
                    allow=""
                    allow_count=0
                    seen=1
                    next
                }
                if (seen && line ~ /^[ \t]/) invalid=1
                lowered=tolower(substr(line, 1, 9))
                if (seen && lowered == "location:") {
                    value=substr(line, 10)
                    sub(/^[ \t]*/, "", value)
                    location=value
                    location_count++
                }
                lowered_allow=tolower(substr(line, 1, 6))
                if (seen && lowered_allow == "allow:") {
                    value=substr(line, 7)
                    sub(/^[ ]*/, "", value)
                    allow=value
                    allow_count++
                }
            }
            END {
                if (!seen || invalid || location_count > 1 || allow_count > 1 || length(location) > 512 || length(allow) > 128) {
                    exit 1
                }
                printf "%s%c%s%c%s", status, 31, location, 31, allow
            }
        ' <<<"$raw"
    )" || {
        service_probe_result_json "$service_id" reachable indeterminate \
            service.response-invalid
        return
    }
    IFS=$'\x1f' read -r status location allow <<<"$parsed"

    case "$service_id" in
        notebooklm)
            if [[ "$status" =~ ^30[12378]$ &&
                  "$location" == "https://notebooklm.google/?location=unsupported" ]]; then
                service_probe_result_json notebooklm reachable ineligible \
                    service.notebooklm.unsupported-location "$status"
            elif [[ "$status" =~ ^30[12378]$ &&
                    "$location" == "https://notebook.google.com/" ]]; then
                service_probe_result_json notebooklm reachable eligible \
                    service.notebooklm.home-reached "$status"
            else
                service_probe_result_json notebooklm reachable indeterminate \
                    service.notebooklm.unrecognized-response "$status"
            fi
            ;;
        openai)
            case "$status" in
                401)
                    service_probe_result_json openai reachable eligible \
                        service.openai.auth-boundary-reached "$status"
                    ;;
                405)
                    if [[ "$allow" == POST ]]; then
                        service_probe_result_json openai reachable eligible \
                            service.openai.auth-boundary-reached "$status"
                    else
                        service_probe_result_json openai reachable indeterminate \
                            service.openai.unrecognized-response "$status"
                    fi
                    ;;
                403)
                    service_probe_result_json openai reachable ineligible \
                        service.openai.edge-denied "$status"
                    ;;
                429)
                    service_probe_result_json openai reachable indeterminate \
                        service.openai.rate-limited "$status"
                    ;;
                5??)
                    service_probe_result_json openai reachable indeterminate \
                        service.openai.service-unavailable "$status"
                    ;;
                *)
                    service_probe_result_json openai reachable indeterminate \
                        service.openai.unrecognized-response "$status"
                    ;;
            esac
            ;;
    esac
}

verify_service_egress_json() {
    local requested="$1" timeout_seconds="$2" protocol="" interface=""
    local service_id result
    local -a services=() results=()
    case "$requested" in
        notebooklm|openai) services=("$requested") ;;
        all) services=(notebooklm openai) ;;
        *) return 2 ;;
    esac
    if selected_from_state; then
        protocol="$SELECTED_PROTOCOL"
        if service_active && connection_local_ok "$protocol"; then
            interface="$(interface_for_protocol "$protocol")"
        fi
    fi
    for service_id in "${services[@]}"; do
        result="$(service_probe_one_json \
            "$service_id" "$interface" "$timeout_seconds")" || return 1
        results+=("$result")
    done
    printf '%s\n' "${results[@]}" |
        jq -cs \
            --arg checked_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
            '{
                schema_version: 1,
                checked_at: $checked_at,
                scope: "unauthenticated-egress",
                results: .
            }'
}

render_service_verify_result() {
    local result="$1" service_id reachability eligibility reason_code http_status
    while IFS=$'\t' read -r \
        service_id reachability eligibility reason_code http_status; do
        printf '%-10s reachability=%-11s egress_eligibility=%-13s reason=%s status=%s\n' \
            "$service_id" "$reachability" "$eligibility" "$reason_code" "$http_status"
    done < <(
        jq -r '.results[] | [
            .service_id, .reachability, .egress_eligibility,
            .reason_code, (.http_status // "unavailable")
        ] | @tsv' <<<"$result"
    )
    say "Account, authentication, organization, subscription and content access were not tested."
}

cmd_verify_service() {
    local requested=all scope_seen=false timeout_seconds=5 json_output=false
    local payload response result
    local deadline_ms
    local -a original_args=("$@")
    while (($#)); do
        case "$1" in
            notebooklm|openai|all)
                [[ "$scope_seen" == false ]] ||
                    die "Укажите только один service scope"
                requested="$1"
                scope_seen=true
                ;;
            --timeout)
                shift
                [[ $# -gt 0 ]] || die "--timeout требует число секунд"
                timeout_seconds="$1"
                ;;
            --json) json_output=true ;;
            --help|-h)
                say "Использование: $CLI_COMMAND verify-service [notebooklm|openai|all] [--timeout 5] [--json]"
                return 0
                ;;
            *) die "Неизвестный параметр verify-service: $1" ;;
        esac
        shift
    done
    if [[ ! "$timeout_seconds" =~ ^[0-9]+$ ]] ||
       ((10#$timeout_seconds < 3 || 10#$timeout_seconds > 15)); then
        die "Таймаут verify-service должен быть от 3 до 15 секунд"
    fi
    if [[ "$requested" == all ]]; then
        deadline_ms=$((timeout_seconds * 2000 + 2000))
    else
        deadline_ms=$((timeout_seconds * 1000 + 2000))
    fi

    if api_client_ready; then
        payload="$(
            jq -cn \
                --arg service "$requested" \
                --argjson timeout_seconds "$timeout_seconds" \
                '{service: $service, timeout_seconds: $timeout_seconds}'
        )"
        response="$(api_client_query_payload \
            tests.verify-service-egress "$payload" "$deadline_ms")" || {
            error "Local API service egress verification is unavailable"
            return 70
        }
        if [[ "$(jq -r '.status' <<<"$response")" != ok ]]; then
            error "Local API: $(jq -r '.error.code + ": " + .error.message_key' <<<"$response")"
            return 1
        fi
        result="$(jq -c '.result' <<<"$response")"
    else
        require_profile_access verify-service "${original_args[@]}"
        result="$(verify_service_egress_json "$requested" "$timeout_seconds")" ||
            die "Не удалось завершить service egress verification"
    fi

    if [[ "$json_output" == true ]]; then
        jq . <<<"$result"
    else
        render_service_verify_result "$result"
    fi
}

validate_test_timeout() {
    local timeout="$1"
    [[ "$timeout" =~ ^[0-9]+$ ]] || return 1
    ((timeout >= 2 && timeout <= 600))
}

inherited_mutation_lock_valid() {
    local fd="${VPNCTL_MUTATION_LOCK_FD:-}" expected_inode actual_inode
    [[ "$fd" =~ ^[0-9]+$ ]] || return 1
    [[ -e "/proc/$$/fd/$fd" ]] || return 1
    expected_inode="$(stat -Lc '%d:%i' -- "$MUTATION_LOCK_FILE" 2>/dev/null)" ||
        return 1
    actual_inode="$(stat -Lc '%d:%i' -- "/proc/$$/fd/$fd" 2>/dev/null)" ||
        return 1
    [[ "$actual_inode" == "$expected_inode" ]] || return 1
    flock -n "$fd"
}

acquire_action_lock() {
    mkdir -p "$RUN_DIR"
    chmod 700 "$RUN_DIR"
    if [[ -n "${VPNCTL_MUTATION_LOCK_FD:-}" ]]; then
        inherited_mutation_lock_valid ||
            die "Недействительная унаследованная блокировка мутации $PRODUCT_NAME"
        return
    fi
    exec 8>"$MUTATION_LOCK_FILE"
    flock -n 8 || die "Другая операция $PRODUCT_NAME уже выполняется"
    export VPNCTL_MUTATION_LOCK_FD=8
}

acquire_recovery_lock() {
    local wait_seconds="${1:-30}"
    mkdir -p "$RUN_DIR"
    chmod 700 "$RUN_DIR"
    if [[ -n "${VPNCTL_MUTATION_LOCK_FD:-}" ]]; then
        inherited_mutation_lock_valid
        return
    fi
    exec 8>"$MUTATION_LOCK_FILE"
    flock -w "$wait_seconds" 8 || return 1
    export VPNCTL_MUTATION_LOCK_FD=8
}

stop_service_bounded() {
    local limit="${1:-15}" reset_failed="${2:-yes}"
    if timeout "$limit" systemctl stop "$SERVICE_NAME"; then
        [[ "$reset_failed" != yes ]] ||
            systemctl_quiet reset-failed "$SERVICE_NAME" || true
        return 0
    fi
    warn "$SERVICE_NAME не остановился за ${limit}s; принудительное завершение"
    systemctl kill --kill-who=all --signal=SIGKILL "$SERVICE_NAME" 2>/dev/null || true
    [[ "$reset_failed" != yes ]] ||
        systemctl_quiet reset-failed "$SERVICE_NAME" || true
    return 1
}

reset_service_start_limit() {
    systemctl_quiet reset-failed "$SERVICE_NAME" || true
}

