main() {
    local command="${1:-}"
    [[ $# -eq 0 ]] || shift
    case "$command" in
        connect|up|start|switch|quick|fast|disconnect|down|stop|\
        reconnect|restart|autostart|auto|monitor|test|check|test-all|check-all|\
        emergency|recover|import|add|import-files|import-dir|add-dir|scan-dir|\
        remove|delete|rm|language|lang|locale)
            trap 'write_dashboard_cache >/dev/null 2>&1 || true' EXIT
            ;;
    esac
    case "$command" in
        "") interactive_menu ;;
        help|-h|--help) usage ;;
        version|-V|--version)
            say "$PRODUCT_NAME $VERSION ($CLI_COMMAND; alias: $COMPAT_COMMAND)"
            ;;
        api-info) cmd_api_info "$@" ;;
        list|ls) cmd_list "$@" ;;
        profiles|profile-list)
            case "${1:-}" in
                "")
                    (($# == 0)) ||
                        die "Использование: $CLI_COMMAND profiles [--json|--api-json]"
                    cmd_profiles_json
                    ;;
                --json)
                    (($# == 1)) ||
                        die "Использование: $CLI_COMMAND profiles --json"
                    cmd_profiles_json
                    ;;
                --api-json)
                    (($# == 1)) ||
                        die "Использование: $CLI_COMMAND profiles --api-json"
                    cmd_profiles_api_json
                    ;;
                *)
                    die "Использование: $CLI_COMMAND profiles [--json|--api-json]"
                    ;;
            esac
            ;;
        connect|up|start|switch) cmd_connect "$@" ;;
        quick|fast) cmd_quick_connect "$@" ;;
        disconnect|down|stop) cmd_disconnect "$@" ;;
        reconnect|restart) cmd_reconnect "$@" ;;
        dashboard|dash) cmd_dashboard "$@" ;;
        status|show) cmd_status "$@" ;;
        diagnose|diag) cmd_diagnose "$@" ;;
        validate|lint) cmd_validate "$@" ;;
        probe|ping) cmd_probe "$@" ;;
        test|check) cmd_test "$@" ;;
        test-all|check-all) cmd_test_all "$@" ;;
        emergency|recover) cmd_emergency "$@" ;;
        self-test|selftest) cmd_self_test "$@" ;;
        doctor) cmd_doctor "$@" ;;
        autostart|auto) cmd_autostart "$@" ;;
        monitor) cmd_monitor "$@" ;;
        import|add) cmd_import "$@" ;;
        import-files) cmd_import_files "$@" ;;
        import-dir|add-dir|scan-dir) cmd_import_dir "$@" ;;
        init-config-dir|init-dir) cmd_init_config_dir "$@" ;;
        remove|delete|rm) cmd_remove "$@" ;;
        logs|log) cmd_logs "$@" ;;
        language|lang|locale) cmd_language "$@" ;;
        _service-run) service_run ;;
        _health-check) health_check ;;
        _refresh-dashboard-cache)
            require_root _refresh-dashboard-cache
            write_dashboard_cache
            ;;
        _api-dispatch) api_dispatch ;;
        _api-clear-recovery) cmd_api_clear_recovery "$@" ;;
        _test-timeout) test_timeout_handler "${1:-}" ;;
        _recover-stale-test) recover_stale_test_state ;;
        _dedupe-quick-policy)
            require_root _dedupe-quick-policy
            cleanup_duplicate_quick_policy
            ;;
        _openvpn-dns-up) openvpn_dns_up "${1:-}" ;;
        _openvpn-dns-down) openvpn_dns_down "${1:-}" ;;
        *) error "Неизвестная команда: $command"; usage >&2; return 2 ;;
    esac
}

main "$@"
