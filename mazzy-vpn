cmd_protocols_diagnose() {
    local registry engine protocol support available_json='{}' ready_json='{}'
    registry="$(protocol_registry_path)" ||
        die "Protocol registry не найден; переустановите $PRODUCT_NAME"
    while IFS= read -r engine; do
        if command -v "$engine" >/dev/null 2>&1; then
            available_json="$(jq -c --arg engine "$engine" \
                '. + {($engine): true}' <<<"$available_json")" || return 1
        else
            available_json="$(jq -c --arg engine "$engine" \
                '. + {($engine): false}' <<<"$available_json")" || return 1
        fi
    done < <(jq -r '[.protocols[].engines[]] | unique[]' "$registry")
    while IFS=$'\t' read -r protocol support; do
        if [[ "$support" == implemented ]] && protocol_runtime_available "$protocol"; then
            ready_json="$(jq -c --arg protocol "$protocol" \
                '. + {($protocol): true}' <<<"$ready_json")" || return 1
        else
            ready_json="$(jq -c --arg protocol "$protocol" \
                '. + {($protocol): false}' <<<"$ready_json")" || return 1
        fi
    done < <(jq -r '.protocols[] | [.id, .support.linux] | @tsv' "$registry")
    jq -c --arg generated_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        --argjson available "$available_json" --argjson ready "$ready_json" '
        {
            schema_version: 1,
            generated_at: $generated_at,
            engines: ([
                .protocols[].engines[]
            ] | unique | map({id: ., available: ($available[.] // false)})),
            protocols: [
                .protocols[] |
                {
                    id,
                    display_name,
                    kind,
                    support,
                    backend_ready: ($ready[.id] // false),
                    candidate_engine_available: any(
                        .engines[]; $available[.] // false
                    )
                }
            ]
        }
    ' "$registry"
}

protocol_detection_result() {
    local registry="$1" protocol="$2" input_kind="$3" result
    result="$(jq -c --arg protocol "$protocol" --arg input_kind "$input_kind" '
        .protocols[] | select(.id == $protocol) |
        {
            schema_version: 1,
            recognized: true,
            protocol: .id,
            display_name,
            kind,
            input_kind: $input_kind,
            contains_secrets: true,
            import_support: .support.import,
            linux_connection_support: .support.linux
        }
    ' "$registry")" || return 1
    [[ -n "$result" ]] || return 1
    printf '%s\n' "$result"
}

cmd_protocols_detect() {
    local registry encoded input byte_count payload_count terminator_bytes
    local last_byte previous_byte first_non_whitespace scheme protocol
    registry="$(protocol_registry_path)" ||
        die "Protocol registry не найден; переустановите $PRODUCT_NAME"
    encoded="$(LC_ALL=C head -c 65539 | base64)" || return 1
    byte_count="$(printf '%s' "$encoded" | base64 -d | wc -c)" || return 1
    if ((byte_count == 0 || byte_count > 65538)); then
        jq -cn '{schema_version: 1, recognized: false, reason: "invalid-input"}'
        return 2
    fi
    first_non_whitespace="$(
        printf '%s' "$encoded" | base64 -d | od -An -v -tu1 | awk '
            {
                for (i = 1; i <= NF; i++) {
                    if ($i != 9 && $i != 10 && $i != 13 && $i != 32) {
                        print $i
                        exit
                    }
                }
            }
        '
    )" || return 1
    if [[ "$first_non_whitespace" == 123 ]]; then
        if ((byte_count > 65536)) ||
           printf '%s' "$encoded" | base64 -d | od -An -v -tu1 | awk '
               {
                   for (i = 1; i <= NF; i++) {
                       if (($i < 32 && $i != 9 && $i != 10 && $i != 13) || $i == 127) {
                           found = 1
                       }
                   }
               }
               END { exit !found }
           '; then
            jq -cn '{schema_version: 1, recognized: false, reason: "invalid-input"}'
            return 2
        fi
        input="$(printf '%s' "$encoded" | base64 -d)" || return 1
        if ! jq -s -e 'length == 1 and (.[0] | type == "object")' \
            <<<"$input" >/dev/null 2>&1; then
            jq -cn '{schema_version: 1, recognized: false, reason: "invalid-json"}'
            return 2
        fi
        if ! api_request_has_unique_schema_keys "$input"; then
            jq -cn '{schema_version: 1, recognized: false, reason: "duplicate-key"}'
            return 2
        fi
        # shellcheck disable=SC2016  # jq variables are intentionally literal here.
        protocol="$(timeout --kill-after=1s 3s jq -r '
            def mapped_outbound:
                ((.type? // .protocol? // "") | ascii_downcase) as $type
                | if $type == "vless" then "vless"
                  elif $type == "hysteria2" then "hysteria2"
                  elif $type == "tuic" then "tuic"
                  elif $type == "trojan" then "trojan"
                  elif $type == "anytls" then "anytls"
                  elif $type == "shadowtls" then "shadowtls"
                  elif $type == "naive" then "naive"
                  elif $type == "mieru" then "mieru"
                  elif $type == "shadowsocks"
                       and ((.method? // "") | startswith("2022-"))
                  then "shadowsocks2022"
                  else empty
                  end;
            [
                (if (.outbounds? | type) == "array"
                 then .outbounds[] | select(type == "object") | mapped_outbound
                 else empty end),
                (if has("type") or has("protocol") then mapped_outbound else empty end),
                (if ((.profiles? | type) == "array")
                    and (.profiles | length) > 0
                    and ((.activeProfile? | type) == "string")
                    and all(.profiles[];
                        (type == "object")
                        and ((.user? | type) == "object")
                        and ((.servers? | type) == "array")
                    )
                 then "mieru" else empty end),
                (if ((.proxy? | type) == "string")
                    and (.proxy | test("^(https|quic)://"; "i"))
                    and ((.listen? | type) == "string")
                    and (.listen | test("^socks://"; "i"))
                 then "naive" else empty end)
            ] | unique
            | if length == 1 then .[0]
              elif length > 1 then "__ambiguous__"
              else ""
              end
        ' <<<"$input")" || {
            jq -cn '{schema_version: 1, recognized: false, reason: "invalid-json"}'
            return 2
        }
        if [[ "$protocol" == __ambiguous__ ]]; then
            jq -cn '{schema_version: 1, recognized: false, reason: "ambiguous-protocol"}'
            return 2
        elif [[ -z "$protocol" ]]; then
            jq -cn '{schema_version: 1, recognized: false, reason: "unsupported-json"}'
            return 2
        fi
        protocol_detection_result "$registry" "$protocol" configuration-json
        return
    fi

    terminator_bytes=0
    if ((byte_count > 0)); then
        last_byte="$(
            printf '%s' "$encoded" | base64 -d | tail -c 1 |
                od -An -tu1 | tr -d '[:space:]'
        )" || return 1
        if [[ "$last_byte" == 10 ]]; then
            terminator_bytes=1
            if ((byte_count > 1)); then
                previous_byte="$(
                    printf '%s' "$encoded" | base64 -d | tail -c 2 | head -c 1 |
                        od -An -tu1 | tr -d '[:space:]'
                )" || return 1
                [[ "$previous_byte" == 13 ]] && terminator_bytes=2
            fi
        fi
    fi
    payload_count=$((byte_count - terminator_bytes))
    if ((payload_count == 0 || payload_count > 65536 || byte_count > 65538)) ||
       printf '%s' "$encoded" | base64 -d | od -An -v -tu1 | awk \
           -v size="$byte_count" -v terminator="$terminator_bytes" '
           {
               for (i = 1; i <= NF; i++) {
                   position++
                   allowed_lf = terminator >= 1 && position == size && $i == 10
                   allowed_cr = terminator == 2 && position == size - 1 && $i == 13
                   if (($i < 32 || $i == 127) && !allowed_lf && !allowed_cr) found = 1
               }
           }
           END { exit !found }
       '; then
        jq -cn '{schema_version: 1, recognized: false, reason: "invalid-input"}'
        return 2
    fi
    input="$(printf '%s' "$encoded" | base64 -d)" || return 1
    [[ "$terminator_bytes" -eq 2 ]] && input="${input%$'\r'}"
    [[ "$input" == *://* ]] || {
        jq -cn '{schema_version: 1, recognized: false, reason: "unsupported-format"}'
        return 2
    }
    scheme="${input%%://*}"
    scheme="${scheme,,}"
    [[ "$scheme" =~ ^[a-z][a-z0-9+.-]{0,31}$ ]] || {
        jq -cn '{schema_version: 1, recognized: false, reason: "invalid-scheme"}'
        return 2
    }
    [[ -n "${input#*://}" && ! "$input" =~ [[:space:]] ]] || {
        jq -cn '{schema_version: 1, recognized: false, reason: "invalid-uri"}'
        return 2
    }
    protocol="$(jq -r --arg scheme "$scheme" '
        first(.protocols[] | select(any(.uri_schemes[]; . == $scheme)) | .id) // ""
    ' "$registry")" || return 1
    if [[ -z "$protocol" ]]; then
        jq -cn '{schema_version: 1, recognized: false, reason: "unsupported-scheme"}'
        return 2
    fi
    protocol_detection_result "$registry" "$protocol" share-uri
}

cmd_protocols_managed_validate() {
    local encoded byte_count input protocol profile_id display_name render_supported
    encoded="$(LC_ALL=C head -c 65537 | base64)" || return 1
    byte_count="$(printf '%s' "$encoded" | base64 -d | wc -c)" || return 1
    if ((byte_count == 0 || byte_count > 65536)); then
        jq -cn '{schema_version: 1, valid: false, reason: "invalid-input"}'
        return 2
    fi
    if printf '%s' "$encoded" | base64 -d | od -An -v -tu1 | awk '
        {
            for (i = 1; i <= NF; i++) {
                if (($i < 32 && $i != 9 && $i != 10 && $i != 13) || $i == 127) {
                    found = 1
                }
            }
        }
        END { exit !found }
    '; then
        jq -cn '{schema_version: 1, valid: false, reason: "invalid-input"}'
        return 2
    fi
    input="$(printf '%s' "$encoded" | base64 -d)" || return 1
    if ! jq -s -e 'length == 1 and (.[0] | type == "object")' \
        <<<"$input" >/dev/null 2>&1; then
        jq -cn '{schema_version: 1, valid: false, reason: "invalid-json"}'
        return 2
    fi
    if ! api_request_has_unique_schema_keys "$input"; then
        jq -cn '{schema_version: 1, valid: false, reason: "duplicate-key"}'
        return 2
    fi
    # shellcheck disable=SC2016  # jq variables are intentionally literal here.
    if ! timeout --kill-after=1s 3s jq -e '
        def closed($allowed):
            type == "object" and ((keys - $allowed) | length) == 0;
        def safe_text($maximum):
            type == "string" and length > 0 and length <= $maximum
            and all(explode[]; . >= 32 and . != 127);
        def host:
            safe_text(253)
            and test("^[A-Za-z0-9._:-]+$")
            and (contains("..") | not);
        def secret:
            safe_text(1024);
        def port:
            type == "number" and floor == . and . >= 1 and . <= 65535;
        def network:
            . == "tcp" or . == "udp" or . == "both";
        def endpoint_ok:
            closed(["host", "port"])
            and (.host | host)
            and (.port | port);
        def credentials_ok($protocol):
            if $protocol == "vless" then
                closed(["uuid"])
                and (.uuid | type == "string"
                    and test("^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"))
            elif $protocol == "tuic" then
                closed(["uuid", "password"])
                and (.uuid | type == "string"
                    and test("^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"))
                and (.password | secret)
            elif $protocol == "mieru" or $protocol == "naive" then
                closed(["username", "password"])
                and (.username | secret)
                and (.password | secret)
            else
                closed(["password"]) and (.password | secret)
            end;
        def tls_ok($protocol):
            closed([
                "enabled", "insecure", "server_name", "alpn",
                "utls_fingerprint", "reality_public_key", "reality_short_id",
                "certificate_public_key_sha256"
            ])
            and (.enabled | type == "boolean")
            and (.insecure == false)
            and (.server_name | type == "string" and length <= 253)
            and ((.alpn // []) | type == "array" and length <= 4
                and length == (unique | length)
                and all(.[]; safe_text(32)))
            and ((.certificate_public_key_sha256 // []) | type == "array"
                and length <= 4 and length == (unique | length)
                and all(.[]; type == "string" and length >= 32
                    and safe_text(128)))
            and (if has("utls_fingerprint") then
                    .utls_fingerprint as $fingerprint
                    | ($fingerprint | type == "string")
                    and (["chrome", "firefox", "safari", "edge", "randomized"]
                        | index($fingerprint) != null)
                 else true end)
            and (if $protocol == "shadowsocks2022" or $protocol == "mieru" then
                    .enabled == false and .server_name == ""
                    and (has("utls_fingerprint") | not)
                    and (has("reality_public_key") | not)
                    and (has("reality_short_id") | not)
                    and (has("certificate_public_key_sha256") | not)
                 else
                    .enabled == true and (.server_name | host)
                 end)
            and (if has("reality_public_key") or has("reality_short_id") then
                    $protocol == "vless"
                    and (.reality_public_key | safe_text(128))
                    and (.reality_short_id | type == "string"
                        and test("^[0-9A-Fa-f]{0,16}$"))
                 else true end);
        def options_ok($protocol):
            . as $options
            | if $protocol == "vless" then
                closed(["flow", "network"])
                and ((.flow // "") == "" or (.flow // "") == "xtls-rprx-vision")
                and ((.network // "both") | network)
            elif $protocol == "hysteria2" then
                closed(["up_mbps", "down_mbps", "obfs_type", "obfs_password", "network"])
                and all([.up_mbps?, .down_mbps?][];
                    . == null or (type == "number" and floor == . and . >= 1 and . <= 100000))
                and ((.network // "both") | network)
                and (if has("obfs_type") or has("obfs_password") then
                    .obfs_type == "salamander" and (.obfs_password | secret)
                    else true end)
            elif $protocol == "tuic" then
                closed(["congestion_control", "udp_relay_mode", "heartbeat", "network"])
                and (["cubic", "new_reno", "bbr"] | index($options.congestion_control // "cubic") != null)
                and (["native", "quic"] | index($options.udp_relay_mode // "native") != null)
                and ((.heartbeat // "10s") | test("^[1-9][0-9]{0,3}s$"))
                and ((.network // "both") | network)
            elif $protocol == "shadowsocks2022" then
                closed(["method", "network"])
                and ([
                    "2022-blake3-aes-128-gcm",
                    "2022-blake3-aes-256-gcm",
                    "2022-blake3-chacha20-poly1305"
                ] | index($options.method) != null)
                and ((.network // "both") | network)
            elif $protocol == "trojan" then
                closed(["network"])
                and ((.network // "both") | network)
            elif $protocol == "anytls" then
                closed(["idle_session_check_interval", "idle_session_timeout", "min_idle_session"])
                and ((.idle_session_check_interval // "30s") | test("^[1-9][0-9]{0,3}s$"))
                and ((.idle_session_timeout // "30s") | test("^[1-9][0-9]{0,3}s$"))
                and ((.min_idle_session // 0) | type == "number" and floor == . and . >= 0 and . <= 64)
            elif $protocol == "shadowtls" then
                closed(["version", "network"])
                and .version == 3
                and ((.network // "tcp") == "tcp")
            elif $protocol == "mieru" then
                closed(["transport", "mtu", "multiplexing", "handshake_mode"])
                and (["TCP", "UDP"] | index($options.transport) != null)
                and ((.mtu // 1400) | type == "number" and floor == . and . >= 1280 and . <= 1400)
                and ([
                    "MULTIPLEXING_OFF", "MULTIPLEXING_LOW",
                    "MULTIPLEXING_MIDDLE", "MULTIPLEXING_HIGH"
                ] | index($options.multiplexing // "MULTIPLEXING_LOW") != null)
                and (["HANDSHAKE_STANDARD", "HANDSHAKE_NO_WAIT"]
                    | index($options.handshake_mode // "HANDSHAKE_STANDARD") != null)
            elif $protocol == "naive" then
                closed(["proxy_protocol", "tunnel_timeout", "idle_timeout"])
                and (["https", "quic"] | index($options.proxy_protocol) != null)
                and ((.tunnel_timeout // 1800) | type == "number" and floor == . and . >= 60 and . <= 86400)
                and ((.idle_timeout // 600) | type == "number" and floor == . and . >= 30 and . <= 86400)
                and ((.idle_timeout // 600) <= (.tunnel_timeout // 1800))
            else false end;
        def shadowsocks2022_key_ok($method):
            if $method == "2022-blake3-aes-128-gcm" then
                test("^[A-Za-z0-9+/]{22}==$")
            else
                test("^[A-Za-z0-9+/]{43}=$")
            end;
        def dns_ok:
            . as $dns
            | closed(["strategy", "servers"])
            and (["prefer_ipv4", "prefer_ipv6", "ipv4_only", "ipv6_only"]
                | index($dns.strategy) != null)
            and (.servers | type == "array" and length >= 1 and length <= 3)
            and all(.servers[];
                closed(["server", "server_port", "server_name", "path"])
                and (.server | host)
                and (.server_port | port)
                and (.server_name | host)
                and (.path | type == "string" and length >= 1 and length <= 256
                    and startswith("/") and (test("[?#]") | not))
            );
        def routing_ok:
            closed(["mode", "allow_lan"])
            and .mode == "full-tunnel"
            and (.allow_lan | type == "boolean");
        . as $profile
        | ($profile | closed([
            "schema_version", "profile_id", "display_name", "protocol",
            "endpoint", "credentials", "tls", "options", "dns", "routing"
          ]))
        and $profile.schema_version == 1
        and ($profile.profile_id | type == "string"
            and test("^[a-z][a-z0-9-]{2,63}$"))
        and ($profile.display_name | safe_text(128))
        and (["vless", "hysteria2", "mieru", "naive", "tuic", "shadowsocks2022", "trojan", "anytls", "shadowtls"]
            | index($profile.protocol) != null)
        and ($profile.endpoint | endpoint_ok)
        and ($profile.credentials | credentials_ok($profile.protocol))
        and (if $profile.protocol == "shadowsocks2022" then
                ($profile.credentials.password
                    | shadowsocks2022_key_ok($profile.options.method))
             else true end)
        and ($profile.tls | tls_ok($profile.protocol))
        and ($profile.options | options_ok($profile.protocol))
        and ($profile.dns | dns_ok)
        and ($profile.routing | routing_ok)
    ' <<<"$input" >/dev/null 2>&1; then
        jq -cn '{schema_version: 1, valid: false, reason: "invalid-managed-profile"}'
        return 2
    fi
    display_name="$(jq -r '.display_name' <<<"$input")" || return 1
    safe_profile_metadata "$display_name" || {
        jq -cn '{schema_version: 1, valid: false, reason: "unsafe-display-name"}'
        return 2
    }
    protocol="$(jq -r '.protocol' <<<"$input")" || return 1
    profile_id="$(jq -r '.profile_id' <<<"$input")" || return 1
    render_supported=true
    case "$protocol" in
        mieru|naive|shadowtls) render_supported=false ;;
    esac
    jq -cn --arg protocol "$protocol" --arg profile_id "$profile_id" \
        --argjson render_supported "$render_supported" '
        {
            schema_version: 1,
            valid: true,
            protocol: $protocol,
            profile_id: $profile_id,
            contains_secrets: true,
            import_support: "partial",
            renderer: (if $render_supported then "sing-box-1.13.12" else "planned-sidecar-or-chain" end),
            render_supported: $render_supported,
            connection_enabled: false
        }
    '
}

managed_import_path_has_symlink() {
    local path="$1" current="/" component
    local -a components=()
    [[ "$path" == /* ]] || return 0
    IFS=/ read -r -a components <<<"$path"
    for component in "${components[@]}"; do
        [[ -n "$component" ]] || continue
        current="${current%/}/$component"
        [[ ! -L "$current" ]] || return 0
        [[ -e "$current" ]] || break
    done
    return 1
}

managed_import_secure_directory() {
    local dir="$1" parent owner
    parent="$(dirname -- "$dir")"
    [[ "$dir" == /* && "$parent" != / ]] ||
        die "Недопустимый каталог managed-профилей"
    ! managed_import_path_has_symlink "$parent" ||
        die "Каталог managed-профилей содержит символическую ссылку"
    [[ ! -e "$parent" || -d "$parent" ]] ||
        die "Родительский путь managed-профилей не является каталогом"
    install -d -m 700 -- "$parent" ||
        die "Не удалось создать каталог managed-профилей"
    [[ ! -L "$parent" && -d "$parent" ]] ||
        die "Небезопасный родительский каталог managed-профилей"
    install -d -m 700 -- "$dir" ||
        die "Не удалось создать каталог протокола"
    [[ ! -L "$dir" && -d "$dir" ]] ||
        die "Небезопасный каталог managed-профилей"
    chmod 700 -- "$parent" "$dir" ||
        die "Не удалось закрыть права каталога managed-профилей"
    if ((EUID == 0)) && [[ "${VPNCTL_ALLOW_UNPRIVILEGED:-0}" != 1 ]]; then
        for path in "$parent" "$dir"; do
            owner="$(stat -c '%u' -- "$path")" ||
                die "Не удалось проверить владельца managed-профилей"
            [[ "$owner" == 0 ]] ||
                die "Каталог managed-профилей должен принадлежать root"
        done
    fi
}

cmd_protocols_managed_import() {
    local source="" force=0 force_json=false dry_run=0 json=0 validation protocol profile_id
    local dir target temporary="" lock_file lock_fd would_replace=false
    local -a original=("$@")
    while (($#)); do
        case "$1" in
            --force) force=1; force_json=true ;;
            --dry-run) dry_run=1 ;;
            --json) json=1 ;;
            --help|-h)
                say "Использование: $CLI_COMMAND protocols managed-import ФАЙЛ [--dry-run] [--force] --json"
                return 0
                ;;
            -*) die "Неизвестный параметр managed-import: $1" ;;
            *)
                [[ -z "$source" ]] || die "Укажите только один managed-профиль"
                source="$1"
                ;;
        esac
        shift
    done
    [[ -n "$source" && "$json" -eq 1 ]] ||
        die "Использование: $CLI_COMMAND protocols managed-import ФАЙЛ [--dry-run] [--force] --json"
    [[ -f "$source" && ! -L "$source" && -r "$source" ]] ||
        die "Managed-профиль должен быть читаемым обычным файлом без symlink"
    validation="$(cmd_protocols_managed_validate <"$source")" ||
        die "Managed-профиль не прошёл проверку закрытой схемы"
    protocol="$(jq -r '.protocol' <<<"$validation")" || return 1
    profile_id="$(jq -r '.profile_id' <<<"$validation")" || return 1
    dir="$(import_target_dir "$protocol")"
    [[ "$dir" == /* ]] || die "Каталог managed-профилей должен быть абсолютным"
    target="$dir/$profile_id.json"
    if [[ -e "$target" || -L "$target" ]]; then
        would_replace=true
    fi
    if ((dry_run)); then
        jq -cn --arg protocol "$protocol" --arg profile_id "$profile_id" \
            --argjson would_replace "$would_replace" --argjson force "$force_json" '
            {
                schema_version: 1,
                valid: true,
                dry_run: true,
                imported: false,
                protocol: $protocol,
                profile_id: $profile_id,
                would_replace: $would_replace,
                force: $force,
                contains_secrets: true,
                connection_enabled: false
            }
        '
        return
    fi

    require_root protocols managed-import "${original[@]}"
    acquire_action_lock
    command -v flock >/dev/null 2>&1 || die "flock не найден"
    managed_import_secure_directory "$dir"
    umask 077
    lock_file="$dir/.managed-import.lock"
    exec {lock_fd}>"$lock_file" || die "Не удалось открыть блокировку импорта"
    chmod 600 -- "$lock_file" || die "Не удалось закрыть права блокировки импорта"
    flock -x "$lock_fd" || die "Не удалось заблокировать импорт managed-профиля"

    temporary="$(mktemp "$dir/.${profile_id}.import.XXXXXX")" ||
        die "Не удалось создать временный managed-профиль"
    if ! install -m 600 -- "$source" "$temporary"; then
        rm -f -- "$temporary"
        die "Не удалось подготовить managed-профиль"
    fi
    validation="$(cmd_protocols_managed_validate <"$temporary")" || {
        rm -f -- "$temporary"
        die "Managed-профиль изменился или не прошёл повторную проверку"
    }
    [[ "$(jq -r '.protocol' <<<"$validation")" == "$protocol" &&
       "$(jq -r '.profile_id' <<<"$validation")" == "$profile_id" ]] || {
        rm -f -- "$temporary"
        die "Идентификатор managed-профиля изменился во время импорта"
    }
    if [[ -e "$target" || -L "$target" ]]; then
        if ((force == 0)); then
            rm -f -- "$temporary"
            die "Managed-профиль уже существует; для замены добавьте --force"
        fi
        [[ -f "$target" && ! -L "$target" ]] || {
            rm -f -- "$temporary"
            die "Существующая цель managed-профиля не является обычным файлом"
        }
    fi
    if ((force)); then
        mv -fT -- "$temporary" "$target" || {
            rm -f -- "$temporary"
            die "Не удалось атомарно заменить managed-профиль"
        }
    else
        ln -- "$temporary" "$target" || {
            rm -f -- "$temporary"
            die "Managed-профиль уже существует или не может быть создан"
        }
        rm -f -- "$temporary"
    fi
    chmod 600 -- "$target" || die "Не удалось закрыть права managed-профиля"
    jq -cn --arg protocol "$protocol" --arg profile_id "$profile_id" \
        --argjson replaced "$would_replace" '
        {
            schema_version: 1,
            imported: true,
            protocol: $protocol,
            profile_id: $profile_id,
            replaced: $replaced,
            contains_secrets: true,
            connection_enabled: false
        }
    '
}

cmd_protocols() {
    case "${1:-}" in
        list)
            [[ $# -eq 2 && "${2:-}" == --json ]] ||
                die "Использование: $CLI_COMMAND protocols list --json"
            cmd_protocols_list
            ;;
        diagnose)
            [[ $# -eq 2 && "${2:-}" == --json ]] ||
                die "Использование: $CLI_COMMAND protocols diagnose --json"
            cmd_protocols_diagnose
            ;;
        adapters)
            [[ $# -eq 2 && "${2:-}" == --json ]] ||
                die "Использование: $CLI_COMMAND protocols adapters --json"
            cmd_protocols_adapters
            ;;
        detect)
            [[ $# -eq 3 && "${2:-}" == --stdin && "${3:-}" == --json ]] ||
                die "Использование: $CLI_COMMAND protocols detect --stdin --json"
            cmd_protocols_detect
            ;;
        managed-validate)
            [[ $# -eq 3 && "${2:-}" == --stdin && "${3:-}" == --json ]] ||
                die "Использование: $CLI_COMMAND protocols managed-validate --stdin --json"
            cmd_protocols_managed_validate
            ;;
        managed-import)
            shift
            cmd_protocols_managed_import "$@"
            ;;
        *)
            die "Использование: $CLI_COMMAND protocols list|diagnose|adapters|detect|managed-validate|managed-import"
            ;;
    esac
}

cmd_agent_transports_list() {
    local registry
    registry="$(agent_control_registry_path)" ||
        die "Agent-control registry не найден; переустановите $PRODUCT_NAME"
    command cat -- "$registry" ||
        die "Не удалось прочитать agent-control registry"
}

cmd_agent_transports_diagnose() {
    local registry runtime available_json='{}'
    registry="$(agent_control_registry_path)" ||
        die "Agent-control registry не найден; переустановите $PRODUCT_NAME"
    while IFS= read -r runtime; do
        if command -v "$runtime" >/dev/null 2>&1; then
            available_json="$(jq -c --arg runtime "$runtime" \
                '. + {($runtime): true}' <<<"$available_json")" || return 1
        else
            available_json="$(jq -c --arg runtime "$runtime" \
                '. + {($runtime): false}' <<<"$available_json")" || return 1
        fi
    done < <(jq -r '[.transports[].runtime_probes[]] | unique[]' "$registry")
    jq -c --arg generated_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        --argjson available "$available_json" '
        {
            schema_version: 1,
            generated_at: $generated_at,
            layer,
            runtimes: ([
                .transports[].runtime_probes[]
            ] | unique | map({id: ., available: ($available[.] // false)})),
            transports: [
                .transports[] |
                {
                    id,
                    display_name,
                    family,
                    implementation_mode,
                    paths,
                    support,
                    contract_ready: (.support.contract == "implemented"),
                    candidate_runtime_available: any(
                        .runtime_probes[]; $available[.] // false
                    ),
                    runtime_ready: (
                        .support.linux == "implemented"
                        and (.runtime_probes | length) > 0
                        and all(.runtime_probes[]; $available[.] // false)
                    )
                }
            ],
            ingress_channels
        }
    ' "$registry"
}

cmd_agent_transports() {
    case "${1:-}" in
        list)
            [[ $# -eq 2 && "${2:-}" == --json ]] ||
                die "Использование: $CLI_COMMAND agent-transports list --json"
            cmd_agent_transports_list
            ;;
        diagnose)
            [[ $# -eq 2 && "${2:-}" == --json ]] ||
                die "Использование: $CLI_COMMAND agent-transports diagnose --json"
            cmd_agent_transports_diagnose
            ;;
        *)
            die "Использование: $CLI_COMMAND agent-transports list|diagnose --json"
            ;;
    esac
}

cmd_planner_evaluate() {
    local encoded byte_count payload response
    local API_CLIENT_MAX_RESPONSE_BYTES=1048576
    [[ $# -eq 2 && "${1:-}" == --stdin && "${2:-}" == --json ]] ||
        die "Использование: $CLI_COMMAND planner evaluate --stdin --json"
    encoded="$(LC_ALL=C head -c 65537 | base64)" || return 1
    byte_count="$(printf '%s' "$encoded" | base64 -d | wc -c)" || return 1
    if ((byte_count == 0 || byte_count > 65536)) ||
       ! printf '%s' "$encoded" | base64 -d | jq -s -e '
            length == 1 and (.[0] | type == "object")
        ' >/dev/null 2>&1; then
        error "Planner payload должен быть одним JSON object размером до 64 КиБ"
        return 2
    fi
    payload="$(printf '%s' "$encoded" | base64 -d)" || return 1
    command -v awk >/dev/null 2>&1 || {
        error "Planner payload parser: awk не найден"
        return 70
    }
    api_request_has_unique_schema_keys "$payload" || {
        error "Planner payload содержит повторяющийся JSON key"
        return 2
    }
    api_client_ready || {
        error "Local API planner недоступен"
        return 70
    }
    response="$(api_client_query_payload planner.evaluate "$payload" 30000)" || {
        error "Local API planner недоступен"
        return 70
    }
    if [[ "$(jq -r '.status' <<<"$response")" != ok ]]; then
        jq . <<<"$response" >&2
        return 1
    fi
    jq .result <<<"$response"
}

cmd_planner() {
    case "${1:-}" in
        evaluate)
            shift
            cmd_planner_evaluate "$@"
            ;;
        *)
            die "Использование: $CLI_COMMAND planner evaluate --stdin --json"
            ;;
    esac
}

