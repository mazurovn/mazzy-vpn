api_secure_backend_directory() {
    local directory="$1" mode owner expected_owner
    [[ -d "$directory" && ! -L "$directory" ]] || return 1
    mode="$(stat -c '%a' "$directory" 2>/dev/null)" || return 1
    owner="$(stat -c '%u' "$directory" 2>/dev/null)" || return 1
    [[ "$mode" =~ ^[0-7]{3,4}$ ]] || return 1
    (((8#$mode & 8#022) == 0)) || return 1
    if ((EUID == 0)); then
        expected_owner=0
    else
        expected_owner="$(id -u)"
    fi
    [[ "$owner" == "$expected_owner" ]]
}

api_rollback_storage_ready() {
    api_secure_backend_directory "$STATE_DIR" || return 1
    if [[ -d "$API_ACTION_DIR" ]]; then
        api_secure_backend_directory "$API_ACTION_DIR"
    else
        [[ ! -e "$API_ACTION_DIR" && ! -L "$API_ACTION_DIR" && -w "$STATE_DIR" ]]
    fi
}

api_profile_runtime_path() {
    local protocol="$1" file_name="$2" directory
    safe_profile_basename "$file_name" >/dev/null || return 1
    directory="$(protocol_dir "$protocol")" || return 1
    [[ -n "$directory" ]] || return 1
    printf '%s/%s\n' "$directory" "$file_name"
}

api_planner_candidate_result() {
    local candidate="$1" registry="$2" weights="$3" rollback_storage_ready="$4"
    local deadline_end_ms="$5" workload="$6" validation_rc=0
    local profile_id profile_record="" protocol="" file_name="" profile_path=""
    local support="" kind="" censorship_resistance="" active_probe_resistance=""
    local transports='[]'
    local backend_ready=false profile_valid=false secrets_secure=false
    local platform_supported=false result

    profile_id="$(jq -r '.profile_id' <<<"$candidate")" || return 1
    profile_record="$(
        jq -er --arg profile_id "$profile_id" '
            (.profiles // [])
            | map(select(.profile_id == $profile_id))
            | select(length == 1)
            | .[0]
            | select(
                (.protocol | type == "string" and length > 0)
                and (.file_name | type == "string" and length > 0)
            )
            | [.protocol, .file_name]
            | @tsv
        ' "$PROFILES_FILE" 2>/dev/null || true
    )"
    if [[ -n "$profile_record" ]]; then
        IFS=$'\t' read -r protocol file_name <<<"$profile_record"
    fi
    if [[ -n "$protocol" ]]; then
        support="$(jq -r --arg protocol "$protocol" '
            first(.protocols[] | select(.id == $protocol) | .support.linux) // ""
        ' "$registry")" || return 1
        kind="$(jq -r --arg protocol "$protocol" '
            first(.protocols[] | select(.id == $protocol) | .kind) // ""
        ' "$registry")" || return 1
        censorship_resistance="$(jq -r --arg protocol "$protocol" '
            first(.protocols[] | select(.id == $protocol) | .censorship_resistance) // ""
        ' "$registry")" || return 1
        active_probe_resistance="$(jq -r --arg protocol "$protocol" '
            first(.protocols[] | select(.id == $protocol) | .active_probe_resistance) // ""
        ' "$registry")" || return 1
        transports="$(jq -c --arg protocol "$protocol" '
            first(.protocols[] | select(.id == $protocol) | .transports) // []
        ' "$registry")" || return 1
        [[ "$support" == implemented ]] && platform_supported=true
        if [[ "$platform_supported" == true ]] &&
           protocol_runtime_available "$protocol"; then
            backend_ready=true
        fi
    fi
    if [[ -n "$protocol" && -n "$file_name" ]]; then
        profile_path="$(api_profile_runtime_path "$protocol" "$file_name" || true)"
    fi
    if [[ -n "$profile_path" && -f "$profile_path" && ! -L "$profile_path" ]]; then
        validate_profile "$protocol" "$profile_path" 1 "$deadline_end_ms" \
            >/dev/null 2>&1 || validation_rc=$?
        if ((validation_rc == 124)); then
            return 124
        elif ((validation_rc == 0)); then
            profile_valid=true
        fi
        validate_permissions "$profile_path" && secrets_secure=true
    fi

    result="$(
        jq -cn \
            --arg profile_id "$profile_id" \
            --arg protocol "$protocol" \
            --argjson evidence "$(jq -c '.evidence' <<<"$candidate")" \
            --argjson weights "$weights" \
            --arg workload "$workload" \
            --arg kind "$kind" \
            --arg censorship_resistance "$censorship_resistance" \
            --arg active_probe_resistance "$active_probe_resistance" \
            --argjson transports "$transports" \
            --argjson backend_ready "$backend_ready" \
            --argjson profile_valid "$profile_valid" \
            --argjson secrets_secure "$secrets_secure" \
            --argjson rollback_storage_ready "$rollback_storage_ready" \
            --argjson platform_supported "$platform_supported" '
            def fit_points($weight; $fit):
                if $fit == "high" then $weight
                elif $fit == "medium" then (($weight * 68 / 100) | floor)
                elif $fit == "low" then (($weight * 32 / 100) | floor)
                else 0
                end;
            def censorship_level($resistance; $active_probe):
                if $resistance == "high"
                    and ($active_probe == "high" or $active_probe == "medium")
                then "high"
                elif $resistance == "high" or $resistance == "medium"
                then "medium"
                elif $resistance == "low" then "low"
                else "unknown"
                end;
            def workload_level($workload; $kind; $transports):
                if $workload == "general" then "medium"
                elif $workload == "split-routing"
                then (if $kind == "vpn" then "high" else "medium" end)
                elif $workload == "video"
                then (
                    if any($transports[]; . == "udp" or . == "quic" or . == "http3")
                    then "high"
                    elif any($transports[]; . == "tcp" or . == "tls" or . == "http2")
                    then "medium"
                    else "low"
                    end
                )
                elif $workload == "llm-streaming" or $workload == "api-calls"
                then (
                    if any($transports[]; . == "tcp" or . == "tls"
                        or . == "http2" or . == "http3")
                    then "high"
                    elif any($transports[]; . == "udp" or . == "quic")
                    then "medium"
                    else "low"
                    end
                )
                else "unknown"
                end;
            def recent_points($weight; $evidence):
                if $evidence.evidence_age_seconds > 900 then 0
                else
                    (
                        if $evidence.recent_outcome == "success" then $weight
                        elif $evidence.recent_outcome == "unknown"
                        then (($weight / 3) | floor)
                        else 0
                        end
                    ) as $base
                    | ([
                        $base - (($weight * $evidence.consecutive_failures / 6) | floor),
                        0
                    ] | max)
                end;
            def latency_loss_points($weight; $evidence):
                if $evidence.evidence_age_seconds > 900
                    or $evidence.reachability != "reachable"
                    or $evidence.latency_ms == null
                then 0
                else
                    (
                        if $evidence.latency_ms <= 100 then 10
                        elif $evidence.latency_ms <= 250 then 8
                        elif $evidence.latency_ms <= 500 then 5
                        elif $evidence.latency_ms <= 1000 then 2
                        else 0
                        end
                    ) as $latency
                    | (
                        if $evidence.loss_percent == 0 then 5
                        elif $evidence.loss_percent <= 1 then 4
                        elif $evidence.loss_percent <= 5 then 3
                        elif $evidence.loss_percent <= 10 then 1
                        else 0
                        end
                    ) as $loss
                    | (($weight * ($latency + $loss) / 15) | floor)
                end;
            censorship_level(
                $censorship_resistance;
                $active_probe_resistance
            ) as $censorship_level
            | workload_level($workload; $kind; $transports) as $workload_level
            | [
                {
                    id: "backend-ready",
                    passed: $backend_ready,
                    reason_code: (
                        if $backend_ready then "planner.gate.backend-ready"
                        else "planner.gate.backend-unavailable" end
                    )
                },
                {
                    id: "profile-valid",
                    passed: $profile_valid,
                    reason_code: (
                        if $profile_valid then "planner.gate.profile-valid"
                        else "planner.gate.profile-invalid" end
                    )
                },
                {
                    id: "secrets-readable-only-by-backend",
                    passed: $secrets_secure,
                    reason_code: (
                        if $secrets_secure then "planner.gate.backend-only-storage"
                        else "planner.gate.storage-unsafe" end
                    )
                },
                {
                    id: "rollback-storage-ready",
                    passed: $rollback_storage_ready,
                    reason_code: (
                        if $rollback_storage_ready
                        then "planner.gate.rollback-storage-ready"
                        else "planner.gate.rollback-storage-unavailable" end
                    )
                },
                {
                    id: "platform-supported",
                    passed: $platform_supported,
                    reason_code: (
                        if $platform_supported then "planner.gate.platform-supported"
                        else "planner.gate.platform-unsupported" end
                    )
                }
            ] as $gates
            | [
                {
                    id: "recent-success",
                    points: recent_points($weights["recent-success"]; $evidence),
                    max_points: $weights["recent-success"],
                    reason_code: (
                        if $evidence.evidence_age_seconds > 900
                        then "planner.factor.recent-stale"
                        else "planner.factor.recent-" + $evidence.recent_outcome
                        end
                    )
                },
                {
                    id: "censorship-fit",
                    points: fit_points(
                        $weights["censorship-fit"];
                        $censorship_level
                    ),
                    max_points: $weights["censorship-fit"],
                    reason_code: (
                        "planner.factor.censorship-catalog-" + $censorship_level
                    )
                },
                {
                    id: "reachability",
                    points: (
                        if $evidence.evidence_age_seconds > 900 then 0
                        elif $evidence.reachability == "reachable"
                        then $weights.reachability
                        elif $evidence.reachability == "unknown"
                        then (($weights.reachability / 4) | floor)
                        else 0
                        end
                    ),
                    max_points: $weights.reachability,
                    reason_code: (
                        if $evidence.evidence_age_seconds > 900
                        then "planner.factor.reachability-stale"
                        else "planner.factor.reachability-" + $evidence.reachability
                        end
                    )
                },
                {
                    id: "latency-loss",
                    points: latency_loss_points(
                        $weights["latency-loss"];
                        $evidence
                    ),
                    max_points: $weights["latency-loss"],
                    reason_code: (
                        if $evidence.evidence_age_seconds > 900
                        then "planner.factor.latency-loss-stale"
                        elif $evidence.reachability != "reachable"
                            or $evidence.latency_ms == null
                        then "planner.factor.latency-loss-unavailable"
                        else "planner.factor.latency-loss-measured"
                        end
                    )
                },
                {
                    id: "workload-fit",
                    points: fit_points(
                        $weights["workload-fit"];
                        $workload_level
                    ),
                    max_points: $weights["workload-fit"],
                    reason_code: (
                        "planner.factor.workload-derived-" + $workload_level
                    )
                }
            ] as $factors
            | ($gates | all(.passed)) as $eligible
            | {
                profile_id: $profile_id,
                eligible: $eligible,
                score: (
                    if $eligible then ($factors | map(.points) | add)
                    else null
                    end
                ),
                hard_gates: $gates,
                factors: $factors,
                reason_codes: (
                    (
                        [$gates[] | select(.passed | not) | .reason_code]
                        + [$factors[].reason_code]
                    ) | unique
                )
            }
            + if $protocol == "" then {} else {protocol: $protocol} end
        '
    )" || return 1
    printf '%s\n' "$result"
}

api_planner_result() {
    local request="$1" deadline_ms="$2" deadline_started_ms="$3"
    local registry weights rollback_storage_ready=false remaining_ms deadline_end_ms
    local candidate result candidates ranked workload rc=0
    local -a candidate_results=()
    registry="$(protocol_registry_path)" || return 1
    weights="$(jq -c '
        .orchestration.score_factors
        | map({key: .id, value: .weight})
        | from_entries
    ' "$registry")" || return 1
    workload="$(jq -r '.payload.workload' <<<"$request")" || return 1
    deadline_end_ms=$((deadline_started_ms + deadline_ms))
    remaining_ms="$(api_deadline_remaining_ms "$deadline_end_ms")" || return 1
    ((remaining_ms > 0)) || return 124
    api_refresh_dashboard_bounded "$remaining_ms" || true
    [[ -r "$PROFILES_FILE" ]] || return 1
    api_rollback_storage_ready && rollback_storage_ready=true

    while IFS= read -r candidate; do
        remaining_ms="$(api_deadline_remaining_ms "$deadline_end_ms")" || return 1
        ((remaining_ms > 0)) || return 124
        result="$(api_planner_candidate_result \
            "$candidate" "$registry" "$weights" "$rollback_storage_ready" \
            "$deadline_end_ms" "$workload")"
        rc=$?
        ((rc == 0)) || return "$rc"
        candidate_results+=("$result")
    done < <(jq -c '.payload.candidates[]' <<<"$request")

    remaining_ms="$(api_deadline_remaining_ms "$deadline_end_ms")" || return 1
    ((remaining_ms > 0)) || return 124

    candidates="$(printf '%s\n' "${candidate_results[@]}" | jq -sc '.')" ||
        return 1

    ranked="$(jq -c '
        sort_by(
            if .eligible
            then [0, -(.score), .profile_id]
            else [1, 0, .profile_id]
            end
        )
        | reduce .[] as $candidate (
            {next_rank: 1, candidates: []};
            if $candidate.eligible then
                .next_rank as $rank
                | .candidates += [$candidate + {rank: $rank}]
                | .next_rank += 1
            else
                .candidates += [$candidate + {rank: null}]
            end
        )
        | .candidates
    ' <<<"$candidates")" || return 1
    remaining_ms="$(api_deadline_remaining_ms "$deadline_end_ms")" || return 1
    ((remaining_ms > 0)) || return 124
    jq -c \
        --arg catalog_version "$(jq -r '.catalog_version' "$registry")" \
        --argjson policy_version "$(jq '.orchestration.policy_version' "$registry")" \
        --arg evaluated_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        --arg workload "$(jq -r '.payload.workload' <<<"$request")" '
        . as $candidates
        |
        {
            schema_version: 1,
            policy_version: $policy_version,
            catalog_version: $catalog_version,
            evaluated_at: $evaluated_at,
            dry_run: true,
            workload: $workload,
            ordered_profile_ids: [
                $candidates[] | select(.eligible) | .profile_id
            ],
            candidates: $candidates
        }
    ' <<<"$ranked"
}

api_probe_result() {
    local request="$1" deadline_ms="$2"
    local timeout_seconds concurrency protocol profile_id duration result result_file rc=0
    mkdir -p -- "$API_ACTION_DIR" || return 1
    chmod 700 -- "$API_ACTION_DIR" || return 1
    {
        flock -n 10 || return 75
        timeout_seconds="$(jq -r '.payload.timeout_seconds' <<<"$request")"
        concurrency="$(jq -r '.payload.concurrency // 4' <<<"$request")"
        protocol="$(jq -r '.payload.protocol // "all"' <<<"$request")"
        profile_id="$(jq -r '.payload.profile_id // ""' <<<"$request")"
        duration="$(api_timeout_seconds_from_ms "$deadline_ms")" || return 1

        result_file="$(mktemp "${API_ACTION_DIR}/.probe-result.XXXXXX")" || return 1
        VPNCTL_API_CLIENT_DISABLE=1 \
            timeout --kill-after=2s "${duration}s" \
                "$SELF" _probe-locations-json \
                "$protocol" "$timeout_seconds" "$concurrency" "$profile_id" \
                >"$result_file" 10>&- || rc=$?
        case "$rc" in
            0) ;;
            124|137) rm -f -- "$result_file"; return 124 ;;
            *) rm -f -- "$result_file"; return 1 ;;
        esac
        result="$(<"$result_file")"
        rm -f -- "$result_file"
        jq -e '
            .schema_version == 1
            and (.checked_at | type == "string")
            and (.summary.total | type == "number")
            and (.results | type == "array")
            and all(
                .results[];
                (.profile_id | type == "string")
                and (.display_name | type == "string")
                and (.protocol | type == "string")
                and (.active | type == "boolean")
                and (
                    .reachability == "reachable"
                    or .reachability == "unknown"
                    or .reachability == "unreachable"
                    or .reachability == "invalid"
                )
                and (
                    .latency_ms == null
                    or (
                        (.latency_ms | type == "number")
                        and .latency_ms >= 0
                        and (.latency_ms | floor) == .latency_ms
                    )
                )
            )
        ' <<<"$result" >/dev/null 2>&1 || return 1
        if [[ -n "$profile_id" ]] &&
           [[ "$(jq -r '.summary.total' <<<"$result")" -eq 0 ]]; then
            return 3
        fi
        printf '%s\n' "$result"
    } 10>"$API_ACTION_DIR/.probe.lock"
}

api_verify_result() {
    local request="$1" deadline_ms="$2"
    local timeout_seconds include_speed duration result result_file rc=0
    mkdir -p -- "$API_ACTION_DIR" || return 1
    chmod 700 -- "$API_ACTION_DIR" || return 1
    {
        flock -n 10 || return 75
        timeout_seconds="$(jq -r '.payload.timeout_seconds' <<<"$request")"
        include_speed="$(jq -r '.payload.include_speed // false' <<<"$request")"
        duration="$(api_timeout_seconds_from_ms "$deadline_ms")" || return 1

        result_file="$(mktemp "${API_ACTION_DIR}/.verify-result.XXXXXX")" || return 1
        VPNCTL_API_CLIENT_DISABLE=1 \
            timeout --kill-after=2s "${duration}s" \
                "$SELF" _verify-egress-json "$timeout_seconds" "$include_speed" \
                >"$result_file" 10>&- || rc=$?
        case "$rc" in
            0) ;;
            124|137) rm -f -- "$result_file"; return 124 ;;
            *) rm -f -- "$result_file"; return 1 ;;
        esac
        result="$(<"$result_file")"
        rm -f -- "$result_file"
        jq -e '
            .schema_version == 1
            and (.checked_at | type == "string")
            and (
                .verdict == "verified"
                or .verdict == "warning"
                or .verdict == "failed"
            )
            and (.tunnel.active | type == "boolean")
            and (.ipv4.same_egress | type == "boolean")
            and (.ipv6.potential_leak | type == "boolean")
            and (
                .geo.country_match == "match"
                or .geo.country_match == "mismatch"
                or .geo.country_match == "unknown"
            )
            and (.geo.providers | type == "array")
            and (.speed.requested | type == "boolean")
            and (.speed.measured | type == "boolean")
            and (.findings | type == "array")
            and all(.findings[]; type == "string")
        ' <<<"$result" >/dev/null 2>&1 || return 1
        printf '%s\n' "$result"
    } 10>"$API_ACTION_DIR/.verify.lock"
}

api_service_verify_result() {
    local request="$1" deadline_ms="$2"
    local service timeout_seconds duration result result_file rc=0
    mkdir -p -- "$API_ACTION_DIR" || return 1
    chmod 700 -- "$API_ACTION_DIR" || return 1
    {
        flock -n 10 || return 75
        service="$(jq -r '.payload.service' <<<"$request")"
        timeout_seconds="$(jq -r '.payload.timeout_seconds' <<<"$request")"
        duration="$(api_timeout_seconds_from_ms "$deadline_ms")" || return 1

        result_file="$(mktemp "${API_ACTION_DIR}/.service-verify-result.XXXXXX")" ||
            return 1
        VPNCTL_API_CLIENT_DISABLE=1 \
            timeout --kill-after=2s "${duration}s" \
                "$SELF" _verify-service-egress-json "$service" "$timeout_seconds" \
                >"$result_file" 10>&- || rc=$?
        case "$rc" in
            0) ;;
            124|137) rm -f -- "$result_file"; return 124 ;;
            *) rm -f -- "$result_file"; return 1 ;;
        esac
        result="$(<"$result_file")"
        rm -f -- "$result_file"
        jq -e --arg service "$service" '
            .schema_version == 1
            and (.checked_at | type == "string")
            and .scope == "unauthenticated-egress"
            and ((keys | sort) == ["checked_at", "results", "schema_version", "scope"])
            and (.results | type == "array")
            and (.results | length) >= 1
            and (.results | length) <= 2
            and ((.results | map(.service_id) | unique | length) == (.results | length))
            and (
                if $service == "all" then
                    (.results | map(.service_id) | sort) == ["notebooklm", "openai"]
                else
                    (.results | length) == 1 and .results[0].service_id == $service
                end
            )
            and all(
                .results[];
                ((keys | sort) == [
                    "egress_eligibility", "http_status", "probe_version",
                    "reachability", "reason_code", "service_id"
                ])
                and (.service_id == "notebooklm" or .service_id == "openai")
                and .probe_version == 1
                and (.reachability == "reachable" or .reachability == "unreachable")
                and (
                    .egress_eligibility == "eligible"
                    or .egress_eligibility == "ineligible"
                    or .egress_eligibility == "indeterminate"
                )
                and (
                    .http_status == null
                    or (
                        (.http_status | type == "number")
                        and (.http_status | floor) == .http_status
                        and .http_status >= 100
                        and .http_status <= 599
                    )
                )
                and (
                    if .reason_code == "service.notebooklm.unsupported-location" then
                        .service_id == "notebooklm"
                        and .reachability == "reachable"
                        and .egress_eligibility == "ineligible"
                        and (
                            .http_status == 301 or .http_status == 302
                            or .http_status == 303 or .http_status == 307
                            or .http_status == 308
                        )
                    elif .reason_code == "service.notebooklm.home-reached" then
                        .service_id == "notebooklm"
                        and .reachability == "reachable"
                        and .egress_eligibility == "eligible"
                        and (
                            .http_status == 301 or .http_status == 302
                            or .http_status == 303 or .http_status == 307
                            or .http_status == 308
                        )
                    elif .reason_code == "service.notebooklm.unrecognized-response" then
                        .service_id == "notebooklm"
                        and .reachability == "reachable"
                        and .egress_eligibility == "indeterminate"
                    elif .reason_code == "service.openai.auth-boundary-reached" then
                        .service_id == "openai"
                        and .reachability == "reachable"
                        and .egress_eligibility == "eligible"
                        and (.http_status == 401 or .http_status == 405)
                    elif .reason_code == "service.openai.edge-denied" then
                        .service_id == "openai"
                        and .reachability == "reachable"
                        and .egress_eligibility == "ineligible"
                        and .http_status == 403
                    elif .reason_code == "service.openai.rate-limited" then
                        .service_id == "openai"
                        and .reachability == "reachable"
                        and .egress_eligibility == "indeterminate"
                        and .http_status == 429
                    elif .reason_code == "service.openai.service-unavailable" then
                        .service_id == "openai"
                        and .reachability == "reachable"
                        and .egress_eligibility == "indeterminate"
                        and .http_status >= 500 and .http_status <= 599
                    elif .reason_code == "service.openai.unrecognized-response" then
                        .service_id == "openai"
                        and .reachability == "reachable"
                        and .egress_eligibility == "indeterminate"
                    elif .reason_code == "service.network-unreachable" then
                        .reachability == "unreachable"
                        and .egress_eligibility == "indeterminate"
                        and .http_status == null
                    elif (
                        .reason_code == "service.response-invalid"
                        or .reason_code == "service.response-too-large"
                    ) then
                        .reachability == "reachable"
                        and .egress_eligibility == "indeterminate"
                        and .http_status == null
                    else false
                    end
                )
            )
        ' <<<"$result" >/dev/null 2>&1 || return 1
        printf '%s\n' "$result"
    } 10>"$API_ACTION_DIR/.verify-service.lock"
}

api_sync_file_and_parent() {
    local path="$1" parent
    parent="$(dirname -- "$path")" || return 1
    sync -f "$path" || return 1
    sync -f "$parent"
}

api_sync_parent() {
    sync -f "$(dirname -- "$1")"
}

api_write_record() {
    local target="$1" content="$2" tmp
    mkdir -p -- "$API_ACTION_DIR" || return 1
    chmod 700 -- "$API_ACTION_DIR" || return 1
    tmp="$(mktemp "$API_ACTION_DIR/.record.XXXXXX")" || return 1
    umask 077
    printf '%s\n' "$content" >"$tmp" || {
        rm -f -- "$tmp"
        return 1
    }
    chmod 600 -- "$tmp" || {
        rm -f -- "$tmp"
        return 1
    }
    mv -f -- "$tmp" "$target" || return 1
    api_sync_file_and_parent "$target"
}

api_mark_recovery_required() {
    local action_id="$1" operation="$2" reason="$3" marker tmp="" content
    local old_umask rc=0
    marker="$API_RECOVERY_MARKER"
    mkdir -p -- "$STATE_DIR" || return 1
    chmod 700 -- "$STATE_DIR" || return 1
    content="$(
        jq -cn \
            --arg action_id "$action_id" \
            --arg operation "$operation" \
            --arg reason "$reason" \
            --arg created_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
            '{
                state: "recovery-required",
                action_id: $action_id,
                operation: $operation,
                reason: $reason,
                created_at: $created_at
            }'
    )" || return 1
    old_umask="$(umask)" || return 1
    umask 077
    tmp="$(mktemp "$STATE_DIR/.api-recovery.XXXXXX")" || rc=1
    ((rc != 0)) || printf '%s\n' "$content" >"$tmp" || rc=1
    ((rc != 0)) || chmod 600 -- "$tmp" || rc=1
    ((rc != 0)) || mv -f -- "$tmp" "$marker" || rc=1
    ((rc != 0)) || chmod 600 -- "$marker" || rc=1
    ((rc != 0)) || api_sync_file_and_parent "$marker" || rc=1
    if ((rc != 0)) && [[ -n "$tmp" && -e "$tmp" ]]; then
        rm -f -- "$tmp" || true
    fi
    umask "$old_umask" || return 1
    return "$rc"
}

api_mark_boot_recovery_unavailable() {
    local reason="$1"
    api_mark_recovery_required \
        boot-recovery api.interrupted-recovery "$reason"
}

api_prune_completed_actions() {
    local preserve_action_id="${1:-}" record base action_id state completed_at
    local max_records remove_count entry
    local -a completed=() sorted=()
    max_records="$API_ACTION_MAX_RECORDS"
    [[ "$max_records" =~ ^[1-9][0-9]*$ ]] &&
        ((max_records <= 4096)) || max_records=512

    shopt -s nullglob
    for record in "$API_ACTION_DIR"/*.json; do
        base="$(basename -- "$record")"
        action_id="${base%.json}"
        api_valid_identifier "$action_id" || continue
        [[ "$action_id" != "$preserve_action_id" ]] || continue
        state="$(jq -r '.state // ""' "$record" 2>/dev/null || true)"
        [[ "$state" == "completed" ]] || continue
        completed_at="$(jq -r '.completed_at // ""' "$record" 2>/dev/null || true)"
        [[ "$completed_at" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T ]] ||
            completed_at="0000-00-00T00:00:00Z"
        completed+=("$completed_at|$base")
    done
    shopt -u nullglob

    remove_count=$((${#completed[@]} - max_records + 1))
    ((remove_count > 0)) || return 0
    mapfile -t sorted < <(printf '%s\n' "${completed[@]}" | sort)
    for entry in "${sorted[@]:0:remove_count}"; do
        base="${entry#*|}"
        rm -f -- "$API_ACTION_DIR/$base"
    done
}

api_cleanup_action_temps() {
    local path
    shopt -s nullglob
    for path in \
        "$API_ACTION_DIR"/.output.* \
        "$API_ACTION_DIR"/.record.* \
        "$API_ACTION_DIR"/.snapshot.*; do
        rm -f -- "$path"
    done
    shopt -u nullglob
}

api_rotate_audit_if_needed() {
    local max_bytes current_bytes=0 archive
    max_bytes="$API_AUDIT_MAX_BYTES"
    [[ "$max_bytes" =~ ^[1-9][0-9]*$ ]] &&
        ((max_bytes <= 67108864)) || max_bytes=2097152
    [[ -e "$API_AUDIT_FILE" ]] || return 0
    current_bytes="$(stat -c %s -- "$API_AUDIT_FILE" 2>/dev/null || printf 0)"
    [[ "$current_bytes" =~ ^[0-9]+$ ]] || current_bytes=0
    ((current_bytes < max_bytes)) || {
        archive="$API_AUDIT_FILE.1"
        mv -f -- "$API_AUDIT_FILE" "$archive" || return 1
        chmod 600 -- "$archive" || return 1
    }
}

api_audit_event() {
    local action_id="$1" operation="$2" decision="$3" outcome="$4"
    local event event_id sequence generated_at
    mkdir -p -- "$STATE_DIR" || return 1
    chmod 700 -- "$STATE_DIR" || return 1
    generated_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    event_id="$(
        printf '%s\000%s\000%s\000%s\000%s' \
            "$action_id" "$operation" "$outcome" "$generated_at" "$$" |
            sha256sum |
            awk '{ print "audit-" substr($1, 1, 32) }'
    )"
    sequence="$(( $(date +%s) * 100000 + ($$ % 1000) * 100 + RANDOM % 100 ))"
    event="$(
        jq -cn \
            --arg generated_at "$generated_at" \
            --arg event_id "$event_id" \
            --argjson sequence "$sequence" \
            --arg action_id "$action_id" \
            --arg operation "$operation" \
            --arg decision "$decision" \
            --arg outcome "$outcome" \
            '{
                api_version: "1.0",
                event_id: $event_id,
                sequence: $sequence,
                generated_at: $generated_at,
                event_type: "audit.recorded",
                action_id: $action_id,
                payload: {
                    action_id: $action_id,
                    operation: $operation,
                    authorization: "system-mutate",
                    decision: $decision,
                    outcome: $outcome
                }
            }'
    )" || return 1
    umask 077
    api_rotate_audit_if_needed || return 1
    printf '%s\n' "$event" >>"$API_AUDIT_FILE" || return 1
    chmod 600 -- "$API_AUDIT_FILE" || return 1
    api_sync_file_and_parent "$API_AUDIT_FILE"
}

api_terminal_audit_recorded() {
    local action_id="$1" operation="$2" outcome="$3"
    local -a audit_files=()
    [[ -r "$API_AUDIT_FILE.1" ]] && audit_files+=("$API_AUDIT_FILE.1")
    [[ -r "$API_AUDIT_FILE" ]] && audit_files+=("$API_AUDIT_FILE")
    ((${#audit_files[@]} > 0)) || return 1
    jq -s -e \
        --arg action_id "$action_id" \
        --arg operation "$operation" \
        --arg outcome "$outcome" '
            any(
                .[];
                .event_type == "audit.recorded"
                and .action_id == $action_id
                and .payload.operation == $operation
                and .payload.decision == "approved"
                and .payload.outcome == $outcome
            )
        ' "${audit_files[@]}" >/dev/null 2>&1
}

api_ensure_terminal_audit() {
    local action_id="$1" operation="$2" outcome="$3"
    api_terminal_audit_recorded "$action_id" "$operation" "$outcome" ||
        api_audit_event "$action_id" "$operation" approved "$outcome"
}

api_action_outcome() {
    local action_id="$1" state="$2" state_changed="$3"
    local rollback_required="$4" rollback_state="$5" message_key="$6"
    jq -cn \
        --arg action_id "$action_id" \
        --arg state "$state" \
        --argjson state_changed "$state_changed" \
        --argjson rollback_required "$rollback_required" \
        --arg rollback_state "$rollback_state" \
        --arg message_key "$message_key" \
        '{
            action_id: $action_id,
            state: $state,
            state_changed: $state_changed,
            rollback: {
                required: $rollback_required,
                state: $rollback_state
            },
            message_key: $message_key
        }'
}

api_find_profile() {
    local profile_id="$1" field="$2"
    [[ -r "$PROFILES_FILE" ]] || return 1
    jq -er --arg profile_id "$profile_id" --arg field "$field" '
        (.profiles // [])
        | map(select(.profile_id == $profile_id))
        | first
        | .[$field]
        | select(type == "string" and length > 0)
    ' "$PROFILES_FILE"
}

api_restore_state() {
    local snapshot="$1" existed="$2" recovery_mode="${3:-runtime}"
    local previous_desired="" tmp rollback_timeout
    if [[ "$existed" == true ]]; then
        mkdir -p -- "$STATE_DIR" || return 1
        chmod 700 -- "$STATE_DIR" || return 1
        tmp="$STATE_DIR/.active.api-rollback.$$"
        install -m 600 "$snapshot" "$tmp" || return 1
        mv -f -- "$tmp" "$STATE_FILE" || return 1
        sync -f "$STATE_FILE" || return 1
        sync -f "$STATE_DIR" || return 1
        previous_desired="$(
            awk -F= '$1 == "DESIRED" { print substr($0, index($0, "=") + 1); exit }' \
                "$snapshot"
        )"
    else
        rm -f -- "$STATE_FILE" || return 1
        sync -f "$STATE_DIR" || return 1
    fi

    health_reset
    if [[ "$recovery_mode" == "boot" ]]; then
        # The boot recovery unit is ordered before vpnctl.service. Waiting for
        # that queued service job here would create an ordering deadlock; the
        # restored DESIRED state is consumed by systemd after this unit exits.
        return 0
    fi
    rollback_timeout="$(api_rollback_timeout_seconds)"
    timeout --kill-after=5s "${rollback_timeout}s" \
        systemctl reset-failed "$SERVICE_NAME" >/dev/null 2>&1 || true
    if [[ "$previous_desired" == "up" ]]; then
        timeout --kill-after=5s "${rollback_timeout}s" \
            systemctl start "$SERVICE_NAME" || return 1
    else
        timeout --kill-after=5s "${rollback_timeout}s" \
            systemctl stop "$SERVICE_NAME" || return 1
    fi
    api_refresh_dashboard_bounded || true
}

api_store_completed_action() {
    local record_file="$1" fingerprint="$2" operation="$3" outcome="$4" record
    record="$(
        jq -cn \
            --arg fingerprint "$fingerprint" \
            --arg operation "$operation" \
            --arg completed_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
            --argjson outcome "$outcome" \
            '{
                fingerprint: $fingerprint,
                state: "completed",
                operation: $operation,
                completed_at: $completed_at,
                outcome: $outcome
            }'
    )" || return 1
    api_write_record "$record_file" "$record"
}

api_complete_unstarted_timeout() {
    local request_id="$1" action_id="$2" operation="$3"
    local record_file="$4" fingerprint="$5" outcome
    outcome="$(api_action_outcome \
        "$action_id" timed-out false false not-needed \
        api.action.deadline-exceeded)"
    api_store_completed_action \
        "$record_file" "$fingerprint" "$operation" "$outcome" || {
        api_error_response "$request_id" internal-error \
            api.journal.unavailable true true
        return 1
    }
    if ! api_audit_event "$action_id" "$operation" approved timed-out; then
        if api_mark_recovery_required \
            "$action_id" "$operation" audit-unavailable; then
            api_error_response "$request_id" internal-error \
                api.audit.unavailable false true
        else
            api_error_response "$request_id" internal-error \
                api.journal.unavailable false true
        fi
        return 1
    fi
    api_ok_response "$request_id" "$outcome"
}

api_recover_interrupted_actions() {
    local recovery_mode="${1:-runtime}"
    local record base action_id fingerprint operation snapshot_existed snapshot
    local legacy_snapshot outcome rollback_state audit_outcome recovery_reason
    local recovery_failed=0
    [[ ! -e "$API_RECOVERY_MARKER" ]] || return 1
    shopt -s nullglob
    for record in "$API_ACTION_DIR"/*.json; do
        [[ "$(jq -r '.state // ""' "$record" 2>/dev/null || true)" == "running" ]] ||
            continue
        base="$(basename -- "$record")"
        action_id="${base%.json}"
        if ! api_valid_identifier "$action_id"; then
            api_mark_recovery_required \
                recovery-scan api.interrupted-recovery journal-corrupt || true
            recovery_failed=1
            break
        fi
        fingerprint="$(jq -r '.fingerprint // ""' "$record" 2>/dev/null || true)"
        operation="$(jq -r '.operation // ""' "$record" 2>/dev/null || true)"
        snapshot_existed="$(jq -r '.snapshot_existed // ""' "$record" 2>/dev/null || true)"
        snapshot="$API_ACTION_DIR/.snapshot.$action_id"
        recovery_reason=""

        if [[ "$snapshot_existed" != true && "$snapshot_existed" != false ]]; then
            legacy_snapshot=""
            for legacy_snapshot in "$API_ACTION_DIR/.snapshot.$action_id".*; do
                break
            done
            if [[ -n "$legacy_snapshot" && -r "$legacy_snapshot" ]]; then
                snapshot="$legacy_snapshot"
                if [[ -s "$snapshot" ]]; then
                    snapshot_existed=true
                else
                    snapshot_existed=false
                fi
            fi
        fi

        if [[ "$snapshot_existed" == false ]] ||
           [[ "$snapshot_existed" == true && -r "$snapshot" ]]; then
            if api_restore_state "$snapshot" "$snapshot_existed" "$recovery_mode"; then
                rollback_state=completed
                outcome="$(api_action_outcome \
                    "$action_id" rolled-back true true "$rollback_state" \
                    api.action.interrupted-rolled-back)"
                audit_outcome=rolled-back
            else
                outcome="$(api_action_outcome \
                    "$action_id" rollback-failed true true failed \
                    api.action.interrupted-rollback-failed)"
                audit_outcome=rollback-failed
                recovery_reason="rollback-failed"
            fi
        else
            outcome="$(api_action_outcome \
                "$action_id" rollback-failed true true failed \
                api.action.interrupted-snapshot-missing)"
            audit_outcome=rollback-failed
            recovery_reason="snapshot-missing"
        fi

        if [[ -n "$recovery_reason" ]]; then
            if ! api_mark_recovery_required \
                "$action_id" "$operation" "$recovery_reason"; then
                recovery_failed=1
                continue
            fi
            recovery_failed=1
        fi

        if [[ -z "$fingerprint" || -z "$operation" ]] ||
           ! api_store_completed_action \
               "$record" "$fingerprint" "$operation" "$outcome"; then
            if [[ ! -e "$API_RECOVERY_MARKER" ]]; then
                api_mark_recovery_required \
                    "$action_id" "${operation:-api.interrupted-recovery}" \
                    journal-unavailable || true
            fi
            recovery_failed=1
            break
        fi
        if ! api_audit_event \
            "$action_id" "$operation" approved "$audit_outcome"; then
            if [[ -z "$recovery_reason" ]]; then
                if ! api_mark_recovery_required \
                    "$action_id" "$operation" audit-unavailable; then
                    recovery_failed=1
                    continue
                fi
            fi
            recovery_failed=1
        fi
        [[ -z "$recovery_reason" ]] || break
        ((recovery_failed == 0)) || break
    done
    shopt -u nullglob
    ((recovery_failed == 0))
}

cmd_api_recover_interrupted_actions() {
    local lock_wait_seconds
    require_root _api-recover-interrupted-actions "$@"
    (($# == 0)) ||
        die "Usage: $CLI_COMMAND _api-recover-interrupted-actions"
    if ! mkdir -p -- "$API_ACTION_DIR" "$RUN_DIR"; then
        api_mark_boot_recovery_unavailable \
            boot-recovery-directory-unavailable ||
            die "BOOT API RECOVERY: unable to persist the fail-closed recovery marker"
        die "BOOT API RECOVERY: unable to open protected state directories"
    fi
    if ! chmod 700 -- "$STATE_DIR" "$API_ACTION_DIR" "$RUN_DIR"; then
        api_mark_boot_recovery_unavailable \
            boot-recovery-permissions-unavailable ||
            die "BOOT API RECOVERY: unable to persist the fail-closed recovery marker"
        die "BOOT API RECOVERY: unable to protect state directories"
    fi
    lock_wait_seconds="$(api_recovery_lock_wait_seconds)"
    if ! acquire_recovery_lock "$lock_wait_seconds"; then
        api_mark_boot_recovery_unavailable \
            boot-recovery-lock-unavailable ||
            die "BOOT API RECOVERY: unable to persist the fail-closed recovery marker"
        die "BOOT API RECOVERY: unable to acquire the shared mutation lock"
    fi
    if [[ -e "$TRANSITION_RECOVERY_MARKER" ]]; then
        transition_guard_restore_fail_closed ||
            die "BOOT API RECOVERY: unable to restore the fail-closed transition guard"
        [[ -e "$TEST_TRANSACTION" ]] ||
            die "BOOT API RECOVERY: transition rollback requires administrator review"
    fi
    if ! api_recover_interrupted_actions boot; then
        die "BOOT API RECOVERY: interrupted action rollback requires administrator review"
    fi
    api_cleanup_action_temps
    info "BOOT API RECOVERY: interrupted actions reconciled"
}

api_run_lifecycle_action() {
    local request="$1" request_id="$2" operation="$3" action_id="$4"
    local deadline_ms="$5" deadline_started_ms="$6" deadline_end_ms remaining_ms
    local fingerprint record_file stored_fingerprint stored_state
    local outcome profile_id protocol profile snapshot snapshot_existed=false
    local duration output_file rc rollback_state audit_outcome running_record

    deadline_end_ms=$((deadline_started_ms + deadline_ms))
    mkdir -p -- "$API_ACTION_DIR" || {
        api_error_response "$request_id" internal-error api.journal.unavailable true true
        return
    }
    chmod 700 -- "$API_ACTION_DIR" || {
        api_error_response "$request_id" internal-error api.journal.unavailable true true
        return
    }
    mkdir -p -- "$RUN_DIR" || {
        api_error_response "$request_id" internal-error api.journal.unavailable true true
        return
    }
    chmod 700 -- "$RUN_DIR" || {
        api_error_response "$request_id" internal-error api.journal.unavailable true true
        return
    }
    exec 7>"$MUTATION_LOCK_FILE"
    if ! flock -n 7; then
        api_error_response "$request_id" busy api.action.busy true false
        return
    fi
    export VPNCTL_MUTATION_LOCK_FD=7
    if [[ -e "$TRANSITION_RECOVERY_MARKER" ]]; then
        api_error_response "$request_id" internal-error \
            api.action.recovery-required false true
        return
    fi
    if ! api_recover_interrupted_actions; then
        api_error_response "$request_id" internal-error \
            api.action.recovery-required false true
        return
    fi
    api_cleanup_action_temps
    api_prune_completed_actions "$action_id"

    fingerprint="$(
        jq -cS 'del(.request_id)' <<<"$request" |
            sha256sum |
            awk '{ print $1 }'
    )"
    record_file="$API_ACTION_DIR/$action_id.json"
    if [[ -r "$record_file" ]]; then
        stored_fingerprint="$(jq -r '.fingerprint // ""' "$record_file" 2>/dev/null || true)"
        stored_state="$(jq -r '.state // ""' "$record_file" 2>/dev/null || true)"
        if [[ "$stored_fingerprint" != "$fingerprint" ]]; then
            api_error_response "$request_id" conflict api.action.id-conflict false true
            return
        fi
        if [[ "$stored_state" == "completed" ]]; then
            outcome="$(jq -c '.outcome' "$record_file" 2>/dev/null)" || {
                api_error_response "$request_id" internal-error api.journal.corrupt false true
                return
            }
            audit_outcome="$(
                jq -er '
                    .state
                    | select(
                        . == "succeeded"
                        or . == "timed-out"
                        or . == "rolled-back"
                        or . == "rollback-failed"
                    )
                ' <<<"$outcome" 2>/dev/null
            )" || {
                api_error_response "$request_id" internal-error api.journal.corrupt false true
                return
            }
            if ! api_ensure_terminal_audit \
                "$action_id" "$operation" "$audit_outcome"; then
                api_mark_recovery_required \
                    "$action_id" "$operation" audit-unavailable || true
                api_error_response "$request_id" internal-error \
                    api.audit.unavailable false true
                return
            fi
            api_ok_response "$request_id" "$outcome"
            return
        fi
        api_error_response "$request_id" internal-error api.journal.corrupt false true
        return
    fi

    case "$operation" in
        lifecycle.connect)
            if ! jq -e '
                ((.payload | keys) - ["profile_id", "protocol"] | length) == 0
            ' <<<"$request" >/dev/null 2>&1; then
                api_error_response "$request_id" invalid-request api.profile.payload-invalid false true
                return
            fi
            profile_id="$(jq -er '.payload.profile_id' <<<"$request" 2>/dev/null)" || {
                api_error_response "$request_id" invalid-request api.profile.id-required false true
                return
            }
            api_valid_identifier "$profile_id" || {
                api_error_response "$request_id" invalid-request api.profile.id-invalid false true
                return
            }
            write_profiles_cache >/dev/null 2>&1 || true
            protocol="$(api_find_profile "$profile_id" protocol 2>/dev/null)" || {
                api_error_response "$request_id" not-found api.profile.not-found false true
                return
            }
            if ! jq -e --arg protocol "$protocol" '
                (.payload.protocol // $protocol) == $protocol
            ' <<<"$request" >/dev/null 2>&1; then
                api_error_response "$request_id" conflict api.profile.protocol-conflict false true
                return
            fi
            profile="$(api_find_profile "$profile_id" file_name 2>/dev/null)" || {
                api_error_response "$request_id" not-found api.profile.not-found false true
                return
            }
            ;;
        lifecycle.reconnect|lifecycle.disconnect)
            if ! jq -e '.payload == {}' <<<"$request" >/dev/null 2>&1; then
                api_error_response "$request_id" invalid-request api.payload.must-be-empty false true
                return
            fi
            ;;
        *)
            api_error_response "$request_id" unsupported-operation api.operation.unsupported false true
            return
            ;;
    esac

    remaining_ms="$(api_deadline_remaining_ms "$deadline_end_ms")" || {
        api_error_response "$request_id" backend-unavailable \
            api.runtime.clock-unavailable false true
        return
    }
    if ((remaining_ms <= 0)); then
        api_complete_unstarted_timeout \
            "$request_id" "$action_id" "$operation" "$record_file" "$fingerprint"
        return
    fi

    snapshot="$API_ACTION_DIR/.snapshot.$action_id"
    if [[ -r "$STATE_FILE" ]]; then
        install -m 600 "$STATE_FILE" "$snapshot" || {
            api_error_response "$request_id" internal-error api.snapshot.failed true true
            return
        }
        snapshot_existed=true
    else
        : >"$snapshot" || {
            api_error_response "$request_id" internal-error api.snapshot.failed true true
            return
        }
        chmod 600 -- "$snapshot"
    fi
    api_sync_file_and_parent "$snapshot" || {
        rm -f -- "$snapshot"
        api_error_response "$request_id" internal-error api.snapshot.failed true true
        return
    }

    running_record="$(
        jq -cn \
            --arg fingerprint "$fingerprint" \
            --arg operation "$operation" \
            --arg started_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
            --argjson snapshot_existed "$snapshot_existed" \
            '{
                fingerprint: $fingerprint,
                state: "running",
                operation: $operation,
                started_at: $started_at,
                snapshot_existed: $snapshot_existed
            }'
    )"
    api_write_record "$record_file" "$running_record" || {
        rm -f -- "$snapshot"
        api_error_response "$request_id" internal-error api.journal.unavailable true true
        return
    }
    if ! api_audit_event "$action_id" "$operation" approved started; then
        rm -f -- "$record_file" "$snapshot"
        api_error_response "$request_id" internal-error \
            api.audit.unavailable true true
        return
    fi

    remaining_ms="$(api_deadline_remaining_ms "$deadline_end_ms")" || {
        api_error_response "$request_id" backend-unavailable \
            api.runtime.clock-unavailable false true
        return
    }
    if ((remaining_ms <= 0)); then
        if api_complete_unstarted_timeout \
            "$request_id" "$action_id" "$operation" "$record_file" "$fingerprint"; then
            rm -f -- "$snapshot"
            api_sync_parent "$snapshot" || true
        fi
        return
    fi

    output_file="$API_ACTION_DIR/.output.$action_id.$$"
    duration="$(api_timeout_seconds_from_ms "$remaining_ms")" || {
        api_error_response "$request_id" internal-error \
            api.action.deadline-invalid false true
        return
    }

    case "$operation" in
        lifecycle.connect)
            timeout --kill-after=5s "${duration}s" \
                "$SELF" connect "$protocol" "$profile" >"$output_file" 2>&1
            rc=$?
            ;;
        lifecycle.reconnect)
            timeout --kill-after=5s "${duration}s" \
                "$SELF" reconnect >"$output_file" 2>&1
            rc=$?
            ;;
        lifecycle.disconnect)
            timeout --kill-after=5s "${duration}s" \
                "$SELF" disconnect >"$output_file" 2>&1
            rc=$?
            ;;
    esac
    rm -f -- "$output_file"

    if ((rc == 0)); then
        api_refresh_dashboard_bounded || true
        outcome="$(api_action_outcome \
            "$action_id" succeeded true false not-needed api.action.succeeded)"
        audit_outcome=succeeded
    else
        if api_restore_state "$snapshot" "$snapshot_existed"; then
            rollback_state=completed
            if ((rc == 124 || rc == 137)); then
                outcome="$(api_action_outcome \
                    "$action_id" timed-out true true "$rollback_state" \
                    api.action.deadline-exceeded)"
                audit_outcome=timed-out
            else
                outcome="$(api_action_outcome \
                    "$action_id" rolled-back true true "$rollback_state" \
                    api.action.rolled-back)"
                audit_outcome=rolled-back
            fi
        else
            outcome="$(api_action_outcome \
                "$action_id" rollback-failed true true failed \
                api.action.rollback-failed)"
            audit_outcome=rollback-failed
            if ! api_mark_recovery_required \
                "$action_id" "$operation" rollback-failed; then
                api_error_response "$request_id" internal-error \
                    api.journal.unavailable false true
                return
            fi
        fi
    fi
    api_store_completed_action "$record_file" "$fingerprint" "$operation" "$outcome" || {
        api_error_response "$request_id" internal-error api.journal.unavailable true true
        return
    }
    rm -f -- "$snapshot" || {
        api_mark_recovery_required "$action_id" "$operation" snapshot-cleanup-failed || true
        api_error_response "$request_id" internal-error api.journal.unavailable true true
        return
    }
    api_sync_parent "$snapshot" || {
        api_mark_recovery_required "$action_id" "$operation" snapshot-cleanup-sync-failed || true
        api_error_response "$request_id" internal-error api.journal.unavailable true true
        return
    }
    if ! api_ensure_terminal_audit \
        "$action_id" "$operation" "$audit_outcome"; then
        if api_mark_recovery_required \
            "$action_id" "$operation" audit-unavailable; then
            api_error_response "$request_id" internal-error \
                api.audit.unavailable false true
        else
            api_error_response "$request_id" internal-error \
                api.journal.unavailable false true
        fi
        return
    fi
    api_ok_response "$request_id" "$outcome"
}

api_dispatch() {
    local request="" request_id operation result action_id authorization deadline_ms
    local deadline_started_ms allowed_keys rc=0
    local LC_ALL=C
    ((EUID == 0)) || [[ "${VPNCTL_ALLOW_UNPRIVILEGED:-0}" == "1" ]] || {
        api_error_response "$(api_server_request_id)" permission-denied \
            api.transport.root-required false true
        return
    }
    export VPNCTL_API_SERVER_CONTEXT=1
    for command in awk jq sha256sum flock timeout install stat sync; do
        command -v "$command" >/dev/null 2>&1 || {
            api_error_response "$(api_server_request_id)" backend-unavailable \
                api.runtime.missing-dependency false true
            return
        }
    done
    [[ "$API_MAX_REQUEST_BYTES" =~ ^[1-9][0-9]*$ ]] &&
        ((API_MAX_REQUEST_BYTES <= 1048576)) || API_MAX_REQUEST_BYTES=65536
    if ! IFS= read -r -t 5 -n "$((API_MAX_REQUEST_BYTES + 1))" request; then
        api_error_response "$(api_server_request_id)" invalid-request \
            api.request.missing false false
        return
    fi
    if ((${#request} == 0 || ${#request} > API_MAX_REQUEST_BYTES)); then
        api_error_response "$(api_server_request_id)" invalid-request \
            api.request.size false false
        return
    fi
    if ! jq -s -e '
        length == 1
        and (.[0] | type == "object")
    ' <<<"$request" >/dev/null 2>&1; then
        api_error_response "$(api_server_request_id)" invalid-request \
            api.request.invalid-json false false
        return
    fi
    if ! api_request_has_unique_schema_keys "$request"; then
        api_error_response "$(api_server_request_id)" invalid-request \
            api.request.duplicate-key false false
        return
    fi
    allowed_keys='[
        "action_id", "api_version", "authorization", "deadline_ms",
        "operation", "payload", "request_id"
    ]'
    if ! jq -e --argjson allowed "$allowed_keys" '
        ((keys - $allowed) | length) == 0
        and has("api_version")
        and has("request_id")
        and has("operation")
        and has("payload")
        and (.api_version | type == "string")
        and (.request_id | type == "string")
        and (.operation | type == "string")
        and (.payload | type == "object")
    ' <<<"$request" >/dev/null 2>&1; then
        api_error_response "$(api_server_request_id)" invalid-request \
            api.request.shape false false
        return
    fi

    request_id="$(jq -r '.request_id // ""' <<<"$request")"
    if ! api_valid_identifier "$request_id"; then
        api_error_response "$(api_server_request_id)" invalid-request \
            api.request.id-invalid false false
        return
    fi
    if [[ "$(jq -r '.api_version // ""' <<<"$request")" != "1.0" ]]; then
        api_error_response "$request_id" unsupported-version api.version.unsupported false true
        return
    fi
    operation="$(jq -r '.operation // ""' <<<"$request")"
    case "$operation" in
        status.get|profiles.list|protocols.list)
            if jq -e 'has("action_id") or has("authorization")' \
                <<<"$request" >/dev/null 2>&1; then
                api_error_response "$request_id" invalid-request \
                    api.query.mutation-fields false false
                return
            fi
            if ! jq -e '
                .payload == {}
                and (
                    (has("deadline_ms") | not)
                    or (
                        (.deadline_ms | type == "number")
                        and ((.deadline_ms | floor) == .deadline_ms)
                        and .deadline_ms >= 100
                        and .deadline_ms <= 900000
                    )
                )
            ' <<<"$request" >/dev/null 2>&1; then
                api_error_response "$request_id" invalid-request \
                    api.query.payload-invalid false false
                return
            fi
            deadline_ms="$(jq -r '.deadline_ms // ""' <<<"$request")"
            if [[ "$operation" == status.get ]]; then
                result="$(api_status_result "$deadline_ms")" || {
                    api_error_response "$request_id" backend-unavailable \
                        api.status.unavailable true false
                    return
                }
            elif [[ "$operation" == profiles.list ]]; then
                result="$(api_profiles_result "$deadline_ms")" || {
                    api_error_response "$request_id" backend-unavailable \
                        api.profiles.unavailable true false
                    return
                }
            else
                result="$(api_protocols_result)" || {
                    api_error_response "$request_id" backend-unavailable \
                        api.protocols.unavailable true false
                    return
                }
            fi
            api_ok_response "$request_id" "$result"
            ;;
        planner.evaluate)
            if jq -e 'has("action_id") or has("authorization")' \
                <<<"$request" >/dev/null 2>&1; then
                api_error_response "$request_id" invalid-request \
                    api.query.mutation-fields false false
                return
            fi
            if ! jq -e '
                has("deadline_ms")
                and (.deadline_ms | type == "number")
                and ((.deadline_ms | floor) == .deadline_ms)
                and .deadline_ms >= 100
                and .deadline_ms <= 30000
                and ((.payload | keys) - ["candidates", "workload"] | length) == 0
                and (.payload | length) == 2
                and (.payload.workload | type == "string")
                and (
                    .payload.workload == "general"
                    or .payload.workload == "llm-streaming"
                    or .payload.workload == "api-calls"
                    or .payload.workload == "video"
                    or .payload.workload == "split-routing"
                )
                and (.payload.candidates | type == "array")
                and (.payload.candidates | length) >= 1
                and (.payload.candidates | length) <= 128
                and all(
                    .payload.candidates[];
                    (type == "object")
                    and ((keys - ["evidence", "profile_id"] | length) == 0)
                    and (length == 2)
                    and (.profile_id | type == "string")
                    and (.profile_id | test(
                        "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
                    ))
                    and (.evidence | type == "object")
                    and ((.evidence | keys) - [
                        "consecutive_failures", "evidence_age_seconds",
                        "latency_ms", "loss_percent", "reachability",
                        "recent_outcome"
                    ] | length) == 0
                    and (.evidence | length) == 6
                    and (
                        .evidence.recent_outcome == "success"
                        or .evidence.recent_outcome == "unknown"
                        or .evidence.recent_outcome == "failure"
                    )
                    and (.evidence.consecutive_failures | type == "number")
                    and ((.evidence.consecutive_failures | floor)
                        == .evidence.consecutive_failures)
                    and .evidence.consecutive_failures >= 0
                    and .evidence.consecutive_failures <= 10
                    and (
                        .evidence.reachability == "reachable"
                        or .evidence.reachability == "unknown"
                        or .evidence.reachability == "unreachable"
                    )
                    and (
                        (.evidence.latency_ms == null)
                        or (
                            (.evidence.latency_ms | type == "number")
                            and ((.evidence.latency_ms | floor)
                                == .evidence.latency_ms)
                            and .evidence.latency_ms >= 0
                            and .evidence.latency_ms <= 60000
                        )
                    )
                    and (.evidence.loss_percent | type == "number")
                    and ((.evidence.loss_percent | floor)
                        == .evidence.loss_percent)
                    and .evidence.loss_percent >= 0
                    and .evidence.loss_percent <= 100
                    and (.evidence.evidence_age_seconds | type == "number")
                    and ((.evidence.evidence_age_seconds | floor)
                        == .evidence.evidence_age_seconds)
                    and .evidence.evidence_age_seconds >= 0
                    and .evidence.evidence_age_seconds <= 86400
                )
                and (
                    (.payload.candidates | map(.profile_id) | unique | length)
                    == (.payload.candidates | length)
                )
            ' <<<"$request" >/dev/null 2>&1; then
                api_error_response "$request_id" invalid-request \
                    api.planner.payload-invalid false false
                return
            fi
            deadline_ms="$(jq -r '.deadline_ms' <<<"$request")"
            deadline_started_ms="$(api_monotonic_ms)" || {
                api_error_response "$request_id" backend-unavailable \
                    api.runtime.clock-unavailable false false
                return
            }
            result="$(api_planner_result \
                "$request" "$deadline_ms" "$deadline_started_ms")"
            rc=$?
            if ((rc == 124)); then
                api_error_response "$request_id" deadline-exceeded \
                    api.planner.deadline-exceeded true false
                return
            elif ((rc != 0)); then
                api_error_response "$request_id" backend-unavailable \
                    api.planner.unavailable true false
                return
            fi
            api_ok_response "$request_id" "$result"
            ;;
        tests.probe)
            if jq -e 'has("action_id") or has("authorization")' \
                <<<"$request" >/dev/null 2>&1; then
                api_error_response "$request_id" invalid-request \
                    api.query.mutation-fields false false
                return
            fi
            if ! jq -e '
                has("deadline_ms")
                and (.deadline_ms | type == "number")
                and ((.deadline_ms | floor) == .deadline_ms)
                and .deadline_ms >= 100
                and .deadline_ms <= 900000
                and ((.payload | keys) - [
                    "concurrency", "profile_id", "protocol", "timeout_seconds"
                ] | length) == 0
                and (.payload.timeout_seconds | type == "number")
                and (
                    (.payload.timeout_seconds | floor)
                    == .payload.timeout_seconds
                )
                and .payload.timeout_seconds >= 1
                and .payload.timeout_seconds <= 30
                and (
                    (.payload | has("concurrency") | not)
                    or (
                        (.payload.concurrency | type == "number")
                        and (
                            (.payload.concurrency | floor)
                            == .payload.concurrency
                        )
                        and .payload.concurrency >= 1
                        and .payload.concurrency <= 8
                    )
                )
                and (
                    (.payload | has("protocol") | not)
                    or (
                        .payload.protocol == "amneziawg"
                        or .payload.protocol == "wireguard"
                        or .payload.protocol == "openvpn"
                        or .payload.protocol == "l2tp"
                    )
                )
                and (
                    (.payload | has("profile_id") | not)
                    or (
                        (.payload.profile_id | type == "string")
                        and (
                            .payload.profile_id
                            | test("^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$")
                        )
                    )
                )
            ' <<<"$request" >/dev/null 2>&1; then
                api_error_response "$request_id" invalid-request \
                    api.tests.probe.payload-invalid false false
                return
            fi
            deadline_ms="$(jq -r '.deadline_ms' <<<"$request")"
            result="$(api_probe_result "$request" "$deadline_ms")"
            rc=$?
            case "$rc" in
                0)
                    api_ok_response "$request_id" "$result"
                    ;;
                3)
                    api_error_response "$request_id" not-found \
                        api.tests.probe.profile-not-found false false
                    ;;
                124)
                    api_error_response "$request_id" deadline-exceeded \
                        api.tests.probe.deadline true false
                    ;;
                75)
                    api_error_response "$request_id" busy \
                        api.tests.probe.busy true false
                    ;;
                *)
                    api_error_response "$request_id" backend-unavailable \
                        api.tests.probe.unavailable true false
                    ;;
            esac
            ;;
        tests.verify-egress)
            if jq -e 'has("action_id") or has("authorization")' \
                <<<"$request" >/dev/null 2>&1; then
                api_error_response "$request_id" invalid-request \
                    api.query.mutation-fields false false
                return
            fi
            if ! jq -e '
                has("deadline_ms")
                and (.deadline_ms | type == "number")
                and ((.deadline_ms | floor) == .deadline_ms)
                and .deadline_ms >= 100
                and .deadline_ms <= 900000
                and ((.payload | keys) - [
                    "include_speed", "timeout_seconds"
                ] | length) == 0
                and (.payload.timeout_seconds | type == "number")
                and (
                    (.payload.timeout_seconds | floor)
                    == .payload.timeout_seconds
                )
                and .payload.timeout_seconds >= 3
                and .payload.timeout_seconds <= 30
                and (
                    (.payload | has("include_speed") | not)
                    or (.payload.include_speed | type == "boolean")
                )
            ' <<<"$request" >/dev/null 2>&1; then
                api_error_response "$request_id" invalid-request \
                    api.tests.verify-egress.payload-invalid false false
                return
            fi
            deadline_ms="$(jq -r '.deadline_ms' <<<"$request")"
            result="$(api_verify_result "$request" "$deadline_ms")"
            rc=$?
            case "$rc" in
                0)
                    api_ok_response "$request_id" "$result"
                    ;;
                124)
                    api_error_response "$request_id" deadline-exceeded \
                        api.tests.verify-egress.deadline true false
                    ;;
                75)
                    api_error_response "$request_id" busy \
                        api.tests.verify-egress.busy true false
                    ;;
                *)
                    api_error_response "$request_id" backend-unavailable \
                        api.tests.verify-egress.unavailable true false
                    ;;
            esac
            ;;
        tests.verify-service-egress)
            if jq -e 'has("action_id") or has("authorization")' \
                <<<"$request" >/dev/null 2>&1; then
                api_error_response "$request_id" invalid-request \
                    api.query.mutation-fields false false
                return
            fi
            if ! jq -e '
                has("deadline_ms")
                and (.deadline_ms | type == "number")
                and ((.deadline_ms | floor) == .deadline_ms)
                and .deadline_ms >= 100
                and .deadline_ms <= 32000
                and ((.payload | keys | sort) == ["service", "timeout_seconds"])
                and (
                    .payload.service == "notebooklm"
                    or .payload.service == "openai"
                    or .payload.service == "all"
                )
                and (.payload.timeout_seconds | type == "number")
                and (
                    (.payload.timeout_seconds | floor)
                    == .payload.timeout_seconds
                )
                and .payload.timeout_seconds >= 3
                and .payload.timeout_seconds <= 15
            ' <<<"$request" >/dev/null 2>&1; then
                api_error_response "$request_id" invalid-request \
                    api.tests.verify-service-egress.payload-invalid false false
                return
            fi
            deadline_ms="$(jq -r '.deadline_ms' <<<"$request")"
            result="$(api_service_verify_result "$request" "$deadline_ms")"
            rc=$?
            case "$rc" in
                0)
                    api_ok_response "$request_id" "$result"
                    ;;
                124)
                    api_error_response "$request_id" deadline-exceeded \
                        api.tests.verify-service-egress.deadline true false
                    ;;
                75)
                    api_error_response "$request_id" busy \
                        api.tests.verify-service-egress.busy true false
                    ;;
                *)
                    api_error_response "$request_id" backend-unavailable \
                        api.tests.verify-service-egress.unavailable true false
                    ;;
            esac
            ;;
        lifecycle.connect|lifecycle.reconnect|lifecycle.disconnect)
            if ! jq -e '
                (.action_id | type == "string")
                and (.authorization | type == "string")
                and (.deadline_ms | type == "number")
                and ((.deadline_ms | floor) == .deadline_ms)
            ' <<<"$request" >/dev/null 2>&1; then
                api_error_response "$request_id" invalid-request \
                    api.mutation.requirements false true
                return
            fi
            action_id="$(jq -r '.action_id // ""' <<<"$request")"
            authorization="$(jq -r '.authorization // ""' <<<"$request")"
            deadline_ms="$(jq -r '.deadline_ms // ""' <<<"$request")"
            if ! api_valid_identifier "$action_id" ||
               [[ "$authorization" != system-mutate ]] ||
               [[ ! "$deadline_ms" =~ ^[0-9]+$ ]] ||
               ((deadline_ms < 100 || deadline_ms > 900000)); then
                api_error_response "$request_id" invalid-request \
                    api.mutation.requirements false true
                return
            fi
            deadline_started_ms="$(api_monotonic_ms)" || {
                api_error_response "$request_id" backend-unavailable \
                    api.runtime.clock-unavailable false true
                return
            }
            api_run_lifecycle_action \
                "$request" "$request_id" "$operation" "$action_id" \
                "$deadline_ms" "$deadline_started_ms"
            ;;
        *)
            api_error_response "$request_id" unsupported-operation \
                api.operation.unsupported false true
            ;;
    esac
}

check_command() {
    local command="$1" label="${2:-$1}"
    if command -v "$command" >/dev/null 2>&1; then
        check_ok "$label: $(command -v "$command")"
    else
        check_fail "$label не установлен"
    fi
}

check_active_connection() {
    local protocol="$1" interface handshake now age ip
    interface="$(interface_for_protocol "$protocol")"
    if service_active; then
        check_ok "$SERVICE_NAME активен"
    else
        check_fail "$SERVICE_NAME не активен"
    fi

    if connection_local_ok "$protocol"; then
        check_ok "VPN-интерфейс/соединение активно${interface:+: $interface}"
    else
        check_fail "VPN-интерфейс/соединение не найдено"
        return
    fi

    if [[ "$protocol" == "amneziawg" || "$protocol" == "wireguard" ]]; then
        handshake="$(latest_handshake "$protocol" "$interface")"
        if [[ "$handshake" =~ ^[0-9]+$ ]] && ((handshake > 0)); then
            now="$(date +%s)"
            age=$((now - handshake))
            if ((age <= 180)); then
                check_ok "Последний handshake: $age сек. назад"
            else
                check_warn "Handshake устарел: $age сек. назад"
            fi
        else
            check_warn "Handshake ещё не получен"
        fi
    fi

    ip="$(public_ip "$interface" || true)"
    if [[ -n "$ip" ]]; then
        check_ok "Интернет через VPN работает; внешний IP: $ip"
    else
        check_fail "Нет ответа через VPN-интерфейс от $PROBE_URL"
    fi
}

cmd_diagnose() {
    local protocol profile endpoint_host
    require_profile_access diagnose "$@"
    CHECK_OK=0
    CHECK_WARN=0
    CHECK_FAIL=0
    say "${C_BOLD}Диагностика VPN${C_RESET}"

    if ip route show default 2>/dev/null | grep -q .; then
        check_ok "Основной маршрут существует"
    else
        check_fail "Основной маршрут отсутствует"
    fi
    if getent ahostsv4 example.com >/dev/null 2>&1; then
        check_ok "DNS-разрешение работает"
    else
        check_fail "DNS-разрешение не работает"
    fi

    if ! selected_from_state; then
        check_fail "Активный профиль не выбран"
    else
        protocol="$SELECTED_PROTOCOL"
        profile="$SELECTED_PROFILE"
        check_ok "Выбран $(protocol_title "$protocol"): $(profile_name "$profile")"
        validate_profile "$protocol" "$profile" 0 || true
        endpoint_host="$(profile_endpoint "$protocol" "$profile")"
        endpoint_host="${endpoint_host#[}"
        endpoint_host="${endpoint_host%%]*}"
        endpoint_host="${endpoint_host%%:*}"
        if [[ -n "$endpoint_host" ]]; then
            if getent ahostsv4 "$endpoint_host" >/dev/null 2>&1; then
                check_ok "Адрес VPN-сервера разрешается: $endpoint_host"
            else
                check_fail "Не удаётся разрешить адрес VPN-сервера: $endpoint_host"
            fi
        fi
        check_active_connection "$protocol"
    fi

    printf '\nИтог: OK=%d WARN=%d FAIL=%d\n' "$CHECK_OK" "$CHECK_WARN" "$CHECK_FAIL"
    ((CHECK_FAIL == 0))
}

