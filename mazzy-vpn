normalize_language() {
    local language="${1:-}"
    language="${language,,}"
    language="${language%%.*}"
    language="${language%%_*}"
    language="${language%%-*}"
    case "$language" in
        ru|rus|russian|русский) printf 'ru\n' ;;
        en|eng|english) printf 'en\n' ;;
        de|deu|ger|german|germany|deutsch) printf 'de\n' ;;
        zh|zho|chi|chinese|china|中文) printf 'zh\n' ;;
        ja|jpn|japanese|japan|日本語) printf 'ja\n' ;;
        ko|kor|korean|korea|한국어) printf 'ko\n' ;;
        *) return 1 ;;
    esac
}

load_ui_language() {
    local candidate="" file
    if [[ -n "${VPNCTL_LANG:-}" ]]; then
        candidate="$VPNCTL_LANG"
    else
        for file in "$USER_LOCALE_FILE" "$SYSTEM_LOCALE_FILE"; do
            [[ -n "$file" && -r "$file" ]] || continue
            IFS= read -r candidate <"$file" || candidate=""
            [[ -n "$candidate" ]] && break
        done
    fi
    UI_LANG="$(normalize_language "$candidate" 2>/dev/null || printf 'ru')"
}

