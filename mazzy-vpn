doctor_fallback_checks() {
    local fallback=""
    if [[ -n "$LEGACY_FALLBACK_START" && -n "$LEGACY_FALLBACK_STOP" &&
          -x "$LEGACY_FALLBACK_START" && -x "$LEGACY_FALLBACK_STOP" ]]; then
        check_ok "Legacy fallback: setup/stop скрипты доступны"
    elif [[ -z "$LEGACY_FALLBACK_START" && -z "$LEGACY_FALLBACK_STOP" ]]; then
        check_warn "Legacy fallback не настроен (опционально: VPNCTL_LEGACY_START/VPNCTL_LEGACY_STOP)"
    else
        check_warn "Legacy fallback неполон: нужны $LEGACY_FALLBACK_START и $LEGACY_FALLBACK_STOP"
    fi
    if [[ -x "$ADGUARD_FALLBACK_CLI" ]] && fallback_account >/dev/null; then
        check_ok "AdGuard fallback доступен для независимого rollback"
    else
        check_warn "AdGuard fallback недоступен или не определён пользователь"
    fi
    fallback="$(detect_external_fallback || true)"
    [[ -z "$fallback" ]] ||
        check_ok "Сейчас активен внешний fallback: $(external_fallback_title "$fallback")"
}

doctor_unit_checks() {
    local desired
    if ! systemd_available; then
        check_fail "systemd сейчас недоступен"
        return
    fi
    if systemctl cat "$SERVICE_NAME" >/dev/null 2>&1; then
        check_ok "Установлен $SERVICE_NAME"
    else
        check_fail "Не установлен $SERVICE_NAME; запустите install.sh"
    fi
    if systemctl cat "$HEALTH_TIMER" >/dev/null 2>&1; then
        check_ok "Установлен $HEALTH_TIMER"
        if systemctl_quiet is-enabled "$HEALTH_TIMER"; then
            check_ok "$HEALTH_TIMER включён при загрузке"
        else
            check_warn "$HEALTH_TIMER не включён при загрузке"
        fi
        if systemctl_quiet is-active "$HEALTH_TIMER"; then
            check_ok "$HEALTH_TIMER выполняет автоматические проверки"
        else
            check_warn "$HEALTH_TIMER сейчас не активен"
        fi
    else
        check_fail "Не установлен $HEALTH_TIMER; запустите install.sh"
    fi
    if systemctl cat "$TEST_RECOVERY_SERVICE" >/dev/null 2>&1; then
        check_ok "Установлен $TEST_RECOVERY_SERVICE"
        if systemctl_quiet is-enabled "$TEST_RECOVERY_SERVICE"; then
            check_ok "$TEST_RECOVERY_SERVICE включён при загрузке"
        else
            check_warn "$TEST_RECOVERY_SERVICE установлен, но не включён"
        fi
    else
        check_fail "Не установлен $TEST_RECOVERY_SERVICE; запустите install.sh"
    fi
    if systemctl cat "$API_SOCKET_UNIT" >/dev/null 2>&1 &&
       systemctl cat "$API_SERVICE_UNIT" >/dev/null 2>&1; then
        check_ok "Установлен защищённый local API transport"
        if systemctl_quiet is-active "$API_SOCKET_UNIT"; then
            check_ok "$API_SOCKET_UNIT принимает локальные API-запросы"
        else
            check_warn "$API_SOCKET_UNIT установлен, но не активен"
        fi
    else
        check_fail "Local API units не установлены; запустите install.sh"
    fi
    desired="$(state_get DESIRED 2>/dev/null || true)"
    if [[ "$desired" == "up" ]]; then
        if systemctl_quiet is-enabled "$SERVICE_NAME"; then
            check_ok "$SERVICE_NAME включён для автоподключения"
        else
            check_warn "$SERVICE_NAME не включён для автоподключения"
        fi
        if service_active; then
            check_ok "$SERVICE_NAME сейчас активен"
        else
            check_warn "$SERVICE_NAME должен быть подключён, но сейчас не активен"
        fi
    fi
}

doctor_profile_checks() {
    local protocol file total=0
    for protocol in amneziawg wireguard openvpn l2tp; do
        load_profiles "$protocol"
        if ((${#PROFILES[@]} == 0)); then
            check_warn "$(protocol_title "$protocol"): профилей нет"
            continue
        fi
        check_ok "$(protocol_title "$protocol"): профилей ${#PROFILES[@]}"
        for file in "${PROFILES[@]}"; do
            total=$((total + 1))
            validate_profile "$protocol" "$file" 0 || true
        done
    done
    ((total > 0)) || check_fail "Не найдено ни одного VPN-профиля"
}

doctor_fix() {
    local protocol file installer
    info "Применение безопасных исправлений"
    mkdir -p "$STATE_DIR" "$RUN_DIR"
    chmod 700 "$STATE_DIR" "$RUN_DIR"

    for protocol in amneziawg wireguard openvpn l2tp; do
        load_profiles "$protocol"
        for file in "${PROFILES[@]}"; do
            validate_permissions "$file" || fix_profile_permissions "$file" || true
        done
    done

    installer="/usr/local/lib/mazzy-vpn/install.sh"
    [[ -x "$installer" ]] || installer="/usr/local/lib/vpnctl/install.sh"
    [[ -x "$installer" ]] || installer="$SCRIPT_DIR/install.sh"
    if [[ -x "$installer" ]]; then
        "$installer" --deps-only --yes || warn "Не все зависимости удалось установить"
    else
        warn "install.sh не найден; зависимости автоматически не установлены"
    fi
    if amnezia_kernel_available && command -v awg-quick >/dev/null 2>&1; then
        modprobe amneziawg 2>/dev/null ||
            warn "Модуль amneziawg не загрузился; проверьте DKMS и журнал ядра"
    elif amnezia_userspace_available; then
        info "AmneziaWG использует userspace backend amneziawg-go"
    else
        warn "AmneziaWG backend всё ещё недоступен"
    fi

    if systemd_available; then
        systemctl daemon-reload || true
        systemctl_quiet enable "$TEST_RECOVERY_SERVICE" || true
        systemctl_quiet enable --now "$HEALTH_TIMER" || true
        if [[ "$(state_get DESIRED 2>/dev/null || true)" == "up" ]] &&
           selected_from_state; then
            systemctl_quiet enable "$SERVICE_NAME" || true
            reset_service_start_limit
            systemctl_quiet start "$SERVICE_NAME" || true
        fi
    fi
}

cmd_api_clear_recovery() {
    require_root _api-clear-recovery "$@"
    [[ $# == 1 && "$1" == "--acknowledge-current-state" ]] ||
        die "Usage: $CLI_COMMAND _api-clear-recovery --acknowledge-current-state"
    mkdir -p -- "$API_ACTION_DIR" ||
        die "Unable to open the local API action journal"
    chmod 700 -- "$API_ACTION_DIR" ||
        die "Unable to protect the local API action journal"
    exec 7>"$API_ACTION_DIR/.mutation.lock"
    flock -n 7 ||
        die "Cannot acknowledge recovery while another API mutation is active"
    if [[ -e "$API_RECOVERY_MARKER" ]]; then
        rm -f -- "$API_RECOVERY_MARKER" ||
            die "Unable to clear the local API recovery marker"
        say "Local API recovery-only mode cleared after explicit administrator acknowledgement."
    else
        say "Local API recovery-only mode is not active."
    fi
}

cmd_doctor() {
    local fix=0
    require_profile_access doctor "$@"
    case "${1:-}" in
        "") ;;
        --fix) fix=1 ;;
        *) die "Неизвестный параметр doctor: $1" ;;
    esac
    if ((fix)); then
        require_root doctor --fix
        doctor_fix
    fi

    CHECK_OK=0
    CHECK_WARN=0
    CHECK_FAIL=0
    say "${C_BOLD}$PRODUCT_NAME doctor${C_RESET}"
    doctor_dependency_checks
    doctor_fallback_checks
    doctor_unit_checks
    doctor_profile_checks
    if [[ -e "$API_RECOVERY_MARKER" ]]; then
        check_fail "Local API recovery-only mode is active after a failed rollback"
        if ((EUID == 0)); then
            say "После ручной проверки состояния: sudo $CLI_COMMAND _api-clear-recovery --acknowledge-current-state"
        fi
    fi
    if [[ -r "$STATE_FILE" ]]; then
        if selected_from_state; then
            check_ok "Сохранённый выбор корректен"
        else
            check_fail "Сохранённый выбор повреждён или профиль удалён"
        fi
    else
        check_warn "Профиль для подключения ещё не выбран"
    fi

    printf '\nИтог: OK=%d WARN=%d FAIL=%d\n' "$CHECK_OK" "$CHECK_WARN" "$CHECK_FAIL"
    if ((CHECK_FAIL > 0)); then
        ((fix)) || say "Для безопасных автоматических исправлений: sudo $CLI_COMMAND doctor --fix"
        return 1
    fi
}

cmd_self_test() {
    local mode="network" timeout="$DEFAULT_PROBE_TIMEOUT" failed=0
    local -a original=("$@")
    while (($#)); do
        case "$1" in
            --offline) mode="offline" ;;
            --live) mode="live" ;;
            --timeout)
                shift
                [[ $# -gt 0 ]] || die "--timeout требует число секунд"
                timeout="$1"
                ;;
            --help|-h)
                say "Использование: $CLI_COMMAND self-test [--offline|--live] [--timeout 3]"
                return 0
                ;;
            *) die "Неизвестный параметр self-test: $1" ;;
        esac
        shift
    done
    if [[ ! "$timeout" =~ ^[0-9]+$ ]] || ((timeout < 1 || timeout > 30)); then
        die "Таймаут self-test должен быть от 1 до 30 секунд"
    fi
    require_profile_access self-test "${original[@]}"

    say "${C_BOLD}$PRODUCT_NAME — самодиагностика${C_RESET}"
    say "Режим: $mode"
    say
    cmd_validate all || failed=1
    if [[ "$mode" != "offline" ]]; then
        say
        cmd_probe all --timeout "$timeout" || failed=1
    fi
    say
    cmd_doctor || failed=1
    if [[ "$mode" == "live" ]]; then
        say
        cmd_test_all all --timeout "$DEFAULT_TEST_TIMEOUT" || failed=1
    fi
    say
    if ((failed)); then
        error "$PRODUCT_NAME self-test: обнаружены проблемы"
        return 1
    fi
    say "$PRODUCT_NAME self-test: все выбранные проверки пройдены."
}

cmd_autostart() {
    local mode="${1:-}"
    [[ "$mode" == "on" || "$mode" == "off" ]] ||
        die "Использование: $CLI_COMMAND autostart on|off"
    require_root autostart "$mode"
    systemd_available || die "systemd недоступен"
    if [[ "$mode" == "on" ]]; then
        selected_from_state || die "Сначала выберите профиль: $CLI_COMMAND connect"
        systemctl enable "$SERVICE_NAME" || die "Не удалось включить $SERVICE_NAME"
        systemctl enable --now "$HEALTH_TIMER" ||
            die "Не удалось включить $HEALTH_TIMER"
        say "Автоподключение после загрузки включено."
    else
        systemctl disable "$SERVICE_NAME" || die "Не удалось отключить $SERVICE_NAME"
        systemctl disable "$HEALTH_TIMER" || die "Не удалось отключить $HEALTH_TIMER"
        say "Автоподключение после загрузки выключено; текущее соединение не остановлено."
    fi
}

cmd_monitor() {
    local mode="${1:-}"
    [[ "$mode" == "on" || "$mode" == "off" ]] ||
        die "Использование: $CLI_COMMAND monitor on|off"
    require_root monitor "$mode"
    systemd_available || die "systemd недоступен"
    if [[ "$mode" == "on" ]]; then
        systemctl enable --now "$HEALTH_TIMER" ||
            die "Не удалось включить $HEALTH_TIMER"
        systemctl enable "$TEST_RECOVERY_SERVICE" ||
            die "Не удалось включить $TEST_RECOVERY_SERVICE"
        say "Автоматический контроль и recovery включены."
    else
        systemctl disable --now "$HEALTH_TIMER" ||
            die "Не удалось остановить $HEALTH_TIMER"
        say "Автоматический контроль остановлен; активный VPN не отключён."
    fi
}

detect_profile_protocol() {
    local file="$1"
    [[ -f "$file" && -r "$file" ]] || return 1
    if [[ "$file" == *.nmconnection ]] ||
       {
           grep -Eiq '^[[:space:]]*type[[:space:]]*=[[:space:]]*vpn[[:space:]]*$' "$file" &&
               grep -Eiq '^[[:space:]]*service-type[[:space:]]*=.*l2tp' "$file"
       }; then
        printf 'l2tp\n'
        return 0
    fi
    if [[ "$file" == *.ovpn ]] ||
       {
           has_directive "$file" client &&
               has_directive "$file" remote &&
               ! grep -Eq '^[[:space:]]*\[(Interface|Peer)\][[:space:]]*$' "$file"
       }; then
        printf 'openvpn\n'
        return 0
    fi
    if grep -Eq '^[[:space:]]*\[Interface\][[:space:]]*$' "$file" &&
       grep -Eq '^[[:space:]]*\[Peer\][[:space:]]*$' "$file"; then
        if grep -Eiq '^[[:space:]]*(Jc|Jmin|Jmax|S1|S2|H1|H2|H3|H4|I1|I2|I3|I4|I5)[[:space:]]*=' "$file"; then
            printf 'amneziawg\n'
        else
            printf 'wireguard\n'
        fi
        return 0
    fi
    return 1
}

import_target_dir() {
    local protocol="$1" dir
    dir="$(protocol_dir "$protocol")"
    if [[ "$dir" == "$SCRIPT_DIR/conf/AMNEZIA" || "$dir" == "$SCRIPT_DIR/conf/"* ]]; then
        dir="$DEFAULT_CONFIG_DIR/$protocol"
    fi
    printf '%s\n' "$dir"
}

safe_import_name() {
    local name
    name="$(basename -- "$1")"
    safe_profile_basename "$name" || return 1
    printf '%s\n' "$name"
}

cmd_import() {
    local requested_protocol="${1:-}" source="${2:-}" force="${3:-}" protocol dir target
    [[ -n "$requested_protocol" && -n "$source" ]] ||
        die "Использование: $CLI_COMMAND import ПРОТОКОЛ ФАЙЛ [--force]"
    protocol="$(canonical_protocol "$requested_protocol")" ||
        die "Неизвестный протокол: $requested_protocol"
    [[ -f "$source" ]] || die "Файл не найден: $source"
    safe_import_name "$source" >/dev/null ||
        die "Имя профиля содержит запрещённые управляющие символы"
    validate_profile "$protocol" "$source" 1 ||
        die "Профиль не прошёл проверку формата/безопасности"
    require_root import "$protocol" "$source" "$force"

    dir="$(import_target_dir "$protocol")"
    mkdir -p "$dir"
    chmod 700 "$(dirname -- "$dir")" "$dir"
    target="$dir/$(basename -- "$source")"
    if [[ -e "$target" && "$force" != "--force" ]]; then
        die "Профиль уже существует: $target (для замены добавьте --force)"
    fi
    install -m 600 -- "$source" "$target" || die "Не удалось скопировать профиль"
    say "Добавлен профиль: $target"
}

cmd_import_files() {
    local force=0 file protocol dir target failed=0 index
    local -a original=("$@") files=() protocols=()
    while (($#)); do
        case "$1" in
            --force) force=1 ;;
            -*) die "Неизвестный параметр import-files: $1" ;;
            *) files+=("$1") ;;
        esac
        shift
    done
    ((${#files[@]} > 0 && ${#files[@]} <= 128)) ||
        die "Использование: $CLI_COMMAND import-files ФАЙЛ... [--force]"

    for file in "${files[@]}"; do
        [[ -f "$file" && -r "$file" ]] || die "Файл не найден: $file"
        safe_import_name "$file" >/dev/null ||
            die "Имя профиля содержит запрещённые управляющие символы: $file"
        protocol="$(detect_profile_protocol "$file")" ||
            die "Не удалось распознать VPN-протокол: $file"
        validate_profile "$protocol" "$file" 1 ||
            die "Профиль не прошёл проверку формата/безопасности: $file"
        protocols+=("$protocol")
    done

    require_root import-files "${original[@]}"

    if ((force == 0)); then
        for index in "${!files[@]}"; do
            file="${files[$index]}"
            protocol="${protocols[$index]}"
            dir="$(import_target_dir "$protocol")"
            target="$dir/$(basename -- "$file")"
            [[ ! -e "$target" ]] ||
                die "Профиль уже существует: $target (для замены добавьте --force)"
        done
    fi

    for index in "${!files[@]}"; do
        file="${files[$index]}"
        protocol="${protocols[$index]}"
        if ((force)); then
            cmd_import "$protocol" "$file" --force || failed=1
        else
            cmd_import "$protocol" "$file" || failed=1
        fi
    done
    ((failed == 0)) || return 1
    printf 'Итог import-files: imported=%d\n' "${#files[@]}"
}

cmd_import_dir() {
    local source_dir="" force=0 dry_run=0 protocol file name dir target
    local detected=0 imported=0 unchanged=0 unknown=0 invalid=0 conflicts=0
    local -a original=("$@") files=()
    while (($#)); do
        case "$1" in
            --force) force=1 ;;
            --dry-run|--scan) dry_run=1 ;;
            --help|-h)
                say "Использование: $CLI_COMMAND import-dir ПАПКА [--dry-run] [--force]"
                return 0
                ;;
            -*)
                die "Неизвестный параметр import-dir: $1"
                ;;
            *)
                [[ -z "$source_dir" ]] || die "Укажите только одну папку конфигов"
                source_dir="$1"
                ;;
        esac
        shift
    done
    [[ -n "$source_dir" && -d "$source_dir" ]] ||
        die "Папка конфигов не найдена: ${source_dir:-<не указана>}"
    source_dir="$(readlink -f -- "$source_dir")"
    mapfile -d '' -t files < <(
        find "$source_dir" -type f \
            \( -name '*.conf' -o -name '*.ovpn' -o -name '*.nmconnection' \) \
            -print0 2>/dev/null | sort -z
    )
    ((${#files[@]} > 0)) ||
        die "В папке нет файлов *.conf, *.ovpn или *.nmconnection"
    ((dry_run)) || require_root import-dir "${original[@]}"

    say "$PRODUCT_NAME: анализ папки $source_dir"
    for file in "${files[@]}"; do
        if ! protocol="$(detect_profile_protocol "$file")"; then
            printf '[SKIP] unknown      %s\n' "$file"
            unknown=$((unknown + 1))
            continue
        fi
        detected=$((detected + 1))
        if ! validate_profile "$protocol" "$file" 1; then
            printf '[FAIL] %-12s %s\n' "$(protocol_title "$protocol")" "$file"
            invalid=$((invalid + 1))
            continue
        fi
        name="$(safe_import_name "$file")" || {
            printf '[FAIL] unsafe-name  %s\n' "$file"
            invalid=$((invalid + 1))
            continue
        }
        dir="$(import_target_dir "$protocol")"
        target="$dir/$name"
        if ((dry_run)); then
            printf '[SCAN] %-12s %s\n' "$(protocol_title "$protocol")" "$file"
            continue
        fi
        mkdir -p "$dir"
        chmod 700 "$(dirname -- "$dir")" "$dir"
        if [[ -e "$target" ]] && cmp -s "$file" "$target"; then
            chmod 600 "$target"
            printf '[SAME] %-12s %s\n' "$(protocol_title "$protocol")" "$target"
            unchanged=$((unchanged + 1))
            continue
        fi
        if [[ -e "$target" && "$force" -eq 0 ]]; then
            printf '[SKIP] conflict     %s (используйте --force)\n' "$target"
            conflicts=$((conflicts + 1))
            continue
        fi
        install -m 600 -- "$file" "$target" || {
            printf '[FAIL] copy         %s\n' "$file"
            invalid=$((invalid + 1))
            continue
        }
        printf '[ OK ] %-12s %s\n' "$(protocol_title "$protocol")" "$target"
        imported=$((imported + 1))
    done
    printf '\nИтог import-dir: files=%d detected=%d imported=%d same=%d unknown=%d invalid=%d conflicts=%d\n' \
        "${#files[@]}" "$detected" "$imported" "$unchanged" "$unknown" "$invalid" "$conflicts"
    ((detected > 0 && invalid == 0))
}

cmd_init_config_dir() {
    local target="${1:-$PWD/mazzy-vpn-configs}" existed=0
    [[ $# -le 1 ]] || die "Использование: $CLI_COMMAND init-config-dir [ПАПКА]"
    target="$(readlink -m -- "$target")"
    [[ -d "$target" ]] && existed=1
    [[ ! -e "$target" || -d "$target" ]] ||
        die "Путь существует и не является папкой: $target"
    mkdir -p "$target"/{amneziawg,wireguard,openvpn,l2tp} ||
        die "Не удалось создать структуру: $target"
    ((existed)) || chmod 700 "$target"
    chmod 700 "$target"/{amneziawg,wireguard,openvpn,l2tp}
    say "Создана структура конфигов: $target"
    say "  amneziawg/  wireguard/  openvpn/  l2tp/"
    say "Импорт: sudo $CLI_COMMAND import-dir '$target'"
}

cmd_remove() {
    local -a original=("$@")
    local requested_protocol="${1:-}" requested_profile="${2:-}" protocol active_profile
    [[ -n "$requested_protocol" && -n "$requested_profile" ]] ||
        die "Использование: $CLI_COMMAND remove ПРОТОКОЛ ПРОФИЛЬ"
    protocol="$(canonical_protocol "$requested_protocol")" ||
        die "Неизвестный протокол: $requested_protocol"
    require_profile_access remove "${original[@]}"
    resolve_profile "$protocol" "$requested_profile" || return 1
    require_root remove "$protocol" "$(basename -- "$SELECTED_PROFILE")"
    active_profile="$(state_get PROFILE 2>/dev/null || true)"
    if [[ "$(state_get PROTOCOL 2>/dev/null || true)" == "$protocol" &&
          "$active_profile" == "$(basename -- "$SELECTED_PROFILE")" ]]; then
        die "Нельзя удалить выбранный профиль. Сначала переключитесь на другой."
    fi
    rm -- "$SELECTED_PROFILE" || die "Не удалось удалить профиль"
    say "Удалён профиль: $(basename -- "$SELECTED_PROFILE")"
}

l2tp_connection_id() {
    local file="$1"
    awk -F= '
        /^\[connection\]$/ { in_connection=1; next }
        /^\[/ { in_connection=0 }
        in_connection && $1 == "id" {
            sub(/^[^=]*=/, "")
            print
            exit
        }
    ' "$file"
}

openvpn_dns_up() {
    local dev="${dev:-${1:-}}" value
    declare -a servers=()
    [[ -n "$dev" ]] || return 0
    while IFS='=' read -r _ value; do
        if [[ "$value" =~ ^dhcp-option[[:space:]]+DNS[[:space:]]+([^[:space:]]+) ]]; then
            servers+=("${BASH_REMATCH[1]}")
        fi
    done < <(env | grep -E '^foreign_option_[0-9]+=' | sort -t_ -k3,3n)

    ((${#servers[@]} > 0)) || servers=("1.1.1.1")
    if command -v resolvectl >/dev/null 2>&1; then
        resolvectl dns "$dev" "${servers[@]}"
        resolvectl domain "$dev" '~.'
        resolvectl default-route "$dev" yes
    elif command -v resolvconf >/dev/null 2>&1; then
        printf 'nameserver %s\n' "${servers[@]}" | resolvconf -a "$dev.vpnctl"
    fi
}

openvpn_dns_down() {
    local dev="${dev:-${1:-}}"
    [[ -n "$dev" ]] || return 0
    if command -v resolvectl >/dev/null 2>&1; then
        resolvectl revert "$dev" >/dev/null 2>&1 || true
    elif command -v resolvconf >/dev/null 2>&1; then
        resolvconf -d "$dev.vpnctl" >/dev/null 2>&1 || true
    fi
}

run_quick_service() {
    local protocol="$1" profile="$2" mode="${3:-normal}" tool status_tool interface runtime
    if [[ "$protocol" == "amneziawg" ]]; then
        tool=awg-quick
        status_tool=awg
        interface=vpnaw0
    else
        tool=wg-quick
        status_tool=wg
        interface=vpnwg0
    fi
    runtime="$RUN_DIR/$interface.conf"
    mkdir -p "$RUN_DIR"
    chmod 700 "$RUN_DIR"
    install -m 600 -- "$profile" "$runtime" || return 1

    cleanup_quick() {
        "$tool" down "$runtime" >/dev/null 2>&1 || true
        rm -f "$runtime"
    }
    stop_quick() {
        exit 0
    }
    trap cleanup_quick EXIT
    trap stop_quick INT TERM
    "$tool" up "$runtime" || return 1
    cleanup_duplicate_quick_policy
    if [[ "$mode" == "test" ]]; then
        info "TEST: $(protocol_title "$protocol") interface $interface создан"
        "$status_tool" show "$interface" 2>/dev/null |
            awk '
                /private key:/ { sub(/:.*/, ": (hidden)"); print; next }
                /^[[:space:]]+i[1-5]:/ {
                    if (!concealment) print "  concealment parameters: configured"
                    concealment=1
                    next
                }
                { print }
            ' || true
        ip -details address show dev "$interface" || true
        ip -4 route show table all | sed -n '1,120p' || true
        ip rule show || true
    fi
    while sleep 10; do
        ip link show "$interface" >/dev/null 2>&1 || return 1
    done
}

run_openvpn_service() {
    local profile="$1" mode="${2:-normal}" legacy_cipher runtime_log rc=0
    local -a args=(
        --config "$profile"
        --dev vpnovpn0
        --dev-type tun
        --script-security 2
        --up "$SELF _openvpn-dns-up"
        --down "$SELF _openvpn-dns-down"
        --down-pre
    )
    if ! has_directive "$profile" 'data-ciphers' &&
       ! has_directive "$profile" 'data-ciphers-fallback'; then
        legacy_cipher="$(awk '$1 == "cipher" { print $2; exit }' "$profile")"
        [[ -n "$legacy_cipher" ]] && args+=(--data-ciphers-fallback "$legacy_cipher")
    fi
    if [[ "$mode" == "test" ]]; then
        args+=(--verb 6)
        info "TEST: OpenVPN запущен с verb=6; профиль $(profile_name "$profile")"
    fi
    mkdir -p "$RUN_DIR"
    chmod 700 "$RUN_DIR"
    runtime_log="$RUN_DIR/openvpn.runtime.log"
    install -m 600 /dev/null "$runtime_log" || return 1
    openvpn "${args[@]}" 2>&1 | tee "$runtime_log"
    rc="${PIPESTATUS[0]}"
    if grep -Fq "Too many connections" "$runtime_log"; then
        [[ "$mode" != "test" ]] ||
            printf '%s\n' openvpn-too-many-connections >"$TEST_FAILURE_MARKER"
        error "OpenVPN: сервер отклонил сессию (Too many connections); systemd повторит подключение"
        return 75
    fi
    if grep -Eq 'AUTH_FAILED|auth-failure' "$runtime_log"; then
        [[ "$mode" != "test" ]] ||
            printf '%s\n' openvpn-auth-failed >"$TEST_FAILURE_MARKER"
        error "OpenVPN: сервер отклонил авторизацию"
        return 77
    fi
    if grep -Eq 'server-pushed-halt|Halt command was pushed by server' "$runtime_log"; then
        [[ "$mode" != "test" ]] ||
            printf '%s\n' openvpn-server-halt >"$TEST_FAILURE_MARKER"
        error "OpenVPN: сервер принудительно остановил сессию"
        return 75
    fi
    return "$rc"
}

run_l2tp_service() {
    local profile="$1" mode="${2:-normal}" connection_id
    connection_id="$(l2tp_connection_id "$profile")"
    [[ -n "$connection_id" ]] || die "В L2TP-профиле отсутствует connection.id"
    nmcli connection load "$profile" || return 1
    nmcli connection up id "$connection_id" || return 1
    if [[ "$mode" == "test" ]]; then
        info "TEST: L2TP/IPsec соединение '$connection_id' поднято"
        nmcli -f GENERAL.NAME,GENERAL.UUID,GENERAL.STATE,IP4.ADDRESS,IP4.GATEWAY \
            connection show "$connection_id" || true
        ip -details link show || true
    fi

    cleanup_l2tp() {
        nmcli connection down id "$connection_id" >/dev/null 2>&1 || true
    }
    stop_l2tp() {
        exit 0
    }
    trap cleanup_l2tp EXIT
    trap stop_l2tp INT TERM
    while sleep 10; do
        nmcli -t -f NAME connection show --active 2>/dev/null |
            grep -Fqx -- "$connection_id" || return 1
    done
}

service_run() {
    local desired mode deadline
    ((EUID == 0)) || [[ "${VPNCTL_ALLOW_UNPRIVILEGED:-0}" == "1" ]] ||
        die "_service-run требует root"
    selected_from_state || die "Выбранный профиль отсутствует"
    desired="$(state_get DESIRED 2>/dev/null || true)"
    mode="$(state_get MODE 2>/dev/null || printf 'normal')"
    deadline="$(state_get TEST_DEADLINE 2>/dev/null || true)"
    if [[ "$desired" != "up" ]]; then
        write_state "$SELECTED_PROTOCOL" "$SELECTED_PROFILE" up ||
            die "Не удалось обновить состояние подключения"
    fi
    validate_profile "$SELECTED_PROTOCOL" "$SELECTED_PROFILE" 1 ||
        die "Профиль не прошёл проверку безопасности"
    validate_permissions "$SELECTED_PROFILE" ||
        die "У выбранного профиля небезопасные права; требуется chmod 600"
    if [[ "$mode" == "test" ]]; then
        info "TEST: расширенное логирование включено; deadline=$deadline"
        info "TEST: $(protocol_title "$SELECTED_PROTOCOL") / $(profile_name "$SELECTED_PROFILE")"
    fi

    case "$SELECTED_PROTOCOL" in
        amneziawg|wireguard)
            run_quick_service "$SELECTED_PROTOCOL" "$SELECTED_PROFILE" "$mode"
            ;;
        openvpn)
            run_openvpn_service "$SELECTED_PROFILE" "$mode"
            ;;
        l2tp)
            run_l2tp_service "$SELECTED_PROFILE" "$mode"
            ;;
    esac
}

health_reset() {
    rm -f "$RUN_DIR/health.failures"
}

health_limit() {
    if [[ "$HEALTH_FAILURE_LIMIT" =~ ^[1-9][0-9]*$ ]]; then
        printf '%s\n' "$HEALTH_FAILURE_LIMIT"
    else
        printf '2\n'
    fi
}

health_internet_ok() {
    local interface="$1" timeout="$HEALTH_PROBE_TIMEOUT" trace
    [[ "$timeout" =~ ^[1-9][0-9]*$ ]] || timeout=4
    public_ip "$interface" "$timeout" >/dev/null && return 0
    trace="$(
        curl -4 -fsS --connect-timeout "$timeout" --max-time "$timeout" \
            --interface "$interface" "$HEALTH_FALLBACK_PROBE_URL" 2>/dev/null
    )" || return 1
    grep -Eq '^ip=[0-9A-Fa-f:.]{3,64}$' <<<"$trace"
}

health_acquire_action_lock() {
    exec 8>"$RUN_DIR/.action.lock"
    flock -n 8
}

health_recover() {
    local reason="$1" action="${2:-restart}" fallback=""
    if ! health_acquire_action_lock; then
        warn "Автовосстановление отложено: уже выполняется другая операция $PRODUCT_NAME"
        return 0
    fi
    fallback="$(detect_external_fallback || true)"
    if [[ -n "$fallback" ]]; then
        warn "Автовосстановление останавливает конфликтующий $(external_fallback_title "$fallback")"
        stop_external_fallbacks || {
            error "Автовосстановление не смогло остановить внешний VPN"
            return 1
        }
    fi
    cleanup_stale_quick_policy
    health_reset
    reset_service_start_limit
    warn "Автовосстановление: $reason; действие=$action $SERVICE_NAME"
    if systemctl "$action" --no-block "$SERVICE_NAME"; then
        info "Команда автовосстановления передана systemd"
        return 0
    fi
    error "systemd отклонил команду автовосстановления"
    return 1
}

health_failure() {
    local reason="$1" failures=0 limit
    limit="$(health_limit)"
    mkdir -p "$RUN_DIR"
    [[ -r "$RUN_DIR/health.failures" ]] &&
        read -r failures <"$RUN_DIR/health.failures"
    [[ "$failures" =~ ^[0-9]+$ ]] || failures=0
    failures=$((failures + 1))
    printf '%s\n' "$failures" >"$RUN_DIR/health.failures"
    warn "Проверка соединения $failures/$limit: $reason"
    if ((failures >= limit)); then
        health_recover "$reason после $failures последовательных проверок" restart || true
    fi
}

health_check() {
    local desired interface mode deadline token now
    mkdir -p "$RUN_DIR"
    chmod 700 "$RUN_DIR"
    trap 'write_dashboard_cache >/dev/null 2>&1 || true' EXIT
    exec 9>"$RUN_DIR/.health.lock"
    flock -n 9 || return 0
    desired="$(state_get DESIRED 2>/dev/null || true)"
    [[ "$desired" == "up" ]] || {
        health_reset
        return 0
    }
    mode="$(state_get MODE 2>/dev/null || printf 'normal')"
    if [[ "$mode" == "test" ]]; then
        deadline="$(state_get TEST_DEADLINE 2>/dev/null || true)"
        token="$(state_get TEST_TOKEN 2>/dev/null || true)"
        now="$(date +%s)"
        if [[ "$deadline" =~ ^[0-9]+$ ]] && ((now >= deadline)); then
            test_timeout_handler "$token"
        else
            health_reset
        fi
        return 0
    fi
    if ! selected_from_state; then
        health_failure "выбранный профиль не найден"
        return 0
    fi
    if ! service_active; then
        health_recover "сохранено DESIRED=up, но сервис не активен" start || true
        return 0
    fi
    if ! connection_local_ok "$SELECTED_PROTOCOL"; then
        health_failure "VPN-интерфейс отсутствует"
        return 0
    fi
    interface="$(interface_for_protocol "$SELECTED_PROTOCOL")"
    if ! health_internet_ok "$interface"; then
        health_failure "нет доступа в интернет через VPN"
        return 0
    fi
    health_reset
}

cmd_logs() {
    local lines=100
    local args=()
    case "${1:-}" in
        "")
            ;;
        -f|--follow)
            args=(-f -u "$SERVICE_NAME")
            ;;
        --lines)
            lines="${2:-}"
            [[ "$lines" =~ ^[0-9]+$ && "$lines" -ge 20 && "$lines" -le 1000 ]] ||
                die "--lines должен быть от 20 до 1000"
            args=(-u "$SERVICE_NAME" --no-pager -n "$lines")
            ;;
        *)
            die "Использование: $CLI_COMMAND logs [-f|--lines 20..1000]"
            ;;
    esac
    ((${#args[@]} > 0)) || args=(-u "$SERVICE_NAME" --no-pager -n "$lines")
    journalctl "${args[@]}"
}

