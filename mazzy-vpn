if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
    C_RED=$'\033[31m'
    C_GREEN=$'\033[32m'
    C_YELLOW=$'\033[33m'
    C_BOLD=$'\033[1m'
    C_CYAN=$'\033[36m'
    C_RESET=$'\033[0m'
else
    C_RED=""
    C_GREEN=""
    C_YELLOW=""
    C_BOLD=""
    C_CYAN=""
    C_RESET=""
fi

say() { printf '%s\n' "$*"; }
info() { printf '%s[INFO]%s %s\n' "$C_BOLD" "$C_RESET" "$*"; }
warn() { printf '%s[WARN]%s %s\n' "$C_YELLOW" "$C_RESET" "$*" >&2; }
error() { printf '%s[FAIL]%s %s\n' "$C_RED" "$C_RESET" "$*" >&2; }
die() { error "$*"; exit 1; }

check_ok() {
    CHECK_OK=$((CHECK_OK + 1))
    printf '%s[ OK ]%s %s\n' "$C_GREEN" "$C_RESET" "$*"
}

check_warn() {
    CHECK_WARN=$((CHECK_WARN + 1))
    printf '%s[WARN]%s %s\n' "$C_YELLOW" "$C_RESET" "$*"
}

check_fail() {
    CHECK_FAIL=$((CHECK_FAIL + 1))
    printf '%s[FAIL]%s %s\n' "$C_RED" "$C_RESET" "$*"
}

