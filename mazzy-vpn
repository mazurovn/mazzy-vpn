stdin_interactive() {
    [[ -t 0 || "${VPNCTL_FORCE_INTERACTIVE:-0}" == "1" ]]
}

canonical_protocol() {
    case "${1,,}" in
        amneziawg|amnezia|awg) printf 'amneziawg\n' ;;
        wireguard|wire|wg) printf 'wireguard\n' ;;
        openvpn|open|ovpn) printf 'openvpn\n' ;;
        l2tp|ltp) printf 'l2tp\n' ;;
        *) return 1 ;;
    esac
}

protocol_title() {
    case "$1" in
        amneziawg) printf 'AmneziaWG' ;;
        wireguard) printf 'WireGuard' ;;
        openvpn) printf 'OpenVPN' ;;
        l2tp) printf 'L2TP/IPsec' ;;
        *) printf '%s' "$1" ;;
    esac
}

effective_config_dir() {
    if [[ -n "$CONFIG_DIR" ]]; then
        printf '%s\n' "$CONFIG_DIR"
    elif [[ -d "$DEFAULT_CONFIG_DIR" ]]; then
        printf '%s\n' "$DEFAULT_CONFIG_DIR"
    elif [[ -d "$SCRIPT_DIR/conf" ]]; then
        printf '%s\n' "$SCRIPT_DIR/conf"
    else
        printf '%s\n' "$DEFAULT_CONFIG_DIR"
    fi
}

protocol_dir() {
    local protocol="$1" base
    base="$(effective_config_dir)"
    if [[ "$protocol" == "amneziawg" && -d "$base/AMNEZIA" ]]; then
        printf '%s\n' "$base/AMNEZIA"
    else
        printf '%s/%s\n' "$base" "$protocol"
    fi
}

safe_profile_basename() {
    local name="$1"
    [[ -n "$name" && "$name" != "." && "$name" != ".." ]] || return 1
    [[ "$name" != */* ]] || return 1
    [[ "$name" != *[[:cntrl:]]* ]] && ! profile_text_has_unsafe_unicode "$name"
}

profile_text_has_unsafe_unicode() {
    local value="$1"
    case "$value" in
        *$'\u00ad'*|*$'\u061c'*|*$'\u200b'*|*$'\u200c'*|*$'\u200d'*|\
        *$'\u200e'*|*$'\u200f'*|*$'\u2028'*|*$'\u2029'*|*$'\u202a'*|\
        *$'\u202b'*|*$'\u202c'*|*$'\u202d'*|*$'\u202e'*|*$'\u2060'*|\
        *$'\u2061'*|*$'\u2062'*|*$'\u2063'*|*$'\u2064'*|*$'\u2066'*|\
        *$'\u2067'*|*$'\u2068'*|*$'\u2069'*|*$'\ufeff'*)
            return 0
            ;;
    esac
    return 1
}

load_profiles() {
    local protocol="$1" dir path name
    local -a safe_profiles=()
    PROFILES=()
    dir="$(protocol_dir "$protocol")"
    [[ -d "$dir" ]] || return 0

    while IFS= read -r -d '' path; do
        PROFILES+=("$path")
    done < <(
        case "$protocol" in
            amneziawg|wireguard)
                find "$dir" -maxdepth 1 -type f -name '*.conf' -print0 2>/dev/null | sort -z
                ;;
            openvpn)
                find "$dir" -maxdepth 1 -type f \( -name '*.ovpn' -o -name '*.conf' \) -print0 2>/dev/null | sort -z
                ;;
            l2tp)
                find "$dir" -maxdepth 1 -type f -name '*.nmconnection' -print0 2>/dev/null | sort -z
                ;;
        esac
    )
    for path in "${PROFILES[@]}"; do
        name="$(basename -- "$path")"
        safe_profile_basename "$name" || {
            warn "Профиль пропущен: имя содержит управляющие символы или скрытые Unicode-маркеры"
            continue
        }
        safe_profiles+=("$path")
    done
    PROFILES=("${safe_profiles[@]}")
}

profile_file_stem() {
    local name
    name="$(basename -- "$1")"
    case "$name" in
        *.nmconnection) name="${name%.nmconnection}" ;;
        *.ovpn) name="${name%.ovpn}" ;;
        *.conf) name="${name%.conf}" ;;
    esac
    printf '%s\n' "$name"
}

safe_profile_metadata() {
    local value="$1"
    [[ -n "$value" ]] || return 1
    ((${#value} <= 120)) || return 1
    [[ "$value" != *[[:cntrl:]]* ]] && ! profile_text_has_unsafe_unicode "$value"
}

profile_metadata_value() {
    local file="$1" requested="$2" value=""
    [[ -f "$file" && -r "$file" ]] || return 1
    value="$(
        LC_ALL=C awk -v requested="$requested" '
            {
                line=$0
                sub(/\r$/, "", line)
                content=line
                sub(/^[[:space:]]*[#;][[:space:]]*/, "", content)
                normalized=tolower(content)
                wanted="mazzy-" requested
                if (substr(normalized, 1, length(wanted)) == wanted) {
                    value=substr(content, length(wanted) + 1)
                    if (value !~ /^[[:space:]]*[:=]/) {
                        next
                    }
                    sub(/^[[:space:]]*[:=][[:space:]]*/, "", value)
                    sub(/[[:space:]]+$/, "", value)
                    if (length(value) > 0) {
                        print substr(value, 1, 121)
                        exit
                    }
                }
            }
        ' "$file" 2>/dev/null
    )"
    safe_profile_metadata "$value" || return 1
    printf '%s\n' "$value"
}

nmconnection_profile_name() {
    local file="$1" value=""
    [[ "$file" == *.nmconnection && -f "$file" && -r "$file" ]] || return 1
    value="$(
        LC_ALL=C awk -F= '
            /^\[connection\][[:space:]]*$/ { section=1; next }
            /^\[/ { section=0 }
            section && $1 == "id" {
                value=substr($0, index($0, "=") + 1)
                sub(/^[[:space:]]+/, "", value)
                sub(/[[:space:]]+$/, "", value)
                print substr(value, 1, 121)
                exit
            }
        ' "$file" 2>/dev/null
    )"
    safe_profile_metadata "$value" || return 1
    printf '%s\n' "$value"
}

profile_name() {
    local file="$1" value=""
    value="$(profile_metadata_value "$file" name 2>/dev/null || true)"
    [[ -n "$value" ]] ||
        value="$(nmconnection_profile_name "$file" 2>/dev/null || true)"
    [[ -n "$value" ]] || value="$(profile_file_stem "$file")"
    printf '%s\n' "$value"
}

profile_location() {
    local file="$1" value=""
    value="$(profile_metadata_value "$file" location 2>/dev/null || true)"
    [[ -n "$value" ]] || value="$(profile_name "$file")"
    printf '%s\n' "$value"
}

profile_probe_label() {
    local file="$1" name location
    name="$(profile_name "$file")"
    location="$(profile_location "$file")"
    if [[ "$location" == "$name" ]]; then
        printf '%s\n' "$name"
    else
        printf '%s — %s\n' "$name" "$location"
    fi
}

profile_config_country_code() {
    local file="$1" value=""
    value="$(profile_metadata_value "$file" country-code 2>/dev/null || true)"
    value="${value^^}"
    [[ "$value" =~ ^[A-Z]{2}$ ]] || return 1
    printf '%s\n' "$value"
}

profile_endpoint() {
    local protocol="$1" file="$2"
    case "$protocol" in
        openvpn)
            awk '$1 == "remote" {
                port=($3 ~ /^[0-9]+$/ ? $3 : 1194)
                print $2 ":" port
                exit
            }' "$file"
            ;;
        amneziawg|wireguard)
            awk -F= '
                /^[[:space:]]*Endpoint[[:space:]]*=/ {
                    sub(/^[^=]*=[[:space:]]*/, "")
                    sub(/[[:space:]]*$/, "")
                    print
                    exit
                }
            ' "$file"
            ;;
        l2tp)
            awk -F= '
                /^\[vpn\]$/ { in_vpn=1; next }
                /^\[/ { in_vpn=0 }
                in_vpn && ($1 == "gateway" || $1 == "remote") {
                    sub(/^[^=]*=/, "")
                    print
                    exit
                }
            ' "$file"
            ;;
    esac
}

endpoint_host() {
    local endpoint="$1"
    if [[ "$endpoint" =~ ^\[([^]]+)\](:[0-9]+)?$ ]]; then
        printf '%s\n' "${BASH_REMATCH[1]}"
    elif [[ "$endpoint" == *:* ]]; then
        printf '%s\n' "${endpoint%:*}"
    else
        printf '%s\n' "$endpoint"
    fi
}

endpoint_port() {
    local endpoint="$1"
    if [[ "$endpoint" =~ :([0-9]+)$ ]]; then
        printf '%s\n' "${BASH_REMATCH[1]}"
    fi
}

validate_endpoint() {
    local protocol="$1" file="$2" endpoint host port
    endpoint="$(profile_endpoint "$protocol" "$file")"
    host="$(endpoint_host "$endpoint")"
    port="$(endpoint_port "$endpoint")"
    [[ -n "$host" && "$host" != -* && "$host" != *[[:space:]]* ]] || return 1
    if [[ "$protocol" != "l2tp" ]]; then
        [[ "$port" =~ ^[0-9]+$ ]] && ((10#$port >= 1 && 10#$port <= 65535)) ||
            return 1
    fi
}

openvpn_parser_ok() {
    local file="$1" deadline_end_ms="${2:-}"
    local timeout_ms=10000 duration rc=0
    command -v openvpn >/dev/null 2>&1 || return 0
    if [[ -n "$deadline_end_ms" ]]; then
        [[ "$deadline_end_ms" =~ ^[1-9][0-9]*$ ]] || return 1
        timeout_ms="$(api_deadline_remaining_ms "$deadline_end_ms")" || return 1
        ((timeout_ms > 0)) || return 124
        ((timeout_ms <= 10000)) || timeout_ms=10000
    fi
    duration="$(api_timeout_seconds_from_ms "$timeout_ms")" || return 1
    timeout --kill-after=0.25s "${duration}s" \
        openvpn --config "$file" --verb 0 --show-tls >/dev/null 2>&1
    rc=$?
    case "$rc" in
        0) return 0 ;;
        124|137) return 124 ;;
        *) return "$rc" ;;
    esac
}

resolve_profile() {
    local protocol="$1" requested="${2:-}" i display index
    local exact_display="" folded_display="" exact_count=0 folded_count=0
    load_profiles "$protocol"
    ((${#PROFILES[@]} > 0)) || {
        error "Для $(protocol_title "$protocol") нет профилей в $(protocol_dir "$protocol")"
        return 1
    }

    if [[ -z "$requested" ]]; then
        if ! stdin_interactive; then
            error "Укажите профиль или его номер. Список: $CLI_COMMAND list $protocol"
            return 1
        fi
        print_profile_list "$protocol"
        read -r -p "$(msg server_number)" requested
    fi

    if [[ "$requested" =~ ^[0-9]+$ ]]; then
        index=$((10#$requested))
        if ((index >= 1 && index <= ${#PROFILES[@]})); then
            SELECTED_PROFILE="${PROFILES[index - 1]}"
            return 0
        fi
    fi

    for ((i = 0; i < ${#PROFILES[@]}; i++)); do
        display="$(profile_name "${PROFILES[i]}")"
        if [[ "$requested" == "$(basename -- "${PROFILES[i]}")" ]]; then
            SELECTED_PROFILE="${PROFILES[i]}"
            return 0
        fi
        if [[ "$requested" == "$display" ]]; then
            exact_count=$((exact_count + 1))
            exact_display="${PROFILES[i]}"
        elif [[ "${requested,,}" == "${display,,}" ]]; then
            folded_count=$((folded_count + 1))
            folded_display="${PROFILES[i]}"
        fi
    done

    if ((exact_count == 1)); then
        SELECTED_PROFILE="$exact_display"
        return 0
    fi
    if ((exact_count > 1 || folded_count > 1)); then
        error "Имя '$requested' неоднозначно; используйте имя файла или номер"
        return 1
    fi
    if ((folded_count == 1)); then
        SELECTED_PROFILE="$folded_display"
        return 0
    fi
    error "Профиль '$requested' не найден для $(protocol_title "$protocol")"
    return 1
}

print_profile_list() {
    local protocol="$1" i endpoint
    load_profiles "$protocol"
    printf '\n%s%s%s\n' "$C_BOLD" "$(protocol_title "$protocol")" "$C_RESET"
    if ((${#PROFILES[@]} == 0)); then
        printf '  Профилей нет: %s\n' "$(protocol_dir "$protocol")"
        return 0
    fi
    for ((i = 0; i < ${#PROFILES[@]}; i++)); do
        endpoint="$(profile_endpoint "$protocol" "${PROFILES[i]}")"
        printf '  %2d. %-42s' "$((i + 1))" "$(profile_name "${PROFILES[i]}")"
        [[ -n "$endpoint" ]] && printf ' %s' "$endpoint"
        printf '\n'
    done
}

state_get_from_file() {
    local file="$1" key="$2"
    [[ -r "$file" ]] || return 1
    awk -F= -v wanted="$key" '
        $1 == wanted {
            sub(/^[^=]*=/, "")
            print
            exit
        }
    ' "$file"
}

state_get() {
    state_get_from_file "$STATE_FILE" "$1"
}

write_state() {
    local protocol="$1" file="$2" desired="$3" mode="${4:-normal}"
    local test_token="${5:-}" test_deadline="${6:-}" tmp
    mkdir -p "$STATE_DIR"
    chmod 700 "$STATE_DIR"
    tmp="$STATE_DIR/.active.$$"
    umask 077
    {
        printf 'PROTOCOL=%s\n' "$protocol"
        printf 'PROFILE=%s\n' "$(basename -- "$file")"
        printf 'DESIRED=%s\n' "$desired"
        printf 'MODE=%s\n' "$mode"
        if [[ "$mode" == "test" ]]; then
            printf 'TEST_TOKEN=%s\n' "$test_token"
            printf 'TEST_DEADLINE=%s\n' "$test_deadline"
        fi
    } >"$tmp"
    chmod 600 "$tmp"
    mv -f "$tmp" "$STATE_FILE" || return 1
    sync -f "$STATE_FILE" || return 1
    sync -f "$STATE_DIR"
}

set_desired_state() {
    local desired="$1" protocol profile
    protocol="$(state_get PROTOCOL 2>/dev/null || true)"
    profile="$(state_get PROFILE 2>/dev/null || true)"
    [[ -n "$protocol" && -n "$profile" ]] || return 1
    resolve_profile "$protocol" "$profile" >/dev/null || return 1
    write_state "$protocol" "$SELECTED_PROFILE" "$desired"
}

selected_from_state() {
    local protocol profile
    protocol="$(state_get PROTOCOL 2>/dev/null || true)"
    profile="$(state_get PROFILE 2>/dev/null || true)"
    [[ -n "$protocol" && -n "$profile" ]] || return 1
    protocol="$(canonical_protocol "$protocol" 2>/dev/null)" || return 1
    resolve_profile "$protocol" "$profile" >/dev/null || return 1
    SELECTED_PROTOCOL="$protocol"
    return 0
}

require_root() {
    if ((EUID == 0)) || [[ "${VPNCTL_ALLOW_UNPRIVILEGED:-0}" == "1" ]]; then
        return 0
    fi
    command -v sudo >/dev/null 2>&1 || die "Нужны права root; sudo не найден"
    info "Для изменения VPN нужны права администратора"
    exec sudo -- "$SELF" "$@"
}

require_profile_access() {
    local base
    base="$(effective_config_dir)"
    if [[ "$base" == "$DEFAULT_CONFIG_DIR" && ! -r "$base" ]]; then
        require_root "$@"
    fi
}

api_client_candidate() {
    [[ "${VPNCTL_API_SERVER_CONTEXT:-0}" != "1" &&
       "${VPNCTL_API_CLIENT_DISABLE:-0}" != "1" ]] || return 1
    ((EUID != 0)) || [[ "${VPNCTL_API_CLIENT_FORCE:-0}" == "1" ]] || return 1
    [[ -S "$API_SOCKET" || "${VPNCTL_API_CLIENT_FORCE:-0}" == "1" ]]
}

api_client_ready() {
    local dependency
    api_client_candidate || return 1
    for dependency in head jq socat timeout; do
        command -v "$dependency" >/dev/null 2>&1 ||
            die "$(msg api_dependency_missing "$dependency")"
    done
    [[ "$API_CLIENT_MAX_RESPONSE_BYTES" =~ ^[1-9][0-9]*$ ]] ||
        API_CLIENT_MAX_RESPONSE_BYTES=65536
    ((API_CLIENT_MAX_RESPONSE_BYTES <= 1048576)) ||
        API_CLIENT_MAX_RESPONSE_BYTES=65536
}

api_client_identifier() {
    local prefix="$1" token=""
    if [[ -r /proc/sys/kernel/random/uuid ]]; then
        IFS= read -r token </proc/sys/kernel/random/uuid || token=""
        token="${token//-/}"
    fi
    if [[ -z "$token" ]]; then
        token="$(
            printf '%s:%s:%s:%s' "$(date +%s%N)" "$$" "$RANDOM" "$prefix" |
                sha256sum |
                awk '{ print substr($1, 1, 32) }'
        )"
    fi
    printf '%s-%s\n' "$prefix" "$token"
}

api_client_send() {
    local request="$1" request_id deadline_ms timeout_seconds grace_seconds=5
    local response="" rc=1 attempt
    local LC_ALL=C
    request_id="$(jq -r '.request_id // ""' <<<"$request")"
    deadline_ms="$(jq -r '.deadline_ms // 5000' <<<"$request")"
    [[ "$deadline_ms" =~ ^[0-9]+$ ]] || deadline_ms=5000
    if jq -e 'has("action_id")' <<<"$request" >/dev/null 2>&1; then
        grace_seconds="$API_CLIENT_COMPLETION_GRACE_SECONDS"
        [[ "$grace_seconds" =~ ^[0-9]+$ ]] &&
            ((grace_seconds >= 60 && grace_seconds <= 120)) ||
            grace_seconds=60
    fi
    timeout_seconds=$(((deadline_ms + 999) / 1000 + grace_seconds))
    ((timeout_seconds >= 10)) || timeout_seconds=10
    ((timeout_seconds <= 1020)) || timeout_seconds=1020

    for attempt in 1 2; do
        response="$(
            printf '%s\n' "$request" |
                timeout --kill-after=2s "${timeout_seconds}s" \
                    socat -T "$timeout_seconds" STDIO,ignoreeof \
                        "UNIX-CONNECT:$API_SOCKET" \
                    2>/dev/null |
                head -c "$((API_CLIENT_MAX_RESPONSE_BYTES + 1))"
        )"
        rc=$?
        if ((rc == 0)) &&
           ((${#response} > 0 && ${#response} <= API_CLIENT_MAX_RESPONSE_BYTES)) &&
           jq -s -e --arg request_id "$request_id" '
               length == 1
               and (
                   .[0].api_version == "1.0"
                   and .[0].request_id == $request_id
                   and (.[0].status == "ok" or .[0].status == "error")
               )
           ' <<<"$response" >/dev/null 2>&1; then
            printf '%s\n' "$response"
            return 0
        fi
    done
    return 70
}

api_client_query_payload() {
    local operation="$1" payload="$2" deadline_ms="${3:-5000}"
    local request_id request
    [[ "$deadline_ms" =~ ^[0-9]+$ ]] &&
        ((deadline_ms >= 100 && deadline_ms <= 900000)) ||
        return 1
    jq -e 'type == "object"' <<<"$payload" >/dev/null 2>&1 || return 1
    request_id="$(api_client_identifier request)"
    request="$(
        jq -cn \
            --arg request_id "$request_id" \
            --arg operation "$operation" \
            --argjson deadline_ms "$deadline_ms" \
            --argjson payload "$payload" \
            '{
                api_version: "1.0",
                request_id: $request_id,
                operation: $operation,
                deadline_ms: $deadline_ms,
                payload: $payload
            }'
    )"
    api_client_send "$request"
}

api_client_query() {
    api_client_query_payload "$1" '{}' 5000
}

api_client_fetch_profiles() {
    local response
    response="$(api_client_query profiles.list)" || {
        error "$(msg api_profiles_unavailable)"
        return 70
    }
    if [[ "$(jq -r '.status' <<<"$response")" != "ok" ]]; then
        error "Local API: $(jq -r '.error.code + ": " + .error.message_key' <<<"$response")"
        return 1
    fi
    API_CLIENT_PROFILES="$(jq -c '.result.profiles // []' <<<"$response")"
}

api_client_print_profile_list() {
    local protocol="$1" entry index=0 name selected
    local -a entries=()
    mapfile -t entries < <(
        jq -c --arg protocol "$protocol" '
            .[] | select(.protocol == $protocol)
        ' <<<"$API_CLIENT_PROFILES"
    )
    printf '\n%s%s%s\n' "$C_BOLD" "$(protocol_title "$protocol")" "$C_RESET"
    if ((${#entries[@]} == 0)); then
        printf '  %s\n' "$(msg api_empty_profiles)"
        return 0
    fi
    for entry in "${entries[@]}"; do
        index=$((index + 1))
        name="$(jq -r '.display_name' <<<"$entry")"
        selected="$(jq -r '.selected // false' <<<"$entry")"
        printf '  %2d. %s' "$index" "$name"
        [[ "$selected" == "true" ]] && printf '  *'
        printf '\n'
    done
}

api_client_choose_protocol() {
    local answer protocol count index=1
    stdin_interactive || {
        error "$(msg api_protocol_required)"
        return 1
    }
    printf '\n%s\n' "$(msg choose_protocol)" >&2
    for protocol in amneziawg wireguard openvpn l2tp; do
        count="$(
            jq -r --arg protocol "$protocol" '
                map(select(.protocol == $protocol)) | length
            ' <<<"$API_CLIENT_PROFILES"
        )"
        printf '  %d. %-12s %s: %-3d\n' "$index" \
            "$(protocol_title "$protocol")" "$(msg profile_count)" "$count" >&2
        index=$((index + 1))
    done
    read -r -p "$(msg protocol_number)" answer
    case "$answer" in
        1) printf 'amneziawg\n' ;;
        2) printf 'wireguard\n' ;;
        3) printf 'openvpn\n' ;;
        4) printf 'l2tp\n' ;;
        *) error "$(msg invalid_protocol)"; return 1 ;;
    esac
}

api_client_resolve_profile() {
    local requested_protocol="${1:-}" requested_profile="${2:-}" protocol
    local matches selected="" match_count index
    api_client_fetch_profiles || return
    if [[ -z "$requested_protocol" ]]; then
        protocol="$(api_client_choose_protocol)" || return 1
    else
        protocol="$(canonical_protocol "$requested_protocol")" ||
            die "$(msg api_unknown_protocol "$requested_protocol")"
    fi
    matches="$(
        jq -c --arg protocol "$protocol" '
            [.[] | select(.protocol == $protocol)]
        ' <<<"$API_CLIENT_PROFILES"
    )"
    match_count="$(jq -r 'length' <<<"$matches")"
    ((match_count > 0)) || {
        error "$(msg api_no_profiles "$(protocol_title "$protocol")")"
        return 1
    }
    if [[ -z "$requested_profile" ]]; then
        stdin_interactive || {
            error "$(msg api_profile_required "$CLI_COMMAND" "$protocol")"
            return 1
        }
        api_client_print_profile_list "$protocol" >&2
        read -r -p "$(msg server_number)" requested_profile
    fi
    if [[ "$requested_profile" =~ ^[0-9]+$ ]]; then
        index=$((10#$requested_profile))
        if ((index >= 1 && index <= match_count)); then
            selected="$(jq -c --argjson index "$((index - 1))" '.[$index]' <<<"$matches")"
        fi
    else
        selected="$(
            jq -c --arg requested "$requested_profile" '
                [.[] | select(.display_name == $requested)] | first // empty
            ' <<<"$matches"
        )"
        if [[ -z "$selected" ]]; then
            match_count="$(
                jq -r --arg requested "${requested_profile,,}" '
                    [.[] | select((.display_name | ascii_downcase) == $requested)] | length
                ' <<<"$matches"
            )"
            if ((match_count == 1)); then
                selected="$(
                    jq -c --arg requested "${requested_profile,,}" '
                        [.[] | select((.display_name | ascii_downcase) == $requested)] | first
                    ' <<<"$matches"
                )"
            elif ((match_count > 1)); then
                error "$(msg api_profile_ambiguous "$requested_profile")"
                return 1
            fi
        fi
    fi
    [[ -n "$selected" && "$selected" != "null" ]] || {
        error "$(msg api_profile_not_found "$requested_profile" \
            "$(protocol_title "$protocol")")"
        return 1
    }
    API_CLIENT_SELECTED_PROFILE_ID="$(jq -r '.profile_id' <<<"$selected")"
    API_CLIENT_SELECTED_PROFILE_NAME="$(jq -r '.display_name' <<<"$selected")"
    API_CLIENT_SELECTED_PROTOCOL="$protocol"
}

api_client_mutation() {
    local operation="$1" payload="$2" deadline_ms="$3"
    local action_id request_id request response status state code message
    action_id="$(api_client_identifier action)"
    request_id="$(api_client_identifier request)"
    request="$(
        jq -cn \
            --arg request_id "$request_id" \
            --arg operation "$operation" \
            --arg action_id "$action_id" \
            --argjson deadline_ms "$deadline_ms" \
            --argjson payload "$payload" \
            '{
                api_version: "1.0",
                request_id: $request_id,
                operation: $operation,
                action_id: $action_id,
                authorization: "system-mutate",
                deadline_ms: $deadline_ms,
                payload: $payload
            }'
    )"
    response="$(api_client_send "$request")" || {
        error "$(msg api_lost_response)"
        error "$(msg api_action_id "$action_id")"
        return 70
    }
    status="$(jq -r '.status' <<<"$response")"
    if [[ "$status" != "ok" ]]; then
        code="$(jq -r '.error.code // "internal-error"' <<<"$response")"
        message="$(jq -r '.error.message_key // "api.response.malformed"' <<<"$response")"
        error "$(msg api_rejected "$code" "$message")"
        error "$(msg api_action_id "$action_id")"
        return 1
    fi
    state="$(jq -r '.result.state // "failed"' <<<"$response")"
    if [[ "$state" != "succeeded" ]]; then
        message="$(jq -r '.result.message_key // "api.response.malformed"' <<<"$response")"
        error "$(msg api_failed_state "$state" "$message")"
        error "$(msg api_action_id "$action_id")"
        return 1
    fi
}

api_client_cmd_connect() {
    api_client_resolve_profile "${1:-}" "${2:-}" || return
    info "$(msg api_selected "$(protocol_title "$API_CLIENT_SELECTED_PROTOCOL")" \
        "$API_CLIENT_SELECTED_PROFILE_NAME")"
    api_client_mutation lifecycle.connect \
        "$(jq -cn --arg profile_id "$API_CLIENT_SELECTED_PROFILE_ID" \
            '{profile_id: $profile_id}')" 60000 || return
    say "$(msg api_connect_started "$CLI_COMMAND")"
}

api_client_cmd_disconnect() {
    (($# == 0)) || die "Использование: $CLI_COMMAND disconnect"
    api_client_mutation lifecycle.disconnect '{}' 30000 || return
    say "$(msg api_disconnected)"
}

api_client_cmd_reconnect() {
    (($# == 0)) || die "Использование: $CLI_COMMAND reconnect"
    api_client_mutation lifecycle.reconnect '{}' 30000 || return
    say "$(msg api_reconnect_started)"
}

api_client_cmd_quick() {
    local response state profile_id profile_name=""
    (($# == 0)) || die "Использование: $CLI_COMMAND quick"
    response="$(api_client_query status.get)" || {
        error "$(msg api_status_unavailable)"
        return 70
    }
    [[ "$(jq -r '.status' <<<"$response")" == "ok" ]] || {
        error "$(msg api_status_invalid)"
        return 1
    }
    state="$(jq -r '.result.connection.state // "unknown"' <<<"$response")"
    profile_id="$(jq -r '.result.connection.profile_id // ""' <<<"$response")"
    api_client_fetch_profiles || return
    if [[ -n "$profile_id" ]]; then
        profile_name="$(
            jq -r --arg profile_id "$profile_id" '
                [.[] | select(.profile_id == $profile_id) | .display_name] |
                first // ""
            ' <<<"$API_CLIENT_PROFILES"
        )"
    fi
    if [[ "$state" == "connected" &&
          "$(jq -r '.result.connection.healthy // false' <<<"$response")" == "true" ]]; then
        say "$(msg already_connected)${profile_name:+: $profile_name}"
        return 0
    fi
    if [[ -z "$profile_id" ]]; then
        info "$(msg no_default)"
        api_client_cmd_connect
        return
    fi
    api_client_cmd_reconnect
}

api_client_cmd_status() {
    local response state profile_id="" protocol="" profile_name=""
    local desired mode interface public_ip handshake_age fallback_active fallback_name
    (($# == 0)) || die "Использование: $CLI_COMMAND status"
    response="$(api_client_query status.get)" || {
        error "$(msg api_status_unavailable)"
        return 70
    }
    [[ "$(jq -r '.status' <<<"$response")" == "ok" ]] || {
        error "$(msg api_status_invalid)"
        return 1
    }
    state="$(jq -r '.result.connection.state // "unknown"' <<<"$response")"
    profile_id="$(jq -r '.result.connection.profile_id // ""' <<<"$response")"
    protocol="$(jq -r '.result.connection.protocol // ""' <<<"$response")"
    if [[ -n "$profile_id" ]]; then
        api_client_fetch_profiles || return
        profile_name="$(
            jq -r --arg profile_id "$profile_id" '
                [.[] | select(.profile_id == $profile_id) | .display_name] |
                first // ""
            ' <<<"$API_CLIENT_PROFILES"
        )"
    fi
    if [[ "$state" == "connected" ]]; then
        printf 'VPN:       active\n'
    else
        printf 'VPN:       %s\n' "$state"
    fi
    [[ -z "$protocol" ]] || printf 'Protocol:  %s\n' "$(protocol_title "$protocol")"
    [[ -z "$profile_name" ]] || printf 'Profile:   %s\n' "$profile_name"
    printf 'Internet:  %s\n' \
        "$(jq -r 'if .result.connection.internet_reachable then "reachable" else "unreachable" end' <<<"$response")"
    printf 'Healthy:   %s\n' \
        "$(jq -r 'if .result.connection.healthy then "yes" else "no" end' <<<"$response")"
    desired="$(jq -r '.result.desired // ""' <<<"$response")"
    mode="$(jq -r '.result.mode // ""' <<<"$response")"
    interface="$(jq -r '.result.connection.interface // ""' <<<"$response")"
    public_ip="$(jq -r '.result.connection.public_ip // ""' <<<"$response")"
    handshake_age="$(jq -r '.result.connection.handshake_age // ""' <<<"$response")"
    fallback_active="$(jq -r '.result.fallback.active // false' <<<"$response")"
    fallback_name="$(jq -r '.result.fallback.display_name // ""' <<<"$response")"
    [[ -z "$desired" ]] || printf 'Desired:   %s\n' "$desired"
    [[ -z "$mode" ]] || printf 'Mode:      %s\n' "$mode"
    if jq -e '.result | has("autostart")' <<<"$response" >/dev/null; then
        printf 'Autostart: %s\n' \
            "$(jq -r 'if .result.autostart then "enabled" else "disabled" end' <<<"$response")"
    fi
    if jq -e '.result | has("health_monitor")' <<<"$response" >/dev/null; then
        printf 'Monitor:   %s\n' \
            "$(jq -r 'if .result.health_monitor then "enabled" else "disabled" end' <<<"$response")"
    fi
    if [[ "$fallback_active" == "true" ]]; then
        printf 'Fallback:  active%s\n' "${fallback_name:+ ($fallback_name)}"
    elif jq -e '.result | has("fallback")' <<<"$response" >/dev/null; then
        printf 'Fallback:  inactive\n'
    fi
    [[ -z "$interface" ]] || printf 'Interface: %s\n' "$interface"
    [[ -z "$handshake_age" ]] ||
        printf 'Handshake: %s sec ago\n' "$handshake_age"
    [[ -z "$public_ip" ]] || printf 'Public IP: %s\n' "$public_ip"
    [[ "$state" == "connected" ]]
}

api_client_dashboard_render() {
    local response state profile_id="" protocol="" profile_name="" counts=""
    local protocol_name count service_text internet_text interface public_ip
    local handshake_age autostart_text monitor_text fallback_text fallback_name
    response="$(api_client_query status.get)" || {
