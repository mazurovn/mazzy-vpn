save_user_language() {
    local language="$1" directory tmp
    [[ -n "$USER_LOCALE_FILE" ]] || return 1
    directory="$(dirname -- "$USER_LOCALE_FILE")"
    install -d -m 700 -- "$directory" || return 1
    tmp="$directory/.language.$$"
    umask 077
    printf '%s\n' "$language" >"$tmp" || return 1
    chmod 600 "$tmp" || return 1
    mv -f -- "$tmp" "$USER_LOCALE_FILE"
    if ((EUID == 0)) && [[ "$LOCALE_OWNER_UID" =~ ^[0-9]+$ &&
                           "$LOCALE_OWNER_GID" =~ ^[0-9]+$ ]]; then
        chown "$LOCALE_OWNER_UID:$LOCALE_OWNER_GID" -- "$directory" \
            "$USER_LOCALE_FILE" || return 1
    fi
}

cmd_language() {
    local requested="${1:-}" language
    if [[ -z "$requested" || "$requested" == "current" ]]; then
        printf '%s: %s (%s)\n' "$(msg current_language)" \
            "$(language_native_name "$UI_LANG")" "$UI_LANG"
        print_language_list
        return 0
    fi
    if [[ "$requested" == "list" ]]; then
        print_language_list
        return 0
    fi
    language="$(normalize_language "$requested" 2>/dev/null)" || {
        error "$(msg unsupported_language): $requested"
        return 2
    }
    save_user_language "$language" || die "Не удалось сохранить язык: $USER_LOCALE_FILE"
    UI_LANG="$language"
    printf '%s: %s (%s)\n' "$(msg language_saved)" \
        "$(language_native_name "$UI_LANG")" "$UI_LANG"
}

menu_language() {
    local answer language
    printf '\n%s: %s (%s)\n' "$(msg language_title)" \
        "$(language_native_name "$UI_LANG")" "$UI_LANG"
    print_language_list
    read -r -p "$(msg language_prompt)" answer
    case "$answer" in
        1) language=ru ;; 2) language=en ;; 3) language=de ;;
        4) language=zh ;; 5) language=ja ;; 6) language=ko ;;
        *) warn "$(msg invalid_choice)"; return 1 ;;
    esac
    cmd_language "$language"
}

