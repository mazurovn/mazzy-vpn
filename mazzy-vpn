dashboard_render() {
    local protocol="" profile="" location="" config_name="" interface=""
    local service_text internet_text public_ip_value="" handshake_text=""
    local autostart_text health_text fallback="" fallback_text counts="" protocol_name count
    local tunnel_ok=0 now handshake
    service_text="$(msg stopped)"
    internet_text="$(msg not_available)"
    autostart_text="$(msg disabled)"
    health_text="$(msg disabled)"
    systemctl_quiet is-enabled "$SERVICE_NAME" && autostart_text="$(msg enabled)"
    systemctl_quiet is-active "$HEALTH_TIMER" && health_text="$(msg enabled)"
    fallback="$(detect_external_fallback || true)"
    if [[ -n "$fallback" ]]; then
        fallback_text="$(external_fallback_title "$fallback") — $(msg active)"
    else
        fallback_text="$(msg fallback_none)"
    fi

    if selected_from_state; then
        protocol="$SELECTED_PROTOCOL"
        profile="$SELECTED_PROFILE"
        location="$(profile_name "$profile")"
        config_name="$(basename -- "$profile")"
        interface="$(interface_for_protocol "$protocol")"
        if service_active; then
            service_text="$(msg active)"
            if connection_local_ok "$protocol"; then
                tunnel_ok=1
                public_ip_value="$(public_ip "$interface" 2 || true)"
                if [[ -n "$public_ip_value" ]]; then
                    internet_text="✓ $(msg check_ok)"
                else
                    internet_text="✗ $(msg check_failed)"
                fi
                if [[ "$protocol" == "amneziawg" || "$protocol" == "wireguard" ]]; then
                    handshake="$(latest_handshake "$protocol" "$interface")"
                    if [[ "$handshake" =~ ^[0-9]+$ && "$handshake" -gt 0 ]]; then
                        now="$(date +%s)"
                        handshake_text="$((now - handshake)) $(msg seconds_ago)"
                    fi
                fi
            else
                internet_text="✗ $(msg check_failed)"
            fi
        fi
    fi

    for protocol_name in amneziawg wireguard openvpn l2tp; do
        load_profiles "$protocol_name"
        count="${#PROFILES[@]}"
        counts+="${counts:+  ·  }$(protocol_title "$protocol_name")=$count"
    done

    print_logo
    printf '%s╭─ %s ───────────────────────────────────────────────╮%s\n' \
        "$C_BOLD" "$(msg connection)" "$C_RESET"
    if [[ -n "$profile" ]]; then
        printf '│  %s●%s %-18s  %s: %s\n' \
            "$([[ "$service_text" == "$(msg active)" ]] && printf '%s' "$C_GREEN" || printf '%s' "$C_YELLOW")" \
            "$C_RESET" "$service_text" "$(msg internet)" "$internet_text"
        printf '│  ◆ %s: %s\n' "$(msg location)" "$location"
        printf '│  ◇ %s: %s\n' "$(msg protocol_label)" "$(protocol_title "$protocol")"
        printf '│  ★ %s: %s\n' "$(msg default_config)" "$config_name"
        printf '│  ↳ %s: %s' "$(msg interface_label)" "${interface:-$(msg not_available)}"
        if ((tunnel_ok)) && [[ -n "$handshake_text" ]]; then
            printf '  ·  %s: %s' "$(msg handshake_label)" "$handshake_text"
        fi
        printf '\n'
        printf '│  ↳ %s: %s\n' "$(msg public_ip_label)" "${public_ip_value:-$(msg not_available)}"
    else
        printf '│  ○ %s: %s\n' "$(msg selected)" "$(msg no_profile)"
        printf '│  %s: %s\n' "$(msg internet)" "$(msg not_available)"
    fi
    printf '│  ⚙ %s: %s  ·  %s: %s\n' \
        "$(msg autostart_label)" "$autostart_text" "$(msg health_label)" "$health_text"
    printf '│  ⇄ %s: %s\n' "$(msg fallback)" "$fallback_text"
    printf '├─ %s ──────────────────────────────────────────────────┤\n' "$(msg profiles)"
    printf '│  %s\n' "$counts"
    printf '╰────────────────────────────────────────────────────────╯\n'
}

cmd_dashboard() {
    require_profile_access dashboard
    dashboard_render
}

