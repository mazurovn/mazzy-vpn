  mazzy-vpn connect [ПРОТОКОЛ] [ПРОФИЛЬ|НОМЕР]
  mazzy-vpn quick                   быстро подключить default-конфиг
  mazzy-vpn disconnect              отключить VPN
  mazzy-vpn reconnect               переподключить выбранный профиль
  mazzy-vpn dashboard               единый dashboard состояния и проверок
  mazzy-vpn status [--json|--api-json]
                                    краткое состояние или JSON
  mazzy-vpn diagnose                диагностика активного соединения
  mazzy-vpn validate [ПРОТОКОЛ|all] проверить формат всех профилей
  mazzy-vpn probe [ПРОТОКОЛ|all] [--timeout СЕК]
                                    DNS и ping всех VPN-серверов
  mazzy-vpn test [ПРОТОКОЛ] [ПРОФИЛЬ] [--timeout СЕК] [--keep]
  mazzy-vpn test-all [ПРОТОКОЛ|all] [--timeout СЕК]
                                    живой тест каждого туннеля с откатом
  mazzy-vpn emergency [--timeout СЕК] [--protocol ПРОТОКОЛ]
  mazzy-vpn self-test [--offline|--live] [--timeout СЕК]
                                    полная самодиагностика
  mazzy-vpn doctor [--fix]          проверка установки и конфигов
  mazzy-vpn autostart on|off        автоподключение после загрузки
  mazzy-vpn monitor on|off          health-monitor и recovery
  mazzy-vpn import ПРОТОКОЛ ФАЙЛ    безопасно добавить профиль
  mazzy-vpn import-files ФАЙЛ...    распознать и добавить файлы
  mazzy-vpn import-dir ПАПКА [--dry-run] [--force]
                                    распознать и импортировать папку
  mazzy-vpn init-config-dir [ПАПКА] создать структуру для конфигов
  mazzy-vpn remove ПРОТОКОЛ ПРОФИЛЬ удалить профиль
  mazzy-vpn logs [-f]               журнал сервиса
  mazzy-vpn api-info --json         manifest локального API v1
  mazzy-vpn language [ru|en|de|zh|ja|ko]
                                    показать или сменить язык интерфейса
  mazzy-vpn version

Протоколы:
  amneziawg (awg), wireguard (wg), openvpn (ovpn), l2tp (ltp)

Примеры:
  mazzy-vpn
  mazzy-vpn list openvpn
  mazzy-vpn connect amneziawg 2
  sudo mazzy-vpn test openvpn 2 --timeout 60
  mazzy-vpn self-test
  sudo mazzy-vpn test-all openvpn --timeout 30
  sudo mazzy-vpn emergency --timeout 20
  sudo mazzy-vpn doctor --fix

Совместимые aliases: vpnctl, mazzyvpn
EOF
}

stdin_interactive() {
    [[ -t 0 || "${VPNCTL_FORCE_INTERACTIVE:-0}" == "1" ]]
}

canonical_protocol() {
    case "${1,,}" in
        amneziawg|amnezia|awg) printf 'amneziawg\n' ;;
        wireguard|wire|wg) printf 'wireguard\n' ;;
        openvpn|open|ovpn) printf 'openvpn\n' ;;
        l2tp|ltp) printf 'l2tp\n' ;;
        *) return 1 ;;
    esac
}

protocol_title() {
    case "$1" in
        amneziawg) printf 'AmneziaWG' ;;
        wireguard) printf 'WireGuard' ;;
        openvpn) printf 'OpenVPN' ;;
        l2tp) printf 'L2TP/IPsec' ;;
        *) printf '%s' "$1" ;;
    esac
}

effective_config_dir() {
    if [[ -n "$CONFIG_DIR" ]]; then
        printf '%s\n' "$CONFIG_DIR"
    elif [[ -d "$DEFAULT_CONFIG_DIR" ]]; then
        printf '%s\n' "$DEFAULT_CONFIG_DIR"
    elif [[ -d "$SCRIPT_DIR/conf" ]]; then
        printf '%s\n' "$SCRIPT_DIR/conf"
    else
        printf '%s\n' "$DEFAULT_CONFIG_DIR"
    fi
}

protocol_dir() {
    local protocol="$1" base
    base="$(effective_config_dir)"
    if [[ "$protocol" == "amneziawg" && -d "$base/AMNEZIA" ]]; then
        printf '%s\n' "$base/AMNEZIA"
    else
        printf '%s/%s\n' "$base" "$protocol"
    fi
}

safe_profile_basename() {
    local name="$1"
    [[ -n "$name" && "$name" != "." && "$name" != ".." ]] || return 1
    [[ "$name" != *[[:cntrl:]]* ]]
}

load_profiles() {
    local protocol="$1" dir path name
    local -a safe_profiles=()
    PROFILES=()
    dir="$(protocol_dir "$protocol")"
    [[ -d "$dir" ]] || return 0

    while IFS= read -r -d '' path; do
        PROFILES+=("$path")
    done < <(
        case "$protocol" in
            amneziawg|wireguard)
                find "$dir" -maxdepth 1 -type f -name '*.conf' -print0 2>/dev/null | sort -z
                ;;
            openvpn)
                find "$dir" -maxdepth 1 -type f \( -name '*.ovpn' -o -name '*.conf' \) -print0 2>/dev/null | sort -z
                ;;
            l2tp)
                find "$dir" -maxdepth 1 -type f -name '*.nmconnection' -print0 2>/dev/null | sort -z
                ;;
        esac
    )
    for path in "${PROFILES[@]}"; do
        name="$(basename -- "$path")"
        safe_profile_basename "$name" || {
            warn "Профиль пропущен: имя содержит управляющие символы"
            continue
        }
        safe_profiles+=("$path")
    done
    PROFILES=("${safe_profiles[@]}")
}

profile_name() {
    local name
    name="$(basename -- "$1")"
    case "$name" in
        *.nmconnection) name="${name%.nmconnection}" ;;
        *.ovpn) name="${name%.ovpn}" ;;
        *.conf) name="${name%.conf}" ;;
    esac
    printf '%s\n' "$name"
}

profile_endpoint() {
    local protocol="$1" file="$2"
    case "$protocol" in
        openvpn)
            awk '$1 == "remote" {
                port=($3 ~ /^[0-9]+$/ ? $3 : 1194)
                print $2 ":" port
                exit
            }' "$file"
            ;;
        amneziawg|wireguard)
            awk -F= '
                /^[[:space:]]*Endpoint[[:space:]]*=/ {
                    sub(/^[^=]*=[[:space:]]*/, "")
                    sub(/[[:space:]]*$/, "")
                    print
                    exit
                }
            ' "$file"
            ;;
        l2tp)
            awk -F= '
                /^\[vpn\]$/ { in_vpn=1; next }
                /^\[/ { in_vpn=0 }
                in_vpn && ($1 == "gateway" || $1 == "remote") {
                    sub(/^[^=]*=/, "")
                    print
                    exit
                }
            ' "$file"
            ;;
    esac
}

endpoint_host() {
    local endpoint="$1"
    if [[ "$endpoint" =~ ^\[([^]]+)\](:[0-9]+)?$ ]]; then
        printf '%s\n' "${BASH_REMATCH[1]}"
    elif [[ "$endpoint" == *:* ]]; then
        printf '%s\n' "${endpoint%:*}"
    else
        printf '%s\n' "$endpoint"
    fi
}

endpoint_port() {
    local endpoint="$1"
    if [[ "$endpoint" =~ :([0-9]+)$ ]]; then
        printf '%s\n' "${BASH_REMATCH[1]}"
    fi
}

validate_endpoint() {
    local protocol="$1" file="$2" endpoint host port
    endpoint="$(profile_endpoint "$protocol" "$file")"
    host="$(endpoint_host "$endpoint")"
    port="$(endpoint_port "$endpoint")"
    [[ -n "$host" && "$host" != -* && "$host" != *[[:space:]]* ]] || return 1
    if [[ "$protocol" != "l2tp" ]]; then
        [[ "$port" =~ ^[0-9]+$ ]] && ((10#$port >= 1 && 10#$port <= 65535)) ||
            return 1
    fi
}

openvpn_parser_ok() {
    local file="$1"
    command -v openvpn >/dev/null 2>&1 || return 0
    timeout 10 openvpn --config "$file" --verb 0 --show-tls >/dev/null 2>&1
}

resolve_profile() {
    local protocol="$1" requested="${2:-}" i display exact="" index
    load_profiles "$protocol"
    ((${#PROFILES[@]} > 0)) || {
        error "Для $(protocol_title "$protocol") нет профилей в $(protocol_dir "$protocol")"
        return 1
    }

    if [[ -z "$requested" ]]; then
        if ! stdin_interactive; then
            error "Укажите профиль или его номер. Список: $CLI_COMMAND list $protocol"
            return 1
        fi
        print_profile_list "$protocol"
        read -r -p "$(msg server_number)" requested
    fi

    if [[ "$requested" =~ ^[0-9]+$ ]]; then
        index=$((10#$requested))
        if ((index >= 1 && index <= ${#PROFILES[@]})); then
            SELECTED_PROFILE="${PROFILES[index - 1]}"
            return 0
        fi
    fi

    for ((i = 0; i < ${#PROFILES[@]}; i++)); do
        display="$(profile_name "${PROFILES[i]}")"
        if [[ "$requested" == "$display" || "$requested" == "$(basename -- "${PROFILES[i]}")" ]]; then
            SELECTED_PROFILE="${PROFILES[i]}"
            return 0
        fi
        if [[ "${requested,,}" == "${display,,}" ]]; then
            [[ -z "$exact" ]] || {
                error "Имя '$requested' неоднозначно; используйте точное имя или номер"
                return 1
            }
            exact="${PROFILES[i]}"
        fi
    done

    if [[ -n "$exact" ]]; then
        SELECTED_PROFILE="$exact"
        return 0
    fi
    error "Профиль '$requested' не найден для $(protocol_title "$protocol")"
    return 1
}

print_profile_list() {
    local protocol="$1" i endpoint
    load_profiles "$protocol"
    printf '\n%s%s%s\n' "$C_BOLD" "$(protocol_title "$protocol")" "$C_RESET"
    if ((${#PROFILES[@]} == 0)); then
        printf '  Профилей нет: %s\n' "$(protocol_dir "$protocol")"
        return 0
    fi
    for ((i = 0; i < ${#PROFILES[@]}; i++)); do
        endpoint="$(profile_endpoint "$protocol" "${PROFILES[i]}")"
        printf '  %2d. %-42s' "$((i + 1))" "$(profile_name "${PROFILES[i]}")"
        [[ -n "$endpoint" ]] && printf ' %s' "$endpoint"
        printf '\n'
    done
}

state_get() {
    local key="$1"
    [[ -r "$STATE_FILE" ]] || return 1
    awk -F= -v wanted="$key" '
        $1 == wanted {
            sub(/^[^=]*=/, "")
            print
            exit
        }
    ' "$STATE_FILE"
}

write_state() {
    local protocol="$1" file="$2" desired="$3" mode="${4:-normal}"
    local test_token="${5:-}" test_deadline="${6:-}" tmp
    mkdir -p "$STATE_DIR"
    chmod 700 "$STATE_DIR"
    tmp="$STATE_DIR/.active.$$"
    umask 077
    {
        printf 'PROTOCOL=%s\n' "$protocol"
        printf 'PROFILE=%s\n' "$(basename -- "$file")"
        printf 'DESIRED=%s\n' "$desired"
        printf 'MODE=%s\n' "$mode"
        if [[ "$mode" == "test" ]]; then
            printf 'TEST_TOKEN=%s\n' "$test_token"
            printf 'TEST_DEADLINE=%s\n' "$test_deadline"
        fi
    } >"$tmp"
    chmod 600 "$tmp"
    mv -f "$tmp" "$STATE_FILE"
}

set_desired_state() {
    local desired="$1" protocol profile
    protocol="$(state_get PROTOCOL 2>/dev/null || true)"
    profile="$(state_get PROFILE 2>/dev/null || true)"
    [[ -n "$protocol" && -n "$profile" ]] || return 1
    resolve_profile "$protocol" "$profile" >/dev/null || return 1
    write_state "$protocol" "$SELECTED_PROFILE" "$desired"
}

selected_from_state() {
    local protocol profile
    protocol="$(state_get PROTOCOL 2>/dev/null || true)"
    profile="$(state_get PROFILE 2>/dev/null || true)"
    [[ -n "$protocol" && -n "$profile" ]] || return 1
    protocol="$(canonical_protocol "$protocol" 2>/dev/null)" || return 1
    resolve_profile "$protocol" "$profile" >/dev/null || return 1
    SELECTED_PROTOCOL="$protocol"
    return 0
}

require_root() {
    if ((EUID == 0)) || [[ "${VPNCTL_ALLOW_UNPRIVILEGED:-0}" == "1" ]]; then
        return 0
    fi
    command -v sudo >/dev/null 2>&1 || die "Нужны права root; sudo не найден"
    info "Для изменения VPN нужны права администратора"
    exec sudo -- "$SELF" "$@"
}

require_profile_access() {
    local base
    base="$(effective_config_dir)"
    if [[ "$base" == "$DEFAULT_CONFIG_DIR" && ! -r "$base" ]]; then
        require_root "$@"
    fi
}

api_client_candidate() {
    [[ "${VPNCTL_API_SERVER_CONTEXT:-0}" != "1" &&
       "${VPNCTL_API_CLIENT_DISABLE:-0}" != "1" ]] || return 1
    ((EUID != 0)) || [[ "${VPNCTL_API_CLIENT_FORCE:-0}" == "1" ]] || return 1
    [[ -S "$API_SOCKET" || "${VPNCTL_API_CLIENT_FORCE:-0}" == "1" ]]
}

api_client_ready() {
    local dependency
    api_client_candidate || return 1
    for dependency in head jq socat timeout; do
        command -v "$dependency" >/dev/null 2>&1 ||
            die "$(msg api_dependency_missing "$dependency")"
    done
    [[ "$API_CLIENT_MAX_RESPONSE_BYTES" =~ ^[1-9][0-9]*$ ]] ||
        API_CLIENT_MAX_RESPONSE_BYTES=65536
    ((API_CLIENT_MAX_RESPONSE_BYTES <= 1048576)) ||
        API_CLIENT_MAX_RESPONSE_BYTES=65536
}

api_client_identifier() {
    local prefix="$1" token=""
    if [[ -r /proc/sys/kernel/random/uuid ]]; then
        IFS= read -r token </proc/sys/kernel/random/uuid || token=""
        token="${token//-/}"
    fi
    if [[ -z "$token" ]]; then
        token="$(
            printf '%s:%s:%s:%s' "$(date +%s%N)" "$$" "$RANDOM" "$prefix" |
                sha256sum |
                awk '{ print substr($1, 1, 32) }'
        )"
    fi
    printf '%s-%s\n' "$prefix" "$token"
}

api_client_send() {
    local request="$1" request_id deadline_ms timeout_seconds response="" rc=1 attempt
    request_id="$(jq -r '.request_id // ""' <<<"$request")"
    deadline_ms="$(jq -r '.deadline_ms // 5000' <<<"$request")"
    [[ "$deadline_ms" =~ ^[0-9]+$ ]] || deadline_ms=5000
    timeout_seconds=$(((deadline_ms + 999) / 1000 + 5))
    ((timeout_seconds >= 10)) || timeout_seconds=10
    ((timeout_seconds <= 905)) || timeout_seconds=905

    for attempt in 1 2; do
        response="$(
            printf '%s\n' "$request" |
                timeout --foreground --kill-after=2s "${timeout_seconds}s" \
                    socat -T "$timeout_seconds" - "UNIX-CONNECT:$API_SOCKET" \
                    2>/dev/null |
                head -c "$((API_CLIENT_MAX_RESPONSE_BYTES + 1))"
        )"
        rc=$?
        if ((rc == 0)) &&
           ((${#response} > 0 && ${#response} <= API_CLIENT_MAX_RESPONSE_BYTES)) &&
           jq -e --arg request_id "$request_id" '
               .api_version == "1.0"
               and .request_id == $request_id
               and (.status == "ok" or .status == "error")
           ' <<<"$response" >/dev/null 2>&1; then
            printf '%s\n' "$response"
            return 0
        fi
    done
    return 70
}

api_client_query() {
    local operation="$1" request_id request
    request_id="$(api_client_identifier request)"
    request="$(
        jq -cn \
            --arg request_id "$request_id" \
            --arg operation "$operation" \
            '{
                api_version: "1.0",
                request_id: $request_id,
                operation: $operation,
                payload: {}
            }'
    )"
    api_client_send "$request"
}

api_client_fetch_profiles() {
    local response
    response="$(api_client_query profiles.list)" || {
        error "$(msg api_profiles_unavailable)"
        return 70
    }
    if [[ "$(jq -r '.status' <<<"$response")" != "ok" ]]; then
        error "Local API: $(jq -r '.error.code + ": " + .error.message_key' <<<"$response")"
        return 1
    fi
    API_CLIENT_PROFILES="$(jq -c '.result.profiles // []' <<<"$response")"
}

api_client_print_profile_list() {
    local protocol="$1" entry index=0 name selected
    local -a entries=()
    mapfile -t entries < <(
        jq -c --arg protocol "$protocol" '
            .[] | select(.protocol == $protocol)
        ' <<<"$API_CLIENT_PROFILES"
    )
    printf '\n%s%s%s\n' "$C_BOLD" "$(protocol_title "$protocol")" "$C_RESET"
    if ((${#entries[@]} == 0)); then
        printf '  %s\n' "$(msg api_empty_profiles)"
        return 0
    fi
    for entry in "${entries[@]}"; do
        index=$((index + 1))
        name="$(jq -r '.display_name' <<<"$entry")"
        selected="$(jq -r '.selected // false' <<<"$entry")"
        printf '  %2d. %s' "$index" "$name"
        [[ "$selected" == "true" ]] && printf '  *'
        printf '\n'
    done
}

api_client_choose_protocol() {
    local answer protocol count index=1
    stdin_interactive || {
        error "$(msg api_protocol_required)"
        return 1
    }
    printf '\n%s\n' "$(msg choose_protocol)" >&2
    for protocol in amneziawg wireguard openvpn l2tp; do
        count="$(
            jq -r --arg protocol "$protocol" '
                map(select(.protocol == $protocol)) | length
            ' <<<"$API_CLIENT_PROFILES"
        )"
        printf '  %d. %-12s %s: %-3d\n' "$index" \
            "$(protocol_title "$protocol")" "$(msg profile_count)" "$count" >&2
        index=$((index + 1))
    done
    read -r -p "$(msg protocol_number)" answer
    case "$answer" in
        1) printf 'amneziawg\n' ;;
        2) printf 'wireguard\n' ;;
        3) printf 'openvpn\n' ;;
        4) printf 'l2tp\n' ;;
        *) error "$(msg invalid_protocol)"; return 1 ;;
    esac
}

api_client_resolve_profile() {
    local requested_protocol="${1:-}" requested_profile="${2:-}" protocol
    local matches selected="" match_count index
    api_client_fetch_profiles || return
    if [[ -z "$requested_protocol" ]]; then
        protocol="$(api_client_choose_protocol)" || return 1
    else
        protocol="$(canonical_protocol "$requested_protocol")" ||
            die "$(msg api_unknown_protocol "$requested_protocol")"
    fi
    matches="$(
        jq -c --arg protocol "$protocol" '
            [.[] | select(.protocol == $protocol)]
        ' <<<"$API_CLIENT_PROFILES"
    )"
    match_count="$(jq -r 'length' <<<"$matches")"
    ((match_count > 0)) || {
        error "$(msg api_no_profiles "$(protocol_title "$protocol")")"
        return 1
    }
    if [[ -z "$requested_profile" ]]; then
        stdin_interactive || {
            error "$(msg api_profile_required "$CLI_COMMAND" "$protocol")"
            return 1
        }
        api_client_print_profile_list "$protocol" >&2
        read -r -p "$(msg server_number)" requested_profile
    fi
    if [[ "$requested_profile" =~ ^[0-9]+$ ]]; then
        index=$((10#$requested_profile))
        if ((index >= 1 && index <= match_count)); then
            selected="$(jq -c --argjson index "$((index - 1))" '.[$index]' <<<"$matches")"
        fi
    else
        selected="$(
            jq -c --arg requested "$requested_profile" '
                [.[] | select(.display_name == $requested)] | first // empty
            ' <<<"$matches"
        )"
        if [[ -z "$selected" ]]; then
            match_count="$(
                jq -r --arg requested "${requested_profile,,}" '
                    [.[] | select((.display_name | ascii_downcase) == $requested)] | length
                ' <<<"$matches"
            )"
            if ((match_count == 1)); then
                selected="$(
                    jq -c --arg requested "${requested_profile,,}" '
                        [.[] | select((.display_name | ascii_downcase) == $requested)] | first
                    ' <<<"$matches"
                )"
            elif ((match_count > 1)); then
                error "$(msg api_profile_ambiguous "$requested_profile")"
                return 1
            fi
        fi
    fi
    [[ -n "$selected" && "$selected" != "null" ]] || {
        error "$(msg api_profile_not_found "$requested_profile" \
            "$(protocol_title "$protocol")")"
        return 1
    }
    API_CLIENT_SELECTED_PROFILE_ID="$(jq -r '.profile_id' <<<"$selected")"
    API_CLIENT_SELECTED_PROFILE_NAME="$(jq -r '.display_name' <<<"$selected")"
    API_CLIENT_SELECTED_PROTOCOL="$protocol"
}

api_client_mutation() {
    local operation="$1" payload="$2" deadline_ms="$3"
    local action_id request_id request response status state code message
    action_id="$(api_client_identifier action)"
    request_id="$(api_client_identifier request)"
    request="$(
        jq -cn \
            --arg request_id "$request_id" \
            --arg operation "$operation" \
            --arg action_id "$action_id" \
            --argjson deadline_ms "$deadline_ms" \
            --argjson payload "$payload" \
            '{
                api_version: "1.0",
                request_id: $request_id,
                operation: $operation,
                action_id: $action_id,
                authorization: "system-mutate",
                deadline_ms: $deadline_ms,
                payload: $payload
            }'
    )"
    response="$(api_client_send "$request")" || {
        error "$(msg api_lost_response)"
        error "$(msg api_action_id "$action_id")"
        return 70
    }
    status="$(jq -r '.status' <<<"$response")"
    if [[ "$status" != "ok" ]]; then
        code="$(jq -r '.error.code // "internal-error"' <<<"$response")"
        message="$(jq -r '.error.message_key // "api.response.malformed"' <<<"$response")"
        error "$(msg api_rejected "$code" "$message")"
        [[ "$code" != "busy" ]] ||
            error "$(msg api_action_id "$action_id")"
        return 1
    fi
    state="$(jq -r '.result.state // "failed"' <<<"$response")"
    if [[ "$state" != "succeeded" ]]; then
        message="$(jq -r '.result.message_key // "api.response.malformed"' <<<"$response")"
        error "$(msg api_failed_state "$state" "$message")"
        return 1
    fi
}

api_client_cmd_connect() {
    api_client_resolve_profile "${1:-}" "${2:-}" || return
    info "$(msg api_selected "$(protocol_title "$API_CLIENT_SELECTED_PROTOCOL")" \
        "$API_CLIENT_SELECTED_PROFILE_NAME")"
    api_client_mutation lifecycle.connect \
        "$(jq -cn --arg profile_id "$API_CLIENT_SELECTED_PROFILE_ID" \
            '{profile_id: $profile_id}')" 60000 || return
    say "$(msg api_connect_started "$CLI_COMMAND")"
}

api_client_cmd_disconnect() {
    (($# == 0)) || die "Использование: $CLI_COMMAND disconnect"
    api_client_mutation lifecycle.disconnect '{}' 30000 || return
    say "$(msg api_disconnected)"
}

api_client_cmd_reconnect() {
    (($# == 0)) || die "Использование: $CLI_COMMAND reconnect"
    api_client_mutation lifecycle.reconnect '{}' 30000 || return
    say "$(msg api_reconnect_started)"
}

api_client_cmd_quick() {
    local response state profile_id profile_name=""
    (($# == 0)) || die "Использование: $CLI_COMMAND quick"
    response="$(api_client_query status.get)" || {
        error "$(msg api_status_unavailable)"
        return 70
    }
    [[ "$(jq -r '.status' <<<"$response")" == "ok" ]] || {
        error "$(msg api_status_invalid)"
        return 1
    }
    state="$(jq -r '.result.connection.state // "unknown"' <<<"$response")"
    profile_id="$(jq -r '.result.connection.profile_id // ""' <<<"$response")"
    api_client_fetch_profiles || return
    if [[ -n "$profile_id" ]]; then
        profile_name="$(
            jq -r --arg profile_id "$profile_id" '
                [.[] | select(.profile_id == $profile_id) | .display_name] |
                first // ""
            ' <<<"$API_CLIENT_PROFILES"
        )"
    fi
    if [[ "$state" == "connected" &&
          "$(jq -r '.result.connection.healthy // false' <<<"$response")" == "true" ]]; then
        say "$(msg already_connected)${profile_name:+: $profile_name}"
        return 0
    fi
    if [[ -z "$profile_id" ]]; then
        info "$(msg no_default)"
        api_client_cmd_connect
        return
    fi
    api_client_cmd_reconnect
}

api_client_cmd_status() {
    local response state profile_id="" protocol="" profile_name=""
    local desired mode interface public_ip handshake_age fallback_active fallback_name
    (($# == 0)) || die "Использование: $CLI_COMMAND status"
    response="$(api_client_query status.get)" || {
        error "$(msg api_status_unavailable)"
        return 70
    }
    [[ "$(jq -r '.status' <<<"$response")" == "ok" ]] || {
        error "$(msg api_status_invalid)"
        return 1
    }
    state="$(jq -r '.result.connection.state // "unknown"' <<<"$response")"
    profile_id="$(jq -r '.result.connection.profile_id // ""' <<<"$response")"
    protocol="$(jq -r '.result.connection.protocol // ""' <<<"$response")"
    if [[ -n "$profile_id" ]]; then
        api_client_fetch_profiles || return
        profile_name="$(
            jq -r --arg profile_id "$profile_id" '
                [.[] | select(.profile_id == $profile_id) | .display_name] |
                first // ""
            ' <<<"$API_CLIENT_PROFILES"
        )"
    fi
    if [[ "$state" == "connected" ]]; then
        printf 'VPN:       active\n'
    else
        printf 'VPN:       %s\n' "$state"
    fi
    [[ -z "$protocol" ]] || printf 'Protocol:  %s\n' "$(protocol_title "$protocol")"
    [[ -z "$profile_name" ]] || printf 'Profile:   %s\n' "$profile_name"
    printf 'Internet:  %s\n' \
        "$(jq -r 'if .result.connection.internet_reachable then "reachable" else "unreachable" end' <<<"$response")"
    printf 'Healthy:   %s\n' \
        "$(jq -r 'if .result.connection.healthy then "yes" else "no" end' <<<"$response")"
    desired="$(jq -r '.result.desired // ""' <<<"$response")"
    mode="$(jq -r '.result.mode // ""' <<<"$response")"
    interface="$(jq -r '.result.connection.interface // ""' <<<"$response")"
    public_ip="$(jq -r '.result.connection.public_ip // ""' <<<"$response")"
    handshake_age="$(jq -r '.result.connection.handshake_age // ""' <<<"$response")"
    fallback_active="$(jq -r '.result.fallback.active // false' <<<"$response")"
    fallback_name="$(jq -r '.result.fallback.display_name // ""' <<<"$response")"
    [[ -z "$desired" ]] || printf 'Desired:   %s\n' "$desired"
    [[ -z "$mode" ]] || printf 'Mode:      %s\n' "$mode"
    if jq -e '.result | has("autostart")' <<<"$response" >/dev/null; then
        printf 'Autostart: %s\n' \
            "$(jq -r 'if .result.autostart then "enabled" else "disabled" end' <<<"$response")"
    fi
    if jq -e '.result | has("health_monitor")' <<<"$response" >/dev/null; then
        printf 'Monitor:   %s\n' \
            "$(jq -r 'if .result.health_monitor then "enabled" else "disabled" end' <<<"$response")"
    fi
    if [[ "$fallback_active" == "true" ]]; then
        printf 'Fallback:  active%s\n' "${fallback_name:+ ($fallback_name)}"
    elif jq -e '.result | has("fallback")' <<<"$response" >/dev/null; then
        printf 'Fallback:  inactive\n'
    fi
    [[ -z "$interface" ]] || printf 'Interface: %s\n' "$interface"
    [[ -z "$handshake_age" ]] ||
        printf 'Handshake: %s sec ago\n' "$handshake_age"
    [[ -z "$public_ip" ]] || printf 'Public IP: %s\n' "$public_ip"
    [[ "$state" == "connected" ]]
}

api_client_dashboard_render() {
    local response state profile_id="" protocol="" profile_name="" counts=""
    local protocol_name count service_text internet_text interface public_ip
    local handshake_age autostart_text monitor_text fallback_text fallback_name
    response="$(api_client_query status.get)" || {
        error "$(msg api_dashboard_unavailable)"
        return 70
    }
    [[ "$(jq -r '.status' <<<"$response")" == "ok" ]] || {
        error "$(msg api_dashboard_invalid)"
        return 1
    }
    api_client_fetch_profiles || return
    state="$(jq -r '.result.connection.state // "unknown"' <<<"$response")"
    profile_id="$(jq -r '.result.connection.profile_id // ""' <<<"$response")"
    protocol="$(jq -r '.result.connection.protocol // ""' <<<"$response")"
    interface="$(jq -r '.result.connection.interface // ""' <<<"$response")"
    public_ip="$(jq -r '.result.connection.public_ip // ""' <<<"$response")"
    handshake_age="$(jq -r '.result.connection.handshake_age // ""' <<<"$response")"
    if [[ "$(jq -r '.result.autostart // false' <<<"$response")" == "true" ]]; then
        autostart_text="$(msg enabled)"
    else
        autostart_text="$(msg disabled)"
    fi
    if [[ "$(jq -r '.result.health_monitor // false' <<<"$response")" == "true" ]]; then
        monitor_text="$(msg enabled)"
    else
        monitor_text="$(msg disabled)"
    fi
    if [[ "$(jq -r '.result.fallback.active // false' <<<"$response")" == "true" ]]; then
        fallback_name="$(jq -r '.result.fallback.display_name // ""' <<<"$response")"
        fallback_text="$(msg active)${fallback_name:+ ($fallback_name)}"
    else
        fallback_text="$(msg fallback_none)"
    fi
    if [[ -n "$profile_id" ]]; then
        profile_name="$(
            jq -r --arg profile_id "$profile_id" '
                [.[] | select(.profile_id == $profile_id) | .display_name] |
                first // ""
            ' <<<"$API_CLIENT_PROFILES"
        )"
    fi
    for protocol_name in amneziawg wireguard openvpn l2tp; do
        count="$(
            jq -r --arg protocol "$protocol_name" '
                map(select(.protocol == $protocol)) | length
            ' <<<"$API_CLIENT_PROFILES"
        )"
        counts+="${counts:+  ·  }$(protocol_title "$protocol_name")=$count"
    done
    case "$state" in
        connected|connecting|testing) service_text="$(msg active)" ;;
        *) service_text="$(msg stopped)" ;;
    esac
    if [[ "$(jq -r '.result.connection.internet_reachable // false' <<<"$response")" == "true" ]]; then
        internet_text="✓ $(msg check_ok)"
    else
        internet_text="✗ $(msg check_failed)"
    fi

    print_logo
    printf '%s╭─ %s ───────────────────────────────────────────────╮%s\n' \
        "$C_BOLD" "$(msg connection)" "$C_RESET"
    if [[ -n "$profile_name" ]]; then
        printf '│  %s●%s %-18s  %s: %s\n' \
            "$([[ "$state" == "connected" ]] && printf '%s' "$C_GREEN" || printf '%s' "$C_YELLOW")" \
            "$C_RESET" "$service_text" "$(msg internet)" "$internet_text"
        printf '│  ◆ %s: %s\n' "$(msg location)" "$profile_name"
        printf '│  ◇ %s: %s\n' "$(msg protocol_label)" "$(protocol_title "$protocol")"
        printf '│  ★ %s: %s\n' "$(msg default_config)" "$profile_name"
        printf '│  ↳ API: 1.0  ·  %s: %s\n' \
            "$(msg connection_health_label)" \
            "$(jq -r 'if .result.connection.healthy then "OK" else "WARN" end' <<<"$response")"
        if [[ -n "$interface" || -n "$public_ip" ]]; then
            printf '│  ↳ %s: %s  ·  %s: %s\n' \
                "$(msg interface_label)" "${interface:--}" \
                "$(msg public_ip_label)" "${public_ip:--}"
        fi
        [[ -z "$handshake_age" ]] ||
            printf '│  ↳ %s: %s sec ago\n' \
                "$(msg handshake_label)" "$handshake_age"
        printf '│  ↳ %s: %s  ·  %s: %s\n' \
            "$(msg autostart_label)" "$autostart_text" \
            "$(msg health_label)" "$monitor_text"
        printf '│  ↳ %s: %s\n' "$(msg fallback)" "$fallback_text"
    else
        printf '│  ○ %s: %s\n' "$(msg selected)" "$(msg no_profile)"
        printf '│  %s: %s\n' "$(msg internet)" "$(msg not_available)"
    fi
    printf '├─ %s ──────────────────────────────────────────────────┤\n' "$(msg profiles)"
    printf '│  %s\n' "$counts"
    printf '╰────────────────────────────────────────────────────────╯\n'
}

systemd_available() {
    command -v systemctl >/dev/null 2>&1 &&
        [[ -d /run/systemd/system || "${VPNCTL_ALLOW_UNPRIVILEGED:-0}" == "1" ]]
}

systemctl_quiet() {
    systemctl "$@" >/dev/null 2>&1
}

validate_permissions() {
    local file="$1" mode
    mode="$(stat -c '%a' "$file" 2>/dev/null || printf '777')"
    [[ "$mode" == "600" || "$mode" == "400" ]]
}

has_directive() {
    local file="$1" directive="$2"
    grep -Eiq "^[[:space:]]*${directive}([[:space:]=]|$)" "$file"
}

validate_profile() {
    local protocol="$1" file="$2" quiet="${3:-0}" bad=0 unsafe
    [[ -f "$file" ]] || {
        ((quiet)) || check_fail "Профиль отсутствует: $file"
        return 1
    }

    if ! validate_permissions "$file"; then
        ((quiet)) || check_warn "Небезопасные права $(stat -c '%a' "$file" 2>/dev/null): $file"
    elif ((quiet == 0)); then
        check_ok "Права профиля закрыты: $(basename -- "$file")"
    fi

    case "$protocol" in
        amneziawg|wireguard)
            for unsafe in PreUp PostUp PreDown PostDown; do
                if has_directive "$file" "$unsafe"; then
                    ((quiet)) || check_fail "$file содержит выполняемую команду $unsafe"
                    bad=1
                fi
            done
            for unsafe in '\[Interface\]' PrivateKey '\[Peer\]' PublicKey AllowedIPs Endpoint; do
                if ! grep -Eq "^[[:space:]]*${unsafe}([[:space:]=]|$)" "$file"; then
                    ((quiet)) || check_fail "$file: отсутствует $unsafe"
                    bad=1
                fi
            done
            if [[ "$protocol" == "amneziawg" ]]; then
                for unsafe in Jc Jmin Jmax S1 S2 H1 H2 H3 H4; do
                    if ! has_directive "$file" "$unsafe"; then
                        ((quiet)) || check_fail "$file: отсутствует параметр AmneziaWG $unsafe"
                        bad=1
                    fi
                done
            fi
            ;;
        openvpn)
            for unsafe in up down route-up route-pre-down ipchange plugin \
                tls-verify auth-user-pass-verify client-connect client-disconnect \
                learn-address config tls-crypt-v2-verify client-crresponse iproute \
                script-security management management-client-auth cd chroot daemon \
                log log-append status writepid syslog; do
                if has_directive "$file" "$unsafe"; then
                    ((quiet)) || check_fail "$file содержит запрещённую выполняемую директиву $unsafe"
                    bad=1
                fi
            done
            for unsafe in client remote dev; do
                if ! has_directive "$file" "$unsafe"; then
                    ((quiet)) || check_fail "$file: отсутствует директива $unsafe"
                    bad=1
                fi
            done
            ;;
        l2tp)
            if ! grep -Eq '^[[:space:]]*type[[:space:]]*=[[:space:]]*vpn[[:space:]]*$' "$file" ||
               ! grep -Eiq '^[[:space:]]*service-type[[:space:]]*=.*l2tp' "$file"; then
                ((quiet)) || check_fail "$file не является профилем NetworkManager L2TP"
                bad=1
            fi
            for unsafe in id gateway; do
                if ! has_directive "$file" "$unsafe"; then
                    ((quiet)) || check_fail "$file: отсутствует параметр L2TP $unsafe"
                    bad=1
                fi
            done
            if grep -q 'CHANGE_ME' "$file"; then
                ((quiet)) || check_fail "$file содержит незаполненные значения CHANGE_ME"
                bad=1
            fi
            ;;
        *)
            ((quiet)) || check_fail "Неизвестный протокол: $protocol"
            return 1
            ;;
    esac
    if ! validate_endpoint "$protocol" "$file"; then
        ((quiet)) || check_fail "$file: endpoint отсутствует или имеет неверный host/port"
        bad=1
    fi
    if [[ "$protocol" == "openvpn" && "$bad" -eq 0 ]] &&
       ! openvpn_parser_ok "$file"; then
        ((quiet)) || check_fail "$file: OpenVPN отклонил конфигурацию при безопасном разборе"
        bad=1
    fi
    ((bad == 0))
}

requested_protocols() {
    local requested="${1:-all}" protocol
    if [[ "$requested" == "all" ]]; then
        printf '%s\n' amneziawg wireguard openvpn l2tp
        return 0
    fi
    protocol="$(canonical_protocol "$requested")" || return 1
    printf '%s\n' "$protocol"
}

cmd_validate() {
    local requested="${1:-all}" protocol file total=0 passed=0 failed=0
    local -a protocols=()
    require_profile_access validate "$@"
    mapfile -t protocols < <(requested_protocols "$requested") ||
        die "Неизвестный протокол: $requested"
    say "Проверка VPN-профилей (формат, безопасность, права, endpoint)"
    for protocol in "${protocols[@]}"; do
        load_profiles "$protocol"
        if ((${#PROFILES[@]} == 0)); then
            warn "$(protocol_title "$protocol"): профилей нет"
            continue
        fi
        for file in "${PROFILES[@]}"; do
            total=$((total + 1))
            if validate_profile "$protocol" "$file" 1 &&
               validate_permissions "$file"; then
                passed=$((passed + 1))
                printf '[ OK ] %-11s %s\n' "$(protocol_title "$protocol")" \
                    "$(profile_name "$file")"
            else
                failed=$((failed + 1))
                printf '[FAIL] %-11s %s\n' "$(protocol_title "$protocol")" \
                    "$(profile_name "$file")"
                validate_profile "$protocol" "$file" 0 || true
                validate_permissions "$file" ||
                    check_fail "Небезопасные права: $(stat -c '%a' "$file" 2>/dev/null) $file"
            fi
        done
    done
    printf '\nИтог: profiles=%d passed=%d failed=%d\n' "$total" "$passed" "$failed"
    ((total > 0 && failed == 0))
}

profile_transport() {
    local protocol="$1" file="$2"
    case "$protocol" in
        openvpn)
            awk '
                $1 == "proto" { proto=tolower($2) }
                $1 == "remote" && NF >= 4 { remote_proto=tolower($4) }
                END {
                    value=(remote_proto != "" ? remote_proto : proto)
                    if (value ~ /^tcp/) print "tcp"; else print "udp"
                }
            ' "$file"
            ;;
        *) printf 'udp\n' ;;
    esac
}

ping_host() {
    local host="$1" timeout="$2"
    command -v ping >/dev/null 2>&1 || return 2
    if [[ "$host" == *:* ]]; then
        ping -6 -n -c 1 -W "$timeout" -- "$host" >/dev/null 2>&1
    else
        ping -4 -n -c 1 -W "$timeout" -- "$host" >/dev/null 2>&1
    fi
}

probe_profile() {
    local protocol="$1" file="$2" timeout="$3"
    local endpoint host port transport ping_rc=0
    endpoint="$(profile_endpoint "$protocol" "$file")"
    host="$(endpoint_host "$endpoint")"
    port="$(endpoint_port "$endpoint")"
    transport="$(profile_transport "$protocol" "$file")"

    validate_endpoint "$protocol" "$file" || return 3
    if ! getent ahosts "$host" >/dev/null 2>&1; then
        return 4
    fi
    ping_host "$host" "$timeout" || ping_rc=$?
    if [[ "$transport" == "tcp" && -n "$port" && -x "$(command -v nc 2>/dev/null)" ]]; then
        nc -z -w "$timeout" "$host" "$port" >/dev/null 2>&1 || return 5
    fi
    return "$ping_rc"
}

cmd_probe() {
    local requested="all" timeout="$DEFAULT_PROBE_TIMEOUT" protocol file rc
    local total=0 dns_fail=0 tcp_fail=0 ping_ok=0 ping_blocked=0 no_ping=0
    local -a protocols=()
    require_profile_access probe "$@"
    while (($#)); do
        case "$1" in
            --timeout)
                shift
                [[ $# -gt 0 ]] || die "--timeout требует число секунд"
                timeout="$1"
                ;;
            --help|-h)
                say "Использование: $CLI_COMMAND probe [ПРОТОКОЛ|all] [--timeout 3]"
                return 0
                ;;
            -*)
                die "Неизвестный параметр probe: $1"
                ;;
            *)
                [[ "$requested" == "all" ]] || die "Лишний аргумент probe: $1"
                requested="$1"
                ;;
        esac
        shift
    done
    if ! [[ "$timeout" =~ ^[0-9]+$ ]] ||
       ! ((timeout >= 1 && timeout <= 30)); then
        die "Таймаут probe должен быть от 1 до 30 секунд"
    fi
    mapfile -t protocols < <(requested_protocols "$requested") ||
        die "Неизвестный протокол: $requested"

    say "Проверка endpoint: DNS + ICMP ping; TCP-порты проверяются дополнительно"
    for protocol in "${protocols[@]}"; do
        load_profiles "$protocol"
        for file in "${PROFILES[@]}"; do
            total=$((total + 1))
            rc=0
            probe_profile "$protocol" "$file" "$timeout" || rc=$?
            case "$rc" in
                0)
                    ping_ok=$((ping_ok + 1))
                    printf '[ OK ] %-11s %-36s ping OK\n' \
                        "$(protocol_title "$protocol")" "$(profile_name "$file")"
                    ;;
                2)
                    no_ping=$((no_ping + 1))
                    printf '[WARN] %-11s %-36s ping не установлен\n' \
                        "$(protocol_title "$protocol")" "$(profile_name "$file")"
                    ;;
                1)
                    ping_blocked=$((ping_blocked + 1))
                    printf '[WARN] %-11s %-36s DNS OK, ICMP без ответа\n' \
                        "$(protocol_title "$protocol")" "$(profile_name "$file")"
                    ;;
                3)
                    dns_fail=$((dns_fail + 1))
                    printf '[FAIL] %-11s %-36s неверный endpoint\n' \
                        "$(protocol_title "$protocol")" "$(profile_name "$file")"
                    ;;
                4)
                    dns_fail=$((dns_fail + 1))
                    printf '[FAIL] %-11s %-36s DNS не разрешается\n' \
                        "$(protocol_title "$protocol")" "$(profile_name "$file")"
                    ;;
                5)
                    tcp_fail=$((tcp_fail + 1))
                    printf '[FAIL] %-11s %-36s TCP-порт недоступен\n' \
                        "$(protocol_title "$protocol")" "$(profile_name "$file")"
                    ;;
            esac
        done
    done
    printf '\nИтог: endpoints=%d ping_ok=%d icmp_blocked=%d no_ping=%d hard_fail=%d\n' \
        "$total" "$ping_ok" "$ping_blocked" "$no_ping" "$((dns_fail + tcp_fail))"
    ((total > 0 && dns_fail == 0 && tcp_fail == 0))
}

fix_profile_permissions() {
    local file="$1"
    chmod 600 "$file" || return 1
    check_ok "Исправлены права: $file"
}

cmd_list() {
    local requested="${1:-all}" protocol
    if api_client_ready; then
        api_client_fetch_profiles || return
        if [[ "$requested" == "all" ]]; then
            for protocol in amneziawg wireguard openvpn l2tp; do
                api_client_print_profile_list "$protocol"
            done
            return 0
        fi
        protocol="$(canonical_protocol "$requested")" ||
            die "Неизвестный протокол: $requested"
        api_client_print_profile_list "$protocol"
        return 0
    fi
    require_profile_access list "$@"
    if [[ "$requested" == "all" ]]; then
        for protocol in amneziawg wireguard openvpn l2tp; do
            print_profile_list "$protocol"
        done
        return 0
    fi
    protocol="$(canonical_protocol "$requested")" || die "Неизвестный протокол: $requested"
    print_profile_list "$protocol"
}

profiles_json_live() {
    local protocol file first=true selected_protocol="" selected_file="" opaque_id
    selected_from_state || true
    selected_protocol="${SELECTED_PROTOCOL:-}"
    selected_file="${SELECTED_PROFILE:-}"

    printf '{"schema_version":1,"generated_at":%s,"profiles":[' "$(date +%s)"
    for protocol in amneziawg wireguard openvpn l2tp; do
        load_profiles "$protocol"
        for file in "${PROFILES[@]}"; do
            [[ "$first" == true ]] || printf ','
            first=false
            opaque_id="$(profile_opaque_id "$protocol" "$file")"
            printf '{'
            printf '"profile_id":"%s","protocol":"%s","protocol_name":"%s",' \
                "$(json_escape "$opaque_id")" \
                "$(json_escape "$protocol")" \
                "$(json_escape "$(protocol_title "$protocol")")"
            printf '"file_name":"%s","name":"%s","location":"%s",' \
                "$(json_escape "$(basename -- "$file")")" \
                "$(json_escape "$(profile_name "$file")")" \
                "$(json_escape "$(profile_name "$file")")"
            if [[ "$protocol" == "$selected_protocol" &&
                  "$file" == "$selected_file" ]]; then
                printf '"selected":true'
            else
                printf '"selected":false'
            fi
            printf '}'
        done
    done
    printf ']}\n'
}

profile_opaque_id() {
    local protocol="$1" file="$2" digest
    digest="$(
        printf '%s\000%s' "$protocol" "$(basename -- "$file")" |
            sha256sum |
            awk '{ print substr($1, 1, 32) }'
    )"
    printf 'profile-%s\n' "$digest"
}

prepare_dashboard_dir() {
    mkdir -p -- "$DASHBOARD_DIR" || return 1
    if ((EUID == 0)); then
        if getent group "$RUNTIME_READER_GROUP" >/dev/null 2>&1; then
            chown -- "root:$RUNTIME_READER_GROUP" "$DASHBOARD_DIR" || return 1
            chmod 750 -- "$DASHBOARD_DIR" || return 1
        else
            chown -- root:root "$DASHBOARD_DIR" || return 1
            chmod 700 -- "$DASHBOARD_DIR" || return 1
        fi
    else
        chmod 750 -- "$DASHBOARD_DIR" || return 1
    fi
}

protect_dashboard_cache() {
    local target="$1"
    if ((EUID == 0)); then
        if getent group "$RUNTIME_READER_GROUP" >/dev/null 2>&1; then
            chown -- "root:$RUNTIME_READER_GROUP" "$target" || return 1
            chmod 640 -- "$target" || return 1
        else
            chown -- root:root "$target" || return 1
            chmod 600 -- "$target" || return 1
        fi
    else
        chmod 640 -- "$target" || return 1
    fi
}

write_profiles_cache() {
    local tmp
    ((EUID == 0)) || [[ "${VPNCTL_ALLOW_UNPRIVILEGED:-0}" == "1" ]] ||
        return 1
    prepare_dashboard_dir || return 1
    tmp="$DASHBOARD_DIR/.profiles.$$"
    umask 077
    profiles_json_live >"$tmp" || {
        rm -f -- "$tmp"
        return 1
    }
    protect_dashboard_cache "$tmp" || {
        rm -f -- "$tmp"
        return 1
    }
    mv -f -- "$tmp" "$PROFILES_FILE"
}

cmd_profiles_json() {
    if [[ -r "$PROFILES_FILE" ]]; then
        cat -- "$PROFILES_FILE"
        return 0
    fi
    if ((EUID == 0)) || [[ "${VPNCTL_ALLOW_UNPRIVILEGED:-0}" == "1" ]]; then
        write_profiles_cache || return 1
        cat -- "$PROFILES_FILE"
        return 0
    fi
    printf '{"schema_version":1,"generated_at":0,"available":false,'
    printf '"error":"profile cache is not ready","profiles":[]}\n'
    return 1
}

cmd_profiles_api_json() {
    api_client_ready || {
        error "$(msg api_socket_unavailable 'profiles --api-json')"
        return 70
    }
    api_client_query profiles.list || {
        error "$(msg api_profiles_unavailable)"
        return 70
    }
}

choose_protocol() {
    local answer protocol count runtime
    stdin_interactive || {
        error "Укажите протокол: amneziawg, wireguard, openvpn или l2tp"
        return 1
    }
    printf '\n%s\n' "$(msg choose_protocol)" >&2
    local index=1
    for protocol in amneziawg wireguard openvpn l2tp; do
        load_profiles "$protocol"
        count="${#PROFILES[@]}"
        if protocol_runtime_available "$protocol"; then
            runtime="$(msg ready)"
        else
            runtime="$(msg runtime_missing)"
        fi
        printf '  %d. %-12s %s: %-3d %s\n' "$index" \
            "$(protocol_title "$protocol")" "$(msg profile_count)" "$count" "$runtime" >&2
        index=$((index + 1))
    done
    read -r -p "$(msg protocol_number)" answer
    case "$answer" in
        1) printf 'amneziawg\n' ;;
        2) printf 'wireguard\n' ;;
        3) printf 'openvpn\n' ;;
        4) printf 'l2tp\n' ;;
        *) error "$(msg invalid_protocol)"; return 1 ;;
    esac
}

cmd_connect() (
    local -a original=("$@")
    local requested_protocol="${1:-}" requested_profile="${2:-}" protocol fallback=""
    if api_client_ready; then
        api_client_cmd_connect "${original[@]}"
        return
    fi
    require_profile_access connect "${original[@]}"
    if [[ -z "$requested_protocol" ]]; then
        protocol="$(choose_protocol)" || return 1
    else
        protocol="$(canonical_protocol "$requested_protocol")" ||
            die "Неизвестный протокол: $requested_protocol"
    fi
    resolve_profile "$protocol" "$requested_profile" || return 1
    validate_profile "$protocol" "$SELECTED_PROFILE" 1 ||
        die "Профиль не прошёл проверку безопасности: $SELECTED_PROFILE. Запустите $CLI_COMMAND doctor"
    validate_permissions "$SELECTED_PROFILE" ||
        die "У профиля небезопасные права. Исправление: chmod 600 '$SELECTED_PROFILE'"
    require_root connect "$protocol" "$(basename -- "$SELECTED_PROFILE")"
    systemd_available || die "systemd недоступен; выполните установку на системе с systemd"
    acquire_action_lock

    info "Выбран $(protocol_title "$protocol"): $(profile_name "$SELECTED_PROFILE")"
    cancel_test_guard
    discard_test_backup
    systemctl_quiet stop "$SERVICE_NAME" || true
    fallback="$(detect_external_fallback || true)"
    if [[ -n "$fallback" ]]; then
        info "Временно останавливаем внешний VPN: $(external_fallback_title "$fallback")"
        if ! stop_external_fallbacks; then
            error "Не удалось безопасно остановить внешний VPN"
            start_external_fallback "$fallback" || true
            return 1
        fi
    fi
    cleanup_stale_quick_policy
    write_state "$protocol" "$SELECTED_PROFILE" up ||
        die "Не удалось сохранить выбранный профиль"
    health_reset
    systemctl_quiet start "$HEALTH_TIMER" || warn "Не удалось запустить $HEALTH_TIMER"
    reset_service_start_limit

    if ! systemctl start "$SERVICE_NAME"; then
        error "Сервис VPN не запустился. Последние сообщения:"
        journalctl -u "$SERVICE_NAME" -n 30 --no-pager 2>/dev/null || true
        if [[ -n "$fallback" ]]; then
            set_desired_state down || true
            start_external_fallback "$fallback" ||
                error "Не удалось автоматически вернуть $(external_fallback_title "$fallback")"
        fi
        return 1
    fi
    say "Подключение запущено. Проверка: $CLI_COMMAND diagnose"
)

cmd_disconnect() (
    if api_client_ready; then
        api_client_cmd_disconnect "$@"
        return
    fi
    require_root disconnect
    systemd_available || die "systemd недоступен"
    acquire_action_lock
    cancel_test_guard
    discard_test_backup
    if [[ -r "$STATE_FILE" ]]; then
        set_desired_state down || die "Не удалось сохранить состояние отключения"
    fi
    health_reset
    if systemctl_quiet stop "$SERVICE_NAME"; then
        say "VPN отключён."
    else
        warn "Сервис уже остановлен или не установлен."
    fi
)

cmd_reconnect() (
    local fallback=""
    if api_client_ready; then
        api_client_cmd_reconnect "$@"
        return
    fi
    require_root reconnect
    acquire_action_lock
    cancel_test_guard
    discard_test_backup
    selected_from_state || die "Сначала выберите профиль: $CLI_COMMAND connect"
    validate_profile "$SELECTED_PROTOCOL" "$SELECTED_PROFILE" 1 ||
        die "Выбранный профиль не прошёл проверку"
    fallback="$(detect_external_fallback || true)"
    if [[ -n "$fallback" ]]; then
        info "Временно останавливаем внешний VPN: $(external_fallback_title "$fallback")"
        if ! stop_external_fallbacks; then
            start_external_fallback "$fallback" || true
            die "Не удалось безопасно остановить внешний VPN"
        fi
    fi
    stop_service_bounded 15 || true
    cleanup_stale_quick_policy
    write_state "$SELECTED_PROTOCOL" "$SELECTED_PROFILE" up ||
        die "Не удалось обновить состояние"
    health_reset
    reset_service_start_limit
    if ! systemctl start "$SERVICE_NAME"; then
        if [[ -n "$fallback" ]]; then
            set_desired_state down || true
            start_external_fallback "$fallback" || true
        fi
        die "Не удалось перезапустить $SERVICE_NAME"
    fi
    say "Переподключение запущено."
)

cmd_quick_connect() {
    local interface
    if api_client_ready; then
        api_client_cmd_quick "$@"
        return
    fi
    require_profile_access quick
    if ! selected_from_state; then
        info "$(msg no_default)"
        cmd_connect
        return
    fi
    interface="$(interface_for_protocol "$SELECTED_PROTOCOL")"
    if service_active && connection_local_ok "$SELECTED_PROTOCOL" &&
       public_ip "$interface" 3 >/dev/null; then
        say "$(msg already_connected): $(protocol_title "$SELECTED_PROTOCOL") / $(profile_name "$SELECTED_PROFILE")"
        return 0
    fi
    cmd_reconnect
}

service_active() {
    systemctl_quiet is-active "$SERVICE_NAME"
}

interface_for_protocol() {
    case "$1" in
        amneziawg) printf 'vpnaw0\n' ;;
        wireguard) printf 'vpnwg0\n' ;;
        openvpn) printf 'vpnovpn0\n' ;;
        l2tp)
            ip -o link show 2>/dev/null |
                awk -F': ' '$2 ~ /^ppp[0-9]+(@.*)?$/ { sub(/@.*/, "", $2); print $2; exit }'
            ;;
    esac
}

latest_handshake() {
    local protocol="$1" interface="$2" tool
    [[ "$protocol" == "amneziawg" ]] && tool=awg || tool=wg
    "$tool" show "$interface" latest-handshakes 2>/dev/null |
        awk 'BEGIN { max=0 } $2 > max { max=$2 } END { print max }'
}

connection_local_ok() {
    local protocol="$1" interface connection_id
    interface="$(interface_for_protocol "$protocol")"
    case "$protocol" in
        amneziawg|wireguard|openvpn)
            [[ -n "$interface" ]] && ip link show "$interface" >/dev/null 2>&1
            ;;
        l2tp)
            connection_id="$(l2tp_connection_id "$SELECTED_PROFILE")"
            nmcli -t -f NAME connection show --active 2>/dev/null |
                grep -Fqx -- "$connection_id"
            ;;
    esac
}

public_ip() {
    local interface="${1:-}" max_time="${2:-7}" connect_timeout=3 result
    [[ "$max_time" =~ ^[0-9]+$ ]] || max_time=7
    ((max_time < 1)) && return 1
    ((max_time < connect_timeout)) && connect_timeout="$max_time"
    local -a args=(-4 -fsS --connect-timeout "$connect_timeout" --max-time "$max_time")
    [[ -n "$interface" ]] && args+=(--interface "$interface")
    result="$(curl "${args[@]}" "$PROBE_URL" 2>/dev/null)" || return 1
    ((${#result} <= 64)) && [[ "$result" =~ ^[0-9A-Fa-f:.]+$ ]] || return 1
    printf '%s\n' "$result"
}

validate_test_timeout() {
    local timeout="$1"
    [[ "$timeout" =~ ^[0-9]+$ ]] || return 1
    ((timeout >= 2 && timeout <= 600))
}

acquire_action_lock() {
    mkdir -p "$RUN_DIR"
    chmod 700 "$RUN_DIR"
    exec 8>"$RUN_DIR/.action.lock"
    flock -n 8 || die "Другая операция $PRODUCT_NAME уже выполняется"
}

acquire_recovery_lock() {
    local wait_seconds="${1:-30}"
    mkdir -p "$RUN_DIR"
    chmod 700 "$RUN_DIR"
    exec 8>"$RUN_DIR/.action.lock"
    flock -w "$wait_seconds" 8
}

stop_service_bounded() {
    local limit="${1:-15}"
    if timeout "$limit" systemctl stop "$SERVICE_NAME"; then
        systemctl_quiet reset-failed "$SERVICE_NAME" || true
        return 0
    fi
    warn "$SERVICE_NAME не остановился за ${limit}s; принудительное завершение"
    systemctl kill --kill-who=all --signal=SIGKILL "$SERVICE_NAME" 2>/dev/null || true
    systemctl_quiet reset-failed "$SERVICE_NAME" || true
    return 1
}

reset_service_start_limit() {
    systemctl_quiet reset-failed "$SERVICE_NAME" || true
}

amnezia_kernel_available() {
    command -v modprobe >/dev/null 2>&1 &&
        (modprobe -n amneziawg >/dev/null 2>&1 || [[ -d /sys/module/amneziawg ]])
}

amnezia_userspace_available() {
    command -v amneziawg-go >/dev/null 2>&1
}

os_release_value() {
    local key="$1"
    awk -F= -v wanted="$key" '
        $1 == wanted {
            value=substr($0, index($0, "=") + 1)
            gsub(/^"|"$/, "", value)
            print value
            exit
        }
    ' /etc/os-release 2>/dev/null
}

broken_current_amnezia_ppa() {
    local codename source_file
    [[ "$(os_release_value ID)" == "ubuntu" ]] || return 1
    codename="$(os_release_value VERSION_CODENAME)"
    [[ -n "$codename" ]] || return 1
    source_file="/etc/apt/sources.list.d/amnezia-ubuntu-ppa-$codename.sources"
    if [[ ! -e "$source_file" ]] &&
       ! grep -RqsE "ppa\.launchpadcontent\.net/amnezia/ppa/ubuntu.*[[:space:]]$codename([[:space:]]|$)" \
           /etc/apt/sources.list /etc/apt/sources.list.d 2>/dev/null; then
        return 1
    fi
    ! curl -fsSI --connect-timeout 3 --max-time 5 \
        "https://ppa.launchpadcontent.net/amnezia/ppa/ubuntu/dists/$codename/Release" \
        >/dev/null 2>&1
}

protocol_runtime_available() {
    local protocol="$1"
    case "$protocol" in
        amneziawg)
            command -v awg >/dev/null 2>&1 &&
                command -v awg-quick >/dev/null 2>&1 &&
                { amnezia_kernel_available || amnezia_userspace_available; }
            ;;
        wireguard)
            command -v wg >/dev/null 2>&1 && command -v wg-quick >/dev/null 2>&1
            ;;
        openvpn)
            command -v openvpn >/dev/null 2>&1
            ;;
        l2tp)
            command -v nmcli >/dev/null 2>&1 &&
                {
                    command -v nm-l2tp-service >/dev/null 2>&1 ||
                        find /usr/lib /usr/libexec -type f -name 'nm-l2tp-service' \
                            -print -quit 2>/dev/null | grep -q .
                }
            ;;
        *) return 1 ;;
    esac
}

quick_interfaces_active() {
    local interfaces=""
    if command -v awg >/dev/null 2>&1; then
        interfaces+=" $(awg show interfaces 2>/dev/null || true)"
    fi
    if command -v wg >/dev/null 2>&1; then
        interfaces+=" $(wg show interfaces 2>/dev/null || true)"
    fi
    [[ -n "${interfaces//[[:space:]]/}" ]]
}

cleanup_duplicate_quick_policy() {
    local -a mark_entries=() mark_priorities=() duplicate_priorities=()
    local -a suppress_priorities=()
    local entry priority key index keep_count
    local -A seen=()
    mapfile -t mark_entries < <(
        ip -4 rule show 2>/dev/null |
            awk '
                /not from all fwmark/ && /lookup 518[2-9][0-9]([[:space:]]|$)/ {
                    priority=$1
                    sub(/:$/, "", priority)
                    mark=""
                    table=""
                    for (i=1; i<=NF; i++) {
                        if ($i == "fwmark") mark=$(i + 1)
                        if ($i == "lookup") table=$(i + 1)
                    }
                    if (priority ~ /^[0-9]+$/ && mark != "" && table != "")
                        print priority, mark "/" table
                }
            '
    )
    ((${#mark_entries[@]} > 1)) || return 0
    for entry in "${mark_entries[@]}"; do
        read -r priority key <<<"$entry"
        mark_priorities+=("$priority")
        if [[ -n "${seen[$key]:-}" ]]; then
            duplicate_priorities+=("$priority")
        else
            seen["$key"]="$priority"
        fi
    done
    ((${#duplicate_priorities[@]} > 0)) || return 0
    mapfile -t suppress_priorities < <(
        ip -4 rule show 2>/dev/null |
            awk '
                /from all lookup main suppress_prefixlength 0/ {
                    sub(/:$/, "", $1)
                    if ($1 ~ /^[0-9]+$/) print $1
                }
            '
    )
    for priority in "${duplicate_priorities[@]}"; do
        ip -4 rule delete priority "$priority" 2>/dev/null ||
            warn "Не удалось удалить duplicate policy rule priority $priority"
    done
    if ((${#suppress_priorities[@]} == ${#mark_priorities[@]})); then
        keep_count=$((${#suppress_priorities[@]} - ${#duplicate_priorities[@]}))
        for ((index = keep_count; index < ${#suppress_priorities[@]}; index++)); do
            priority="${suppress_priorities[$index]}"
            ip -4 rule delete priority "$priority" 2>/dev/null ||
                warn "Не удалось удалить duplicate suppress rule priority $priority"
        done
    fi
    ip -4 route flush cache 2>/dev/null || true
    info "Удалены дубли policy rules WireGuard/AmneziaWG"
}

cleanup_stale_quick_policy() {
    local -a mark_priorities=() suppress_priorities=()
    local priority
    if quick_interfaces_active; then
        cleanup_duplicate_quick_policy
        return 0
    fi
    mapfile -t mark_priorities < <(
        ip -4 rule show 2>/dev/null |
            awk '
                /not from all fwmark/ && /lookup 518[2-9][0-9]([[:space:]]|$)/ {
                    sub(/:$/, "", $1)
                    print $1
                }
            '
    )
    ((${#mark_priorities[@]} > 0)) || return 0
    mapfile -t suppress_priorities < <(
        ip -4 rule show 2>/dev/null |
            awk '
                /from all lookup main suppress_prefixlength 0/ {
                    sub(/:$/, "", $1)
                    print $1
                }
            '
    )
    for priority in "${mark_priorities[@]}" "${suppress_priorities[@]}"; do
        [[ "$priority" =~ ^[0-9]+$ ]] || continue
        ip -4 rule delete priority "$priority" 2>/dev/null ||
            warn "Не удалось удалить orphan policy rule priority $priority"
    done
    ip -4 route flush cache 2>/dev/null || true
    info "Удалены orphan policy rules от остановленных wg-quick туннелей"
}

fallback_account() {
    local user="$FALLBACK_USER" entry candidate_uid=""
    if [[ -z "$user" && -e "$LEGACY_FALLBACK_START" ]]; then
        user="$(stat -c %U -- "$LEGACY_FALLBACK_START" 2>/dev/null || true)"
    fi
    if [[ -z "$user" ]]; then
        if [[ "${PKEXEC_UID:-}" =~ ^[0-9]+$ ]]; then
            candidate_uid="$PKEXEC_UID"
        elif [[ "${SUDO_UID:-}" =~ ^[0-9]+$ ]]; then
            candidate_uid="$SUDO_UID"
        fi
        if [[ -n "$candidate_uid" && "$candidate_uid" -ge 1000 ]]; then
            user="$(getent passwd "$candidate_uid" 2>/dev/null | cut -d: -f1)"
        fi
    fi
    if [[ -z "$user" ]] && command -v loginctl >/dev/null 2>&1; then
        user="$(
            loginctl list-users --no-legend 2>/dev/null |
                awk '$1 ~ /^[0-9]+$/ && $1 >= 1000 { print $2; exit }'
        )"
    fi
    if [[ -z "$user" || ! "$user" =~ ^[a-z_][a-z0-9_-]*[$]?$ ]]; then
        return 1
    fi
    if [[ "$user" == "root" && "${VPNCTL_ALLOW_UNPRIVILEGED:-0}" != "1" ]]; then
        return 1
    fi
    entry="$(getent passwd "$user" 2>/dev/null || true)"
    [[ -n "$entry" ]] || return 1
    printf '%s\n' "$entry"
}

run_adguard_fallback() {
    local limit="$1" entry uid home
    shift
    [[ -x "$ADGUARD_FALLBACK_CLI" ]] || return 127
    entry="$(fallback_account)" || return 1
    IFS=: read -r _ _ uid _ _ home _ <<<"$entry"
    [[ "$uid" =~ ^[0-9]+$ && -d "$home" ]] || return 1
    timeout "$limit" env HOME="$home" \
        XDG_RUNTIME_DIR="/run/user/$uid" \
        DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
        "$ADGUARD_FALLBACK_CLI" "$@" 8>&- 9>&-
}

adguard_fallback_pid_file() {
    local entry home
    if [[ -n "$ADGUARD_FALLBACK_PID_FILE" ]]; then
        printf '%s\n' "$ADGUARD_FALLBACK_PID_FILE"
        return 0
    fi
    entry="$(fallback_account)" || return 1
    IFS=: read -r _ _ _ _ _ home _ <<<"$entry"
    [[ -d "$home" ]] || return 1
    printf '%s/.local/share/adguardvpn-cli/vpn.pid\n' "$home"
}

adguard_fallback_process_pid() {
    local pid_file pid command_line
    pid_file="$(adguard_fallback_pid_file)" || return 1
    [[ -r "$pid_file" ]] || return 1
    read -r pid <"$pid_file" || return 1
    [[ "$pid" =~ ^[0-9]+$ && "$pid" -gt 1 && -r "/proc/$pid/cmdline" ]] ||
        return 1
    command_line="$(tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null)" ||
        return 1
    [[ "$command_line" == *adguardvpn-cli* &&
        "$command_line" == *" connect "* ]] || return 1
    printf '%s\n' "$pid"
}

terminate_adguard_fallback_process() {
    local pid pgid
    pid="$(adguard_fallback_process_pid)" || return 1
    pgid="$(ps -o pgid= -p "$pid" 2>/dev/null | tr -d '[:space:]')"
    if [[ "$pgid" =~ ^[0-9]+$ && "$pgid" == "$pid" ]]; then
        kill -TERM -- "-$pgid" 2>/dev/null || return 1
    else
        kill -TERM -- "$pid" 2>/dev/null || return 1
    fi
}

legacy_fallback_active() {
    ip link show "$LEGACY_FALLBACK_INTERFACE" >/dev/null 2>&1
}

adguard_fallback_active() {
    local output
    output="$(run_adguard_fallback 8 status 2>/dev/null)" || output=""
    grep -q '^Connected to ' <<<"$output" && return 0
    adguard_fallback_process_pid >/dev/null
}

detect_external_fallback() {
    local legacy=0 adguard=0
    legacy_fallback_active && legacy=1
    adguard_fallback_active && adguard=1
    if ((legacy && adguard)); then
        warn "Одновременно активны $LEGACY_FALLBACK_INTERFACE и AdGuard VPN; rollback сохранит AdGuard"
    fi
    if ((adguard)); then
        printf 'adguard\n'
    elif ((legacy)); then
        printf 'legacy\n'
    fi
}

external_fallback_title() {
    case "$1" in
        legacy) printf 'legacy AmneziaWG (%s)' "$LEGACY_FALLBACK_INTERFACE" ;;
        adguard) printf 'AdGuard VPN' ;;
        *) printf 'неизвестный внешний VPN' ;;
    esac
}

stop_one_external_fallback() {
    local kind="$1" deadline
    deadline=$(($(date +%s) + FALLBACK_TIMEOUT))
    case "$kind" in
        legacy)
            [[ -x "$LEGACY_FALLBACK_STOP" ]] || {
                error "Fallback stop-скрипт недоступен: $LEGACY_FALLBACK_STOP"
                return 1
            }
            timeout "$FALLBACK_TIMEOUT" "$LEGACY_FALLBACK_STOP" 8>&- 9>&- ||
                return 1
            while legacy_fallback_active; do
                (($(date +%s) < deadline)) || return 1
                sleep 1
            done
            ;;
        adguard)
            if ! run_adguard_fallback "$FALLBACK_TIMEOUT" disconnect; then
                adguard_fallback_process_pid >/dev/null || return 1
            fi
            if adguard_fallback_process_pid >/dev/null; then
                terminate_adguard_fallback_process || return 1
            fi
            while adguard_fallback_active; do
                (($(date +%s) < deadline)) || return 1
                sleep 1
            done
            ;;
        *) return 1 ;;
    esac
}

stop_external_fallbacks() {
    local failed=0
    if legacy_fallback_active; then
        stop_one_external_fallback legacy || failed=1
    fi
    if adguard_fallback_active; then
        stop_one_external_fallback adguard || failed=1
    fi
    ((failed == 0))
}

start_external_fallback() {
    local kind="$1" deadline
    deadline=$(($(date +%s) + FALLBACK_TIMEOUT))
    info "Восстанавливаем внешний VPN: $(external_fallback_title "$kind")"
    case "$kind" in
        legacy)
            [[ -x "$LEGACY_FALLBACK_START" ]] || {
                error "Fallback setup-скрипт недоступен: $LEGACY_FALLBACK_START"
                return 1
            }
            timeout "$FALLBACK_TIMEOUT" "$LEGACY_FALLBACK_START" 8>&- 9>&- ||
                return 1
            while ! legacy_fallback_active; do
                (($(date +%s) < deadline)) || return 1
                sleep 1
            done
            ;;
        adguard)
            run_adguard_fallback "$FALLBACK_TIMEOUT" connect --no-progress -y ||
                return 1
            while ! adguard_fallback_active; do
                (($(date +%s) < deadline)) || return 1
                sleep 1
            done
            ;;
        *) return 1 ;;
    esac
    info "Внешний VPN восстановлен: $(external_fallback_title "$kind")"
}

discard_test_backup() {
    rm -f "$TEST_BACKUP" "$TEST_BACKUP_EXISTS" "$TEST_BACKUP_ACTIVE" \
        "$TEST_BACKUP_FALLBACK" "$TEST_TRANSACTION" "$TEST_FAILURE_MARKER"
}

save_test_backup() {
    local fallback=""
    mkdir -p "$STATE_DIR"
    chmod 700 "$STATE_DIR"
    discard_test_backup
    umask 077
    : >"$TEST_TRANSACTION"
    if [[ -r "$STATE_FILE" ]]; then
        install -m 600 -- "$STATE_FILE" "$TEST_BACKUP" ||
            die "Не удалось сохранить предыдущее состояние"
        : >"$TEST_BACKUP_EXISTS"
    fi
    fallback="$(detect_external_fallback || true)"
    if [[ -n "$fallback" ]]; then
        printf '%s\n' "$fallback" >"$TEST_BACKUP_FALLBACK"
        if service_active; then
            warn "Обнаружен конфликт managed VPN и внешнего VPN; rollback оставит внешний VPN"
        fi
    elif service_active; then
        : >"$TEST_BACKUP_ACTIVE"
    fi
    chmod 600 "$TEST_TRANSACTION" "$TEST_BACKUP_EXISTS" "$TEST_BACKUP_ACTIVE" \
        "$TEST_BACKUP_FALLBACK" 2>/dev/null || true
    if [[ -n "$fallback" ]]; then
        info "TEST: останавливаем внешний VPN без потери rollback: $(external_fallback_title "$fallback")"
        if ! stop_external_fallbacks; then
            error "Не удалось безопасно остановить внешний VPN"
            start_external_fallback "$fallback" || true
            discard_test_backup
            return 1
        fi
    fi
}

cancel_test_guard() {
    local token="${1:-}" unit="$TEST_GUARD_UNIT"
    [[ -n "$token" ]] || token="$(state_get TEST_TOKEN 2>/dev/null || true)"
    [[ -n "$token" ]] && unit="$TEST_GUARD_UNIT-$token"
    systemctl_quiet stop "$unit.timer" || true
    systemctl_quiet reset-failed "$unit.service" "$unit.timer" || true
}

arm_test_guard() {
    local timeout="$1" token="$2"
    local unit="$TEST_GUARD_UNIT-$token"
    cancel_test_guard "$token"
    if ! command -v systemd-run >/dev/null 2>&1; then
        warn "systemd-run не найден; аварийный откат зависит от процесса $PRODUCT_NAME"
        return 1
    fi
    systemd-run --quiet --collect \
        --unit="$unit" \
        --on-active="${timeout}s" \
        --property=Type=oneshot \
        "$SELF" _test-timeout "$token" >/dev/null ||
        {
            warn "Не удалось создать systemd timeout guard"
            return 1
        }
}

restore_test_backup() {
    local reason="${1:-rollback}" had_previous=0 was_active=0 token fallback=""
    [[ -e "$TEST_TRANSACTION" ]] || return 0
    [[ -e "$TEST_BACKUP_EXISTS" && -r "$TEST_BACKUP" ]] && had_previous=1
    [[ -e "$TEST_BACKUP_ACTIVE" ]] && was_active=1
    if [[ -r "$TEST_BACKUP_FALLBACK" ]]; then
        read -r fallback <"$TEST_BACKUP_FALLBACK"
        [[ "$fallback" == "legacy" || "$fallback" == "adguard" ]] || fallback=""
    fi
    token="$(state_get TEST_TOKEN 2>/dev/null || true)"

    warn "TEST rollback: $reason"
    stop_service_bounded 15 || true
    cleanup_stale_quick_policy
    cancel_test_guard "$token"
    if ((had_previous)); then
        install -m 600 -- "$TEST_BACKUP" "$STATE_FILE" ||
            die "Не удалось восстановить предыдущее состояние"
        if [[ -n "$fallback" ]]; then
            set_desired_state down ||
                warn "Не удалось отметить managed VPN отключённым при возврате fallback"
        fi
    else
        rm -f "$STATE_FILE"
    fi
    health_reset

    if ((was_active)); then
        reset_service_start_limit
        if timeout 20 systemctl start "$SERVICE_NAME"; then
            info "Предыдущее VPN-соединение восстановлено"
        else
            error "Не удалось перезапустить предыдущее VPN-соединение"
            return 1
        fi
    elif [[ -n "$fallback" ]]; then
        start_external_fallback "$fallback" || {
            error "Не удалось восстановить $(external_fallback_title "$fallback"); транзакция сохранена"
            return 1
        }
    else
        info "Восстановлено состояние без активного VPN"
    fi
    discard_test_backup
}

recover_stale_test_state() {
    local mode token fallback="" was_active=0
    ((EUID == 0)) || [[ "${VPNCTL_ALLOW_UNPRIVILEGED:-0}" == "1" ]] ||
        die "_recover-stale-test требует root"
    [[ -e "$TEST_TRANSACTION" ]] || return 0
    acquire_recovery_lock 30 ||
        die "BOOT RECOVERY: не удалось получить блокировку восстановления"
    mode="$(state_get MODE 2>/dev/null || true)"
    [[ "$mode" == "test" ]] || {
        discard_test_backup
        return 0
    }

    warn "BOOT RECOVERY: найден незавершённый тестовый туннель"
    token="$(state_get TEST_TOKEN 2>/dev/null || true)"
    cancel_test_guard "$token"
    stop_service_bounded 15 || true
    cleanup_stale_quick_policy
    if [[ -e "$TEST_BACKUP_EXISTS" && -r "$TEST_BACKUP" ]]; then
        install -m 600 -- "$TEST_BACKUP" "$STATE_FILE" ||
            die "Не удалось восстановить state после незавершённого теста"
    else
        rm -f "$STATE_FILE"
    fi
    [[ -e "$TEST_BACKUP_ACTIVE" ]] && was_active=1
    if [[ -r "$TEST_BACKUP_FALLBACK" ]]; then
        read -r fallback <"$TEST_BACKUP_FALLBACK"
        [[ "$fallback" == "legacy" || "$fallback" == "adguard" ]] || fallback=""
    fi
    if [[ -n "$fallback" && -r "$STATE_FILE" ]]; then
        set_desired_state down ||
            warn "BOOT RECOVERY: не удалось отметить managed VPN отключённым"
    fi
    health_reset
    if ((was_active)); then
        reset_service_start_limit
        timeout 20 systemctl start "$SERVICE_NAME" ||
            die "BOOT RECOVERY: не удалось восстановить managed VPN"
    elif [[ -n "$fallback" ]]; then
        start_external_fallback "$fallback" ||
            die "BOOT RECOVERY: не удалось восстановить $(external_fallback_title "$fallback")"
    fi
    discard_test_backup
    info "BOOT RECOVERY: предыдущее состояние восстановлено"
}

finalize_test_connection() {
    local protocol="$1" profile="$2"
    cancel_test_guard
    write_state "$protocol" "$profile" up normal ||
        die "Не удалось зафиксировать рабочее соединение"
    discard_test_backup
    health_reset
}

new_test_token() {
    printf '%s-%s-%s\n' "$(date +%s)" "$$" "$RANDOM"
}

start_test_attempt() {
    local protocol="$1" profile="$2" timeout="$3"
    local token deadline
    token="$(new_test_token)"
    ACTIVE_TEST_TOKEN="$token"
    deadline=$(($(date +%s) + timeout))
    cancel_test_guard
    stop_service_bounded 15 || true
    cleanup_stale_quick_policy
    rm -f "$TEST_FAILURE_MARKER"
    write_state "$protocol" "$profile" up test "$token" "$deadline" ||
        die "Не удалось записать тестовое состояние"
    health_reset
    arm_test_guard "$timeout" "$token" || true
    info "TEST: запуск $(protocol_title "$protocol") / $(profile_name "$profile"), timeout=${timeout}s"
    reset_service_start_limit
    timeout "$timeout" systemctl start "$SERVICE_NAME"
}

wait_for_test_connection() {
    local timeout="$1" expected_protocol="$2" expected_profile="$3"
    local now elapsed remaining sleep_for interface mode token deadline
    while true; do
        now="$(date +%s)"
        mode="$(state_get MODE 2>/dev/null || true)"
        token="$(state_get TEST_TOKEN 2>/dev/null || true)"
        deadline="$(state_get TEST_DEADLINE 2>/dev/null || true)"
        if [[ "$mode" != "test" || "$token" != "$ACTIVE_TEST_TOKEN" ||
              ! "$deadline" =~ ^[0-9]+$ ]]; then
            printf '\n'
            return 1
        fi
        remaining=$((deadline - now))
        if ((remaining <= 0)); then
            printf '\n'
            return 1
        fi
        if [[ -s "$TEST_FAILURE_MARKER" ]]; then
            printf '\n'
            return 1
        fi
        elapsed=$((timeout - remaining))
        if selected_from_state &&
           [[ "$SELECTED_PROTOCOL" == "$expected_protocol" ]] &&
           [[ "$(basename -- "$SELECTED_PROFILE")" == "$(basename -- "$expected_profile")" ]] &&
           service_active &&
           connection_local_ok "$SELECTED_PROTOCOL"; then
            interface="$(interface_for_protocol "$SELECTED_PROTOCOL")"
            if public_ip "$interface" "$remaining" >/dev/null; then
                printf '\n'
                return 0
            fi
        fi
        if ((elapsed >= 3)) &&
           systemctl_quiet is-failed "$SERVICE_NAME"; then
            printf '\n'
            return 1
        fi
        if ((elapsed >= 3)) && ! service_active; then
            printf '\n'
            return 1
        fi
        printf '.'
        sleep_for=2
        ((remaining < sleep_for)) && sleep_for="$remaining"
        sleep "$sleep_for"
    done
}

show_test_failure_log() {
    local lines=80
    [[ "${VPNCTL_BATCH_MODE:-0}" == "1" ]] && lines=20
    say "Последние сообщения расширенного журнала:"
    journalctl -u "$SERVICE_NAME" -n "$lines" --no-pager 2>/dev/null || true
}

classify_test_failure() {
    local reason=""
    TEST_FAILURE_CODE=1
    [[ -r "$TEST_FAILURE_MARKER" ]] && read -r reason <"$TEST_FAILURE_MARKER"
    case "$reason" in
        openvpn-too-many-connections)
            error "OpenVPN-сервер отклонил сессию: Too many connections"
            error "Остановите другие подключения этого аккаунта или подождите освобождения серверной сессии"
            TEST_FAILURE_CODE=3
            ;;
        openvpn-auth-failed)
            error "OpenVPN-сервер отклонил авторизацию профиля"
            TEST_FAILURE_CODE=3
            ;;
        openvpn-server-halt)
            error "OpenVPN-сервер принудительно остановил подключение"
            TEST_FAILURE_CODE=3
            ;;
    esac
}

test_timeout_handler() {
    local token="${1:-}" current_token mode
    mode="$(state_get MODE 2>/dev/null || true)"
    current_token="$(state_get TEST_TOKEN 2>/dev/null || true)"
    [[ "$mode" == "test" && -n "$token" && "$token" == "$current_token" ]] || return 0
    acquire_recovery_lock 30 || {
        warn "Защитный таймаут не получил блокировку; boot recovery сохранён"
        return 1
    }
    mode="$(state_get MODE 2>/dev/null || true)"
    current_token="$(state_get TEST_TOKEN 2>/dev/null || true)"
    [[ "$mode" == "test" && "$token" == "$current_token" ]] || return 0
    restore_test_backup "истёк защитный таймаут"
}

cmd_test() (
    local -a original=("$@")
    local requested_protocol="" requested_profile="" timeout="$DEFAULT_TEST_TIMEOUT"
    local keep=0 protocol previous_protocol="" previous_profile="" failure_rc=1

    while (($#)); do
        case "$1" in
            --timeout)
                shift
                [[ $# -gt 0 ]] || die "--timeout требует число секунд"
                timeout="$1"
                ;;
            --keep) keep=1 ;;
            --help|-h)
                say "Использование: $CLI_COMMAND test [ПРОТОКОЛ] [ПРОФИЛЬ] [--timeout 45] [--keep]"
                return 0
                ;;
            -*)
                die "Неизвестный параметр test: $1"
                ;;
            *)
                if [[ -z "$requested_protocol" ]]; then
                    requested_protocol="$1"
                elif [[ -z "$requested_profile" ]]; then
                    requested_profile="$1"
                else
                    die "Лишний аргумент test: $1"
                fi
                ;;
        esac
        shift
    done
    validate_test_timeout "$timeout" || die "Таймаут должен быть от 2 до 600 секунд"
    require_root test "${original[@]}"
    systemd_available || die "systemd недоступен"

    if selected_from_state; then
        previous_protocol="$SELECTED_PROTOCOL"
        previous_profile="$SELECTED_PROFILE"
    fi
    if [[ -z "$requested_protocol" ]]; then
        if [[ -n "$previous_protocol" ]]; then
            protocol="$previous_protocol"
            requested_profile="$(basename -- "$previous_profile")"
        else
            protocol="$(choose_protocol)" || return 1
        fi
    else
        protocol="$(canonical_protocol "$requested_protocol")" ||
            die "Неизвестный протокол: $requested_protocol"
        if [[ -z "$requested_profile" && "$protocol" == "$previous_protocol" ]]; then
            requested_profile="$(basename -- "$previous_profile")"
        fi
    fi

    resolve_profile "$protocol" "$requested_profile" || return 1
    validate_profile "$protocol" "$SELECTED_PROFILE" 1 ||
        die "Профиль не прошёл проверку безопасности"
    validate_permissions "$SELECTED_PROFILE" ||
        die "У профиля небезопасные права; требуется chmod 600"
    acquire_action_lock
    if [[ "$(state_get MODE 2>/dev/null || true)" == "test" ]]; then
        restore_test_backup "очистка незавершённого предыдущего теста" ||
            die "Не удалось восстановить предыдущий VPN; новый тест отменён"
    fi
    save_test_backup || die "Не удалось подготовить безопасный VPN rollback"

    local tested_profile="$SELECTED_PROFILE"
    local transaction_active=1
    # shellcheck disable=SC2317,SC2329  # Called indirectly by the signal trap below.
    abort_test_signal() {
        if ((transaction_active)); then
            restore_test_backup "тест прерван сигналом" || true
        fi
        exit 130
    }
    trap abort_test_signal INT TERM HUP

    if ! start_test_attempt "$protocol" "$tested_profile" "$timeout"; then
        classify_test_failure
        failure_rc="$TEST_FAILURE_CODE"
        show_test_failure_log
        if ! restore_test_backup "сервис не запустился"; then
            transaction_active=0
            trap - INT TERM HUP
            error "КРИТИЧЕСКАЯ ОШИБКА: исходный VPN не восстановлен; транзакция сохранена"
            return 2
        fi
        transaction_active=0
        trap - INT TERM HUP
        return "$failure_rc"
    fi
    if wait_for_test_connection "$timeout" "$protocol" "$tested_profile"; then
        say "TEST OK: туннель и доступ в интернет работают."
        if ((keep)); then
            finalize_test_connection "$protocol" "$tested_profile"
            say "Тестовое соединение оставлено активным. Расширенный журнал сохранится до переподключения."
        else
            if ! restore_test_backup "проверка завершена; возвращаем исходное соединение"; then
                transaction_active=0
                trap - INT TERM HUP
                error "КРИТИЧЕСКАЯ ОШИБКА: тест прошёл, но исходный VPN не восстановлен"
                return 2
            fi
        fi
        transaction_active=0
        trap - INT TERM HUP
        return 0
    fi

    classify_test_failure
    failure_rc="$TEST_FAILURE_CODE"
    error "TEST FAIL: соединение не прошло проверку за ${timeout}s"
    show_test_failure_log
    if ! restore_test_backup "тест не прошёл"; then
        transaction_active=0
        trap - INT TERM HUP
        error "КРИТИЧЕСКАЯ ОШИБКА: исходный VPN не восстановлен; транзакция сохранена"
        return 2
    fi
    transaction_active=0
    trap - INT TERM HUP
    return "$failure_rc"
)

cmd_test_all() {
    local -a original=("$@") protocols=() files=()
    local requested="all" timeout="$DEFAULT_TEST_TIMEOUT" protocol file
    local total=0 passed=0 failed=0 skipped=0 started_at elapsed rc=0 aborted=0
    while (($#)); do
        case "$1" in
            --timeout)
                shift
                [[ $# -gt 0 ]] || die "--timeout требует число секунд"
                timeout="$1"
                ;;
            --help|-h)
                say "Использование: $CLI_COMMAND test-all [ПРОТОКОЛ|all] [--timeout 45]"
                return 0
                ;;
            -*)
                die "Неизвестный параметр test-all: $1"
                ;;
            *)
                [[ "$requested" == "all" ]] || die "Лишний аргумент test-all: $1"
                requested="$1"
                ;;
        esac
        shift
    done
    validate_test_timeout "$timeout" || die "Таймаут должен быть от 2 до 600 секунд"
    mapfile -t protocols < <(requested_protocols "$requested") ||
        die "Неизвестный протокол: $requested"
    require_root test-all "${original[@]}"
    systemd_available || die "systemd недоступен"

    say "Живой тест всех профилей: каждый туннель имеет timeout и полный rollback."
    for protocol in "${protocols[@]}"; do
        load_profiles "$protocol"
        files=("${PROFILES[@]}")
        if ((${#files[@]} == 0)); then
            warn "$(protocol_title "$protocol"): профилей нет"
            continue
        fi
        if ! protocol_runtime_available "$protocol"; then
            warn "$(protocol_title "$protocol"): runtime отсутствует, пропущено ${#files[@]}"
            skipped=$((skipped + ${#files[@]}))
            continue
        fi
        for file in "${files[@]}"; do
            total=$((total + 1))
            printf '\n=== [%d] %s / %s ===\n' "$total" \
                "$(protocol_title "$protocol")" "$(profile_name "$file")"
            if ! validate_profile "$protocol" "$file" 1 ||
               ! validate_permissions "$file"; then
                error "Профиль не прошёл предварительную проверку"
                failed=$((failed + 1))
                continue
            fi
            started_at="$(date +%s)"
            VPNCTL_BATCH_MODE=1 "$SELF" test "$protocol" \
                "$(basename -- "$file")" --timeout "$timeout"
            rc=$?
            if ((rc == 0)); then
                elapsed=$(($(date +%s) - started_at))
                passed=$((passed + 1))
                printf '[PASS] туннель работает (%d сек.)\n' "$elapsed"
            else
                elapsed=$(($(date +%s) - started_at))
                failed=$((failed + 1))
                printf '[FAIL] туннель не работает (%d сек.)\n' "$elapsed"
                if ((rc == 2)); then
                    aborted=1
                    error "Пакетная проверка остановлена: исходное VPN-соединение не восстановлено"
                    break 2
                elif ((rc == 3)); then
                    aborted=1
                    error "Пакетная проверка остановлена: OpenVPN-сервер отклонил сессию"
                    break 2
                fi
            fi
        done
    done
    printf '\nИтог live-test: tested=%d passed=%d failed=%d skipped=%d\n' \
        "$total" "$passed" "$failed" "$skipped"
    ((aborted == 0 && total > 0 && failed == 0 && skipped == 0))
}

cmd_emergency() (
    local -a original=("$@") candidate_protocols=() candidate_profiles=()
    local -A seen=()
    local timeout=20 filter="" requested_protocol="" protocol file key
    local previous_protocol="" previous_profile="" attempt=0 total=0

    while (($#)); do
        case "$1" in
            --timeout)
                shift
                [[ $# -gt 0 ]] || die "--timeout требует число секунд"
                timeout="$1"
                ;;
            --protocol)
                shift
                [[ $# -gt 0 ]] || die "--protocol требует имя"
                requested_protocol="$1"
                ;;
            --help|-h)
                say "Использование: $CLI_COMMAND emergency [--timeout 20] [--protocol ПРОТОКОЛ]"
                return 0
                ;;
            *) die "Неизвестный параметр emergency: $1" ;;
        esac
        shift
    done
    validate_test_timeout "$timeout" || die "Таймаут должен быть от 2 до 600 секунд"
    require_root emergency "${original[@]}"
    systemd_available || die "systemd недоступен"
    if [[ -n "$requested_protocol" ]]; then
        filter="$(canonical_protocol "$requested_protocol")" ||
            die "Неизвестный протокол: $requested_protocol"
    fi

    if selected_from_state; then
        previous_protocol="$SELECTED_PROTOCOL"
        previous_profile="$SELECTED_PROFILE"
        if [[ -z "$filter" || "$filter" == "$previous_protocol" ]] &&
           protocol_runtime_available "$previous_protocol"; then
            key="$previous_protocol|$(basename -- "$previous_profile")"
            seen["$key"]=1
            candidate_protocols+=("$previous_protocol")
            candidate_profiles+=("$previous_profile")
        fi
    fi

    for protocol in amneziawg wireguard openvpn l2tp; do
        [[ -z "$filter" || "$filter" == "$protocol" ]] || continue
        if ! protocol_runtime_available "$protocol"; then
            warn "EMERGENCY: $(protocol_title "$protocol") runtime недоступен, пропуск"
            continue
        fi
        load_profiles "$protocol"
        for file in "${PROFILES[@]}"; do
            key="$protocol|$(basename -- "$file")"
            [[ -z "${seen[$key]:-}" ]] || continue
            validate_profile "$protocol" "$file" 1 || continue
            validate_permissions "$file" || continue
            seen["$key"]=1
            candidate_protocols+=("$protocol")
            candidate_profiles+=("$file")
        done
    done
    total="${#candidate_profiles[@]}"
    ((total > 0)) || die "Нет безопасных профилей для emergency recovery"

    acquire_action_lock
    if [[ "$(state_get MODE 2>/dev/null || true)" == "test" ]]; then
        restore_test_backup "очистка незавершённого теста" || true
    fi
    save_test_backup || die "Не удалось подготовить безопасный VPN rollback"

    local transaction_active=1
    # shellcheck disable=SC2317,SC2329  # Called indirectly by the signal trap below.
    abort_emergency_signal() {
        if ((transaction_active)); then
            restore_test_backup "emergency recovery прерван" || true
        fi
        exit 130
    }
    trap abort_emergency_signal INT TERM HUP

    for ((attempt = 0; attempt < total; attempt++)); do
        protocol="${candidate_protocols[attempt]}"
        file="${candidate_profiles[attempt]}"
        say
        info "EMERGENCY $((attempt + 1))/$total: $(protocol_title "$protocol") / $(profile_name "$file")"
        if ! start_test_attempt "$protocol" "$file" "$timeout"; then
            warn "Сервис не запустился; переход к следующему профилю"
            continue
        fi
        if wait_for_test_connection "$timeout" "$protocol" "$file"; then
            finalize_test_connection "$protocol" "$file"
            transaction_active=0
            trap - INT TERM HUP
            say "EMERGENCY OK: подключён первый доступный туннель."
            say "Расширенный журнал останется до следующего переподключения."
            return 0
        fi
        warn "Профиль не прошёл проверку; переход к следующему"
        journalctl -u "$SERVICE_NAME" -n 20 --no-pager 2>/dev/null || true
    done

    error "EMERGENCY FAIL: доступный туннель не найден"
    restore_test_backup "все профили недоступны"
    transaction_active=0
    trap - INT TERM HUP
    return 1
)

cmd_status() {
    local protocol profile desired mode state interface endpoint handshake now age ip autostart deadline
    local fallback=""
    if [[ "${1:-}" == "--json" ]]; then
        shift
        (($# == 0)) || die "Использование: $CLI_COMMAND status --json"
        cmd_status_json
        return
    fi
    if [[ "${1:-}" == "--api-json" ]]; then
        shift
        (($# == 0)) || die "Использование: $CLI_COMMAND status --api-json"
        api_client_ready || {
            error "$(msg api_socket_unavailable 'status --api-json')"
            return 70
        }
        api_client_query status.get || {
            error "$(msg api_status_unavailable)"
            return 70
        }
        return
    fi
    if api_client_ready; then
        api_client_cmd_status "$@"
        return
    fi
    require_profile_access status "$@"
    fallback="$(detect_external_fallback || true)"
    if ! selected_from_state; then
        say "VPN: профиль не выбран"
        [[ -z "$fallback" ]] ||
            say "Fallback:  active ($(external_fallback_title "$fallback"))"
        return 1
    fi
    protocol="$SELECTED_PROTOCOL"
    profile="$SELECTED_PROFILE"
    desired="$(state_get DESIRED 2>/dev/null || printf 'unknown')"
    mode="$(state_get MODE 2>/dev/null || printf 'normal')"
    endpoint="$(profile_endpoint "$protocol" "$profile")"
    interface="$(interface_for_protocol "$protocol")"
    if service_active; then state="active"; else state="inactive"; fi
    if systemctl_quiet is-enabled "$SERVICE_NAME"; then
        autostart="enabled"
    else
        autostart="disabled"
    fi

    printf 'VPN:       %s\n' "$state"
    printf 'Protocol:  %s\n' "$(protocol_title "$protocol")"
    printf 'Profile:   %s\n' "$(profile_name "$profile")"
    printf 'Desired:   %s\n' "$desired"
    printf 'Mode:      %s\n' "$mode"
    if [[ "$mode" == "test" ]]; then
        deadline="$(state_get TEST_DEADLINE 2>/dev/null || true)"
        if [[ "$deadline" =~ ^[0-9]+$ ]]; then
            deadline=$((deadline - $(date +%s)))
            ((deadline < 0)) && deadline=0
            printf 'Test left: %s sec\n' "$deadline"
        fi
    fi
    printf 'Autostart: %s\n' "$autostart"
    if [[ -n "$fallback" ]]; then
        printf 'Fallback:  active (%s)\n' "$(external_fallback_title "$fallback")"
    else
        printf 'Fallback:  inactive\n'
    fi
    [[ -n "$endpoint" ]] && printf 'Endpoint:  %s\n' "$endpoint"
    [[ -n "$interface" ]] && printf 'Interface: %s\n' "$interface"

    if [[ "$state" == "active" && ("$protocol" == "amneziawg" || "$protocol" == "wireguard") ]]; then
        handshake="$(latest_handshake "$protocol" "$interface")"
        if [[ "$handshake" =~ ^[0-9]+$ ]] && ((handshake > 0)); then
            now="$(date +%s)"
            age=$((now - handshake))
            printf 'Handshake: %s sec ago\n' "$age"
        else
            printf 'Handshake: not received\n'
        fi
    fi
    if [[ "$state" == "active" ]]; then
        ip="$(public_ip "$interface" || true)"
        [[ -n "$ip" ]] && printf 'Public IP: %s\n' "$ip"
    fi
    [[ "$state" == "active" ]]
}

json_escape() {
    local value="${1:-}"
    value="${value//\\/\\\\}"
    value="${value//\"/\\\"}"
    value="${value//$'\n'/\\n}"
    value="${value//$'\r'/\\r}"
    value="${value//$'\t'/\\t}"
    printf '%s' "$value"
}

dashboard_json_live() {
    local timestamp service_state="inactive" desired="unknown" mode="normal"
    local protocol="" protocol_name="" profile="" interface="" handshake_age=""
    local tunnel_active=false internet_state="unknown" public_ip_value=""
    local autostart=false health_monitor=false fallback="" fallback_name=""
    local failure_count=0 healthy=false selected=false count profile_protocol
    local awg_count=0 wg_count=0 ovpn_count=0 l2tp_count=0 now handshake

    timestamp="$(date +%s)"
    service_active && service_state="active"
    systemctl_quiet is-enabled "$SERVICE_NAME" && autostart=true
    systemctl_quiet is-active "$HEALTH_TIMER" && health_monitor=true
    desired="$(state_get DESIRED 2>/dev/null || printf 'unknown')"
    mode="$(state_get MODE 2>/dev/null || printf 'normal')"
    fallback="$(detect_external_fallback || true)"
    [[ -z "$fallback" ]] || fallback_name="$(external_fallback_title "$fallback")"
    if [[ -r "$RUN_DIR/health.failures" ]]; then
        read -r failure_count <"$RUN_DIR/health.failures" || failure_count=0
        [[ "$failure_count" =~ ^[0-9]+$ ]] || failure_count=0
    fi

    if selected_from_state; then
        selected=true
        protocol="$SELECTED_PROTOCOL"
        protocol_name="$(protocol_title "$protocol")"
        profile="$(profile_name "$SELECTED_PROFILE")"
        interface="$(interface_for_protocol "$protocol")"
        if [[ "$service_state" == "active" ]] && connection_local_ok "$protocol"; then
            tunnel_active=true
            public_ip_value="$(public_ip "$interface" 2 || true)"
            if [[ -n "$public_ip_value" ]]; then
                internet_state="up"
            else
                internet_state="down"
            fi
            if [[ "$protocol" == "amneziawg" || "$protocol" == "wireguard" ]]; then
                handshake="$(latest_handshake "$protocol" "$interface")"
                if [[ "$handshake" =~ ^[0-9]+$ ]] && ((handshake > 0)); then
                    now="$(date +%s)"
                    handshake_age=$((now - handshake))
                fi
            fi
        elif [[ "$desired" == "up" ]]; then
            internet_state="down"
        fi
    fi

    for profile_protocol in amneziawg wireguard openvpn l2tp; do
        load_profiles "$profile_protocol"
        count="${#PROFILES[@]}"
        case "$profile_protocol" in
            amneziawg) awg_count="$count" ;;
            wireguard) wg_count="$count" ;;
            openvpn) ovpn_count="$count" ;;
            l2tp) l2tp_count="$count" ;;
        esac
    done
    if [[ "$tunnel_active" == true && "$internet_state" == "up" &&
          "$failure_count" -eq 0 ]]; then
        healthy=true
    fi

    printf '{'
    printf '"schema_version":1,'
    printf '"generated_at":%s,' "$timestamp"
    printf '"product":"%s","version":"%s",' \
        "$(json_escape "$PRODUCT_NAME")" "$(json_escape "$VERSION")"
    printf '"language":"%s",' "$(json_escape "$UI_LANG")"
    printf '"selected":%s,' "$selected"
    printf '"service_state":"%s","desired":"%s","mode":"%s",' \
        "$(json_escape "$service_state")" "$(json_escape "$desired")" \
        "$(json_escape "$mode")"
    printf '"tunnel_active":%s,"internet":"%s","healthy":%s,' \
        "$tunnel_active" "$(json_escape "$internet_state")" "$healthy"
    printf '"protocol":"%s","protocol_name":"%s",' \
        "$(json_escape "$protocol")" "$(json_escape "$protocol_name")"
    printf '"profile":"%s","location":"%s","interface":"%s",' \
        "$(json_escape "$profile")" "$(json_escape "$profile")" \
        "$(json_escape "$interface")"
    if [[ "$handshake_age" =~ ^[0-9]+$ ]]; then
        printf '"handshake_age":%s,' "$handshake_age"
    else
        printf '"handshake_age":null,'
    fi
    printf '"public_ip":"%s",' "$(json_escape "$public_ip_value")"
    printf '"autostart":%s,"health_monitor":%s,' "$autostart" "$health_monitor"
    printf '"fallback":{"active":%s,"name":"%s"},' \
        "$([[ -n "$fallback" ]] && printf true || printf false)" \
        "$(json_escape "$fallback_name")"
    printf '"health_failures":%s,' "$failure_count"
    printf '"profiles":{"amneziawg":%s,"wireguard":%s,"openvpn":%s,"l2tp":%s}' \
        "$awg_count" "$wg_count" "$ovpn_count" "$l2tp_count"
    printf '}\n'
}

write_dashboard_cache() {
    local tmp
    ((EUID == 0)) || [[ "${VPNCTL_ALLOW_UNPRIVILEGED:-0}" == "1" ]] ||
        return 1
    prepare_dashboard_dir || return 1
    tmp="$DASHBOARD_DIR/.status.$$"
    umask 077
    dashboard_json_live >"$tmp" || {
        rm -f -- "$tmp"
        return 1
    }
    protect_dashboard_cache "$tmp" || {
        rm -f -- "$tmp"
        return 1
    }
    mv -f -- "$tmp" "$DASHBOARD_FILE"
    write_profiles_cache
}

cmd_status_json() {
    if [[ -r "$DASHBOARD_FILE" ]]; then
        cat -- "$DASHBOARD_FILE"
        return 0
    fi
    if ((EUID == 0)) || [[ "${VPNCTL_ALLOW_UNPRIVILEGED:-0}" == "1" ]]; then
        write_dashboard_cache || return 1
        cat -- "$DASHBOARD_FILE"
        return 0
    fi
    printf '{"schema_version":1,"generated_at":0,"product":"Mazzy VPN",'
    printf '"version":"%s","available":false,"error":"status cache is not ready"}\n' \
        "$(json_escape "$VERSION")"
    return 1
}

api_valid_identifier() {
    [[ "${1:-}" =~ ^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$ ]]
}

api_server_request_id() {
    printf 'server-%s-%s\n' "$(date +%s)" "$$"
}

api_error_response() {
    local request_id="$1" code="$2" message_key="$3"
    local retryable="${4:-false}" user_action_required="${5:-false}"
    jq -cn \
        --arg request_id "$request_id" \
        --arg code "$code" \
        --arg message_key "$message_key" \
        --argjson retryable "$retryable" \
        --argjson user_action_required "$user_action_required" \
        '{
            api_version: "1.0",
            request_id: $request_id,
            status: "error",
            error: {
                code: $code,
                message_key: $message_key,
                retryable: $retryable,
                user_action_required: $user_action_required
            }
        }'
}

api_ok_response() {
    local request_id="$1" result="$2"
    jq -cn \
        --arg request_id "$request_id" \
        --argjson result "$result" \
        '{
            api_version: "1.0",
            request_id: $request_id,
            status: "ok",
            result: $result
        }'
}

api_status_result() {
    write_dashboard_cache >/dev/null 2>&1 || true
    [[ -r "$DASHBOARD_FILE" && -r "$PROFILES_FILE" ]] || return 1
    jq -c --arg engine_version "$VERSION" --slurpfile catalog "$PROFILES_FILE" '
        . as $status
        | (
            ($catalog[0].profiles // [])
            | map(select(
                .protocol == ($status.protocol // "")
                and .name == ($status.profile // "")
            ))
            | first // null
        ) as $profile
        | {
            product: "Mazzy VPN",
            engine_version: ($status.version // $engine_version),
            generated_at: (
                if (($status.generated_at // 0) | type) == "number"
                    and ($status.generated_at // 0) > 0
                then ($status.generated_at | todateiso8601)
                else "1970-01-01T00:00:00Z"
                end
            ),
            available: ($status.available // true),
            connection: (
                {
                    state: (
                        if ($status.mode // "") == "test" then "testing"
                        elif ($status.tunnel_active // false) then "connected"
                        elif ($status.desired // "") == "down" then "disconnected"
                        elif ($status.service_state // "") == "active" then "connecting"
                        elif ($status.desired // "") == "up" then "error"
                        else "unknown"
                        end
                    ),
                    internet_reachable: (($status.internet // "") == "up"),
                    healthy: ($status.healthy // false)
                }
                + (
                    if (($status.interface // "") | test("^[A-Za-z0-9_.:-]{1,32}$"))
                    then {interface: $status.interface}
                    else {}
                    end
                )
                + (
                    if (($status.handshake_age // null) | type) == "number"
                        and ($status.handshake_age | floor) == $status.handshake_age
                        and $status.handshake_age >= 0
                    then {handshake_age: $status.handshake_age}
                    else {}
                    end
                )
                + (
                    if (($status.public_ip // "") | test("^[0-9A-Fa-f:.]{3,64}$"))
                    then {public_ip: $status.public_ip}
                    else {}
                    end
                )
                + (
                    if $profile == null then {}
                    else {
                        protocol: $profile.protocol,
                        profile_id: $profile.profile_id
                    }
                    end
                )
            ),
            desired: (
                if ($status.desired // "") == "up" then "up"
                elif ($status.desired // "") == "down" then "down"
                else "unknown"
                end
            ),
            mode: (
                if ($status.mode // "") == "normal" then "normal"
                elif ($status.mode // "") == "test" then "test"
                else "unknown"
                end
            ),
            autostart: ($status.autostart // false),
            health_monitor: ($status.health_monitor // false),
            health_failures: (
                if (($status.health_failures // 0) | type) == "number"
                    and ($status.health_failures | floor) == $status.health_failures
                    and $status.health_failures >= 0
                then $status.health_failures
                else 0
                end
            ),
            fallback: (
                {active: ($status.fallback.active // false)}
                + (
                    if (($status.fallback.name // "") | type) == "string"
                        and (($status.fallback.name // "") | length) > 0
                        and (($status.fallback.name // "") | length) <= 64
                    then {display_name: $status.fallback.name}
                    else {}
                    end
                )
            )
        }
    ' "$DASHBOARD_FILE"
}

api_profiles_result() {
    write_profiles_cache >/dev/null 2>&1 || true
    [[ -r "$PROFILES_FILE" ]] || return 1
    jq -c '{
        profiles: [
            (.profiles // [])[] |
            {
                profile_id: .profile_id,
                display_name: .name,
                protocol: .protocol,
                selected: (.selected // false),
                validation: "unknown",
                source_kind: "system"
            }
        ]
    }' "$PROFILES_FILE"
}

api_write_record() {
    local target="$1" content="$2" tmp
    mkdir -p -- "$API_ACTION_DIR" || return 1
    chmod 700 -- "$API_ACTION_DIR" || return 1
    tmp="$(mktemp "$API_ACTION_DIR/.record.XXXXXX")" || return 1
    umask 077
    printf '%s\n' "$content" >"$tmp" || {
        rm -f -- "$tmp"
        return 1
    }
    chmod 600 -- "$tmp" || {
        rm -f -- "$tmp"
        return 1
    }
    mv -f -- "$tmp" "$target"
}

api_mark_recovery_required() {
    local action_id="$1" operation="$2" reason="$3" marker tmp content
    marker="$API_RECOVERY_MARKER"
    mkdir -p -- "$STATE_DIR" || return 1
    chmod 700 -- "$STATE_DIR" || return 1
    content="$(
        jq -cn \
            --arg action_id "$action_id" \
            --arg operation "$operation" \
            --arg reason "$reason" \
            --arg created_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
            '{
                state: "recovery-required",
                action_id: $action_id,
                operation: $operation,
                reason: $reason,
                created_at: $created_at
            }'
    )" || return 1
    tmp="$(mktemp "$STATE_DIR/.api-recovery.XXXXXX")" || return 1
    umask 077
    printf '%s\n' "$content" >"$tmp" || {
        rm -f -- "$tmp"
        return 1
    }
    chmod 600 -- "$tmp" || {
        rm -f -- "$tmp"
        return 1
    }
    mv -f -- "$tmp" "$marker"
}

api_prune_completed_actions() {
    local preserve_action_id="${1:-}" record base action_id state completed_at
    local max_records remove_count entry
    local -a completed=() sorted=()
    max_records="$API_ACTION_MAX_RECORDS"
    [[ "$max_records" =~ ^[1-9][0-9]*$ ]] &&
        ((max_records <= 4096)) || max_records=512

    shopt -s nullglob
    for record in "$API_ACTION_DIR"/*.json; do
        base="$(basename -- "$record")"
        action_id="${base%.json}"
        api_valid_identifier "$action_id" || continue
        [[ "$action_id" != "$preserve_action_id" ]] || continue
        state="$(jq -r '.state // ""' "$record" 2>/dev/null || true)"
        [[ "$state" == "completed" ]] || continue
        completed_at="$(jq -r '.completed_at // ""' "$record" 2>/dev/null || true)"
        [[ "$completed_at" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T ]] ||
            completed_at="0000-00-00T00:00:00Z"
        completed+=("$completed_at|$base")
    done
    shopt -u nullglob

    remove_count=$((${#completed[@]} - max_records + 1))
    ((remove_count > 0)) || return 0
    mapfile -t sorted < <(printf '%s\n' "${completed[@]}" | sort)
    for entry in "${sorted[@]:0:remove_count}"; do
        base="${entry#*|}"
        rm -f -- "$API_ACTION_DIR/$base"
    done
}

api_cleanup_action_temps() {
    local path
    shopt -s nullglob
    for path in \
        "$API_ACTION_DIR"/.output.* \
        "$API_ACTION_DIR"/.record.* \
        "$API_ACTION_DIR"/.snapshot.*; do
        rm -f -- "$path"
    done
    shopt -u nullglob
}

api_rotate_audit_if_needed() {
    local max_bytes current_bytes=0 archive
    max_bytes="$API_AUDIT_MAX_BYTES"
    [[ "$max_bytes" =~ ^[1-9][0-9]*$ ]] &&
        ((max_bytes <= 67108864)) || max_bytes=2097152
    [[ -e "$API_AUDIT_FILE" ]] || return 0
    current_bytes="$(stat -c %s -- "$API_AUDIT_FILE" 2>/dev/null || printf 0)"
    [[ "$current_bytes" =~ ^[0-9]+$ ]] || current_bytes=0
    ((current_bytes < max_bytes)) || {
        archive="$API_AUDIT_FILE.1"
        mv -f -- "$API_AUDIT_FILE" "$archive" || return 1
        chmod 600 -- "$archive" || return 1
    }
}

api_audit_event() {
    local action_id="$1" operation="$2" decision="$3" outcome="$4"
    local event event_id sequence generated_at
    mkdir -p -- "$STATE_DIR" || return 1
    chmod 700 -- "$STATE_DIR" || return 1
    generated_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    event_id="$(
        printf '%s\000%s\000%s\000%s\000%s' \
            "$action_id" "$operation" "$outcome" "$generated_at" "$$" |
            sha256sum |
            awk '{ print "audit-" substr($1, 1, 32) }'
    )"
    sequence="$(( $(date +%s) * 100000 + ($$ % 1000) * 100 + RANDOM % 100 ))"
    event="$(
        jq -cn \
            --arg generated_at "$generated_at" \
            --arg event_id "$event_id" \
            --argjson sequence "$sequence" \
            --arg action_id "$action_id" \
            --arg operation "$operation" \
            --arg decision "$decision" \
            --arg outcome "$outcome" \
            '{
                api_version: "1.0",
                event_id: $event_id,
                sequence: $sequence,
                generated_at: $generated_at,
                event_type: "audit.recorded",
                action_id: $action_id,
                payload: {
                    action_id: $action_id,
                    operation: $operation,
                    authorization: "system-mutate",
                    decision: $decision,
                    outcome: $outcome
                }
            }'
    )" || return 1
    umask 077
    api_rotate_audit_if_needed || return 1
    printf '%s\n' "$event" >>"$API_AUDIT_FILE"
    chmod 600 -- "$API_AUDIT_FILE"
}

api_action_outcome() {
    local action_id="$1" state="$2" state_changed="$3"
    local rollback_required="$4" rollback_state="$5" message_key="$6"
    jq -cn \
        --arg action_id "$action_id" \
        --arg state "$state" \
        --argjson state_changed "$state_changed" \
        --argjson rollback_required "$rollback_required" \
        --arg rollback_state "$rollback_state" \
        --arg message_key "$message_key" \
        '{
            action_id: $action_id,
            state: $state,
            state_changed: $state_changed,
            rollback: {
                required: $rollback_required,
                state: $rollback_state
            },
            message_key: $message_key
        }'
}

api_find_profile() {
    local profile_id="$1" field="$2"
    write_profiles_cache >/dev/null 2>&1 || true
    [[ -r "$PROFILES_FILE" ]] || return 1
    jq -er --arg profile_id "$profile_id" --arg field "$field" '
        (.profiles // [])
        | map(select(.profile_id == $profile_id))
        | first
        | .[$field]
        | select(type == "string" and length > 0)
    ' "$PROFILES_FILE"
}

api_restore_state() {
    local snapshot="$1" existed="$2" previous_desired="" tmp
    if [[ "$existed" == true ]]; then
        mkdir -p -- "$STATE_DIR" || return 1
        chmod 700 -- "$STATE_DIR" || return 1
        tmp="$STATE_DIR/.active.api-rollback.$$"
        install -m 600 "$snapshot" "$tmp" || return 1
        mv -f -- "$tmp" "$STATE_FILE" || return 1
        previous_desired="$(
            awk -F= '$1 == "DESIRED" { print substr($0, index($0, "=") + 1); exit }' \
                "$snapshot"
        )"
    else
        rm -f -- "$STATE_FILE" || return 1
    fi

    health_reset
    systemctl_quiet reset-failed "$SERVICE_NAME" || true
    if [[ "$previous_desired" == "up" ]]; then
        systemctl start "$SERVICE_NAME" || return 1
    else
        systemctl_quiet stop "$SERVICE_NAME" || true
    fi
    write_dashboard_cache >/dev/null 2>&1 || true
}

api_store_completed_action() {
    local record_file="$1" fingerprint="$2" operation="$3" outcome="$4" record
    record="$(
        jq -cn \
            --arg fingerprint "$fingerprint" \
            --arg operation "$operation" \
            --arg completed_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
            --argjson outcome "$outcome" \
            '{
                fingerprint: $fingerprint,
                state: "completed",
                operation: $operation,
                completed_at: $completed_at,
                outcome: $outcome
            }'
    )" || return 1
    api_write_record "$record_file" "$record"
}

api_recover_interrupted_actions() {
    local record base action_id fingerprint operation snapshot_existed snapshot
    local legacy_snapshot outcome rollback_state audit_outcome recovery_reason
    local recovery_failed=0
    [[ ! -e "$API_RECOVERY_MARKER" ]] || return 1
    shopt -s nullglob
    for record in "$API_ACTION_DIR"/*.json; do
        [[ "$(jq -r '.state // ""' "$record" 2>/dev/null || true)" == "running" ]] ||
            continue
        base="$(basename -- "$record")"
        action_id="${base%.json}"
        if ! api_valid_identifier "$action_id"; then
            recovery_failed=1
            continue
        fi
        fingerprint="$(jq -r '.fingerprint // ""' "$record" 2>/dev/null || true)"
        operation="$(jq -r '.operation // ""' "$record" 2>/dev/null || true)"
        snapshot_existed="$(jq -r '.snapshot_existed // ""' "$record" 2>/dev/null || true)"
        snapshot="$API_ACTION_DIR/.snapshot.$action_id"
        recovery_reason=""

        if [[ "$snapshot_existed" != true && "$snapshot_existed" != false ]]; then
            legacy_snapshot=""
            for legacy_snapshot in "$API_ACTION_DIR/.snapshot.$action_id".*; do
                break
            done
            if [[ -n "$legacy_snapshot" && -r "$legacy_snapshot" ]]; then
                snapshot="$legacy_snapshot"
                if [[ -s "$snapshot" ]]; then
                    snapshot_existed=true
                else
                    snapshot_existed=false
                fi
            fi
        fi

        if [[ "$snapshot_existed" == false ]] ||
           [[ "$snapshot_existed" == true && -r "$snapshot" ]]; then
            if api_restore_state "$snapshot" "$snapshot_existed"; then
                rollback_state=completed
                outcome="$(api_action_outcome \
                    "$action_id" rolled-back true true "$rollback_state" \
                    api.action.interrupted-rolled-back)"
                audit_outcome=rolled-back
            else
                outcome="$(api_action_outcome \
                    "$action_id" rollback-failed true true failed \
                    api.action.interrupted-rollback-failed)"
                audit_outcome=rollback-failed
                recovery_reason="rollback-failed"
            fi
        else
            outcome="$(api_action_outcome \
                "$action_id" rollback-failed true true failed \
                api.action.interrupted-snapshot-missing)"
            audit_outcome=rollback-failed
            recovery_reason="snapshot-missing"
        fi

        if [[ -n "$recovery_reason" ]]; then
            if ! api_mark_recovery_required \
                "$action_id" "$operation" "$recovery_reason"; then
                recovery_failed=1
                continue
            fi
            recovery_failed=1
        fi

        if [[ -z "$fingerprint" || -z "$operation" ]] ||
           ! api_store_completed_action \
               "$record" "$fingerprint" "$operation" "$outcome"; then
            recovery_failed=1
            continue
        fi
        api_audit_event "$action_id" "$operation" approved "$audit_outcome" || true
        [[ -z "$recovery_reason" ]] || break
    done
    shopt -u nullglob
    ((recovery_failed == 0))
}

api_run_lifecycle_action() {
    local request="$1" request_id="$2" operation="$3" action_id="$4"
    local deadline_ms="$5" fingerprint record_file stored_fingerprint stored_state
    local outcome profile_id protocol profile snapshot snapshot_existed=false
    local duration output_file rc rollback_state audit_outcome running_record

    mkdir -p -- "$API_ACTION_DIR" || {
        api_error_response "$request_id" internal-error api.journal.unavailable true true
        return
    }
    chmod 700 -- "$API_ACTION_DIR" || {
        api_error_response "$request_id" internal-error api.journal.unavailable true true
        return
    }
    exec 7>"$API_ACTION_DIR/.mutation.lock"
    if ! flock -n 7; then
        api_error_response "$request_id" busy api.action.busy true false
        return
    fi
    if ! api_recover_interrupted_actions; then
        api_error_response "$request_id" internal-error \
            api.action.recovery-required false true
        return
    fi
    api_cleanup_action_temps
    api_prune_completed_actions "$action_id"

    fingerprint="$(
        jq -cS 'del(.request_id)' <<<"$request" |
            sha256sum |
            awk '{ print $1 }'
    )"
    record_file="$API_ACTION_DIR/$action_id.json"
    if [[ -r "$record_file" ]]; then
        stored_fingerprint="$(jq -r '.fingerprint // ""' "$record_file" 2>/dev/null || true)"
        stored_state="$(jq -r '.state // ""' "$record_file" 2>/dev/null || true)"
        if [[ "$stored_fingerprint" != "$fingerprint" ]]; then
            api_error_response "$request_id" conflict api.action.id-conflict false true
            return
        fi
        if [[ "$stored_state" == "completed" ]]; then
            outcome="$(jq -c '.outcome' "$record_file" 2>/dev/null)" || {
                api_error_response "$request_id" internal-error api.journal.corrupt false true
                return
            }
            api_ok_response "$request_id" "$outcome"
            return
        fi
        api_error_response "$request_id" internal-error api.journal.corrupt false true
        return
    fi

    case "$operation" in
        lifecycle.connect)
            if ! jq -e '
                ((.payload | keys) - ["profile_id", "protocol"] | length) == 0
            ' <<<"$request" >/dev/null 2>&1; then
                api_error_response "$request_id" invalid-request api.profile.payload-invalid false true
                return
            fi
            profile_id="$(jq -er '.payload.profile_id' <<<"$request" 2>/dev/null)" || {
                api_error_response "$request_id" invalid-request api.profile.id-required false true
                return
            }
            api_valid_identifier "$profile_id" || {
                api_error_response "$request_id" invalid-request api.profile.id-invalid false true
                return
            }
            protocol="$(api_find_profile "$profile_id" protocol 2>/dev/null)" || {
                api_error_response "$request_id" not-found api.profile.not-found false true
                return
            }
            if ! jq -e --arg protocol "$protocol" '
                (.payload.protocol // $protocol) == $protocol
            ' <<<"$request" >/dev/null 2>&1; then
                api_error_response "$request_id" conflict api.profile.protocol-conflict false true
                return
            fi
            profile="$(api_find_profile "$profile_id" file_name 2>/dev/null)" || {
                api_error_response "$request_id" not-found api.profile.not-found false true
                return
            }
            ;;
        lifecycle.reconnect|lifecycle.disconnect)
            if ! jq -e '.payload == {}' <<<"$request" >/dev/null 2>&1; then
                api_error_response "$request_id" invalid-request api.payload.must-be-empty false true
                return
            fi
            ;;
        *)
            api_error_response "$request_id" unsupported-operation api.operation.unsupported false true
            return
            ;;
    esac

    snapshot="$API_ACTION_DIR/.snapshot.$action_id"
    if [[ -r "$STATE_FILE" ]]; then
        install -m 600 "$STATE_FILE" "$snapshot" || {
            api_error_response "$request_id" internal-error api.snapshot.failed true true
            return
        }
        snapshot_existed=true
    else
        : >"$snapshot" || {
            api_error_response "$request_id" internal-error api.snapshot.failed true true
            return
        }
        chmod 600 -- "$snapshot"
    fi

    running_record="$(
        jq -cn \
            --arg fingerprint "$fingerprint" \
            --arg operation "$operation" \
            --arg started_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
            --argjson snapshot_existed "$snapshot_existed" \
            '{
                fingerprint: $fingerprint,
                state: "running",
                operation: $operation,
                started_at: $started_at,
                snapshot_existed: $snapshot_existed
            }'
    )"
    api_write_record "$record_file" "$running_record" || {
        rm -f -- "$snapshot"
        api_error_response "$request_id" internal-error api.journal.unavailable true true
        return
    }
    api_audit_event "$action_id" "$operation" approved started || true

    output_file="$API_ACTION_DIR/.output.$action_id.$$"
    duration=$(((deadline_ms + 999) / 1000))
    ((duration > 0)) || duration=1

    case "$operation" in
        lifecycle.connect)
            timeout --foreground --kill-after=5s "${duration}s" \
                "$SELF" connect "$protocol" "$profile" >"$output_file" 2>&1
            rc=$?
            ;;
        lifecycle.reconnect)
            timeout --foreground --kill-after=5s "${duration}s" \
                "$SELF" reconnect >"$output_file" 2>&1
            rc=$?
            ;;
        lifecycle.disconnect)
            timeout --foreground --kill-after=5s "${duration}s" \
                "$SELF" disconnect >"$output_file" 2>&1
            rc=$?
            ;;
    esac
    rm -f -- "$output_file"

    if ((rc == 0)); then
        write_dashboard_cache >/dev/null 2>&1 || true
        outcome="$(api_action_outcome \
            "$action_id" succeeded true false not-needed api.action.succeeded)"
        audit_outcome=succeeded
    else
        if api_restore_state "$snapshot" "$snapshot_existed"; then
            rollback_state=completed
            if ((rc == 124 || rc == 137)); then
                outcome="$(api_action_outcome \
                    "$action_id" timed-out true true "$rollback_state" \
                    api.action.deadline-exceeded)"
                audit_outcome=timed-out
            else
                outcome="$(api_action_outcome \
                    "$action_id" rolled-back true true "$rollback_state" \
                    api.action.rolled-back)"
                audit_outcome=rolled-back
            fi
        else
            outcome="$(api_action_outcome \
                "$action_id" rollback-failed true true failed \
                api.action.rollback-failed)"
            audit_outcome=rollback-failed
            if ! api_mark_recovery_required \
                "$action_id" "$operation" rollback-failed; then
                api_error_response "$request_id" internal-error \
                    api.journal.unavailable false true
                return
            fi
        fi
    fi
    api_store_completed_action "$record_file" "$fingerprint" "$operation" "$outcome" || {
        api_error_response "$request_id" internal-error api.journal.unavailable true true
        return
    }
    rm -f -- "$snapshot"
    api_audit_event "$action_id" "$operation" approved "$audit_outcome" || true
    api_ok_response "$request_id" "$outcome"
}

api_dispatch() {
    local request="" request_id operation result action_id authorization deadline_ms
    local allowed_keys
    local LC_ALL=C
    ((EUID == 0)) || [[ "${VPNCTL_ALLOW_UNPRIVILEGED:-0}" == "1" ]] || {
        api_error_response "$(api_server_request_id)" permission-denied \
            api.transport.root-required false true
        return
    }
    export VPNCTL_API_SERVER_CONTEXT=1
    for command in jq sha256sum flock timeout install; do
        command -v "$command" >/dev/null 2>&1 || {
            api_error_response "$(api_server_request_id)" backend-unavailable \
                api.runtime.missing-dependency false true
            return
        }
    done
    [[ "$API_MAX_REQUEST_BYTES" =~ ^[1-9][0-9]*$ ]] &&
        ((API_MAX_REQUEST_BYTES <= 1048576)) || API_MAX_REQUEST_BYTES=65536
    if ! IFS= read -r -t 5 -n "$((API_MAX_REQUEST_BYTES + 1))" request; then
        api_error_response "$(api_server_request_id)" invalid-request \
            api.request.missing false false
        return
    fi
    if ((${#request} == 0 || ${#request} > API_MAX_REQUEST_BYTES)); then
        api_error_response "$(api_server_request_id)" invalid-request \
            api.request.size false false
        return
    fi
    if ! jq -e 'type == "object"' <<<"$request" >/dev/null 2>&1; then
        api_error_response "$(api_server_request_id)" invalid-request \
            api.request.invalid-json false false
        return
    fi
    allowed_keys='[
        "action_id", "api_version", "authorization", "deadline_ms",
        "operation", "payload", "request_id"
    ]'
    if ! jq -e --argjson allowed "$allowed_keys" '
        ((keys - $allowed) | length) == 0
        and has("api_version")
        and has("request_id")
        and has("operation")
        and has("payload")
        and (.api_version | type == "string")
        and (.request_id | type == "string")
        and (.operation | type == "string")
        and (.payload | type == "object")
    ' <<<"$request" >/dev/null 2>&1; then
        api_error_response "$(api_server_request_id)" invalid-request \
            api.request.shape false false
        return
    fi

    request_id="$(jq -r '.request_id // ""' <<<"$request")"
    if ! api_valid_identifier "$request_id"; then
        api_error_response "$(api_server_request_id)" invalid-request \
            api.request.id-invalid false false
        return
    fi
    if [[ "$(jq -r '.api_version // ""' <<<"$request")" != "1.0" ]]; then
        api_error_response "$request_id" unsupported-version api.version.unsupported false true
        return
    fi
    operation="$(jq -r '.operation // ""' <<<"$request")"
    case "$operation" in
        status.get|profiles.list)
            if jq -e 'has("action_id") or has("authorization")' \
                <<<"$request" >/dev/null 2>&1; then
                api_error_response "$request_id" invalid-request \
                    api.query.mutation-fields false false
                return
            fi
            if ! jq -e '
                .payload == {}
                and (
                    (has("deadline_ms") | not)
                    or (
                        (.deadline_ms | type == "number")
                        and ((.deadline_ms | floor) == .deadline_ms)
                        and .deadline_ms >= 100
                        and .deadline_ms <= 900000
                    )
                )
            ' <<<"$request" >/dev/null 2>&1; then
                api_error_response "$request_id" invalid-request \
                    api.query.payload-invalid false false
                return
            fi
            if [[ "$operation" == status.get ]]; then
                result="$(api_status_result)" || {
                    api_error_response "$request_id" backend-unavailable \
                        api.status.unavailable true false
                    return
                }
            else
                result="$(api_profiles_result)" || {
                    api_error_response "$request_id" backend-unavailable \
                        api.profiles.unavailable true false
                    return
                }
            fi
            api_ok_response "$request_id" "$result"
            ;;
        lifecycle.connect|lifecycle.reconnect|lifecycle.disconnect)
            if ! jq -e '
                (.action_id | type == "string")
                and (.authorization | type == "string")
                and (.deadline_ms | type == "number")
                and ((.deadline_ms | floor) == .deadline_ms)
            ' <<<"$request" >/dev/null 2>&1; then
                api_error_response "$request_id" invalid-request \
                    api.mutation.requirements false true
                return
            fi
            action_id="$(jq -r '.action_id // ""' <<<"$request")"
            authorization="$(jq -r '.authorization // ""' <<<"$request")"
            deadline_ms="$(jq -r '.deadline_ms // ""' <<<"$request")"
            if ! api_valid_identifier "$action_id" ||
               [[ "$authorization" != system-mutate ]] ||
               [[ ! "$deadline_ms" =~ ^[0-9]+$ ]] ||
               ((deadline_ms < 100 || deadline_ms > 900000)); then
                api_error_response "$request_id" invalid-request \
                    api.mutation.requirements false true
                return
            fi
            api_run_lifecycle_action \
                "$request" "$request_id" "$operation" "$action_id" "$deadline_ms"
            ;;
        *)
            api_error_response "$request_id" unsupported-operation \
                api.operation.unsupported false true
            ;;
    esac
}

check_command() {
    local command="$1" label="${2:-$1}"
    if command -v "$command" >/dev/null 2>&1; then
        check_ok "$label: $(command -v "$command")"
    else
        check_fail "$label не установлен"
    fi
}

check_active_connection() {
    local protocol="$1" interface handshake now age ip
    interface="$(interface_for_protocol "$protocol")"
    if service_active; then
        check_ok "$SERVICE_NAME активен"
    else
        check_fail "$SERVICE_NAME не активен"
    fi

    if connection_local_ok "$protocol"; then
        check_ok "VPN-интерфейс/соединение активно${interface:+: $interface}"
    else
        check_fail "VPN-интерфейс/соединение не найдено"
        return
    fi

    if [[ "$protocol" == "amneziawg" || "$protocol" == "wireguard" ]]; then
        handshake="$(latest_handshake "$protocol" "$interface")"
        if [[ "$handshake" =~ ^[0-9]+$ ]] && ((handshake > 0)); then
            now="$(date +%s)"
            age=$((now - handshake))
            if ((age <= 180)); then
                check_ok "Последний handshake: $age сек. назад"
            else
                check_warn "Handshake устарел: $age сек. назад"
            fi
        else
            check_warn "Handshake ещё не получен"
        fi
    fi

    ip="$(public_ip "$interface" || true)"
    if [[ -n "$ip" ]]; then
        check_ok "Интернет через VPN работает; внешний IP: $ip"
    else
        check_fail "Нет ответа через VPN-интерфейс от $PROBE_URL"
    fi
}

cmd_diagnose() {
    local protocol profile endpoint_host
    require_profile_access diagnose "$@"
    CHECK_OK=0
    CHECK_WARN=0
    CHECK_FAIL=0
    say "${C_BOLD}Диагностика VPN${C_RESET}"

    if ip route show default 2>/dev/null | grep -q .; then
        check_ok "Основной маршрут существует"
    else
        check_fail "Основной маршрут отсутствует"
    fi
    if getent ahostsv4 example.com >/dev/null 2>&1; then
        check_ok "DNS-разрешение работает"
    else
        check_fail "DNS-разрешение не работает"
    fi

    if ! selected_from_state; then
        check_fail "Активный профиль не выбран"
    else
        protocol="$SELECTED_PROTOCOL"
        profile="$SELECTED_PROFILE"
        check_ok "Выбран $(protocol_title "$protocol"): $(profile_name "$profile")"
        validate_profile "$protocol" "$profile" 0 || true
        endpoint_host="$(profile_endpoint "$protocol" "$profile")"
        endpoint_host="${endpoint_host#[}"
        endpoint_host="${endpoint_host%%]*}"
        endpoint_host="${endpoint_host%%:*}"
        if [[ -n "$endpoint_host" ]]; then
            if getent ahostsv4 "$endpoint_host" >/dev/null 2>&1; then
                check_ok "Адрес VPN-сервера разрешается: $endpoint_host"
            else
                check_fail "Не удаётся разрешить адрес VPN-сервера: $endpoint_host"
            fi
        fi
        check_active_connection "$protocol"
    fi

    printf '\nИтог: OK=%d WARN=%d FAIL=%d\n' "$CHECK_OK" "$CHECK_WARN" "$CHECK_FAIL"
    ((CHECK_FAIL == 0))
}

