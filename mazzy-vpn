            "$([[ "$state" == "connected" ]] && printf '%s' "$C_GREEN" || printf '%s' "$C_YELLOW")" \
            "$C_RESET" "$service_text" "$(msg internet)" "$internet_text"
        printf '│  ◆ %s: %s\n' "$(msg location)" "$profile_name"
        printf '│  ◇ %s: %s\n' "$(msg protocol_label)" "$(protocol_title "$protocol")"
        printf '│  ★ %s: %s\n' "$(msg default_config)" "$profile_name"
        printf '│  ↳ API: 1.0  ·  %s: %s\n' \
            "$(msg connection_health_label)" \
            "$(jq -r 'if .result.connection.healthy then "OK" else "WARN" end' <<<"$response")"
        if [[ -n "$interface" || -n "$public_ip" ]]; then
            printf '│  ↳ %s: %s  ·  %s: %s\n' \
                "$(msg interface_label)" "${interface:--}" \
                "$(msg public_ip_label)" "${public_ip:--}"
        fi
        [[ -z "$handshake_age" ]] ||
            printf '│  ↳ %s: %s sec ago\n' \
                "$(msg handshake_label)" "$handshake_age"
        printf '│  ↳ %s: %s  ·  %s: %s\n' \
            "$(msg autostart_label)" "$autostart_text" \
            "$(msg health_label)" "$monitor_text"
        printf '│  ↳ %s: %s\n' "$(msg fallback)" "$fallback_text"
    else
        printf '│  ○ %s: %s\n' "$(msg selected)" "$(msg no_profile)"
        printf '│  %s: %s\n' "$(msg internet)" "$(msg not_available)"
    fi
    printf '├─ %s ──────────────────────────────────────────────────┤\n' "$(msg profiles)"
    printf '│  %s\n' "$counts"
    printf '╰────────────────────────────────────────────────────────╯\n'
}

