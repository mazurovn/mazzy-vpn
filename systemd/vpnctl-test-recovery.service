[Unit]
Description=Restore Mazzy VPN state after an interrupted tunnel test
After=local-fs.target
Before=vpnctl.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/mazzy-vpn _recover-stale-test
UMask=0077

[Install]
WantedBy=multi-user.target
