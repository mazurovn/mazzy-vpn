[Unit]
Description=Restore Mazzy VPN state after an interrupted tunnel test
Wants=mazzy-vpn-api-recovery.service
After=local-fs.target mazzy-vpn-api-recovery.service
Before=vpnctl.service

[Service]
Type=oneshot
ExecStart=/usr/local/lib/mazzy-vpn/mazzy-vpn _recover-stale-test
UMask=0077
TimeoutStartSec=60s

[Install]
WantedBy=multi-user.target
