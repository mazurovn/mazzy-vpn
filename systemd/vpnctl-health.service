[Unit]
Description=Mazzy VPN connection health check
Wants=mazzy-vpn-api-recovery.service
After=network-online.target mazzy-vpn-api-recovery.service vpnctl.service

[Service]
Type=oneshot
ExecStart=/usr/local/lib/mazzy-vpn/mazzy-vpn _health-check
UMask=0077
