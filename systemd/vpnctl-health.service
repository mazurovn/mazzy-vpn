[Unit]
Description=Mazzy VPN connection health check
Requires=mazzy-vpn-api-recovery.service
After=network-online.target mazzy-vpn-api-recovery.service vpnctl.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/mazzy-vpn _health-check
UMask=0077
