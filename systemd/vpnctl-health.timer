[Unit]
Description=Periodically check and recover Mazzy VPN connection

[Timer]
OnBootSec=15s
OnUnitActiveSec=20s
AccuracySec=1s
RandomizedDelaySec=2s
Unit=vpnctl-health.service
Persistent=true

[Install]
WantedBy=timers.target
