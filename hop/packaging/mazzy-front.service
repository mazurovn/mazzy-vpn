#
# mazzy-front owns A2A and the status page. It calls the admin API.
# No credential is stored in this unit. Do not set MAZZY_HOP_TEST_ROOT.

[Unit]
Description=Mazzy hop frontend
Documentation=https://github.com/mazurovn/mazzy-vpn
After=mazzy-backend.service
Wants=mazzy-backend.service

[Service]
Type=simple
ExecStart=/usr/local/bin/mazzy-front --config /etc/mazzy-vpn/hop.toeac --trust /usr/local/bin/mazzy-core --toeac /usr/local/bin/mazzy-toeac
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=78
User=root
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true

[Install]
WantedBy=multi-user.target
