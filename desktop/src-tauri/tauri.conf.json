{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mazzy VPN Desktop",
  "version": "0.1.0",
  "identifier": "com.mazurovn.mazzy-vpn",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Mazzy VPN",
        "width": 1180,
        "height": 820,
        "minWidth": 740,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Mazzy VPN CLI dashboard and tray",
    "longDescription": "A secure dashboard and system tray companion for the Mazzy VPN CLI engine.",
    "copyright": "Copyright © 2026 Nik m (@mazurovn)",
    "license": "AGPL-3.0-or-later",
    "homepage": "https://github.com/mazurovn/mazzy-vpn",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
