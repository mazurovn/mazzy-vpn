{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mazzy VPN Desktop",
  "version": "0.4.8",
  "identifier": "com.mazurovn.mazzy-vpn",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Mazzy VPN",
        "width": 1180,
        "height": 820,
        "minWidth": 740,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
      "targets": "all",
    "category": "Utility",
    "shortDescription": "AI-ready, self-healing multi-protocol VPN client",
    "longDescription": "An open AI-ready VPN client and control center for resilient access to AI tools, the web, video and corporate resources. Linux connections currently support AmneziaWG, WireGuard, OpenVPN and L2TP/IPsec, with a versioned 13-protocol catalog and safe detection foundation for future audited adapters.",
    "copyright": "Copyright © 2026 Nik m (@mazurovn)",
    "license": "PolyForm-Noncommercial-1.0.0",
    "homepage": "https://github.com/mazurovn/mazzy-vpn",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "acl",
          "bash",
          "ca-certificates",
          "coreutils",
          "curl",
          "diffutils",
          "findutils",
          "grep",
          "iproute2",
          "iputils-ping",
          "jq",
          "libc-bin",
          "nftables",
          "openvpn",
          "passwd",
          "pkexec",
          "procps",
          "python3",
          "socat",
          "sed",
          "systemd",
          "util-linux"
        ],
        "recommends": [
          "network-manager",
          "network-manager-l2tp",
          "netcat-openbsd",
          "ppp",
          "strongswan",
          "wireguard-tools",
          "xl2tpd"
        ],
