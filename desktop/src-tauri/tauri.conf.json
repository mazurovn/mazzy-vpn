{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mazzy VPN Desktop",
  "version": "0.2.0",
  "identifier": "com.mazurovn.mazzy-vpn",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Mazzy VPN",
        "width": 1180,
        "height": 820,
        "minWidth": 740,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Mazzy VPN Desktop control center",
    "longDescription": "A Linux VPN control center with an embedded Mazzy VPN engine installer, profiles, diagnostics, tests, logs, settings and tray controls.",
    "copyright": "Copyright © 2026 Nik m (@mazurovn)",
    "license": "AGPL-3.0-or-later",
    "homepage": "https://github.com/mazurovn/mazzy-vpn",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../mazzy-vpn": "engine/mazzy-vpn",
      "../../vpnctl": "engine/vpnctl",
      "../../install.sh": "engine/install.sh",
      "../../setup_amnezia_vpn.sh": "engine/setup_amnezia_vpn.sh",
      "../../stop_amnezia_vpn.sh": "engine/stop_amnezia_vpn.sh",
      "../../LICENSE": "engine/LICENSE",
      "../../AUTHORS.md": "engine/AUTHORS.md",
      "../../CHANGELOG.md": "engine/CHANGELOG.md",
      "../../SECURITY.md": "engine/SECURITY.md",
      "../../PRIVACY.md": "engine/PRIVACY.md",
      "../../README.md": "engine/README.md",
      "../../README.ru.md": "engine/README.ru.md",
      "../../README.en.md": "engine/README.en.md",
      "../../README.de.md": "engine/README.de.md",
      "../../README.zh.md": "engine/README.zh.md",
      "../../README.ja.md": "engine/README.ja.md",
      "../../README.ko.md": "engine/README.ko.md",
      "../../api/": "engine/api",
      "../../docs/": "engine/docs",
      "../../tests/": "engine/tests",
      "../../systemd/": "engine/systemd",
      "../../completions/": "engine/completions",
      "../README.md": "engine/desktop/README.md"
    }
  }
}
