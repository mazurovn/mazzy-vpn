{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mazurovn/mazzy-vpn/api/v1/schema.json",
  "title": "Mazzy VPN local API v1 envelopes",
  "description": "Language-neutral frontend-safe request, response and event contract.",
  "oneOf": [
    {
      "$ref": "#/$defs/RequestEnvelope"
    },
    {
      "$ref": "#/$defs/ResponseEnvelope"
    },
    {
      "$ref": "#/$defs/EventEnvelope"
    }
  ],
  "$defs": {
    "ApiVersion": {
      "const": "1.0"
    },
    "Identifier": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]+$"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "Protocol": {
      "enum": [
        "amneziawg",
        "wireguard",
        "openvpn",
        "l2tp"
      ]
    },
    "Authorization": {
      "enum": [
        "none",
        "system-read",
        "user-write",
        "system-mutate"
      ]
    },
    "QueryOperation": {
      "enum": [
        "status.get",
        "profiles.list",
        "protocols.list",
        "planner.evaluate",
        "profiles.inspect-import",
        "tests.validate",
        "tests.probe",
        "tests.verify-egress",
        "tests.verify-service-egress",
        "services.get",
        "doctor.inspect",
        "settings.get"
      ]
    },
    "MutationOperation": {
      "enum": [
        "profiles.import",
        "profiles.remove",
        "profiles.select",
        "lifecycle.connect",
        "lifecycle.reconnect",
        "lifecycle.disconnect",
        "tests.run",
        "tests.run-all",
        "tests.emergency",
        "services.start-engine",
        "services.stop-engine",
        "services.restart-engine",
        "services.set-autostart",
        "services.set-monitor",
        "services.set-recovery",
        "doctor.apply-fix",
        "settings.update"
      ]
    },
    "EmptyPayload": {
      "type": "object",
      "additionalProperties": false
    },
    "ProfileReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id"
      ],
      "properties": {
        "profile_id": {
          "$ref": "#/$defs/Identifier"
        },
        "protocol": {
          "$ref": "#/$defs/Protocol"
        }
      }
    },
    "ImportReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "import_token"
      ],
      "properties": {
        "import_token": {
          "$ref": "#/$defs/Identifier"
        },
        "replace_existing": {
          "type": "boolean"
        }
      }
    },
    "PlannerEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recent_outcome",
        "consecutive_failures",
        "reachability",
        "latency_ms",
        "loss_percent",
        "evidence_age_seconds"
      ],
      "properties": {
        "recent_outcome": {
          "enum": ["success", "unknown", "failure"]
        },
        "consecutive_failures": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "reachability": {
          "enum": ["reachable", "unknown", "unreachable"]
        },
        "latency_ms": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 60000
        },
        "loss_percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "evidence_age_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        }
      }
    },
    "PlannerCandidateInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "evidence"],
      "properties": {
        "profile_id": {
          "$ref": "#/$defs/Identifier"
        },
        "evidence": {
          "$ref": "#/$defs/PlannerEvidence"
        }
      }
    },
    "PlannerRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workload", "candidates"],
      "properties": {
        "workload": {
          "enum": [
            "general",
            "llm-streaming",
            "api-calls",
            "video",
            "split-routing"
          ]
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/PlannerCandidateInput"
          }
        }
      }
    },
    "TestRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeout_seconds"
      ],
      "properties": {
        "profile_id": {
          "$ref": "#/$defs/Identifier"
        },
        "protocol": {
          "$ref": "#/$defs/Protocol"
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "include_speed": {
          "type": "boolean"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 900
        }
      }
    },
    "ServiceChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "DoctorFixRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fix_id"
      ],
      "properties": {
        "fix_id": {
          "$ref": "#/$defs/Identifier"
        }
      }
    },
    "SettingsPatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "language": {
          "enum": [
            "ru",
            "en",
            "de",
            "zh",
            "ja",
            "ko"
          ]
        },
        "notifications": {
          "type": "boolean"
        },
        "update_channel": {
          "enum": [
            "stable",
            "preview"
          ]
        },
        "fallback_policy": {
          "enum": [
            "disabled",
            "previous-profile",
            "emergency"
          ]
        }
      },
      "minProperties": 1
    },
    "RequestPayload": {
      "oneOf": [
        {
          "$ref": "#/$defs/EmptyPayload"
        },
        {
          "$ref": "#/$defs/ProfileReference"
        },
        {
          "$ref": "#/$defs/ImportReference"
        },
        {
          "$ref": "#/$defs/PlannerRequest"
        },
        {
          "$ref": "#/$defs/TestRequest"
        },
        {
          "$ref": "#/$defs/ServiceEgressRequest"
        },
        {
          "$ref": "#/$defs/ServiceChange"
        },
        {
          "$ref": "#/$defs/DoctorFixRequest"
        },
        {
          "$ref": "#/$defs/SettingsPatch"
        }
      ]
    },
    "QueryRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_version",
        "request_id",
        "operation",
        "payload"
      ],
      "properties": {
        "api_version": {
          "$ref": "#/$defs/ApiVersion"
        },
        "request_id": {
          "$ref": "#/$defs/Identifier"
        },
        "operation": {
          "$ref": "#/$defs/QueryOperation"
        },
        "deadline_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 900000
        },
        "payload": {
          "$ref": "#/$defs/RequestPayload"
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["operation"],
            "properties": {
              "operation": {"const": "planner.evaluate"}
            }
          },
          "then": {
            "required": ["deadline_ms"],
            "properties": {
              "deadline_ms": {
                "type": "integer",
                "minimum": 100,
                "maximum": 30000
              },
              "payload": {
                "$ref": "#/$defs/PlannerRequest"
              }
            }
          }
        },
        {
          "if": {
            "required": ["payload"],
            "properties": {
              "payload": {
                "$ref": "#/$defs/PlannerRequest"
              }
            }
          },
          "then": {
            "properties": {
              "operation": {"const": "planner.evaluate"}
            }
          }
        },
        {
          "if": {
            "required": ["operation"],
            "properties": {
              "operation": {"const": "tests.verify-service-egress"}
            }
          },
          "then": {
            "required": ["deadline_ms"],
            "properties": {
              "deadline_ms": {
                "type": "integer",
                "minimum": 100,
                "maximum": 32000
              },
              "payload": {
                "$ref": "#/$defs/ServiceEgressRequest"
              }
            }
          }
        },
        {
          "if": {
            "required": ["payload"],
            "properties": {
              "payload": {
                "$ref": "#/$defs/ServiceEgressRequest"
              }
            }
          },
          "then": {
            "properties": {
              "operation": {"const": "tests.verify-service-egress"}
            }
          }
        }
      ]
    },
    "MutationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_version",
        "request_id",
        "operation",
        "action_id",
        "authorization",
        "deadline_ms",
        "payload"
      ],
      "properties": {
        "api_version": {
          "$ref": "#/$defs/ApiVersion"
        },
        "request_id": {
          "$ref": "#/$defs/Identifier"
        },
        "operation": {
          "$ref": "#/$defs/MutationOperation"
        },
        "action_id": {
          "$ref": "#/$defs/Identifier"
        },
        "authorization": {
          "$ref": "#/$defs/Authorization"
        },
        "deadline_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 900000
        },
        "payload": {
          "$ref": "#/$defs/RequestPayload"
        }
      }
    },
    "RequestEnvelope": {
      "oneOf": [
        {
          "$ref": "#/$defs/QueryRequest"
        },
        {
          "$ref": "#/$defs/MutationRequest"
        }
      ]
    },
    "ConnectionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "disconnected",
            "connecting",
            "connected",
            "testing",
            "recovering",
            "error",
            "unknown"
          ]
        },
        "protocol": {
          "$ref": "#/$defs/Protocol"
        },
        "profile_id": {
          "$ref": "#/$defs/Identifier"
        },
        "internet_reachable": {
          "type": "boolean"
        },
        "healthy": {
          "type": "boolean"
        },
        "interface": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "handshake_age": {
          "type": "integer",
          "minimum": 0
        },
        "public_ip": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[0-9A-Fa-f:.]+$"
        }
      }
    },
    "FallbackSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active"
      ],
      "properties": {
        "active": {
          "type": "boolean"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "PublicStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product",
        "engine_version",
        "generated_at",
        "available",
        "connection"
      ],
      "properties": {
        "product": {
          "const": "Mazzy VPN"
        },
        "engine_version": {
          "type": "string"
        },
        "generated_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "available": {
          "type": "boolean"
        },
        "connection": {
          "$ref": "#/$defs/ConnectionSummary"
        },
        "desired": {
          "enum": [
            "up",
            "down",
            "unknown"
          ]
        },
        "mode": {
          "enum": [
            "normal",
            "test",
            "unknown"
          ]
        },
        "autostart": {
          "type": "boolean"
        },
        "health_monitor": {
          "type": "boolean"
        },
        "health_failures": {
          "type": "integer",
          "minimum": 0
        },
        "fallback": {
          "$ref": "#/$defs/FallbackSummary"
        }
      }
    },
    "ProfileSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "display_name",
        "protocol",
        "selected",
        "validation"
      ],
      "properties": {
        "profile_id": {
          "$ref": "#/$defs/Identifier"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "protocol": {
          "$ref": "#/$defs/Protocol"
        },
        "selected": {
          "type": "boolean"
        },
        "validation": {
          "enum": [
            "unknown",
            "valid",
            "invalid"
          ]
        },
        "source_kind": {
          "enum": [
            "system",
            "imported",
            "managed"
          ]
        }
      }
    },
    "ProfileCollection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profiles"
      ],
      "properties": {
        "profiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProfileSummary"
          }
        }
      }
    },
    "ProtocolSupportStatus": {
      "enum": [
        "implemented",
        "partial",
        "planned"
      ]
    },
    "ProtocolCatalogEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "display_name",
        "kind",
        "family",
        "formats",
        "uri_schemes",
        "engines",
        "transports",
        "censorship_resistance",
        "active_probe_resistance",
        "support"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,31}$"},
        "display_name": {"type": "string", "minLength": 2, "maxLength": 64},
        "kind": {"enum": ["vpn", "proxy", "transport"]},
        "family": {"type": "string", "minLength": 2, "maxLength": 64},
        "formats": {"type": "array", "uniqueItems": true, "items": {"type": "string", "maxLength": 64}},
        "uri_schemes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "maxLength": 32}},
        "engines": {"type": "array", "uniqueItems": true, "items": {"type": "string", "maxLength": 64}},
        "transports": {"type": "array", "uniqueItems": true, "items": {"type": "string", "maxLength": 32}},
        "censorship_resistance": {"enum": ["low", "medium", "high"]},
        "active_probe_resistance": {"enum": ["low", "limited", "medium", "high"]},
        "support": {
          "type": "object",
          "additionalProperties": false,
          "required": ["detection", "import", "diagnostics", "linux", "windows", "android"],
          "properties": {
            "detection": {"$ref": "#/$defs/ProtocolSupportStatus"},
            "import": {"$ref": "#/$defs/ProtocolSupportStatus"},
            "diagnostics": {"$ref": "#/$defs/ProtocolSupportStatus"},
            "linux": {"$ref": "#/$defs/ProtocolSupportStatus"},
            "windows": {"$ref": "#/$defs/ProtocolSupportStatus"},
            "android": {"$ref": "#/$defs/ProtocolSupportStatus"}
          }
        }
      }
    },
    "ProtocolCatalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "catalog_version", "protocols", "orchestration"],
      "properties": {
        "schema_version": {"const": 1},
        "catalog_version": {"type": "string", "format": "date"},
        "protocols": {
          "type": "array",
          "minItems": 10,
          "maxItems": 15,
          "items": {"$ref": "#/$defs/ProtocolCatalogEntry"}
        },
        "orchestration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy_version", "hard_constraints", "score_factors", "agent_rules"],
          "properties": {
            "policy_version": {"const": 1},
            "hard_constraints": {"type": "array", "uniqueItems": true, "items": {"type": "string", "maxLength": 64}},
            "score_factors": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "weight"],
                "properties": {
                  "id": {"type": "string", "maxLength": 64},
                  "weight": {"type": "integer", "minimum": 1, "maximum": 100}
                }
              }
            },
            "agent_rules": {"type": "array", "uniqueItems": true, "items": {"type": "string", "maxLength": 96}}
          }
        }
      }
    },
    "PlannerGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "passed", "reason_code"],
      "properties": {
        "id": {
          "enum": [
            "backend-ready",
            "profile-valid",
            "secrets-readable-only-by-backend",
            "rollback-storage-ready",
            "platform-supported"
          ]
        },
        "passed": {
          "type": "boolean"
        },
        "reason_code": {
          "$ref": "#/$defs/Identifier"
        }
      }
    },
    "PlannerFactor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "points", "max_points", "reason_code"],
      "properties": {
        "id": {
          "enum": [
            "recent-success",
            "censorship-fit",
            "reachability",
            "latency-loss",
            "workload-fit"
          ]
        },
        "points": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "max_points": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "reason_code": {
          "$ref": "#/$defs/Identifier"
        }
      }
    },
    "PlannerCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "eligible",
        "rank",
        "score",
        "hard_gates",
        "factors",
        "reason_codes"
      ],
      "properties": {
        "profile_id": {
          "$ref": "#/$defs/Identifier"
        },
        "protocol": {
          "$ref": "#/$defs/Protocol"
        },
        "eligible": {
          "type": "boolean"
        },
        "rank": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "score": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "hard_gates": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/PlannerGate"
          }
        },
        "factors": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/PlannerFactor"
          }
        },
        "reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        }
      }
    },
    "PlannerEvaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "policy_version",
        "catalog_version",
        "evaluated_at",
        "dry_run",
        "workload",
        "ordered_profile_ids",
        "candidates"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "policy_version": {
          "const": 1
        },
        "catalog_version": {
          "type": "string",
          "format": "date"
        },
        "evaluated_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "dry_run": {
          "const": true
        },
        "workload": {
          "enum": [
            "general",
            "llm-streaming",
            "api-calls",
            "video",
            "split-routing"
          ]
        },
        "ordered_profile_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/PlannerCandidate"
          }
        }
      }
    },
    "TestResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "profile_id": {
          "$ref": "#/$defs/Identifier"
        },
        "protocol": {
          "$ref": "#/$defs/Protocol"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "timed-out",
            "cancelled",
            "rolled-back",
            "rollback-failed"
          ]
        },
        "latency_ms": {
          "type": "integer",
          "minimum": 0
        },
        "message_key": {
          "$ref": "#/$defs/Identifier"
        }
      }
    },
    "ProbeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "display_name",
        "protocol",
        "selected",
        "active",
        "transport",
        "reachability",
        "latency_ms",
        "latency_source",
        "message_key"
      ],
      "properties": {
        "profile_id": {
          "$ref": "#/$defs/Identifier"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "protocol": {
          "$ref": "#/$defs/Protocol"
        },
        "selected": {
          "type": "boolean"
        },
        "active": {
          "type": "boolean"
        },
        "transport": {
          "enum": [
            "tcp",
            "udp"
          ]
        },
        "reachability": {
          "enum": [
            "reachable",
            "unknown",
            "unreachable",
            "invalid"
          ]
        },
        "latency_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "latency_source": {
          "enum": [
            "icmp",
            "tcp",
            "none"
          ]
        },
        "message_key": {
          "$ref": "#/$defs/Identifier"
        }
      }
    },
    "ProbeSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "reachable",
        "unknown",
        "unreachable",
        "invalid",
        "active"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "reachable": {
          "type": "integer",
          "minimum": 0
        },
        "unknown": {
          "type": "integer",
          "minimum": 0
        },
        "unreachable": {
          "type": "integer",
          "minimum": 0
        },
        "invalid": {
          "type": "integer",
          "minimum": 0
        },
        "active": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ProbeCollection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "checked_at",
        "scope",
        "timeout_seconds",
        "concurrency",
        "duration_ms",
        "summary",
        "results"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "checked_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "scope": {
          "oneOf": [
            {
              "$ref": "#/$defs/Protocol"
            },
            {
              "const": "all"
            }
          ]
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "summary": {
          "$ref": "#/$defs/ProbeSummary"
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProbeResult"
          }
        }
      }
    },
    "VerificationIpv4Address": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 15,
      "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}$"
    },
    "VerificationIpv6Address": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 45,
      "pattern": "^[0-9A-Fa-f:]+$"
    },
    "EgressGeoProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "ip",
        "country_code",
        "country",
        "region",
        "city"
      ],
      "properties": {
        "provider": {
          "enum": [
            "ipapi",
            "ipwho"
          ]
        },
        "ip": {
          "type": "string",
          "maxLength": 15,
          "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}$"
        },
        "country_code": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2,
          "pattern": "^[A-Z]{2}$"
        },
        "country": {
          "type": "string",
          "maxLength": 96
        },
        "region": {
          "type": "string",
          "maxLength": 96
        },
        "city": {
          "type": "string",
          "maxLength": 96
        }
      }
    },
    "EgressVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "checked_at",
        "verdict",
        "message_key",
        "tunnel",
        "ipv4",
        "ipv6",
        "geo",
        "dns",
        "speed",
        "findings"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "checked_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "verdict": {
          "enum": [
            "verified",
            "warning",
            "failed"
          ]
        },
        "message_key": {
          "$ref": "#/$defs/Identifier"
        },
        "tunnel": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "active",
            "protocol",
            "profile",
            "interface"
          ],
          "properties": {
            "active": {
              "type": "boolean"
            },
            "protocol": {
              "oneOf": [
                {
                  "$ref": "#/$defs/Protocol"
                },
                {
                  "type": "null"
                }
              ]
            },
            "profile": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 255
            },
            "interface": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 32,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            }
          }
        },
        "ipv4": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "interface_ip",
            "default_ip",
            "same_egress"
          ],
          "properties": {
            "interface_ip": {
              "$ref": "#/$defs/VerificationIpv4Address"
            },
            "default_ip": {
              "$ref": "#/$defs/VerificationIpv4Address"
            },
            "same_egress": {
              "type": "boolean"
            }
          }
        },
        "ipv6": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "interface_ip",
            "default_ip",
            "potential_leak"
          ],
          "properties": {
            "interface_ip": {
              "$ref": "#/$defs/VerificationIpv6Address"
            },
            "default_ip": {
              "$ref": "#/$defs/VerificationIpv6Address"
            },
            "potential_leak": {
              "type": "boolean"
            }
          }
        },
        "geo": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "expected_country_code",
            "observed_country_code",
            "country_match",
            "providers_agree",
            "providers"
          ],
          "properties": {
            "expected_country_code": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[A-Z]{2}$"
            },
            "observed_country_code": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[A-Z]{2}$"
            },
            "country_match": {
              "enum": [
                "match",
                "mismatch",
                "unknown"
              ]
            },
            "providers_agree": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "providers": {
              "type": "array",
              "maxItems": 2,
              "items": {
                "$ref": "#/$defs/EgressGeoProvider"
              }
            }
          }
        },
        "dns": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "enum": [
                "vpn-full-tunnel",
                "vpn-interface",
                "unknown",
                "unavailable"
              ]
            }
          }
        },
        "speed": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requested",
            "measured",
            "mbps",
            "connect_ms"
          ],
          "properties": {
            "requested": {
              "type": "boolean"
            },
            "measured": {
              "type": "boolean"
            },
            "mbps": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "connect_ms": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "findings": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        }
      }
    },
    "ServiceEgressRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service",
        "timeout_seconds"
      ],
      "properties": {
        "service": {
          "enum": [
            "notebooklm",
            "openai",
            "all"
          ]
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 3,
          "maximum": 15
        }
      }
    },
    "ServiceEgressProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service_id",
        "probe_version",
        "reachability",
        "egress_eligibility",
        "reason_code",
        "http_status"
      ],
      "properties": {
        "service_id": {
          "enum": [
            "notebooklm",
            "openai"
          ]
        },
        "probe_version": {
          "const": 1
        },
        "reachability": {
          "enum": [
            "reachable",
            "unreachable"
          ]
        },
        "egress_eligibility": {
          "enum": [
            "eligible",
            "ineligible",
            "indeterminate"
          ]
        },
        "reason_code": {
          "enum": [
            "service.notebooklm.unsupported-location",
            "service.notebooklm.home-reached",
            "service.notebooklm.unrecognized-response",
            "service.openai.auth-boundary-reached",
            "service.openai.edge-denied",
            "service.openai.rate-limited",
            "service.openai.service-unavailable",
            "service.openai.unrecognized-response",
            "service.network-unreachable",
            "service.response-invalid",
            "service.response-too-large"
          ]
        },
        "http_status": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 100,
          "maximum": 599
        }
      }
    },
    "ServiceEgressVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "checked_at",
        "scope",
        "results"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "checked_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "scope": {
          "const": "unauthenticated-egress"
        },
        "results": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ServiceEgressProbe"
          }
        }
      }
    },
    "ServiceState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service_id",
        "state",
        "enabled"
      ],
      "properties": {
        "service_id": {
          "$ref": "#/$defs/Identifier"
        },
        "state": {
          "enum": [
            "active",
            "inactive",
            "failed",
            "unknown"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "last_transition_at": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    },
    "ServiceCollection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "services"
      ],
      "properties": {
        "services": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ServiceState"
          }
        }
      }
    },
    "DoctorFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "message_key"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/Identifier"
        },
        "severity": {
          "enum": [
            "ok",
            "warning",
            "error"
          ]
        },
        "message_key": {
          "$ref": "#/$defs/Identifier"
        },
        "fix_id": {
          "$ref": "#/$defs/Identifier"
        }
      }
    },
    "DoctorReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "warnings",
        "failures",
        "findings"
      ],
      "properties": {
        "ok": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        },
        "failures": {
          "type": "integer",
          "minimum": 0
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DoctorFinding"
          }
        }
      }
    },
    "PublicSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "notifications",
        "update_channel",
        "fallback_policy"
      ],
      "properties": {
        "language": {
          "enum": [
            "ru",
            "en",
            "de",
            "zh",
            "ja",
            "ko"
          ]
        },
        "notifications": {
          "type": "boolean"
        },
        "update_channel": {
          "enum": [
            "stable",
            "preview"
          ]
        },
        "fallback_policy": {
          "enum": [
            "disabled",
            "previous-profile",
            "emergency"
          ]
        }
      }
    },
    "RollbackOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "state"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "state": {
          "enum": [
            "not-needed",
            "pending",
            "completed",
            "failed"
          ]
        },
        "message_key": {
          "$ref": "#/$defs/Identifier"
        }
      }
    },
    "ActionOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "state",
        "state_changed",
        "rollback"
      ],
      "properties": {
        "action_id": {
          "$ref": "#/$defs/Identifier"
        },
        "state": {
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed",
            "timed-out",
            "rolled-back",
            "rollback-failed"
          ]
        },
        "state_changed": {
          "type": "boolean"
        },
        "rollback": {
          "$ref": "#/$defs/RollbackOutcome"
        },
        "message_key": {
          "$ref": "#/$defs/Identifier"
        }
      }
    },
    "ErrorCode": {
      "enum": [
        "invalid-request",
        "unsupported-version",
        "unsupported-operation",
        "authorization-required",
        "permission-denied",
        "not-found",
        "conflict",
        "busy",
        "deadline-exceeded",
        "backend-unavailable",
        "validation-failed",
        "operation-failed",
        "rollback-failed",
        "internal-error"
      ]
    },
    "ApiError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message_key",
        "retryable",
        "user_action_required"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message_key": {
          "$ref": "#/$defs/Identifier"
        },
        "retryable": {
          "type": "boolean"
        },
        "user_action_required": {
          "type": "boolean"
        }
      }
    },
    "ResponseResult": {
      "oneOf": [
        {
          "$ref": "#/$defs/PublicStatus"
        },
        {
          "$ref": "#/$defs/ProfileCollection"
        },
        {
          "$ref": "#/$defs/ProtocolCatalog"
        },
        {
          "$ref": "#/$defs/PlannerEvaluation"
        },
        {
          "$ref": "#/$defs/TestResult"
        },
        {
          "$ref": "#/$defs/ProbeCollection"
        },
        {
          "$ref": "#/$defs/EgressVerification"
        },
        {
          "$ref": "#/$defs/ServiceEgressVerification"
        },
        {
          "$ref": "#/$defs/ServiceCollection"
        },
        {
          "$ref": "#/$defs/DoctorReport"
        },
        {
          "$ref": "#/$defs/PublicSettings"
        },
        {
          "$ref": "#/$defs/ActionOutcome"
        }
      ]
    },
    "ResponseEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_version",
        "request_id",
        "status"
      ],
      "properties": {
        "api_version": {
          "$ref": "#/$defs/ApiVersion"
        },
        "request_id": {
          "$ref": "#/$defs/Identifier"
        },
        "status": {
          "enum": [
            "ok",
            "error"
          ]
        },
        "result": {
          "$ref": "#/$defs/ResponseResult"
        },
        "error": {
          "$ref": "#/$defs/ApiError"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "ok"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "result"
            ],
            "not": {
              "required": [
                "error"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "error"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "error"
            ],
            "not": {
              "required": [
                "result"
              ]
            }
          }
        }
      ]
    },
    "ConnectionEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connection"
      ],
      "properties": {
        "connection": {
          "$ref": "#/$defs/ConnectionSummary"
        }
      }
    },
    "ActionEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action"
      ],
      "properties": {
        "action": {
          "$ref": "#/$defs/ActionOutcome"
        }
      }
    },
    "ServiceEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service"
      ],
      "properties": {
        "service": {
          "$ref": "#/$defs/ServiceState"
        }
      }
    },
    "DiagnosticEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding"
      ],
      "properties": {
        "finding": {
          "$ref": "#/$defs/DoctorFinding"
        }
      }
    },
    "AuditEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "operation",
        "authorization",
        "decision",
        "outcome"
      ],
      "properties": {
        "action_id": {
          "$ref": "#/$defs/Identifier"
        },
        "operation": {
          "$ref": "#/$defs/MutationOperation"
        },
        "authorization": {
          "$ref": "#/$defs/Authorization"
        },
        "decision": {
          "enum": [
            "approved",
            "denied",
            "not-required"
          ]
        },
        "outcome": {
          "enum": [
            "started",
            "succeeded",
            "failed",
            "timed-out",
            "rolled-back",
            "rollback-failed"
          ]
        }
      }
    },
    "EventPayload": {
      "oneOf": [
        {
          "$ref": "#/$defs/ConnectionEvent"
        },
        {
          "$ref": "#/$defs/ActionEvent"
        },
        {
          "$ref": "#/$defs/ServiceEvent"
        },
        {
          "$ref": "#/$defs/DiagnosticEvent"
        },
        {
          "$ref": "#/$defs/AuditEvent"
        }
      ]
    },
    "EventEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_version",
        "event_id",
        "sequence",
        "generated_at",
        "event_type",
        "payload"
      ],
      "properties": {
        "api_version": {
          "$ref": "#/$defs/ApiVersion"
        },
        "event_id": {
          "$ref": "#/$defs/Identifier"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "generated_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "event_type": {
          "enum": [
            "connection.changed",
            "action.changed",
            "service.changed",
            "doctor.finding",
            "audit.recorded"
          ]
        },
        "action_id": {
          "$ref": "#/$defs/Identifier"
        },
        "payload": {
          "$ref": "#/$defs/EventPayload"
        }
      }
    }
  }
}
