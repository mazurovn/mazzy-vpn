_mazzy_vpn()
{
    local cur prev commands protocols
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    commands="api-info protocols planner list profiles connect quick disconnect reconnect dashboard status diagnose verify verify-service region-check validate probe test test-all emergency self-test doctor autostart monitor import import-files import-dir init-config-dir remove logs language help version"
    protocols="amneziawg wireguard openvpn l2tp"

    if ((COMP_CWORD == 1)); then
        mapfile -t COMPREPLY < <(compgen -W "$commands" -- "$cur")
    elif [[ "$prev" == "api-info" ]]; then
        mapfile -t COMPREPLY < <(compgen -W "--json" -- "$cur")
    elif [[ "${COMP_WORDS[1]:-}" == "protocols" ]]; then
        mapfile -t COMPREPLY < <(
            compgen -W "list diagnose detect --json --stdin" -- "$cur"
        )
    elif [[ "${COMP_WORDS[1]:-}" == "planner" ]]; then
        mapfile -t COMPREPLY < <(
            compgen -W "evaluate --stdin --json" -- "$cur"
        )
    elif [[ "$prev" == "status" || "$prev" == "profiles" ]]; then
        mapfile -t COMPREPLY < <(compgen -W "--json --api-json" -- "$cur")
    elif [[ "${COMP_WORDS[1]:-}" == "probe" || "${COMP_WORDS[1]:-}" == "ping" ]]; then
        mapfile -t COMPREPLY < <(
            compgen -W "$protocols all --timeout --jobs --json" -- "$cur"
        )
    elif [[ "${COMP_WORDS[1]:-}" == "verify" ||
            "${COMP_WORDS[1]:-}" == "verify-egress" ]]; then
        mapfile -t COMPREPLY < <(compgen -W "--timeout --speed --json" -- "$cur")
    elif [[ "${COMP_WORDS[1]:-}" == "verify-service" ]]; then
        mapfile -t COMPREPLY < <(
            compgen -W "notebooklm openai google antigravity all --timeout --json" -- "$cur"
        )
    elif [[ "${COMP_WORDS[1]:-}" == "region-check" ]]; then
        mapfile -t COMPREPLY < <(
            compgen -W "--provider --target-country --json notebooklm openai google antigravity" -- "$cur"
        )
    elif [[ "$prev" == "list" || "$prev" == "connect" || "$prev" == "test" ||
            "$prev" == "test-all" || "$prev" == "validate" ||
            "$prev" == "import" || "$prev" == "remove" ]]; then
        mapfile -t COMPREPLY < <(compgen -W "$protocols all" -- "$cur")
    elif [[ "$prev" == "autostart" || "$prev" == "monitor" ]]; then
        mapfile -t COMPREPLY < <(compgen -W "on off" -- "$cur")
    elif [[ "$prev" == "language" || "$prev" == "lang" ]]; then
        mapfile -t COMPREPLY < <(compgen -W "ru en de zh ja ko list current" -- "$cur")
    elif [[ "$prev" == "emergency" ]]; then
        mapfile -t COMPREPLY < <(compgen -W "--timeout --protocol" -- "$cur")
    elif [[ "$prev" == "self-test" || "$prev" == "selftest" ]]; then
        mapfile -t COMPREPLY < <(compgen -W "--offline --live --timeout" -- "$cur")
    elif [[ "$prev" == "import-dir" ]]; then
        mapfile -t COMPREPLY < <(compgen -W "--dry-run --force" -- "$cur")
    elif [[ "$prev" == "import-files" ]]; then
        mapfile -t COMPREPLY < <(compgen -W "--force" -- "$cur")
    fi
}
complete -F _mazzy_vpn mazzy-vpn mazzyvpn vpnctl
