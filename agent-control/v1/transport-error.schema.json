{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mazurovn/mazzy-vpn/agent-control/v1/transport-error.schema.json",
  "title": "Mazzy agent egress transport error v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol", "message_type", "error", "recorded_at"],
  "properties": {
    "schema_version": {"const": 1},
    "protocol": {"const": "mazzy-agent-egress/1"},
    "message_type": {"const": "error"},
    "error": {"$ref": "error.schema.json"},
    "recorded_at": {"type": "string", "format": "date-time"}
  }
}
